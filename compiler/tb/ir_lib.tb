# Internal ordinary-local identities use a delimiter unavailable to source names.
string ir_source_binding_name(string identity):
    int separator = identity.index_of('$')
    if (separator >= 0):
        return identity.substring(0, separator)
    return identity.substring(0)

# Conditional carriers are compiler-only bindings, unavailable to source names.
bool ir_is_conditional_binding(string name):
    return name.starts_with('choice.')

bool ir_is_expression_block(string label):
    return label.starts_with('logic.') || label.starts_with('choice.')

record LinearInstruction(string kind, string lhs, string result_type, string ownership_mode, string detail, string[] args);
record TerminatorIR(string kind, string[] args);
record BindingIR(string type_name, string name);
record ImportDeclIR(string header);
record GlobalDeclIR(string header, LinearInstruction[] instructions, string value_name);
record BlockIR(string label, LinearInstruction[] instructions, TerminatorIR terminator);
record ParsedFunction(string header, string name, string return_type, BindingIR[] params, BindingIR[] locals, BlockIR[] blocks);
record RecordDeclIR(string header, string[] fields);
record EnumDeclIR(string header, string[] values);
record ProgramIR(ImportDeclIR[] imports, GlobalDeclIR[] globals, RecordDeclIR[] records, EnumDeclIR[] enums, ParsedFunction[] functions);

# Lowering emits each try body before its catch. The last active try in
# this order is the nearest handler, including nested tries in one block.
int block_index_by_label(ParsedFunction function_ir, string label):
    int block_index = 0
    while (block_index < function_ir.blocks.length()):
        if (function_ir.blocks[block_index].label == label):
            return block_index
        block_index += 1
    return -1

int enclosing_try_catch_block_index(ParsedFunction function_ir, string block_label):
    int block_index = block_index_by_label(function_ir, block_label)
    if (block_index < 0):
        return -1
    int best_catch_block_index = -1
    int scan_block_index = 0
    while (scan_block_index <= block_index):
        BlockIR block = function_ir.blocks[scan_block_index]
        for (LinearInstruction op in block.instructions):
            if (op.kind == 'try'):
                int catch_block_index = block_index_by_label(function_ir, op.detail)
                if (catch_block_index > block_index):
                    best_catch_block_index = catch_block_index
        scan_block_index += 1
    return best_catch_block_index

int ir_last_space_index(string value):
    int index = value.length() - 1
    while (index >= 0):
        if (value[index] == ' '):
            return index
        index -= 1
    return -1

BindingIR ir_parse_binding_decl(string value):
    int split = ir_last_space_index(value)
    if (split < 0):
        return BindingIR('', value.substring(0))
    return BindingIR(value.substring(0, split).substring(0), value.substring(split + 1).substring(0))

string ir_format_param_binding(BindingIR binding):
    return 'param ' + binding.type_name + ' ' + binding.name

string ir_format_local_binding(BindingIR binding):
    return 'local ' + binding.type_name + ' ' + binding.name

string[] ir_tail_strings(string[] items, int start):
    string[] tail = []
    int index = start
    while (index < items.length()):
        tail.push(items[index])
        index += 1
    return tail
