import ir_lib;
import parser;

record TempResult(string name, string[] lines, int next_temp);
record TempListResult(string[] names, string[] lines, int next_temp);
record LinearBlockResult(string[] lines, int next_temp);
record LinearListResult(string[] lines, int next_temp, int next_label);
record TempIRResult(string name, LinearInstruction[] instructions, int next_temp);
record TempIRListResult(string[] names, LinearInstruction[] instructions, int next_temp);
record LinearIRBlockResult(LinearInstruction[] instructions, int next_temp);
record LinearIRListResult(LinearInstruction[] instructions, int next_temp, int next_label);
record LoweredFunctionDeclIR(ParsedFunction function_ir, int next_index);
record SubmitLambdaRewrite(Node node, Node[] generated, string[] used_names, int next_index);
record SubmitScopedRewrite(Node node, Node[] generated, string[] used_names, int next_index, BindingIR[] bindings);
record SubmitScopedListRewrite(Node[] nodes, Node[] generated, string[] used_names, int next_index, BindingIR[] bindings);
record SubmitLambdaBlockCheck(string return_type, bool returns_all_paths);
record SubmitLambdaScope(string[] names, string[] types, string[] const_names, string[] declared_names, string parameter_name);
record SubmitLambdaValidation(SubmitLambdaBlockCheck check, SubmitLambdaScope scope);
record SubmitRangeListRewrite(Node[] nodes, string[] used_names, int next_index);

bool submit_lambda_managed_type(string type_name):
    return type_name == 'string' || type_name == 'int[]' || type_name == 'int[][]'

string quote_string(string value):
    return '\'' + value + '\''

string join_strings(string[] items, string separator):
    if (items.is_empty()):
        return ''
    string result = items[0]
    int index = 1
    while (index < items.length()):
        result += separator + items[index]
        index += 1
    return result

string temp_name(int index):
    return 't' + index.to_string()

string label_name(int index):
    return 'L' + index.to_string()

string loop_index_name(int index):
    return '__for_index_' + index.to_string()

string[] append_lines(string[] left, string[] right):
    for (string line in right):
        left.push(line)
    return left

LinearInstruction[] append_instructions(LinearInstruction[] left, LinearInstruction[] right):
    LinearInstruction[] result = []
    for (LinearInstruction op : left):
        result.push(op)
    for (LinearInstruction op : right):
        result.push(op)
    return result

Node[] append_nodes(Node[] left, Node[] right):
    Node[] result = []
    for (Node node : left):
        result.push(node)
    for (Node node : right):
        result.push(node)
    return result

string[] indent_lines(string[] lines, string indent):
    string[] result = []
    for (string line in lines):
        result.push(indent + line)
    return result

string[] append_indented_lines(string[] left, string[] right, string indent):
    for (string line in right):
        left.push(indent + line)
    return left

Node[] tail_nodes(Node[] nodes, int start):
    Node[] tail = []
    int index = start
    while (index < nodes.length()):
        tail.push(nodes[index])
        index += 1
    return tail

Node[] copy_nodes(Node[] nodes):
    Node[] copied = []
    for (Node node in nodes):
        copied.push(node)
    return copied

bool contains_name(string[] names, string name):
    for (string existing : names):
        if (existing == name):
            return true
    return false

string[] add_unique_name(string[] names, string name):
    if (!contains_name(names, name)):
        names.push(name)
    return names

string binding_name(string value):
    return ir_parse_binding_decl(value).name

int submit_lambda_name_index(string[] names, string name):
    int index = names.length() - 1
    while (index >= 0):
        if (names[index] == name):
            return index
        index -= 1
    return -1

SubmitLambdaScope copy_submit_lambda_scope(SubmitLambdaScope scope):
    string[] names = []
    string[] types = []
    string[] const_names = []
    string[] declared_names = []
    for (string name : scope.names):
        names.push(name)
    for (string type_name : scope.types):
        types.push(type_name)
    for (string name : scope.const_names):
        const_names.push(name)
    for (string name : scope.declared_names):
        declared_names.push(name)
    return SubmitLambdaScope(names, types, const_names, declared_names, scope.parameter_name)

string[] collect_submit_unavailable_names(Node node, string[] names):
    names = add_unique_name(names, node.value)
    if (node.kind == 'Param' || node.kind == 'VarDecl' || node.kind == 'ForEach' || node.kind == 'Catch' || node.kind == 'Function' || node.kind == 'CachedFunction'):
        names = add_unique_name(names, binding_name(node.value))
    for (Node child : node.children):
        names = collect_submit_unavailable_names(child, names)
    return names

Node submit_lambda_helper(Node[] functions, string name):
    int index = functions.length() - 1
    while (index >= 0):
        Node function_node = functions[index]
        if (function_node.kind == 'Function' || function_node.kind == 'CachedFunction'):
            BindingIR signature = ir_parse_binding_decl(function_node.value)
            if (signature.name == name):
                return function_node
        index -= 1
    return Node('', '', [])

string submit_lambda_expression_type(Node node, SubmitLambdaScope scope, Node[] functions):
    if (node.kind == 'Int'):
        return 'int'
    if (node.kind == 'Bool'):
        return 'bool'
    if (node.kind == 'Identifier'):
        int local_index = submit_lambda_name_index(scope.names, node.value)
        if (local_index >= 0):
            return scope.types[local_index]
        return ''
    if (node.kind == 'Index'):
        if (node.children.length() != 2):
            return ''
        string base_type = submit_lambda_expression_type(node.children[0], scope, functions)
        string index_type = submit_lambda_expression_type(node.children[1], scope, functions)
        if (index_type != 'int'):
            throw 'thread_pool.submit lambda array index must have type int'
        if (base_type == 'int[]'):
            return 'int'
        if (base_type == 'int[][]'):
            return 'int[]'
        if (base_type == 'string' || base_type == 'string[]' || base_type == 'string[][]'):
            throw 'thread_pool.submit lambda string indexing is not supported'
        throw 'thread_pool.submit lambda indexing requires int[] or int[][]'
    if (node.kind == 'MethodCall'):
        if (node.children.length() < 1):
            return ''
        if (node.value != 'length' && node.value != 'is_empty'):
            return ''
        if (node.children.length() != 1):
            throw 'thread_pool.submit lambda ' + node.value + ' query takes no arguments'
        string receiver_type = submit_lambda_expression_type(node.children[0], scope, functions)
        if (!(receiver_type == 'string' || receiver_type == 'int[]' || receiver_type == 'int[][]')):
            throw 'thread_pool.submit lambda ' + node.value + ' query requires string, int[], or int[][]'
        if (node.value == 'length'):
            return 'int'
        return 'bool'
    if (node.kind == 'Unary'):
        if (node.children.length() != 1):
            return ''
        if (node.value == '-'):
            if (submit_lambda_expression_type(node.children[0], scope, functions) == 'int'):
                return 'int'
            return ''
        if (node.value == '!' || node.value == 'not'):
            if (submit_lambda_expression_type(node.children[0], scope, functions) == 'bool'):
                return 'bool'
        return ''
    if (node.kind == 'Binary'):
        if (node.children.length() != 2):
            return ''
        string left_type = submit_lambda_expression_type(node.children[0], scope, functions)
        if (left_type == ''):
            return ''
        string right_type = submit_lambda_expression_type(node.children[1], scope, functions)
        if (right_type == ''):
            return ''
        if (node.value == '+' || node.value == '-' || node.value == '*' || node.value == '/' || node.value == '%' || node.value == '&' || node.value == '|' || node.value == '^' || node.value == '<<' || node.value == '>>'):
            if (left_type == 'int' && right_type == 'int'):
                return 'int'
            return ''
        if (node.value == '<' || node.value == '<=' || node.value == '>' || node.value == '>='):
            if (left_type == 'int' && right_type == 'int'):
                return 'bool'
            return ''
        if (node.value == '==' || node.value == '!='):
            if (left_type == right_type && (left_type == 'int' || left_type == 'bool')):
                return 'bool'
            return ''
        if (node.value == '&&' || node.value == '||' || node.value == 'and' || node.value == 'or'):
            if (left_type == 'bool' && right_type == 'bool'):
                return 'bool'
        return ''
    if (node.kind == 'Call'):
        Node function_node = submit_lambda_helper(functions, node.value)
        if (function_node.kind == ''):
            return ''
        BindingIR signature = ir_parse_binding_decl(function_node.value)
        if (!(signature.type_name == 'int' || signature.type_name == 'bool')):
            return ''
        int parameter_count = 0
        int index = 0
        while (index < function_node.children.length()):
            if (function_node.children[index].kind != 'Param'):
                break
            BindingIR parameter = ir_parse_binding_decl(function_node.children[index].value)
            string helper_decl_type = parameter.type_name
            if (helper_decl_type.starts_with('const ')):
                helper_decl_type = helper_decl_type.substring(6)
            if (!(helper_decl_type == 'int' || helper_decl_type == 'bool' || submit_lambda_managed_type(helper_decl_type))):
                return ''
            parameter_count += 1
            index += 1
        if (node.children.length() != parameter_count):
            throw 'thread_pool.submit lambda helper ' + node.value + ' expects ' + parameter_count.to_string() + ' arguments but received ' + node.children.length().to_string()
        index = 0
        while (index < parameter_count):
            BindingIR parameter = ir_parse_binding_decl(function_node.children[index].value)
            string helper_decl_type = parameter.type_name
            if (helper_decl_type.starts_with('const ')):
                helper_decl_type = helper_decl_type.substring(6)
            string argument_type = submit_lambda_expression_type(node.children[index], scope, functions)
            if (argument_type == ''):
                return ''
            if (argument_type != helper_decl_type):
                throw 'thread_pool.submit lambda helper ' + node.value + ' argument ' + (index + 1).to_string() + ' must have type ' + helper_decl_type + '; got ' + argument_type
            index += 1
        return signature.type_name
    return ''

string merge_submit_return_types(string left, string right):
    if (left == ''):
        return right
    if (right == ''):
        return left
    if (left != right):
        throw 'thread_pool.submit lambda block returns must all have the same int or bool type'
    return left

SubmitLambdaValidation validate_submit_lambda_block_statements(Node[] statements, SubmitLambdaScope initial_scope, Node[] functions, int loop_depth):
    SubmitLambdaScope scope = initial_scope
    string return_type = ''
    bool previous_paths_return = false
    for (Node statement : statements):
        SubmitLambdaBlockCheck current = SubmitLambdaBlockCheck('', false)
        if (statement.kind == 'VarDecl'):
            if (statement.children.length() != 1):
                throw 'thread_pool.submit lambda local declaration requires an initializer'
            BindingIR binding = ir_parse_binding_decl(statement.value)
            string local_type = binding.type_name
            bool is_const = local_type.starts_with('const ')
            if (is_const):
                local_type = local_type.substring(6)
            if (!(local_type == 'int' || local_type == 'bool')):
                throw 'thread_pool.submit lambda locals must have type int or bool'
            if (contains_name(scope.declared_names, binding.name)):
                throw 'thread_pool.submit lambda local names must be unique, including the parameter'
            string initializer_type = submit_lambda_expression_type(statement.children[0], scope, functions)
            if (initializer_type == ''):
                throw 'thread_pool.submit lambda local initializer must use only in-scope scalar values and declared scalar helper calls'
            if (initializer_type != local_type):
                throw 'thread_pool.submit lambda local initializer must have type ' + local_type + '; got ' + initializer_type
            scope.declared_names = append_lines(scope.declared_names, [binding.name])
            scope.names = append_lines(scope.names, [binding.name])
            scope.types = append_lines(scope.types, [local_type])
            if (is_const):
                scope.const_names = append_lines(scope.const_names, [binding.name])
        else if (statement.kind == 'Assign'):
            if (statement.children.length() != 2):
                throw 'thread_pool.submit lambda assignments must target a mutable scalar local'
            if (statement.children[0].kind != 'Identifier'):
                throw 'thread_pool.submit lambda assignments must target a mutable scalar local'
            string target_name = statement.children[0].value
            int target_index = submit_lambda_name_index(scope.names, target_name)
            if (target_index < 0):
                throw 'thread_pool.submit lambda assignment target must be an in-scope scalar local'
            if (contains_name(scope.const_names, target_name)):
                if (submit_lambda_managed_type(scope.types[target_index])):
                    throw 'thread_pool.submit lambda cannot assign to managed task parameter ' + target_name
                throw 'thread_pool.submit lambda cannot assign to const local ' + target_name
            string value_type = submit_lambda_expression_type(statement.children[1], scope, functions)
            if (value_type == ''):
                throw 'thread_pool.submit lambda assignment value must use only in-scope scalar values and declared scalar helper calls'
            if (value_type != scope.types[target_index]):
                throw 'thread_pool.submit lambda assignment must have type ' + scope.types[target_index] + '; got ' + value_type
        else if (statement.kind == 'Return'):
            if (statement.children.length() != 1):
                throw 'thread_pool.submit lambda block requires value returns'
            current.return_type = submit_lambda_expression_type(statement.children[0], scope, functions)
            if (!(current.return_type == 'int' || current.return_type == 'bool')):
                throw 'thread_pool.submit lambda return must be an int or bool expression using only in-scope scalar values and declared scalar helper calls'
            current.returns_all_paths = true
        else if (statement.kind == 'Throw'):
            if (statement.children.length() != 1):
                throw 'thread_pool.submit lambda throw requires a string literal'
            if (statement.children[0].kind != 'String'):
                throw 'thread_pool.submit lambda throw requires a string literal'
            current.returns_all_paths = true
        else if (statement.kind == 'If'):
            if (statement.children.length() < 1):
                throw 'thread_pool.submit lambda block contains an invalid if statement'
            if (submit_lambda_expression_type(statement.children[0], scope, functions) != 'bool'):
                throw 'thread_pool.submit lambda condition must be a bool expression using only in-scope scalar values and declared scalar helper calls'
            Node[] then_statements = []
            Node[] else_statements = []
            bool has_else = false
            int child_index = 1
            while (child_index < statement.children.length()):
                Node child = statement.children[child_index]
                if (child.kind == 'Else'):
                    if (has_else || child_index + 1 != statement.children.length()):
                        throw 'thread_pool.submit lambda block contains an invalid else branch'
                    has_else = true
                    else_statements = child.children
                else:
                    then_statements.push(child)
                child_index += 1
            SubmitLambdaValidation then_validation = validate_submit_lambda_block_statements(then_statements, copy_submit_lambda_scope(scope), functions, loop_depth)
            SubmitLambdaBlockCheck then_check = then_validation.check
            return_type = merge_submit_return_types(return_type, then_check.return_type)
            current.returns_all_paths = false
            if (has_else):
                SubmitLambdaScope else_scope = copy_submit_lambda_scope(scope)
                else_scope.declared_names = then_validation.scope.declared_names
                SubmitLambdaValidation else_validation = validate_submit_lambda_block_statements(else_statements, else_scope, functions, loop_depth)
                SubmitLambdaBlockCheck else_check = else_validation.check
                return_type = merge_submit_return_types(return_type, else_check.return_type)
                current.returns_all_paths = then_check.returns_all_paths && else_check.returns_all_paths
                scope.declared_names = else_validation.scope.declared_names
            else:
                scope.declared_names = then_validation.scope.declared_names
            current.return_type = return_type
        else if (statement.kind == 'While'):
            if (statement.children.length() < 1):
                throw 'thread_pool.submit lambda block contains an invalid while statement'
            if (submit_lambda_expression_type(statement.children[0], scope, functions) != 'bool'):
                throw 'thread_pool.submit lambda while condition must be a bool expression using only in-scope scalar values and declared scalar helper calls'
            Node[] body_statements = tail_nodes(statement.children, 1)
            SubmitLambdaValidation body_validation = validate_submit_lambda_block_statements(body_statements, copy_submit_lambda_scope(scope), functions, loop_depth + 1)
            scope.declared_names = body_validation.scope.declared_names
            current.return_type = body_validation.check.return_type
        else if (statement.kind == 'For'):
            if (statement.children.length() < 3):
                throw 'thread_pool.submit lambda block contains an invalid for statement'
            Node init_statement = statement.children[0]
            if (!(init_statement.kind == 'VarDecl' || init_statement.kind == 'Assign')):
                throw 'thread_pool.submit lambda for initializer must be an initialized scalar declaration or assignment'
            SubmitLambdaValidation init_validation = validate_submit_lambda_block_statements([init_statement], copy_submit_lambda_scope(scope), functions, loop_depth)
            SubmitLambdaScope loop_scope = init_validation.scope
            if (submit_lambda_expression_type(statement.children[1], loop_scope, functions) != 'bool'):
                throw 'thread_pool.submit lambda for condition must be a bool expression using only in-scope scalar values and declared scalar helper calls'
            Node update_statement = statement.children[2]
            if (update_statement.kind != 'Assign'):
                throw 'thread_pool.submit lambda for update must assign to a mutable scalar local'
            SubmitLambdaValidation update_validation = validate_submit_lambda_block_statements([update_statement], copy_submit_lambda_scope(loop_scope), functions, loop_depth)
            Node[] body_statements = tail_nodes(statement.children, 3)
            SubmitLambdaValidation body_validation = validate_submit_lambda_block_statements(body_statements, copy_submit_lambda_scope(loop_scope), functions, loop_depth + 1)
            scope.declared_names = body_validation.scope.declared_names
            current.return_type = body_validation.check.return_type
        else if (statement.kind == 'ForEach'):
            if (statement.children.length() < 1):
                throw 'thread_pool.submit lambda foreach iterable must be a direct range call'
            bool is_range = statement.children[0].kind == 'Call' && statement.children[0].value == 'range'
            if (is_range):
                Node range_call = statement.children[0]
                if (!(range_call.children.length() == 1 || range_call.children.length() == 2)):
                    throw 'thread_pool.submit lambda range requires one or two int bounds'
                for (Node bound : range_call.children):
                    if (submit_lambda_expression_type(bound, scope, functions) != 'int'):
                        throw 'thread_pool.submit lambda range bounds must be int expressions using only in-scope scalar values and declared scalar helper calls'
            else:
                int parameter_index = submit_lambda_name_index(scope.names, scope.parameter_name)
                bool is_array_parameter = false
                if (statement.children[0].kind == 'Identifier'):
                    if (statement.children[0].value == scope.parameter_name):
                        if (parameter_index >= 0):
                            is_array_parameter = scope.types[parameter_index] == 'int[]'
                if (!is_array_parameter):
                    throw 'thread_pool.submit lambda foreach iterable must be the int[] task parameter or a direct range call'
            BindingIR iterator = ir_parse_binding_decl(statement.value)
            string iterator_type = iterator.type_name
            bool iterator_is_const = iterator_type.starts_with('const ')
            if (iterator_is_const):
                iterator_type = iterator_type.substring(6)
            if (iterator_type != 'int'):
                if (is_range):
                    throw 'thread_pool.submit lambda range iterator must have type int'
                throw 'thread_pool.submit lambda array iterator must have type int'
            if (contains_name(scope.declared_names, iterator.name)):
                throw 'thread_pool.submit lambda local names must be unique, including the parameter'
            SubmitLambdaScope loop_scope = copy_submit_lambda_scope(scope)
            loop_scope.names = append_lines(loop_scope.names, [iterator.name])
            loop_scope.types = append_lines(loop_scope.types, ['int'])
            loop_scope.declared_names = append_lines(loop_scope.declared_names, [iterator.name])
            if (iterator_is_const):
                loop_scope.const_names = append_lines(loop_scope.const_names, [iterator.name])
            SubmitLambdaValidation body_validation = validate_submit_lambda_block_statements(tail_nodes(statement.children, 1), loop_scope, functions, loop_depth + 1)
            scope.declared_names = body_validation.scope.declared_names
            current.return_type = body_validation.check.return_type
        else if (statement.kind == 'Switch'):
            if (statement.children.length() < 1):
                throw 'thread_pool.submit lambda block contains an invalid switch statement'
            if (submit_lambda_expression_type(statement.children[0], scope, functions) != 'int'):
                throw 'thread_pool.submit lambda switch subject must be an int expression using only in-scope scalar values and declared scalar helper calls'
            bool has_default = false
            string[] declared_names = scope.declared_names
            int child_index = 1
            while (child_index < statement.children.length()):
                Node branch = statement.children[child_index]
                Node[] branch_statements = []
                if (branch.kind == 'Case'):
                    if (branch.children.length() < 1):
                        throw 'thread_pool.submit lambda block contains an invalid switch case'
                    if (submit_lambda_expression_type(branch.children[0], scope, functions) != 'int'):
                        throw 'thread_pool.submit lambda switch case must be an int expression using only in-scope scalar values and declared scalar helper calls'
                    branch_statements = tail_nodes(branch.children, 1)
                else if (branch.kind == 'Default'):
                    if (has_default):
                        throw 'thread_pool.submit lambda switch can contain only one default branch'
                    has_default = true
                    branch_statements = branch.children
                else:
                    throw 'thread_pool.submit lambda block contains an invalid switch branch'
                SubmitLambdaScope branch_scope = copy_submit_lambda_scope(scope)
                branch_scope.declared_names = declared_names
                SubmitLambdaValidation branch_validation = validate_submit_lambda_block_statements(branch_statements, branch_scope, functions, loop_depth)
                return_type = merge_submit_return_types(return_type, branch_validation.check.return_type)
                declared_names = branch_validation.scope.declared_names
                child_index += 1
            scope.declared_names = declared_names
            current.return_type = return_type
        else if (statement.kind == 'Try'):
            Node[] try_statements = try_body_nodes(statement)
            Node catch_clause = catch_node(statement)
            SubmitLambdaValidation try_validation = validate_submit_lambda_block_statements(try_statements, copy_submit_lambda_scope(scope), functions, loop_depth)
            BindingIR catch_binding = ir_parse_binding_decl(catch_clause.value)
            if (!(catch_binding.type_name == 'exception' || catch_binding.type_name == 'string')):
                throw 'thread_pool.submit lambda catch binding must have type exception or string'
            if (contains_name(try_validation.scope.declared_names, catch_binding.name)):
                throw 'thread_pool.submit lambda local names must be unique, including the parameter'
            SubmitLambdaScope catch_scope = copy_submit_lambda_scope(scope)
            catch_scope.declared_names = append_lines(try_validation.scope.declared_names, [catch_binding.name])
            SubmitLambdaValidation catch_validation = validate_submit_lambda_block_statements(catch_clause.children, catch_scope, functions, loop_depth)
            return_type = merge_submit_return_types(return_type, try_validation.check.return_type)
            return_type = merge_submit_return_types(return_type, catch_validation.check.return_type)
            scope.declared_names = catch_validation.scope.declared_names
            current.return_type = return_type
            current.returns_all_paths = try_validation.check.returns_all_paths && catch_validation.check.returns_all_paths
        else if (statement.kind == 'Break'):
            if (loop_depth == 0):
                throw 'thread_pool.submit lambda break is only supported inside a while or for loop'
        else if (statement.kind == 'Continue'):
            if (loop_depth == 0):
                throw 'thread_pool.submit lambda continue is only supported inside a while or for loop'
        else:
            throw 'thread_pool.submit lambda block supports only scalar locals, assignments, return, literal throw, if/else, while, for, range foreach, switch and try/catch statements with break/continue'
        return_type = merge_submit_return_types(return_type, current.return_type)
        if (!previous_paths_return):
            previous_paths_return = current.returns_all_paths
    return SubmitLambdaValidation(SubmitLambdaBlockCheck(return_type, previous_paths_return), scope)

string validate_submit_lambda(Node lambda_node, Node[] functions, BindingIR[] captured):
    if (lambda_node.children.length() != 1):
        throw 'thread_pool.submit lambda must have one int or bool parameter and a scalar body'
    SubmitLambdaScope initial_scope = SubmitLambdaScope([], [], [], [], '')
    if (lambda_node.kind == 'Lambda'):
        BindingIR parameter = ir_parse_binding_decl(lambda_node.value)
        string parameter_type = parameter.type_name
        if (!(parameter_type == 'int' || parameter_type == 'bool' || submit_lambda_managed_type(parameter_type))):
            throw 'thread_pool.submit lambda parameter must have type int, bool, string, int[], or int[][]'
        string[] const_names = []
        if (submit_lambda_managed_type(parameter_type)):
            const_names.push(parameter.name)
        initial_scope = SubmitLambdaScope([parameter.name], [parameter_type], const_names, [parameter.name], parameter.name)
    else if (lambda_node.kind != 'Lambda0' || lambda_node.value != ''):
        throw 'thread_pool.submit lambda must have one int or bool parameter and a scalar body'
    if (lambda_node.kind == 'Lambda0' && captured.length() == 1):
        BindingIR binding = captured[0]
        string captured_type = binding.type_name
        if (captured_type.starts_with('const ')):
            captured_type = captured_type.substring(6)
        if (captured_type == 'int[]'):
            initial_scope.parameter_name = binding.name
    for (BindingIR binding : captured):
        string captured_type = binding.type_name
        if (captured_type.starts_with('const ')):
            captured_type = captured_type.substring(6)
        initial_scope.names = append_lines(initial_scope.names, [binding.name])
        initial_scope.types = append_lines(initial_scope.types, [captured_type])
        initial_scope.const_names = append_lines(initial_scope.const_names, [binding.name])
        initial_scope.declared_names = append_lines(initial_scope.declared_names, [binding.name])
    Node body = lambda_node.children[0]
    if (body.kind == 'Block'):
        SubmitLambdaValidation validation = validate_submit_lambda_block_statements(body.children, initial_scope, functions, 0)
        SubmitLambdaBlockCheck block_check = validation.check
        if (!(block_check.return_type == 'int' || block_check.return_type == 'bool') || !block_check.returns_all_paths):
            throw 'thread_pool.submit lambda block must return a value on every path'
        return block_check.return_type
    string result_type = submit_lambda_expression_type(body, initial_scope, functions)
    if (!(result_type == 'int' || result_type == 'bool')):
        throw 'thread_pool.submit lambda body must be an int or bool expression using only in-scope scalar values and declared scalar helper calls'
    return result_type

string[] submit_lambda_local_names(Node node, string[] names):
    if (node.kind == 'Lambda' || node.kind == 'Lambda0' || node.kind == 'Lambda2'):
        return names
    # Catch binders are reserved by the validator, but must not hide an outer
    # scalar reference when collecting captures for the whole lambda.
    if (node.kind == 'VarDecl' || node.kind == 'ForEach'):
        names = add_unique_name(names, binding_name(node.value))
    for (Node child : node.children):
        names = submit_lambda_local_names(child, names)
    return names

string[] submit_lambda_free_identifiers(Node node, string[] locals, string[] names):
    if (node.kind == 'Lambda' || node.kind == 'Lambda0' || node.kind == 'Lambda2'):
        return names
    if (node.kind == 'Identifier'):
        if (!contains_name(locals, node.value)):
            names = add_unique_name(names, node.value)
        return names
    for (Node child : node.children):
        names = submit_lambda_free_identifiers(child, locals, names)
    return names

string[] submit_function_declaration_names(Node node, string[] names):
    if (node.kind == 'Lambda' || node.kind == 'Lambda0' || node.kind == 'Lambda2'):
        return names
    if (node.kind == 'Param' || node.kind == 'VarDecl' || node.kind == 'ForEach' || node.kind == 'Catch'):
        names.push(binding_name(node.value))
    for (Node child : node.children):
        names = submit_function_declaration_names(child, names)
    return names

int submit_name_occurrence_count(string[] names, string name):
    int count = 0
    for (string existing : names):
        if (existing == name):
            count += 1
    return count

BindingIR[] submit_unique_global_bindings(Node[] declarations):
    BindingIR[] globals = []
    string[] names = []
    for (Node declaration : declarations):
        if (declaration.kind == 'VarDecl'):
            BindingIR binding = ir_parse_binding_decl(declaration.value)
            globals.push(binding)
            names.push(binding.name)
    BindingIR[] unique = []
    for (BindingIR binding : globals):
        if (submit_name_occurrence_count(names, binding.name) == 1):
            unique.push(binding)
    return unique

BindingIR[] submit_lambda_captures(Node lambda_node, BindingIR[] bindings, string[] declaration_names):
    BindingIR[] captured = []
    if (!(lambda_node.kind == 'Lambda' || lambda_node.kind == 'Lambda0') || lambda_node.children.length() != 1):
        return captured
    string[] locals = submit_lambda_local_names(lambda_node.children[0], [])
    if (lambda_node.kind == 'Lambda'):
        BindingIR parameter = ir_parse_binding_decl(lambda_node.value)
        locals = add_unique_name(locals, parameter.name)
    string[] identifiers = submit_lambda_free_identifiers(lambda_node.children[0], locals, [])
    for (string name : identifiers):
        BindingIR binding = const_lookup_binding(bindings, name)
        if (binding.name != ''):
            if (submit_name_occurrence_count(declaration_names, name) != 1):
                throw 'thread_pool.submit lambda capture name is ambiguous because the enclosing function declares ' + name + ' more than once'
            string type_name = binding.type_name
            if (type_name.starts_with('const ')):
                type_name = type_name.substring(6)
            if (type_name == 'int' || type_name == 'bool'):
                captured.push(binding)
            else if (lambda_node.kind == 'Lambda0' && submit_lambda_managed_type(type_name)):
                captured.push(binding)
            else:
                if (lambda_node.kind == 'Lambda0'):
                    throw 'thread_pool.submit zero-argument lambda can capture int or bool values, or one string, int[], or int[][] value; unsupported capture ' + name
                throw 'thread_pool.submit lambda can capture only int or bool values; unsupported capture ' + name
    int managed_capture_count = 0
    for (BindingIR binding : captured):
        string capture_type = binding.type_name
        if (capture_type.starts_with('const ')):
            capture_type = capture_type.substring(6)
        if (submit_lambda_managed_type(capture_type)):
            managed_capture_count += 1
    if (managed_capture_count > 0 && (lambda_node.kind != 'Lambda0' || captured.length() != 1)):
        throw 'thread_pool.submit lambda can capture one managed value only in a zero-argument lambda without other captures'
    return captured

string submit_worker_name(string[] used_names, int start_index):
    int index = start_index
    while (contains_name(used_names, '__tb_submit_lambda_' + index.to_string())):
        index += 1
    return '__tb_submit_lambda_' + index.to_string()

string submit_capture_name(string[] used_names, string prefix, int start_index):
    int index = start_index
    while (contains_name(used_names, prefix + index.to_string())):
        index += 1
    return prefix + index.to_string()

string submit_range_name(string[] used_names, string prefix, int index):
    int candidate = index
    while (contains_name(used_names, prefix + candidate.to_string())):
        candidate += 1
    return prefix + candidate.to_string()

Node rewrite_submit_array_parameter_reads(Node node, string parameter_name, string environment_name):
    if (node.kind == 'Identifier' && node.value == parameter_name):
        return Node('Index', '', [Node('Identifier', environment_name, []), Node('Int', '0', [])])
    Node[] children = []
    for (Node child : node.children):
        children.push(rewrite_submit_array_parameter_reads(child, parameter_name, environment_name))
    return Node(node.kind, node.value, children)

# Called only after validate_submit_lambda accepted the original worker AST.
SubmitRangeListRewrite rewrite_submit_range_foreach_list(Node[] statements, string[] used_names, int next_index):
    Node[] rewritten = []
    string[] current_names = used_names
    int current_index = next_index
    for (Node statement : statements):
        if (statement.kind == 'ForEach'):
            Node iterable = statement.children[0]
            if (iterable.kind != 'Call' || iterable.value != 'range'):
                SubmitRangeListRewrite body = rewrite_submit_range_foreach_list(tail_nodes(statement.children, 1), current_names, current_index)
                Node[] children = [iterable]
                children = append_nodes(children, body.nodes)
                rewritten.push(Node(statement.kind, statement.value, children))
                current_names = body.used_names
                current_index = body.next_index
                continue
            Node range_call = iterable
            Node start_expr = Node('Int', '0', [])
            Node end_expr = range_call.children[0]
            if (range_call.children.length() == 2):
                start_expr = range_call.children[0]
                end_expr = range_call.children[1]
            string start_name = submit_range_name(current_names, '__tb_range_start_', current_index)
            current_names = add_unique_name(current_names, start_name)
            current_index += 1
            string end_name = submit_range_name(current_names, '__tb_range_end_', current_index)
            current_names = add_unique_name(current_names, end_name)
            current_index += 1
            string counter_name = submit_range_name(current_names, '__tb_range_counter_', current_index)
            current_names = add_unique_name(current_names, counter_name)
            current_index += 1
            SubmitRangeListRewrite body = rewrite_submit_range_foreach_list(tail_nodes(statement.children, 1), current_names, current_index)
            current_names = body.used_names
            current_index = body.next_index
            Node[] loop_body = [Node('VarDecl', statement.value, [Node('Identifier', counter_name, [])])]
            loop_body = append_nodes(loop_body, body.nodes)
            Node init = Node('VarDecl', 'int ' + counter_name, [Node('Identifier', start_name, [])])
            Node condition = Node('Binary', '<', [Node('Identifier', counter_name, []), Node('Identifier', end_name, [])])
            Node update = Node('Assign', '', [Node('Identifier', counter_name, []), Node('Binary', '+', [Node('Identifier', counter_name, []), Node('Int', '1', [])])])
            rewritten.push(Node('VarDecl', 'const int ' + start_name, [start_expr]))
            rewritten.push(Node('VarDecl', 'const int ' + end_name, [end_expr]))
            Node[] loop_children = [init, condition, update]
            loop_children = append_nodes(loop_children, loop_body)
            rewritten.push(Node('For', '', loop_children))
        else if (statement.kind == 'If' && statement.children.length() > 0):
            SubmitRangeListRewrite then_part = rewrite_submit_range_foreach_list(if_then_nodes(statement), current_names, current_index)
            Node[] children = [statement.children[0]]
            children = append_nodes(children, then_part.nodes)
            current_names = then_part.used_names
            current_index = then_part.next_index
            Node[] else_source = if_else_nodes(statement)
            if (!else_source.is_empty()):
                SubmitRangeListRewrite else_part = rewrite_submit_range_foreach_list(else_source, current_names, current_index)
                children.push(Node('Else', '', else_part.nodes))
                current_names = else_part.used_names
                current_index = else_part.next_index
            rewritten.push(Node(statement.kind, statement.value, children))
        else if (statement.kind == 'While' && statement.children.length() > 0):
            SubmitRangeListRewrite body = rewrite_submit_range_foreach_list(tail_nodes(statement.children, 1), current_names, current_index)
            Node[] children = [statement.children[0]]
            children = append_nodes(children, body.nodes)
            rewritten.push(Node(statement.kind, statement.value, children))
            current_names = body.used_names
            current_index = body.next_index
        else if (statement.kind == 'For' && statement.children.length() >= 3):
            SubmitRangeListRewrite body = rewrite_submit_range_foreach_list(tail_nodes(statement.children, 3), current_names, current_index)
            Node[] children = [statement.children[0], statement.children[1], statement.children[2]]
            children = append_nodes(children, body.nodes)
            rewritten.push(Node(statement.kind, statement.value, children))
            current_names = body.used_names
            current_index = body.next_index
        else if (statement.kind == 'Switch' && statement.children.length() > 0):
            Node[] children = [statement.children[0]]
            for (Node branch : tail_nodes(statement.children, 1)):
                int body_start = 0
                if (branch.kind == 'Case'):
                    body_start = 1
                Node[] branch_head = []
                if (body_start == 1):
                    branch_head.push(branch.children[0])
                SubmitRangeListRewrite body = rewrite_submit_range_foreach_list(tail_nodes(branch.children, body_start), current_names, current_index)
                children.push(Node(branch.kind, branch.value, append_nodes(branch_head, body.nodes)))
                current_names = body.used_names
                current_index = body.next_index
            rewritten.push(Node(statement.kind, statement.value, children))
        else if (statement.kind == 'Try'):
            Node[] try_source = try_body_nodes(statement)
            SubmitRangeListRewrite try_part = rewrite_submit_range_foreach_list(try_source, current_names, current_index)
            Node catch_clause = catch_node(statement)
            SubmitRangeListRewrite catch_part = rewrite_submit_range_foreach_list(catch_clause.children, try_part.used_names, try_part.next_index)
            Node[] children = try_part.nodes
            children.push(Node(catch_clause.kind, catch_clause.value, catch_part.nodes))
            rewritten.push(Node(statement.kind, statement.value, children))
            current_names = catch_part.used_names
            current_index = catch_part.next_index
        else:
            rewritten.push(statement)
    return SubmitRangeListRewrite(rewritten, current_names, current_index)

SubmitScopedRewrite rewrite_submit_expression(Node node, string[] used_names, int next_index, Node[] functions, BindingIR[] bindings, string[] declaration_names):
    BindingIR[] captured = []
    string worker_return_type = ''
    bool rewrite_worker = false
    if (node.kind == 'MethodCall' && node.value == 'submit' && node.children.length() > 1):
        Node lambda_node = node.children[1]
        if (lambda_node.kind == 'Lambda0'):
            if (node.children.length() != 2):
                throw 'thread_pool.submit zero-argument lambda does not accept a task argument'
            captured = submit_lambda_captures(lambda_node, bindings, declaration_names)
            worker_return_type = validate_submit_lambda(lambda_node, functions, captured)
            rewrite_worker = true
        else if (lambda_node.kind == 'Lambda' || lambda_node.kind == 'Lambda2'):
            if (node.children.length() != 3):
                throw 'thread_pool.submit lambda requires exactly one task argument'
            if (lambda_node.kind == 'Lambda'):
                captured = submit_lambda_captures(lambda_node, bindings, declaration_names)
                BindingIR lambda_parameter = ir_parse_binding_decl(lambda_node.value)
                string lambda_parameter_type = lambda_parameter.type_name
                if (submit_lambda_managed_type(lambda_parameter_type) && !captured.is_empty() && lambda_parameter_type != 'int[]'):
                    throw 'thread_pool.submit lambda with a managed task parameter cannot capture values'
            worker_return_type = validate_submit_lambda(lambda_node, functions, captured)
            rewrite_worker = lambda_node.kind == 'Lambda'

    Node[] rewritten_children = []
    Node[] generated = []
    string[] current_names = used_names
    int current_index = next_index
    BindingIR[] child_bindings = bindings
    string[] child_declarations = declaration_names
    if (node.kind == 'Lambda' || node.kind == 'Lambda0' || node.kind == 'Lambda2'):
        child_bindings = []
        child_declarations = []
    for (Node child : node.children):
        SubmitScopedRewrite rewritten_child = rewrite_submit_expression(child, current_names, current_index, functions, child_bindings, child_declarations)
        rewritten_children.push(rewritten_child.node)
        generated = append_nodes(generated, rewritten_child.generated)
        current_names = rewritten_child.used_names
        current_index = rewritten_child.next_index

    Node rewritten = Node(node.kind, node.value, rewritten_children)
    if (rewrite_worker):
        Node lambda_node = node.children[1]
        string worker_name = submit_worker_name(current_names, current_index)
        current_names = add_unique_name(current_names, worker_name)
        current_index += 1
        Node[] function_children = []
        bool array_task_parameter = false
        if (lambda_node.kind == 'Lambda' && !captured.is_empty()):
            BindingIR lambda_parameter = ir_parse_binding_decl(lambda_node.value)
            array_task_parameter = lambda_parameter.type_name == 'int[]'
        bool packed_environment = (lambda_node.kind == 'Lambda0' && captured.length() > 1) || (lambda_node.kind == 'Lambda' && !captured.is_empty())
        string environment_name = ''
        string wrapper_name = ''
        string wrapper_pool_name = ''
        string wrapper_task_name = ''
        if (packed_environment):
            environment_name = submit_capture_name(current_names, '__tb_submit_environment_', current_index)
            current_names = add_unique_name(current_names, environment_name)
            current_index += 1
            if (array_task_parameter):
                function_children.push(Node('Param', 'const int[][] ' + environment_name, []))
            else:
                function_children.push(Node('Param', 'const int[] ' + environment_name, []))
        else:
            if (lambda_node.kind == 'Lambda'):
                function_children.push(Node('Param', lambda_node.value, []))
            for (BindingIR binding : captured):
                string capture_type = binding.type_name
                if (capture_type.starts_with('const ')):
                    capture_type = capture_type.substring(6)
                function_children.push(Node('Param', 'const ' + capture_type + ' ' + binding.name, []))
                rewritten_children.push(Node('Identifier', binding.name, []))
        Node lambda_body = lambda_node.children[0]
        if (array_task_parameter):
            BindingIR parameter = ir_parse_binding_decl(lambda_node.value)
            # Validation reserves the parameter name and rejects nested closures.
            lambda_body = rewrite_submit_array_parameter_reads(lambda_body, parameter.name, environment_name)
        if (packed_environment):
            int environment_offset = 0
            if (lambda_node.kind == 'Lambda'):
                BindingIR parameter = ir_parse_binding_decl(lambda_node.value)
                if (!array_task_parameter):
                    Node parameter_value = Node('Index', '', [Node('Identifier', environment_name, []), Node('Int', '0', [])])
                    if (parameter.type_name == 'bool'):
                        parameter_value = Node('Binary', '!=', [parameter_value, Node('Int', '0', [])])
                    function_children.push(Node('VarDecl', parameter.type_name + ' ' + parameter.name, [parameter_value]))
                    environment_offset = 1
            for (int capture_index = 0; capture_index < captured.length(); capture_index += 1):
                BindingIR binding = captured[capture_index]
                string capture_type = binding.type_name
                if (capture_type.starts_with('const ')):
                    capture_type = capture_type.substring(6)
                Node captured_value = Node('Index', '', [Node('Identifier', environment_name, []), Node('Int', (capture_index + environment_offset).to_string(), [])])
                if (array_task_parameter):
                    captured_value = Node('Index', '', [Node('Index', '', [Node('Identifier', environment_name, []), Node('Int', '1', [])]), Node('Int', capture_index.to_string(), [])])
                if (capture_type == 'bool'):
                    captured_value = Node('Binary', '!=', [captured_value, Node('Int', '0', [])])
                function_children.push(Node('VarDecl', 'const ' + capture_type + ' ' + binding.name, [captured_value]))
            wrapper_name = submit_capture_name(current_names, '__tb_submit_wrapper_', current_index)
            current_names = add_unique_name(current_names, wrapper_name)
            current_index += 1
            wrapper_pool_name = submit_capture_name(current_names, '__tb_submit_pool_', current_index)
            current_names = add_unique_name(current_names, wrapper_pool_name)
            current_index += 1
        if (lambda_body.kind == 'Block'):
            SubmitRangeListRewrite normalized = rewrite_submit_range_foreach_list(lambda_body.children, current_names, current_index)
            function_children = append_nodes(function_children, normalized.nodes)
            current_names = normalized.used_names
            current_index = normalized.next_index
        else:
            function_children.push(Node('Return', '', [lambda_body]))
        generated.push(Node('Function', worker_return_type + ' ' + worker_name, function_children))
        if (packed_environment):
            Node[] wrapper_children = [Node('Param', 'thread_pool ' + wrapper_pool_name, [])]
            Node[] capture_values = []
            Node[] packed_values = []
            if (lambda_node.kind == 'Lambda'):
                BindingIR parameter = ir_parse_binding_decl(lambda_node.value)
                wrapper_task_name = submit_capture_name(current_names, '__tb_submit_task_', current_index)
                current_names = add_unique_name(current_names, wrapper_task_name)
                current_index += 1
                wrapper_children.push(Node('Param', parameter.type_name + ' ' + wrapper_task_name, []))
                if (parameter.type_name == 'bool'):
                    packed_values.push(Node('Ternary', '', [Node('Identifier', wrapper_task_name, []), Node('Int', '1', []), Node('Int', '0', [])]))
                else:
                    packed_values.push(Node('Identifier', wrapper_task_name, []))
            for (int capture_index = 0; capture_index < captured.length(); capture_index += 1):
                BindingIR binding = captured[capture_index]
                string capture_type = binding.type_name
                if (capture_type.starts_with('const ')):
                    capture_type = capture_type.substring(6)
                wrapper_children.push(Node('Param', capture_type + ' ' + binding.name, []))
                capture_values.push(Node('Identifier', binding.name, []))
                if (capture_type == 'bool'):
                    packed_values.push(Node('Ternary', '', [Node('Identifier', binding.name, []), Node('Int', '1', []), Node('Int', '0', [])]))
                else:
                    packed_values.push(Node('Identifier', binding.name, []))
            string wrapper_environment_name = submit_capture_name(current_names, '__tb_submit_environment_', current_index)
            current_names = add_unique_name(current_names, wrapper_environment_name)
            current_index += 1
            if (array_task_parameter):
                string wrapper_capture_row_name = submit_capture_name(current_names, '__tb_submit_captures_', current_index)
                current_names = add_unique_name(current_names, wrapper_capture_row_name)
                current_index += 1
                wrapper_children.push(Node('VarDecl', 'int[] ' + wrapper_capture_row_name, [Node('Array', '', tail_nodes(packed_values, 1))]))
                Node task_row = Node('Identifier', wrapper_task_name, [])
                Node capture_row = Node('Identifier', wrapper_capture_row_name, [])
                wrapper_children.push(Node('VarDecl', 'int[][] ' + wrapper_environment_name, [Node('Array', '', [task_row, capture_row])]))
            else:
                wrapper_children.push(Node('VarDecl', 'int[] ' + wrapper_environment_name, [Node('Array', '', packed_values)]))
            Node submit_call = Node('MethodCall', 'submit', [Node('Identifier', wrapper_pool_name, []), Node('Identifier', worker_name, []), Node('Identifier', wrapper_environment_name, [])])
            wrapper_children.push(Node('Return', '', [submit_call]))
            generated.push(Node('Function', 'future<' + worker_return_type + '> ' + wrapper_name, wrapper_children))
            Node[] call_arguments = [rewritten_children[0]]
            if (lambda_node.kind == 'Lambda'):
                call_arguments.push(rewritten_children[2])
            call_arguments = append_nodes(call_arguments, capture_values)
            rewritten = Node('Call', wrapper_name, call_arguments)
        else:
            rewritten_children[1] = Node('Identifier', worker_name, [])
            rewritten = Node(node.kind, node.value, rewritten_children)
    return SubmitScopedRewrite(rewritten, generated, current_names, current_index, bindings)

SubmitScopedListRewrite rewrite_submit_statement_list(Node[] statements, string[] used_names, int next_index, Node[] functions, BindingIR[] bindings, string[] declaration_names):
    Node[] rewritten_nodes = []
    Node[] generated = []
    string[] current_names = used_names
    int current_index = next_index
    BindingIR[] current_bindings = bindings
    for (Node statement : statements):
        SubmitScopedRewrite rewritten = rewrite_submit_statement(statement, current_names, current_index, functions, current_bindings, declaration_names)
        rewritten_nodes.push(rewritten.node)
        generated = append_nodes(generated, rewritten.generated)
        current_names = rewritten.used_names
        current_index = rewritten.next_index
        current_bindings = rewritten.bindings
    return SubmitScopedListRewrite(rewritten_nodes, generated, current_names, current_index, current_bindings)

SubmitScopedRewrite rewrite_submit_statement(Node node, string[] used_names, int next_index, Node[] functions, BindingIR[] bindings, string[] declaration_names):
    if (node.kind == 'If' && node.children.length() > 0):
        SubmitScopedRewrite condition = rewrite_submit_expression(node.children[0], used_names, next_index, functions, bindings, declaration_names)
        SubmitScopedListRewrite then_part = rewrite_submit_statement_list(if_then_nodes(node), condition.used_names, condition.next_index, functions, const_copy_bindings(bindings), declaration_names)
        Node[] children = [condition.node]
        children = append_nodes(children, then_part.nodes)
        Node[] generated = append_nodes(condition.generated, then_part.generated)
        string[] current_names = then_part.used_names
        int current_index = then_part.next_index
        if (!if_else_nodes(node).is_empty()):
            Node[] else_source = if_else_nodes(node)
            SubmitScopedListRewrite else_part = rewrite_submit_statement_list(else_source, current_names, current_index, functions, const_copy_bindings(bindings), declaration_names)
            children.push(Node('Else', '', else_part.nodes))
            generated = append_nodes(generated, else_part.generated)
            current_names = else_part.used_names
            current_index = else_part.next_index
        return SubmitScopedRewrite(Node(node.kind, node.value, children), generated, current_names, current_index, bindings)
    if (node.kind == 'While' && node.children.length() > 0):
        SubmitScopedRewrite condition = rewrite_submit_expression(node.children[0], used_names, next_index, functions, bindings, declaration_names)
        SubmitScopedListRewrite body = rewrite_submit_statement_list(tail_nodes(node.children, 1), condition.used_names, condition.next_index, functions, const_copy_bindings(bindings), declaration_names)
        Node[] children = [condition.node]
        children = append_nodes(children, body.nodes)
        return SubmitScopedRewrite(Node(node.kind, node.value, children), append_nodes(condition.generated, body.generated), body.used_names, body.next_index, bindings)
    if (node.kind == 'For' && node.children.length() >= 3):
        SubmitScopedRewrite init = rewrite_submit_statement(node.children[0], used_names, next_index, functions, const_copy_bindings(bindings), declaration_names)
        BindingIR[] loop_bindings = init.bindings
        SubmitScopedRewrite condition = rewrite_submit_expression(node.children[1], init.used_names, init.next_index, functions, loop_bindings, declaration_names)
        SubmitScopedRewrite update = rewrite_submit_statement(node.children[2], condition.used_names, condition.next_index, functions, loop_bindings, declaration_names)
        SubmitScopedListRewrite body = rewrite_submit_statement_list(lowerer_for_body_nodes(node), update.used_names, update.next_index, functions, const_copy_bindings(loop_bindings), declaration_names)
        Node[] children = [init.node, condition.node, update.node]
        children = append_nodes(children, body.nodes)
        Node[] generated = append_nodes(append_nodes(init.generated, condition.generated), append_nodes(update.generated, body.generated))
        return SubmitScopedRewrite(Node(node.kind, node.value, children), generated, body.used_names, body.next_index, bindings)
    if (node.kind == 'ForEach' && node.children.length() > 0):
        SubmitScopedRewrite iterable = rewrite_submit_expression(node.children[0], used_names, next_index, functions, bindings, declaration_names)
        BindingIR[] body_bindings = const_copy_bindings(bindings)
        body_bindings.push(ir_parse_binding_decl(node.value))
        SubmitScopedListRewrite body = rewrite_submit_statement_list(tail_nodes(node.children, 1), iterable.used_names, iterable.next_index, functions, body_bindings, declaration_names)
        Node[] children = [iterable.node]
        children = append_nodes(children, body.nodes)
        return SubmitScopedRewrite(Node(node.kind, node.value, children), append_nodes(iterable.generated, body.generated), body.used_names, body.next_index, bindings)
    if (node.kind == 'Switch' && node.children.length() > 0):
        SubmitScopedRewrite subject = rewrite_submit_expression(node.children[0], used_names, next_index, functions, bindings, declaration_names)
        Node[] children = [subject.node]
        Node[] generated = subject.generated
        string[] current_names = subject.used_names
        int current_index = subject.next_index
        for (Node branch : tail_nodes(node.children, 1)):
            Node[] branch_children = []
            int body_start = 0
            if (branch.kind == 'Case' && branch.children.length() > 0):
                SubmitScopedRewrite case_value = rewrite_submit_expression(branch.children[0], current_names, current_index, functions, bindings, declaration_names)
                branch_children.push(case_value.node)
                generated = append_nodes(generated, case_value.generated)
                current_names = case_value.used_names
                current_index = case_value.next_index
                body_start = 1
            SubmitScopedListRewrite body = rewrite_submit_statement_list(tail_nodes(branch.children, body_start), current_names, current_index, functions, const_copy_bindings(bindings), declaration_names)
            branch_children = append_nodes(branch_children, body.nodes)
            children.push(Node(branch.kind, branch.value, branch_children))
            generated = append_nodes(generated, body.generated)
            current_names = body.used_names
            current_index = body.next_index
        return SubmitScopedRewrite(Node(node.kind, node.value, children), generated, current_names, current_index, bindings)
    if (node.kind == 'Try'):
        Node[] try_source = try_body_nodes(node)
        SubmitScopedListRewrite try_part = rewrite_submit_statement_list(try_source, used_names, next_index, functions, const_copy_bindings(bindings), declaration_names)
        Node catch_part = catch_node(node)
        BindingIR[] catch_bindings = const_copy_bindings(bindings)
        catch_bindings.push(ir_parse_binding_decl(catch_part.value))
        SubmitScopedListRewrite catch_rewrite = rewrite_submit_statement_list(catch_part.children, try_part.used_names, try_part.next_index, functions, catch_bindings, declaration_names)
        Node[] children = append_nodes(try_part.nodes, [Node('Catch', catch_part.value, catch_rewrite.nodes)])
        return SubmitScopedRewrite(Node(node.kind, node.value, children), append_nodes(try_part.generated, catch_rewrite.generated), catch_rewrite.used_names, catch_rewrite.next_index, bindings)
    if (node.kind == 'VarDecl'):
        Node[] children = []
        Node[] generated = []
        string[] current_names = used_names
        int current_index = next_index
        for (Node child : node.children):
            SubmitScopedRewrite rewritten = rewrite_submit_expression(child, current_names, current_index, functions, bindings, declaration_names)
            children.push(rewritten.node)
            generated = append_nodes(generated, rewritten.generated)
            current_names = rewritten.used_names
            current_index = rewritten.next_index
        BindingIR[] next_bindings = const_copy_bindings(bindings)
        next_bindings.push(ir_parse_binding_decl(node.value))
        return SubmitScopedRewrite(Node(node.kind, node.value, children), generated, current_names, current_index, next_bindings)
    SubmitScopedRewrite rewritten = rewrite_submit_expression(node, used_names, next_index, functions, bindings, declaration_names)
    return SubmitScopedRewrite(rewritten.node, rewritten.generated, rewritten.used_names, rewritten.next_index, bindings)

SubmitLambdaRewrite rewrite_submit_lambdas_in_program(Node program):
    string[] unavailable_names = collect_submit_unavailable_names(program, [])
    BindingIR[] global_bindings = submit_unique_global_bindings(program.children)
    Node[] functions = []
    for (Node child : program.children):
        if (child.kind == 'Function' || child.kind == 'CachedFunction'):
            functions.push(child)

    Node[] rewritten_children = []
    Node[] generated = []
    string[] used_names = unavailable_names
    int next_index = 0
    for (Node child : program.children):
        if (child.kind == 'Function' || child.kind == 'CachedFunction'):
            BindingIR[] bindings = []
            for (Node fn_child : child.children):
                if (fn_child.kind == 'Param'):
                    bindings.push(ir_parse_binding_decl(fn_child.value))
            string[] declaration_names = submit_function_declaration_names(child, [])
            for (BindingIR global_binding : global_bindings):
                if (submit_name_occurrence_count(declaration_names, global_binding.name) == 0):
                    bindings.push(global_binding)
                    declaration_names.push(global_binding.name)
            Node[] body_nodes = []
            for (Node fn_child : child.children):
                if (fn_child.kind != 'Param'):
                    body_nodes.push(fn_child)
            SubmitScopedListRewrite rewritten_body = rewrite_submit_statement_list(body_nodes, used_names, next_index, functions, bindings, declaration_names)
            Node[] function_children = []
            for (Node fn_child : child.children):
                if (fn_child.kind == 'Param'):
                    function_children.push(fn_child)
            function_children = append_nodes(function_children, rewritten_body.nodes)
            rewritten_children.push(Node(child.kind, child.value, function_children))
            generated = append_nodes(generated, rewritten_body.generated)
            used_names = rewritten_body.used_names
            next_index = rewritten_body.next_index
        else:
            BindingIR[] no_bindings = []
            string[] no_declarations = []
            SubmitScopedRewrite rewritten = rewrite_submit_expression(child, used_names, next_index, functions, no_bindings, no_declarations)
            rewritten_children.push(rewritten.node)
            generated = append_nodes(generated, rewritten.generated)
            used_names = rewritten.used_names
            next_index = rewritten.next_index
    for (Node generated_node : generated):
        rewritten_children.push(generated_node)
    return SubmitLambdaRewrite(Node('Program', program.value, rewritten_children), generated, used_names, next_index)

bool int_node_is(Node node, string value):
    return node.kind == 'Int' && node.value == value

bool identifier_node_is(Node node, string value):
    return node.kind == 'Identifier' && node.value == value

bool is_local_self_add_assignment(Node target, Node value):
    if (target.kind != 'Identifier'):
        return false
    if (value.kind != 'Binary' || value.value != '+'):
        return false
    if (value.children.length() != 2):
        return false
    return identifier_node_is(value.children[0], target.value)

bool binding_index_node_is(Node node, string binding_name, string index_value):
    if (node.kind != 'Index'):
        return false
    if (!identifier_node_is(node.children[0], binding_name)):
        return false
    return int_node_is(node.children[1], index_value)

bool add_capture_and_binding_index(Node node, string capture_name, string binding_name, string index_value):
    if (node.kind != 'Binary' || node.value != '+'):
        return false
    if (!identifier_node_is(node.children[0], capture_name)):
        return false
    return binding_index_node_is(node.children[1], binding_name, index_value)

Node[] flatten_logical_and_nodes(Node node):
    if (node.kind == 'Binary' && (node.value == '&&' || node.value == 'and')):
        Node[] parts = []
        for (Node child in flatten_logical_and_nodes(node.children[0])):
            parts.push(child)
        for (Node child in flatten_logical_and_nodes(node.children[1])):
            parts.push(child)
        return parts
    return [node]

bool is_filter_bounds_lambda(Node lambda_node):
    BindingIR binding = ir_parse_binding_decl(lambda_node.value)
    Node[] parts = flatten_logical_and_nodes(lambda_node.children[0])
    if (parts.length() != 4):
        return false
    if (!(parts[0].kind == 'Binary' && parts[0].value == '>=')):
        return false
    if (!(parts[1].kind == 'Binary' && parts[1].value == '<')):
        return false
    if (!(parts[2].kind == 'Binary' && parts[2].value == '>=')):
        return false
    if (!(parts[3].kind == 'Binary' && parts[3].value == '<')):
        return false
    if (!add_capture_and_binding_index(parts[0].children[0], 'r', binding.name, '0') || !int_node_is(parts[0].children[1], '0')):
        return false
    if (!add_capture_and_binding_index(parts[1].children[0], 'r', binding.name, '0') || !identifier_node_is(parts[1].children[1], 'WIDTH')):
        return false
    if (!add_capture_and_binding_index(parts[2].children[0], 'c', binding.name, '1') || !int_node_is(parts[2].children[1], '0')):
        return false
    if (!add_capture_and_binding_index(parts[3].children[0], 'c', binding.name, '1') || !identifier_node_is(parts[3].children[1], 'HEIGHT')):
        return false
    return true

bool is_grid_eq_lambda(Node lambda_node):
    BindingIR binding = ir_parse_binding_decl(lambda_node.value)
    Node body = lambda_node.children[0]
    if (!(body.kind == 'Binary' && body.value == '==')):
        return false
    if (body.children[1].kind != 'String'):
        return false
    Node outer_index = body.children[0]
    if (outer_index.kind != 'Index'):
        return false
    Node row_index = outer_index.children[0]
    if (row_index.kind != 'Index'):
        return false
    if (!identifier_node_is(row_index.children[0], 'GRID')):
        return false
    if (!add_capture_and_binding_index(row_index.children[1], 'r', binding.name, '0')):
        return false
    if (!add_capture_and_binding_index(outer_index.children[1], 'c', binding.name, '1')):
        return false
    return true

string lambda2_left_binding(string value):
    int split = value.index_of(' | ')
    if (split < 0):
        return value
    return value.substring(0, split)

string lambda2_right_binding(string value):
    int split = value.index_of(' | ')
    if (split < 0):
        return ''
    return value.substring(split + 3)

bool is_identifier_subtraction_lambda(Node lambda_node):
    if (lambda_node.kind != 'Lambda2'):
        return false
    Node body = lambda_node.children[0]
    if (!(body.kind == 'Binary' && body.value == '-')):
        return false
    BindingIR left_binding = ir_parse_binding_decl(lambda2_left_binding(lambda_node.value))
    BindingIR right_binding = ir_parse_binding_decl(lambda2_right_binding(lambda_node.value))
    return identifier_node_is(body.children[0], right_binding.name) && identifier_node_is(body.children[1], left_binding.name)

bool is_identifier_subtraction_lambda_asc(Node lambda_node):
    if (lambda_node.kind != 'Lambda2'):
        return false
    Node body = lambda_node.children[0]
    if (!(body.kind == 'Binary' && body.value == '-')):
        return false
    BindingIR left_binding = ir_parse_binding_decl(lambda2_left_binding(lambda_node.value))
    BindingIR right_binding = ir_parse_binding_decl(lambda2_right_binding(lambda_node.value))
    return identifier_node_is(body.children[0], left_binding.name) && identifier_node_is(body.children[1], right_binding.name)

bool is_record_field_subtraction_lambda(Node lambda_node):
    if (lambda_node.kind != 'Lambda2'):
        return false
    Node body = lambda_node.children[0]
    if (!(body.kind == 'Binary' && body.value == '-')):
        return false
    if (!(body.children[0].kind == 'Field' && body.children[1].kind == 'Field')):
        return false
    BindingIR left_binding = ir_parse_binding_decl(lambda2_left_binding(lambda_node.value))
    BindingIR right_binding = ir_parse_binding_decl(lambda2_right_binding(lambda_node.value))
    if (body.children[0].value != body.children[1].value):
        return false
    return identifier_node_is(body.children[0].children[0], left_binding.name) && identifier_node_is(body.children[1].children[0], right_binding.name)

bool is_record_field_desc_subtraction_lambda(Node lambda_node):
    if (lambda_node.kind != 'Lambda2'):
        return false
    Node body = lambda_node.children[0]
    if (!(body.kind == 'Binary' && body.value == '-')):
        return false
    if (!(body.children[0].kind == 'Field' && body.children[1].kind == 'Field')):
        return false
    BindingIR left_binding = ir_parse_binding_decl(lambda2_left_binding(lambda_node.value))
    BindingIR right_binding = ir_parse_binding_decl(lambda2_right_binding(lambda_node.value))
    if (body.children[0].value != body.children[1].value):
        return false
    return identifier_node_is(body.children[0].children[0], right_binding.name) && identifier_node_is(body.children[1].children[0], left_binding.name)

bool is_parse_binding_call_lambda(Node lambda_node):
    if (lambda_node.kind != 'Lambda'):
        return false
    BindingIR binding = ir_parse_binding_decl(lambda_node.value)
    Node body = lambda_node.children[0]
    if (body.kind != 'Call' || body.value != 'parse_point' || body.children.length() != 1):
        return false
    return identifier_node_is(body.children[0], binding.name)

bool is_string_length_map_lambda(Node lambda_node):
    if (lambda_node.kind != 'Lambda'):
        return false
    BindingIR binding = ir_parse_binding_decl(lambda_node.value)
    Node body = lambda_node.children[0]
    if (body.kind != 'Call' || body.value != 'length' || body.children.length() != 1):
        return false
    return identifier_node_is(body.children[0], binding.name)

bool is_edge_distance_map_lambda(Node lambda_node):
    if (lambda_node.kind != 'Lambda'):
        return false
    BindingIR binding = ir_parse_binding_decl(lambda_node.value)
    Node body = lambda_node.children[0]
    if (body.kind != 'Call' || body.value != 'Edge' || body.children.length() != 3):
        return false
    if (!identifier_node_is(body.children[1], binding.name)):
        return false
    Node distance_call = body.children[2]
    if (distance_call.kind != 'Call' || distance_call.value != 'point_distance' || distance_call.children.length() != 2):
        return false
    Node point_index = distance_call.children[1]
    if (point_index.kind != 'Index'):
        return false
    return identifier_node_is(point_index.children[1], binding.name)

bool is_edges_for_point_flat_map_lambda(Node lambda_node):
    if (lambda_node.kind != 'Lambda'):
        return false
    BindingIR binding = ir_parse_binding_decl(lambda_node.value)
    Node body = lambda_node.children[0]
    if (body.kind != 'Call' || body.value != 'edges_for_point' || body.children.length() != 2):
        return false
    return identifier_node_is(body.children[1], binding.name)

TempListResult lower_linear_values(Node[] nodes, int next_temp):
    string[] names = []
    string[] lines = []
    int current_temp = next_temp
    for (Node child in nodes):
        TempResult lowered = lower_linear_value(child, current_temp)
        names.push(lowered.name)
        lines = append_lines(lines, lowered.lines)
        current_temp = lowered.next_temp
    return TempListResult(names, lines, current_temp)

TempIRListResult lower_linear_values_ir(Node[] nodes, int next_temp):
    string[] names = []
    LinearInstruction[] instructions = []
    int current_temp = next_temp
    for (Node child : nodes):
        TempIRResult lowered = lower_linear_value_ir(child, current_temp)
        names.push(lowered.name)
        instructions = append_instructions(instructions, lowered.instructions)
        current_temp = lowered.next_temp
    return TempIRListResult(names, instructions, current_temp)

TempResult lower_linear_value(Node node, int next_temp):
    if (node.kind == 'Int'):
        string name = temp_name(next_temp)
        return TempResult(name, [name + ' = int ' + node.value], next_temp + 1)
    if (node.kind == 'Num'):
        string name = temp_name(next_temp)
        return TempResult(name, [name + ' = num ' + node.value], next_temp + 1)
    if (node.kind == 'String'):
        string name = temp_name(next_temp)
        return TempResult(name, [name + ' = string ' + quote_string(node.value)], next_temp + 1)
    if (node.kind == 'Bool'):
        string name = temp_name(next_temp)
        return TempResult(name, [name + ' = bool ' + node.value], next_temp + 1)
    if (node.kind == 'Identifier'):
        string name = temp_name(next_temp)
        return TempResult(name, [name + ' = identifier ' + node.value], next_temp + 1)
    if (node.kind == 'Array'):
        TempListResult items = lower_linear_values(node.children, next_temp)
        string name = temp_name(items.next_temp)
        string line = name + ' = array'
        if (!items.names.is_empty()):
            line += ' ' + join_strings(items.names, ' ')
        string[] lines = append_lines(items.lines, [line])
        return TempResult(name, lines, items.next_temp + 1)
    if (node.kind == 'Set'):
        TempListResult items = lower_linear_values(node.children, next_temp)
        string name = temp_name(items.next_temp)
        string line = name + ' = set'
        if (!items.names.is_empty()):
            line += ' ' + join_strings(items.names, ' ')
        string[] lines = append_lines(items.lines, [line])
        return TempResult(name, lines, items.next_temp + 1)
    if (node.kind == 'Map'):
        string[] names = []
        string[] lines = []
        int current_temp = next_temp
        for (Node map_item : node.children):
            TempResult key = lower_linear_value(map_item.children[0], current_temp)
            TempResult value = lower_linear_value(map_item.children[1], key.next_temp)
            lines = append_lines(lines, key.lines)
            lines = append_lines(lines, value.lines)
            names.push(key.name)
            names.push(value.name)
            current_temp = value.next_temp
        string name = temp_name(current_temp)
        string line = name + ' = map'
        if (!names.is_empty()):
            line += ' ' + join_strings(names, ' ')
        lines.push(line)
        return TempResult(name, lines, current_temp + 1)
    if (node.kind == 'Binary'):
        TempResult left = lower_linear_value(node.children[0], next_temp)
        TempResult right = lower_linear_value(node.children[1], left.next_temp)
        string name = temp_name(right.next_temp)
        string[] lines = append_lines(left.lines, right.lines)
        lines.push(name + ' = binary ' + node.value + ' ' + left.name + ' ' + right.name)
        return TempResult(name, lines, right.next_temp + 1)
    if (node.kind == 'Ternary'):
        TempResult condition = lower_linear_value(node.children[0], next_temp)
        TempResult when_true = lower_linear_value(node.children[1], condition.next_temp)
        TempResult when_false = lower_linear_value(node.children[2], when_true.next_temp)
        string name = temp_name(when_false.next_temp)
        string[] lines = append_lines(condition.lines, when_true.lines)
        lines = append_lines(lines, when_false.lines)
        lines.push(name + ' = ternary ' + condition.name + ' ' + when_true.name + ' ' + when_false.name)
        return TempResult(name, lines, when_false.next_temp + 1)
    if (node.kind == 'Unary'):
        TempResult operand = lower_linear_value(node.children[0], next_temp)
        string name = temp_name(operand.next_temp)
        string[] lines = append_lines(operand.lines, [name + ' = unary ' + node.value + ' ' + operand.name])
        return TempResult(name, lines, operand.next_temp + 1)
    if (node.kind == 'Call'):
        TempListResult args = lower_linear_values(node.children, next_temp)
        string name = temp_name(args.next_temp)
        string line = name + ' = call ' + node.value
        if (!args.names.is_empty()):
            line += ' ' + join_strings(args.names, ' ')
        string[] lines = append_lines(args.lines, [line])
        return TempResult(name, lines, args.next_temp + 1)
    if (node.kind == 'CallExpr'):
        TempListResult args = lower_linear_values(node.children, next_temp)
        string name = temp_name(args.next_temp)
        string line = name + ' = call-expr'
        if (!args.names.is_empty()):
            line += ' ' + join_strings(args.names, ' ')
        string[] lines = append_lines(args.lines, [line])
        return TempResult(name, lines, args.next_temp + 1)
    if (node.kind == 'Field'):
        TempResult base = lower_linear_value(node.children[0], next_temp)
        string name = temp_name(base.next_temp)
        string[] lines = append_lines(base.lines, [name + ' = field ' + node.value + ' ' + base.name])
        return TempResult(name, lines, base.next_temp + 1)
    if (node.kind == 'Slice'):
        TempResult base = lower_linear_value(node.children[0], next_temp)
        TempResult start = lower_linear_value(node.children[1], base.next_temp)
        string[] lines = append_lines(base.lines, start.lines)
        if (node.children.length() == 2):
            string name = temp_name(start.next_temp)
            lines.push(name + ' = slice ' + base.name + ' ' + start.name)
            return TempResult(name, lines, start.next_temp + 1)
        TempResult stop = lower_linear_value(node.children[2], start.next_temp)
        string name = temp_name(stop.next_temp)
        lines = append_lines(lines, stop.lines)
        lines.push(name + ' = slice ' + base.name + ' ' + start.name + ' ' + stop.name)
        return TempResult(name, lines, stop.next_temp + 1)
    if (node.kind == 'MethodCall'):
        if (node.value == 'sum'):
            if (node.children.length() == 1):
                if (node.children[0].kind == 'MethodCall'):
                    Node mapped = node.children[0]
                    if (mapped.value == 'map_to'):
                        if (mapped.children.length() == 2):
                            if (mapped.children[1].kind == 'Lambda'):
                                if (is_grid_eq_lambda(mapped.children[1])):
                                    Node body = mapped.children[1].children[0]
                                    Node outer_index = body.children[0]
                                    Node row_index = outer_index.children[0]
                                    TempResult base = lower_linear_value(mapped.children[0], next_temp)
                                    TempResult grid = lower_linear_value(row_index.children[0], base.next_temp)
                                    TempResult row = lower_linear_value(row_index.children[1].children[0], grid.next_temp)
                                    TempResult col = lower_linear_value(outer_index.children[1].children[0], row.next_temp)
                                    TempResult needle = lower_linear_value(body.children[1], col.next_temp)
                                    string name = temp_name(needle.next_temp)
                                    string[] lines = append_lines(base.lines, grid.lines)
                                    lines = append_lines(lines, row.lines)
                                    lines = append_lines(lines, col.lines)
                                    lines = append_lines(lines, needle.lines)
                                    lines.push(name + ' = method-call-lambda sum_grid_eq ' + base.name + ' ' + mapped.children[1].value + ' ' + grid.name + ' ' + row.name + ' ' + col.name + ' ' + needle.name)
                                    return TempResult(name, lines, needle.next_temp + 1)
        TempResult base = lower_linear_value(node.children[0], next_temp)
        if (node.value == 'create_prio_q'):
            if (node.children.length() == 2):
                if (node.children[1].kind == 'Lambda2'):
                    if (is_identifier_subtraction_lambda(node.children[1])):
                        string name = temp_name(base.next_temp)
                        string[] lines = base.lines
                        lines.push(name + ' = method-call-lambda create_prio_q_int_desc ' + base.name + ' ' + lambda2_left_binding(node.children[1].value) + ' ' + lambda2_right_binding(node.children[1].value))
                        return TempResult(name, lines, base.next_temp + 1)
                    if (is_record_field_desc_subtraction_lambda(node.children[1])):
                        string name = temp_name(base.next_temp)
                        string field_name = node.children[1].children[0].children[0].value
                        string[] lines = base.lines
                        lines.push(name + ' = method-call-lambda create_prio_q_record_field_desc ' + base.name + ' ' + lambda2_left_binding(node.children[1].value) + ' ' + lambda2_right_binding(node.children[1].value) + ' ' + field_name)
                        return TempResult(name, lines, base.next_temp + 1)
        if (node.value == 'filter'):
            if (node.children.length() == 2):
                if (node.children[1].kind == 'Lambda' && is_filter_bounds_lambda(node.children[1])):
                    Node[] parts = flatten_logical_and_nodes(node.children[1].children[0])
                    TempResult row = lower_linear_value(parts[0].children[0].children[0], base.next_temp)
                    TempResult col = lower_linear_value(parts[2].children[0].children[0], row.next_temp)
                    TempResult width = lower_linear_value(parts[1].children[1], col.next_temp)
                    TempResult height = lower_linear_value(parts[3].children[1], width.next_temp)
                    string name = temp_name(height.next_temp)
                    string[] lines = append_lines(base.lines, row.lines)
                    lines = append_lines(lines, col.lines)
                    lines = append_lines(lines, width.lines)
                    lines = append_lines(lines, height.lines)
                    lines.push(name + ' = method-call-lambda filter_bounds ' + base.name + ' ' + node.children[1].value + ' ' + row.name + ' ' + col.name + ' ' + width.name + ' ' + height.name)
                    return TempResult(name, lines, height.next_temp + 1)
        if (node.value == 'map_to'):
            if (node.children.length() == 2):
                if (node.children[1].kind == 'Lambda'):
                    if (is_parse_binding_call_lambda(node.children[1])):
                        string name = temp_name(base.next_temp)
                        string[] lines = base.lines
                        lines.push(name + ' = method-call-lambda map_to_parse_point ' + base.name + ' ' + node.children[1].value)
                        return TempResult(name, lines, base.next_temp + 1)
                    if (is_string_length_map_lambda(node.children[1])):
                        string name = temp_name(base.next_temp)
                        string[] lines = base.lines
                        lines.push(name + ' = method-call-lambda map_to_string_length ' + base.name + ' ' + node.children[1].value)
                        return TempResult(name, lines, base.next_temp + 1)
                    if (is_edge_distance_map_lambda(node.children[1])):
                        Node body = node.children[1].children[0]
                        Node distance_call = body.children[2]
                        Node point_index = distance_call.children[1]
                        TempResult capture_i = lower_linear_value(body.children[0], base.next_temp)
                        TempResult capture_left = lower_linear_value(distance_call.children[0], capture_i.next_temp)
                        TempResult capture_points = lower_linear_value(point_index.children[0], capture_left.next_temp)
                        string name = temp_name(capture_points.next_temp)
                        string[] lines = append_lines(base.lines, capture_i.lines)
                        lines = append_lines(lines, capture_left.lines)
                        lines = append_lines(lines, capture_points.lines)
                        lines.push(name + ' = method-call-lambda map_to_edge_distance ' + base.name + ' ' + node.children[1].value + ' ' + capture_i.name + ' ' + capture_left.name + ' ' + capture_points.name)
                        return TempResult(name, lines, capture_points.next_temp + 1)
                    Node lambda_body = node.children[1].children[0]
                    BindingIR binding = ir_parse_binding_decl(node.children[1].value)
                    if (lambda_body.kind == 'Binary'):
                        if (lambda_body.children.length() == 2):
                            if (lambda_body.children[0].kind == 'Identifier' && lambda_body.children[0].value == binding.name):
                                TempResult right = lower_linear_value(lambda_body.children[1], base.next_temp)
                                string name = temp_name(right.next_temp)
                                string[] lines = append_lines(base.lines, right.lines)
                                lines.push(name + ' = method-call-lambda ' + node.value + ' ' + base.name + ' ' + node.children[1].value + ' ' + lambda_body.value + ' ' + right.name)
                                return TempResult(name, lines, right.next_temp + 1)
        if (node.value == 'flat_map'):
            if (node.children.length() == 2):
                if (node.children[1].kind == 'Lambda' && is_edges_for_point_flat_map_lambda(node.children[1])):
                    Node body = node.children[1].children[0]
                    TempResult capture_points = lower_linear_value(body.children[0], base.next_temp)
                    string name = temp_name(capture_points.next_temp)
                    string[] lines = append_lines(base.lines, capture_points.lines)
                    lines.push(name + ' = method-call-lambda flat_map_edges_for_point ' + base.name + ' ' + node.children[1].value + ' ' + capture_points.name)
                    return TempResult(name, lines, capture_points.next_temp + 1)
        if (node.value == 'sort'):
            if (node.children.length() == 2):
                if (node.children[1].kind == 'Lambda2'):
                    BindingIR left_binding = ir_parse_binding_decl(lambda2_left_binding(node.children[1].value))
                    BindingIR right_binding = ir_parse_binding_decl(lambda2_right_binding(node.children[1].value))
                    string name = temp_name(base.next_temp)
                    string[] lines = base.lines
                    if (is_identifier_subtraction_lambda(node.children[1])):
                        lines.push(name + ' = method-call-lambda sort_int_desc ' + base.name + ' ' + lambda2_left_binding(node.children[1].value) + ' ' + lambda2_right_binding(node.children[1].value))
                        return TempResult(name, lines, base.next_temp + 1)
                    if (is_identifier_subtraction_lambda_asc(node.children[1])):
                        lines.push(name + ' = method-call-lambda sort_int_asc ' + base.name + ' ' + lambda2_left_binding(node.children[1].value) + ' ' + lambda2_right_binding(node.children[1].value))
                        return TempResult(name, lines, base.next_temp + 1)
                    if (is_record_field_subtraction_lambda(node.children[1])):
                        string field_name = node.children[1].children[0].children[0].value
                        lines.push(name + ' = method-call-lambda sort_record_field_asc ' + base.name + ' ' + lambda2_left_binding(node.children[1].value) + ' ' + lambda2_right_binding(node.children[1].value) + ' ' + field_name)
                        return TempResult(name, lines, base.next_temp + 1)
        TempListResult args = lower_linear_values(tail_nodes(node.children, 1), base.next_temp)
        string name = temp_name(args.next_temp)
        string line = name + ' = method-call ' + node.value + ' ' + base.name
        if (!args.names.is_empty()):
            line += ' ' + join_strings(args.names, ' ')
        string[] lines = append_lines(base.lines, args.lines)
        lines.push(line)
        return TempResult(name, lines, args.next_temp + 1)
    if (node.kind == 'Index'):
        TempResult base = lower_linear_value(node.children[0], next_temp)
        TempResult item = lower_linear_value(node.children[1], base.next_temp)
        string name = temp_name(item.next_temp)
        string[] lines = append_lines(base.lines, item.lines)
        lines.push(name + ' = index ' + base.name + ' ' + item.name)
        return TempResult(name, lines, item.next_temp + 1)

    string name = temp_name(next_temp)
    return TempResult(name, [name + ' = unsupported ' + node.kind], next_temp + 1)

TempIRResult lower_linear_value_ir(Node node, int next_temp):
    if (node.kind == 'Int'):
        string name = temp_name(next_temp)
        return TempIRResult(name, [LinearInstruction('value', name, 'int', 'plain', 'int', [node.value])], next_temp + 1)
    if (node.kind == 'Num'):
        string name = temp_name(next_temp)
        return TempIRResult(name, [LinearInstruction('value', name, 'num', 'plain', 'num', [node.value])], next_temp + 1)
    if (node.kind == 'String'):
        string name = temp_name(next_temp)
        return TempIRResult(name, [LinearInstruction('value', name, 'string', 'borrowed', 'string', [quote_string(node.value)])], next_temp + 1)
    if (node.kind == 'Bool'):
        string name = temp_name(next_temp)
        return TempIRResult(name, [LinearInstruction('value', name, 'bool', 'plain', 'bool', [node.value])], next_temp + 1)
    if (node.kind == 'Identifier'):
        string name = temp_name(next_temp)
        return TempIRResult(name, [LinearInstruction('value', name, 'unknown', 'borrowed', 'identifier', [node.value])], next_temp + 1)
    if (node.kind == 'Array'):
        TempIRListResult items = lower_linear_values_ir(node.children, next_temp)
        string name = temp_name(items.next_temp)
        LinearInstruction[] instructions = append_instructions(items.instructions, [LinearInstruction('value', name, 'array', 'owned', 'array', items.names)])
        return TempIRResult(name, instructions, items.next_temp + 1)
    if (node.kind == 'Set'):
        TempIRListResult items = lower_linear_values_ir(node.children, next_temp)
        string name = temp_name(items.next_temp)
        LinearInstruction[] instructions = append_instructions(items.instructions, [LinearInstruction('value', name, 'set', 'owned', 'set', items.names)])
        return TempIRResult(name, instructions, items.next_temp + 1)
    if (node.kind == 'Map'):
        string[] names = []
        LinearInstruction[] instructions = []
        int current_temp = next_temp
        for (Node map_item : node.children):
            TempIRResult key = lower_linear_value_ir(map_item.children[0], current_temp)
            TempIRResult value = lower_linear_value_ir(map_item.children[1], key.next_temp)
            instructions = append_instructions(instructions, key.instructions)
            instructions = append_instructions(instructions, value.instructions)
            names.push(key.name)
            names.push(value.name)
            current_temp = value.next_temp
        string name = temp_name(current_temp)
        instructions.push(LinearInstruction('value', name, 'map', 'owned', 'map', names))
        return TempIRResult(name, instructions, current_temp + 1)
    if (node.kind == 'Binary'):
        TempIRResult left = lower_linear_value_ir(node.children[0], next_temp)
        TempIRResult right = lower_linear_value_ir(node.children[1], left.next_temp)
        string name = temp_name(right.next_temp)
        LinearInstruction[] instructions = append_instructions(left.instructions, right.instructions)
        instructions.push(LinearInstruction('value', name, 'unknown', 'unknown', 'binary', [node.value, left.name, right.name]))
        return TempIRResult(name, instructions, right.next_temp + 1)
    if (node.kind == 'Ternary'):
        TempIRResult condition = lower_linear_value_ir(node.children[0], next_temp)
        TempIRResult when_true = lower_linear_value_ir(node.children[1], condition.next_temp)
        TempIRResult when_false = lower_linear_value_ir(node.children[2], when_true.next_temp)
        string name = temp_name(when_false.next_temp)
        LinearInstruction[] instructions = append_instructions(condition.instructions, when_true.instructions)
        instructions = append_instructions(instructions, when_false.instructions)
        instructions.push(LinearInstruction('value', name, 'unknown', 'unknown', 'ternary', [condition.name, when_true.name, when_false.name]))
        return TempIRResult(name, instructions, when_false.next_temp + 1)
    if (node.kind == 'Unary'):
        TempIRResult operand = lower_linear_value_ir(node.children[0], next_temp)
        string name = temp_name(operand.next_temp)
        LinearInstruction[] instructions = append_instructions(operand.instructions, [LinearInstruction('value', name, 'unknown', 'unknown', 'unary', [node.value, operand.name])])
        return TempIRResult(name, instructions, operand.next_temp + 1)
    if (node.kind == 'Call'):
        TempIRListResult args = lower_linear_values_ir(node.children, next_temp)
        string name = temp_name(args.next_temp)
        string[] call_args = [node.value]
        for (string arg_name : args.names):
            call_args.push(arg_name)
        LinearInstruction[] instructions = append_instructions(args.instructions, [LinearInstruction('value', name, 'unknown', 'unknown', 'call', call_args)])
        return TempIRResult(name, instructions, args.next_temp + 1)
    if (node.kind == 'CallExpr'):
        TempIRListResult args = lower_linear_values_ir(node.children, next_temp)
        string name = temp_name(args.next_temp)
        LinearInstruction[] instructions = append_instructions(args.instructions, [LinearInstruction('value', name, 'unknown', 'unknown', 'call-expr', args.names)])
        return TempIRResult(name, instructions, args.next_temp + 1)
    if (node.kind == 'Field'):
        TempIRResult base = lower_linear_value_ir(node.children[0], next_temp)
        string name = temp_name(base.next_temp)
        LinearInstruction[] instructions = append_instructions(base.instructions, [LinearInstruction('value', name, 'unknown', 'borrowed', 'field', [node.value, base.name])])
        return TempIRResult(name, instructions, base.next_temp + 1)
    if (node.kind == 'Slice'):
        TempIRResult base = lower_linear_value_ir(node.children[0], next_temp)
        TempIRResult start = lower_linear_value_ir(node.children[1], base.next_temp)
        LinearInstruction[] instructions = append_instructions(base.instructions, start.instructions)
        if (node.children.length() == 2):
            string name = temp_name(start.next_temp)
            instructions.push(LinearInstruction('value', name, 'unknown', 'unknown', 'slice', [base.name, start.name]))
            return TempIRResult(name, instructions, start.next_temp + 1)
        TempIRResult stop = lower_linear_value_ir(node.children[2], start.next_temp)
        string name = temp_name(stop.next_temp)
        instructions = append_instructions(instructions, stop.instructions)
        instructions.push(LinearInstruction('value', name, 'unknown', 'unknown', 'slice', [base.name, start.name, stop.name]))
        return TempIRResult(name, instructions, stop.next_temp + 1)
    if (node.kind == 'MethodCall'):
        if (node.value == 'sum'):
            if (node.children.length() == 1):
                if (node.children[0].kind == 'MethodCall'):
                    Node mapped = node.children[0]
                    if (mapped.value == 'map_to'):
                        if (mapped.children.length() == 2):
                            if (mapped.children[1].kind == 'Lambda'):
                                if (is_grid_eq_lambda(mapped.children[1])):
                                    Node body = mapped.children[1].children[0]
                                    Node outer_index = body.children[0]
                                    Node row_index = outer_index.children[0]
                                    TempIRResult base = lower_linear_value_ir(mapped.children[0], next_temp)
                                    TempIRResult grid = lower_linear_value_ir(row_index.children[0], base.next_temp)
                                    TempIRResult row = lower_linear_value_ir(row_index.children[1].children[0], grid.next_temp)
                                    TempIRResult col = lower_linear_value_ir(outer_index.children[1].children[0], row.next_temp)
                                    TempIRResult needle = lower_linear_value_ir(body.children[1], col.next_temp)
                                    string name = temp_name(needle.next_temp)
                                    LinearInstruction[] instructions = append_instructions(base.instructions, grid.instructions)
                                    instructions = append_instructions(instructions, row.instructions)
                                    instructions = append_instructions(instructions, col.instructions)
                                    instructions = append_instructions(instructions, needle.instructions)
                                    instructions.push(LinearInstruction('value', name, 'unknown', 'unknown', 'method-call-lambda', ['sum_grid_eq', base.name, mapped.children[1].value, grid.name, row.name, col.name, needle.name]))
                                    return TempIRResult(name, instructions, needle.next_temp + 1)
        TempIRResult base = lower_linear_value_ir(node.children[0], next_temp)
        if (node.value == 'submit'):
            if (node.children.length() != 2 && node.children.length() != 3):
                throw 'thread_pool.submit currently requires a function name with zero or one argument'
            if (node.children[1].kind != 'Identifier'):
                throw 'thread_pool.submit currently requires a top-level named function'
            if (node.children.length() == 2):
                string name = temp_name(base.next_temp)
                LinearInstruction[] instructions = append_instructions(base.instructions, [LinearInstruction('value', name, 'unknown', 'owned', 'method-call', ['submit', base.name, node.children[1].value])])
                return TempIRResult(name, instructions, base.next_temp + 1)
            TempIRResult arg = lower_linear_value_ir(node.children[2], base.next_temp)
            string name = temp_name(arg.next_temp)
            LinearInstruction[] instructions = append_instructions(base.instructions, arg.instructions)
            instructions.push(LinearInstruction('value', name, 'unknown', 'owned', 'method-call', ['submit', base.name, node.children[1].value, arg.name]))
            return TempIRResult(name, instructions, arg.next_temp + 1)
        if (node.value == 'create_prio_q'):
            if (node.children.length() == 2):
                if (node.children[1].kind == 'Lambda2'):
                    if (is_identifier_subtraction_lambda(node.children[1])):
                        string name = temp_name(base.next_temp)
                        LinearInstruction[] instructions = append_instructions(base.instructions, [LinearInstruction('value', name, 'unknown', 'owned', 'method-call-lambda', ['create_prio_q_int_desc', base.name, lambda2_left_binding(node.children[1].value), lambda2_right_binding(node.children[1].value)])])
                        return TempIRResult(name, instructions, base.next_temp + 1)
                    if (is_record_field_desc_subtraction_lambda(node.children[1])):
                        string name = temp_name(base.next_temp)
                        string field_name = node.children[1].children[0].children[0].value
                        LinearInstruction[] instructions = append_instructions(base.instructions, [LinearInstruction('value', name, 'unknown', 'owned', 'method-call-lambda', ['create_prio_q_record_field_desc', base.name, lambda2_left_binding(node.children[1].value), lambda2_right_binding(node.children[1].value), field_name])])
                        return TempIRResult(name, instructions, base.next_temp + 1)
        if (node.value == 'filter'):
            if (node.children.length() == 2):
                if (node.children[1].kind == 'Lambda' && is_filter_bounds_lambda(node.children[1])):
                    Node[] parts = flatten_logical_and_nodes(node.children[1].children[0])
                    TempIRResult row = lower_linear_value_ir(parts[0].children[0].children[0], base.next_temp)
                    TempIRResult col = lower_linear_value_ir(parts[2].children[0].children[0], row.next_temp)
                    TempIRResult width = lower_linear_value_ir(parts[1].children[1], col.next_temp)
                    TempIRResult height = lower_linear_value_ir(parts[3].children[1], width.next_temp)
                    string name = temp_name(height.next_temp)
                    LinearInstruction[] instructions = append_instructions(base.instructions, row.instructions)
                    instructions = append_instructions(instructions, col.instructions)
                    instructions = append_instructions(instructions, width.instructions)
                    instructions = append_instructions(instructions, height.instructions)
                    instructions.push(LinearInstruction('value', name, 'unknown', 'unknown', 'method-call-lambda', ['filter_bounds', base.name, node.children[1].value, row.name, col.name, width.name, height.name]))
                    return TempIRResult(name, instructions, height.next_temp + 1)
        if (node.value == 'map_to'):
            if (node.children.length() == 2):
                if (node.children[1].kind == 'Lambda'):
                    if (is_parse_binding_call_lambda(node.children[1])):
                        LinearInstruction[] instructions = append_instructions(base.instructions, [LinearInstruction('value', temp_name(base.next_temp), 'unknown', 'unknown', 'method-call-lambda', ['map_to_parse_point', base.name, node.children[1].value])])
                        return TempIRResult(temp_name(base.next_temp), instructions, base.next_temp + 1)
                    if (is_string_length_map_lambda(node.children[1])):
                        LinearInstruction[] instructions = append_instructions(base.instructions, [LinearInstruction('value', temp_name(base.next_temp), 'unknown', 'unknown', 'method-call-lambda', ['map_to_string_length', base.name, node.children[1].value])])
                        return TempIRResult(temp_name(base.next_temp), instructions, base.next_temp + 1)
                    if (is_edge_distance_map_lambda(node.children[1])):
                        Node body = node.children[1].children[0]
                        Node distance_call = body.children[2]
                        Node point_index = distance_call.children[1]
                        TempIRResult capture_i = lower_linear_value_ir(body.children[0], base.next_temp)
                        TempIRResult capture_left = lower_linear_value_ir(distance_call.children[0], capture_i.next_temp)
                        TempIRResult capture_points = lower_linear_value_ir(point_index.children[0], capture_left.next_temp)
                        string name = temp_name(capture_points.next_temp)
                        LinearInstruction[] instructions = append_instructions(base.instructions, capture_i.instructions)
                        instructions = append_instructions(instructions, capture_left.instructions)
                        instructions = append_instructions(instructions, capture_points.instructions)
                        instructions.push(LinearInstruction('value', name, 'unknown', 'unknown', 'method-call-lambda', ['map_to_edge_distance', base.name, node.children[1].value, capture_i.name, capture_left.name, capture_points.name]))
                        return TempIRResult(name, instructions, capture_points.next_temp + 1)
                    Node lambda_body = node.children[1].children[0]
                    BindingIR binding = ir_parse_binding_decl(node.children[1].value)
                    if (lambda_body.kind == 'Binary'):
                        if (lambda_body.children.length() == 2):
                            if (lambda_body.children[0].kind == 'Identifier' && lambda_body.children[0].value == binding.name):
                                TempIRResult right = lower_linear_value_ir(lambda_body.children[1], base.next_temp)
                                string name = temp_name(right.next_temp)
                                LinearInstruction[] instructions = append_instructions(base.instructions, right.instructions)
                                instructions.push(LinearInstruction('value', name, 'unknown', 'unknown', 'method-call-lambda', [node.value, base.name, node.children[1].value, lambda_body.value, right.name]))
                                return TempIRResult(name, instructions, right.next_temp + 1)
        if (node.value == 'flat_map'):
            if (node.children.length() == 2):
                if (node.children[1].kind == 'Lambda' && is_edges_for_point_flat_map_lambda(node.children[1])):
                    Node body = node.children[1].children[0]
                    TempIRResult capture_points = lower_linear_value_ir(body.children[0], base.next_temp)
                    string name = temp_name(capture_points.next_temp)
                    LinearInstruction[] instructions = append_instructions(base.instructions, capture_points.instructions)
                    instructions.push(LinearInstruction('value', name, 'unknown', 'unknown', 'method-call-lambda', ['flat_map_edges_for_point', base.name, node.children[1].value, capture_points.name]))
                    return TempIRResult(name, instructions, capture_points.next_temp + 1)
        if (node.value == 'sort'):
            if (node.children.length() == 2):
                if (node.children[1].kind == 'Lambda2'):
                    BindingIR left_binding = ir_parse_binding_decl(lambda2_left_binding(node.children[1].value))
                    BindingIR right_binding = ir_parse_binding_decl(lambda2_right_binding(node.children[1].value))
                    string name = temp_name(base.next_temp)
                    if (is_identifier_subtraction_lambda(node.children[1])):
                        LinearInstruction[] instructions = append_instructions(base.instructions, [LinearInstruction('value', name, 'unknown', 'borrowed', 'method-call-lambda', ['sort_int_desc', base.name, lambda2_left_binding(node.children[1].value), lambda2_right_binding(node.children[1].value)])])
                        return TempIRResult(name, instructions, base.next_temp + 1)
                    if (is_identifier_subtraction_lambda_asc(node.children[1])):
                        LinearInstruction[] instructions = append_instructions(base.instructions, [LinearInstruction('value', name, 'unknown', 'borrowed', 'method-call-lambda', ['sort_int_asc', base.name, lambda2_left_binding(node.children[1].value), lambda2_right_binding(node.children[1].value)])])
                        return TempIRResult(name, instructions, base.next_temp + 1)
                    if (is_record_field_subtraction_lambda(node.children[1])):
                        string field_name = node.children[1].children[0].children[0].value
                        LinearInstruction[] instructions = append_instructions(base.instructions, [LinearInstruction('value', name, 'unknown', 'borrowed', 'method-call-lambda', ['sort_record_field_asc', base.name, lambda2_left_binding(node.children[1].value), lambda2_right_binding(node.children[1].value), field_name])])
                        return TempIRResult(name, instructions, base.next_temp + 1)
        TempIRListResult args = lower_linear_values_ir(tail_nodes(node.children, 1), base.next_temp)
        string name = temp_name(args.next_temp)
        string[] call_args = [node.value, base.name]
        for (string arg_name : args.names):
            call_args.push(arg_name)
        LinearInstruction[] instructions = append_instructions(base.instructions, args.instructions)
        string result_type = 'unknown'
        if (node.value == 'length'):
            result_type = 'int'
        string ownership_mode = 'unknown'
        if (result_type == 'int' || result_type == 'bool'):
            ownership_mode = 'plain'
        instructions.push(LinearInstruction('value', name, result_type, ownership_mode, 'method-call', call_args))
        return TempIRResult(name, instructions, args.next_temp + 1)
    if (node.kind == 'Index'):
        TempIRResult base = lower_linear_value_ir(node.children[0], next_temp)
        TempIRResult item = lower_linear_value_ir(node.children[1], base.next_temp)
        string name = temp_name(item.next_temp)
        LinearInstruction[] instructions = append_instructions(base.instructions, item.instructions)
        instructions.push(LinearInstruction('value', name, 'unknown', 'borrowed', 'index', [base.name, item.name]))
        return TempIRResult(name, instructions, item.next_temp + 1)

    string name = temp_name(next_temp)
    return TempIRResult(name, [LinearInstruction('value', name, 'unknown', 'unknown', 'unsupported', [node.kind])], next_temp + 1)

bool is_straight_line_statement(Node node):
    return node.kind == 'VarDecl' || node.kind == 'Assign' || node.kind == 'ExprStmt' || node.kind == 'Return' || node.kind == 'Throw'

Node[] lowerer_for_body_nodes(Node node):
    return tail_nodes(node.children, 3)

Node[] if_then_nodes(Node node):
    Node[] then_nodes = []
    int index = 1
    while (index < node.children.length()):
        Node child = node.children[index]
        if (child.kind != 'Else'):
            then_nodes.push(child)
        index += 1
    return then_nodes

Node[] if_else_nodes(Node node):
    int index = 1
    while (index < node.children.length()):
        Node child = node.children[index]
        if (child.kind == 'Else'):
            return copy_nodes(child.children)
        index += 1
    Node[] empty = []
    return empty

Node[] switch_case_body(Node case_node):
    return tail_nodes(case_node.children, 1)

Node[] switch_default_body(Node node):
    for (Node child : tail_nodes(node.children, 1)):
        if (child.kind == 'Default'):
            return copy_nodes(child.children)
    Node[] empty = []
    return empty

bool is_linear_statement(Node node):
    if (is_straight_line_statement(node)):
        return true
    if (node.kind == 'Break' || node.kind == 'Continue'):
        return true
    if (node.kind == 'If'):
        if (!is_linear_body(if_then_nodes(node))):
            return false
        return is_linear_body(if_else_nodes(node))
    if (node.kind == 'While'):
        return is_linear_body_from(node.children, 1)
    if (node.kind == 'For'):
        if (!is_straight_line_statement(node.children[0])):
            return false
        if (!is_straight_line_statement(node.children[2])):
            return false
        return is_linear_body(lowerer_for_body_nodes(node))
    if (node.kind == 'ForEach'):
        return is_linear_body_from(node.children, 1)
    if (node.kind == 'Try'):
        if (!is_linear_body(try_body_nodes(node))):
            return false
        Node catch_body = catch_node(node)
        return is_linear_body(catch_body.children)
    if (node.kind == 'Switch'):
        int index = 1
        while (index < node.children.length()):
            Node child = node.children[index]
            if (child.kind == 'Case' && !is_linear_body(switch_case_body(child))):
                return false
            if (child.kind == 'Default' && !is_linear_body(child.children)):
                return false
            index += 1
        return true
    return false

bool is_linear_body_from(Node[] nodes, int start):
    int index = start
    while (index < nodes.length()):
        if (!is_linear_statement(nodes[index])):
            return false
        index += 1
    return true

bool is_linear_body(Node[] nodes):
    return is_linear_body_from(nodes, 0)

LinearBlockResult lower_linear_statement(Node node, int next_temp, string indent):
    if (node.kind == 'VarDecl'):
        TempResult value = lower_linear_value(node.children[0], next_temp)
        string[] lines = []
        for (string line in value.lines):
            lines.push(indent + line)
        lines.push(indent + 'set ' + node.value + ' ' + value.name)
        return LinearBlockResult(lines, value.next_temp)
    if (node.kind == 'Assign'):
        Node target_node = node.children[0]
        if (target_node.kind == 'Field' || target_node.kind == 'Index'):
            TempResult base = lower_linear_value(target_node.children[0], next_temp)
            string[] lines = base.lines
            int current_temp = base.next_temp
            string item_name = ''
            if (target_node.kind == 'Index'):
                TempResult item = lower_linear_value(target_node.children[1], current_temp)
                lines = append_lines(lines, item.lines)
                item_name = item.name
                current_temp = item.next_temp
            Node rhs = node.children[1]
            string old_name = ''
            if (node.value != ''):
                if (target_node.kind == 'Index'):
                    string selected_name = temp_name(current_temp)
                    lines.push(selected_name + ' = target-index ' + base.name + ' ' + item_name)
                    item_name = selected_name
                    current_temp += 1
                old_name = temp_name(current_temp)
                if (target_node.kind == 'Field'):
                    lines.push(old_name + ' = field ' + target_node.value + ' ' + base.name)
                else:
                    lines.push(old_name + ' = index ' + base.name + ' ' + item_name)
                current_temp += 1
                rhs = node.children[1].children[1]
            TempResult value = lower_linear_value(rhs, current_temp)
            lines = append_lines(lines, value.lines)
            string value_name = value.name
            current_temp = value.next_temp
            if (node.value != ''):
                value_name = temp_name(current_temp)
                lines.push(value_name + ' = binary ' + node.value + ' ' + old_name + ' ' + value.name)
                current_temp += 1
            if (target_node.kind == 'Field'):
                lines.push('assign_field ' + target_node.value + ' ' + base.name + ' ' + value_name)
            else:
                lines.push('assign_index ' + base.name + ' ' + item_name + ' ' + value_name)
            return LinearBlockResult(indent_lines(lines, indent), current_temp)
        if (is_local_self_add_assignment(node.children[0], node.children[1])):
            TempResult value = lower_linear_value(node.children[1].children[1], next_temp)
            string[] lines = []
            for (string line in value.lines):
                lines.push(indent + line)
            lines.push(indent + 'assign_local_add ' + node.children[0].value + ' ' + value.name)
            return LinearBlockResult(lines, value.next_temp)
        TempResult target = lower_linear_value(node.children[0], next_temp)
        TempResult value = lower_linear_value(node.children[1], target.next_temp)
        string[] lines = []
        for (string line in target.lines):
            lines.push(indent + line)
        for (string line in value.lines):
            lines.push(indent + line)
        lines.push(indent + 'assign ' + target.name + ' ' + value.name)
        return LinearBlockResult(lines, value.next_temp)
    if (node.kind == 'ExprStmt'):
        TempResult value = lower_linear_value(node.children[0], next_temp)
        string[] lines = []
        for (string line in value.lines):
            lines.push(indent + line)
        lines.push(indent + 'drop ' + value.name)
        return LinearBlockResult(lines, value.next_temp)
    if (node.kind == 'Return'):
        if (node.children.is_empty()):
            return LinearBlockResult([indent + 'return'], next_temp)
        TempResult value = lower_linear_value(node.children[0], next_temp)
        string[] lines = []
        for (string line in value.lines):
            lines.push(indent + line)
        lines.push(indent + 'return ' + value.name)
        return LinearBlockResult(lines, value.next_temp)
    if (node.kind == 'Throw'):
        TempResult value = lower_linear_value(node.children[0], next_temp)
        string[] lines = []
        for (string line in value.lines):
            lines.push(indent + line)
        lines.push(indent + 'throw ' + value.name)
        return LinearBlockResult(lines, value.next_temp)
    return LinearBlockResult([indent + 'unsupported-straight-line ' + node.kind], next_temp)

LinearIRBlockResult lower_linear_statement_ir(Node node, int next_temp):
    if (node.kind == 'VarDecl'):
        TempIRResult value = lower_linear_value_ir(node.children[0], next_temp)
        LinearInstruction[] instructions = append_instructions(value.instructions, [LinearInstruction('set', '', '', '', node.value, [value.name])])
        return LinearIRBlockResult(instructions, value.next_temp)
    if (node.kind == 'Assign'):
        Node target = node.children[0]
        if (target.kind == 'Identifier'):
            if (is_local_self_add_assignment(target, node.children[1])):
                TempIRResult value = lower_linear_value_ir(node.children[1].children[1], next_temp)
                LinearInstruction[] instructions = append_instructions(value.instructions, [LinearInstruction('assign_local_add', '', '', '', target.value, [value.name])])
                return LinearIRBlockResult(instructions, value.next_temp)
            TempIRResult value = lower_linear_value_ir(node.children[1], next_temp)
            LinearInstruction[] instructions = append_instructions(value.instructions, [LinearInstruction('assign_local', '', '', '', target.value, [value.name])])
            return LinearIRBlockResult(instructions, value.next_temp)
        if (target.kind == 'Field' || target.kind == 'Index'):
            TempIRResult base = lower_linear_value_ir(target.children[0], next_temp)
            LinearInstruction[] instructions = base.instructions
            int current_temp = base.next_temp
            string item_name = ''
            if (target.kind == 'Index'):
                TempIRResult item = lower_linear_value_ir(target.children[1], current_temp)
                instructions = append_instructions(instructions, item.instructions)
                item_name = item.name
                current_temp = item.next_temp
            Node rhs = node.children[1]
            string old_name = ''
            if (node.value != ''):
                if (target.kind == 'Index'):
                    string selected_name = temp_name(current_temp)
                    instructions.push(LinearInstruction('value', selected_name, 'unknown', 'unknown', 'target-index', [base.name, item_name]))
                    item_name = selected_name
                    current_temp += 1
                old_name = temp_name(current_temp)
                if (target.kind == 'Field'):
                    instructions.push(LinearInstruction('value', old_name, 'unknown', 'borrowed', 'field', [target.value, base.name]))
                else:
                    instructions.push(LinearInstruction('value', old_name, 'unknown', 'borrowed', 'index', [base.name, item_name]))
                current_temp += 1
                rhs = node.children[1].children[1]
            TempIRResult value = lower_linear_value_ir(rhs, current_temp)
            instructions = append_instructions(instructions, value.instructions)
            string value_name = value.name
            current_temp = value.next_temp
            if (node.value != ''):
                value_name = temp_name(current_temp)
                instructions.push(LinearInstruction('value', value_name, 'unknown', 'unknown', 'binary', [node.value, old_name, value.name]))
                current_temp += 1
            if (target.kind == 'Field'):
                instructions.push(LinearInstruction('assign_field', '', '', '', target.value, [base.name, value_name]))
            else:
                instructions.push(LinearInstruction('assign_index', '', '', '', '', [base.name, item_name, value_name]))
            return LinearIRBlockResult(instructions, current_temp)
        TempIRResult target_value = lower_linear_value_ir(target, next_temp)
        TempIRResult value = lower_linear_value_ir(node.children[1], target_value.next_temp)
        LinearInstruction[] instructions = append_instructions(target_value.instructions, value.instructions)
        instructions.push(LinearInstruction('assign', '', '', '', '', [target_value.name, value.name]))
        return LinearIRBlockResult(instructions, value.next_temp)
    if (node.kind == 'ExprStmt'):
        TempIRResult value = lower_linear_value_ir(node.children[0], next_temp)
        LinearInstruction[] instructions = append_instructions(value.instructions, [LinearInstruction('drop', '', '', '', '', [value.name])])
        return LinearIRBlockResult(instructions, value.next_temp)
    if (node.kind == 'Return'):
        if (node.children.is_empty()):
            return LinearIRBlockResult([LinearInstruction('return', '', '', '', '', [])], next_temp)
        TempIRResult value = lower_linear_value_ir(node.children[0], next_temp)
        LinearInstruction[] instructions = append_instructions(value.instructions, [LinearInstruction('return', '', '', '', '', [value.name])])
        return LinearIRBlockResult(instructions, value.next_temp)
    if (node.kind == 'Throw'):
        TempIRResult value = lower_linear_value_ir(node.children[0], next_temp)
        LinearInstruction[] instructions = append_instructions(value.instructions, [LinearInstruction('throw', '', '', '', '', [value.name])])
        return LinearIRBlockResult(instructions, value.next_temp)
    return LinearIRBlockResult([LinearInstruction('unsupported', '', '', '', node.kind, [])], next_temp)

LinearBlockResult lower_linear_block(Node[] nodes, int next_temp, string indent):
    string[] lines = []
    int current_temp = next_temp
    for (Node node in nodes):
        LinearBlockResult lowered = lower_linear_statement(node, current_temp, indent)
        lines = append_lines(lines, lowered.lines)
        current_temp = lowered.next_temp
    return LinearBlockResult(lines, current_temp)

LinearListResult lower_linear_statement_list_from(Node[] nodes, int start, int next_temp, int next_label, string indent, string break_label, string continue_label):
    if (start >= nodes.length()):
        string[] empty_lines = []
        return LinearListResult(empty_lines, next_temp, next_label)

    Node node = nodes[start]

    if (node.kind == 'Break'):
        if (break_label == ''):
            return LinearListResult([indent + 'unsupported-linear Break'], next_temp, next_label)
        return LinearListResult([indent + 'jump ' + break_label], next_temp, next_label)

    if (node.kind == 'Continue'):
        if (continue_label == ''):
            return LinearListResult([indent + 'unsupported-linear Continue'], next_temp, next_label)
        return LinearListResult([indent + 'jump ' + continue_label], next_temp, next_label)

    if (is_straight_line_statement(node)):
        LinearBlockResult statement = lower_linear_statement(node, next_temp, indent)
        LinearListResult rest = lower_linear_statement_list_from(nodes, start + 1, statement.next_temp, next_label, indent, break_label, continue_label)
        return LinearListResult(append_lines(statement.lines, rest.lines), rest.next_temp, rest.next_label)

    if (node.kind == 'If'):
        TempResult condition = lower_linear_value(node.children[0], next_temp)
        string then_label = label_name(next_label)
        string else_label = label_name(next_label + 1)
        string after_label = label_name(next_label + 2)
        LinearListResult then_part = lower_linear_statement_list(if_then_nodes(node), condition.next_temp, next_label + 3, indent, break_label, continue_label)
        LinearListResult else_part = lower_linear_statement_list(if_else_nodes(node), then_part.next_temp, then_part.next_label, indent, break_label, continue_label)
        LinearListResult rest = lower_linear_statement_list_from(nodes, start + 1, else_part.next_temp, else_part.next_label, indent, break_label, continue_label)

        string[] lines = []
        lines = append_indented_lines(lines, condition.lines, indent)
        lines.push(indent + 'branch_if ' + condition.name + ' ' + then_label + ' ' + else_label)
        lines.push(indent + 'label ' + then_label)
        lines = append_lines(lines, then_part.lines)
        lines.push(indent + 'jump ' + after_label)
        lines.push(indent + 'label ' + else_label)
        lines = append_lines(lines, else_part.lines)
        lines.push(indent + 'jump ' + after_label)
        lines.push(indent + 'label ' + after_label)
        lines = append_lines(lines, rest.lines)
        return LinearListResult(lines, rest.next_temp, rest.next_label)

    if (node.kind == 'While'):
        string cond_label = label_name(next_label)
        string body_label = label_name(next_label + 1)
        string end_label = label_name(next_label + 2)
        TempResult condition = lower_linear_value(node.children[0], next_temp)
        LinearListResult body = lower_linear_statement_list_from(node.children, 1, condition.next_temp, next_label + 3, indent, end_label, cond_label)
        LinearListResult rest = lower_linear_statement_list_from(nodes, start + 1, body.next_temp, body.next_label, indent, break_label, continue_label)

        string[] lines = [indent + 'jump ' + cond_label, indent + 'label ' + cond_label]
        lines = append_indented_lines(lines, condition.lines, indent)
        lines.push(indent + 'branch_if ' + condition.name + ' ' + body_label + ' ' + end_label)
        lines.push(indent + 'label ' + body_label)
        lines = append_lines(lines, body.lines)
        lines.push(indent + 'jump ' + cond_label)
        lines.push(indent + 'label ' + end_label)
        lines = append_lines(lines, rest.lines)
        return LinearListResult(lines, rest.next_temp, rest.next_label)

    if (node.kind == 'For'):
        string cond_label = label_name(next_label)
        string body_label = label_name(next_label + 1)
        string update_label = label_name(next_label + 2)
        string end_label = label_name(next_label + 3)
        LinearBlockResult init_statement = lower_linear_statement(node.children[0], next_temp, indent)
        TempResult condition = lower_linear_value(node.children[1], init_statement.next_temp)
        LinearListResult body = lower_linear_statement_list(lowerer_for_body_nodes(node), condition.next_temp, next_label + 4, indent, end_label, update_label)
        LinearBlockResult update_statement = lower_linear_statement(node.children[2], body.next_temp, indent)
        LinearListResult rest = lower_linear_statement_list_from(nodes, start + 1, update_statement.next_temp, body.next_label, indent, break_label, continue_label)

        string[] lines = []
        lines = append_lines(lines, init_statement.lines)
        lines.push(indent + 'jump ' + cond_label)
        lines.push(indent + 'label ' + cond_label)
        lines = append_indented_lines(lines, condition.lines, indent)
        lines.push(indent + 'branch_if ' + condition.name + ' ' + body_label + ' ' + end_label)
        lines.push(indent + 'label ' + body_label)
        lines = append_lines(lines, body.lines)
        lines.push(indent + 'jump ' + update_label)
        lines.push(indent + 'label ' + update_label)
        lines = append_lines(lines, update_statement.lines)
        lines.push(indent + 'jump ' + cond_label)
        lines.push(indent + 'label ' + end_label)
        lines = append_lines(lines, rest.lines)
        return LinearListResult(lines, rest.next_temp, rest.next_label)

    if (node.kind == 'ForEach'):
        string cond_label = label_name(next_label)
        string body_label = label_name(next_label + 1)
        string end_label = label_name(next_label + 2)
        string continue_loop_label = label_name(next_label + 3)
        string index_name = loop_index_name(next_label)
        TempResult iterable = lower_linear_value(node.children[0], next_temp)
        string index_init = temp_name(iterable.next_temp)
        string index_check = temp_name(iterable.next_temp + 1)
        string iterable_len = temp_name(iterable.next_temp + 2)
        string cond_value = temp_name(iterable.next_temp + 3)
        string index_item = temp_name(iterable.next_temp + 4)
        string item_value = temp_name(iterable.next_temp + 5)
        LinearListResult body = lower_linear_statement_list_from(node.children, 1, iterable.next_temp + 6, next_label + 4, indent, end_label, continue_loop_label)
        int post_body_temp = body.next_temp + 4
        LinearListResult rest = lower_linear_statement_list_from(nodes, start + 1, post_body_temp, body.next_label, indent, break_label, continue_label)

        string[] lines = []
        lines = append_indented_lines(lines, iterable.lines, indent)
        lines.push(indent + index_init + ' = int 0')
        lines.push(indent + 'set int ' + index_name + ' ' + index_init)
        lines.push(indent + 'jump ' + cond_label)
        lines.push(indent + 'label ' + cond_label)
        lines.push(indent + index_check + ' = identifier ' + index_name)
        lines.push(indent + iterable_len + ' = method-call length ' + iterable.name)
        lines.push(indent + cond_value + ' = binary < ' + index_check + ' ' + iterable_len)
        lines.push(indent + 'branch_if ' + cond_value + ' ' + body_label + ' ' + end_label)
        lines.push(indent + 'label ' + body_label)
        lines.push(indent + index_item + ' = identifier ' + index_name)
        lines.push(indent + item_value + ' = index ' + iterable.name + ' ' + index_item)
        lines.push(indent + 'set ' + node.value + ' ' + item_value)
        lines = append_lines(lines, body.lines)
        lines.push(indent + 'label ' + continue_loop_label)
        string next_index_ref = temp_name(body.next_temp)
        string one_value = temp_name(body.next_temp + 1)
        string bumped_index = temp_name(body.next_temp + 2)
        string index_target = temp_name(body.next_temp + 3)
        lines.push(indent + next_index_ref + ' = identifier ' + index_name)
        lines.push(indent + one_value + ' = int 1')
        lines.push(indent + bumped_index + ' = binary + ' + next_index_ref + ' ' + one_value)
        lines.push(indent + index_target + ' = identifier ' + index_name)
        lines.push(indent + 'assign ' + index_target + ' ' + bumped_index)
        lines.push(indent + 'jump ' + cond_label)
        lines.push(indent + 'label ' + end_label)
        lines = append_lines(lines, rest.lines)
        return LinearListResult(lines, rest.next_temp, rest.next_label)

    if (node.kind == 'Try'):
        string catch_label = label_name(next_label)
        string after_label = label_name(next_label + 1)
        Node catch_part = catch_node(node)
        LinearListResult try_part = lower_linear_statement_list(try_body_nodes(node), next_temp, next_label + 2, indent, break_label, continue_label)
        LinearListResult catch_part_lines = lower_linear_statement_list(catch_part.children, try_part.next_temp, try_part.next_label, indent, break_label, continue_label)
        LinearListResult rest = lower_linear_statement_list_from(nodes, start + 1, catch_part_lines.next_temp, catch_part_lines.next_label, indent, break_label, continue_label)

        string[] lines = [indent + 'try ' + catch_label]
        lines = append_lines(lines, try_part.lines)
        lines.push(indent + 'jump ' + after_label)
        lines.push(indent + 'label ' + catch_label)
        lines.push(indent + 'catch ' + catch_part.value)
        lines = append_lines(lines, catch_part_lines.lines)
        lines.push(indent + 'jump ' + after_label)
        lines.push(indent + 'label ' + after_label)
        lines = append_lines(lines, rest.lines)
        return LinearListResult(lines, rest.next_temp, rest.next_label)

    if (node.kind == 'Switch'):
        Node[] cases = []
        Node[] default_nodes = []
        for (Node child : tail_nodes(node.children, 1)):
            if (child.kind == 'Case'):
                cases.push(child)
            else if (child.kind == 'Default'):
                default_nodes = child.children
        TempResult subject = lower_linear_value(node.children[0], next_temp)
        int reserved_labels = 1 + cases.length() * 2
        if (!default_nodes.is_empty()):
            reserved_labels += 1
        string after_label = label_name(next_label)
        string default_label = after_label
        if (!default_nodes.is_empty()):
            default_label = label_name(next_label + 1 + cases.length() * 2)

        string[] lines = []
        lines = append_indented_lines(lines, subject.lines, indent)
        int current_temp = subject.next_temp
        int current_next_label = next_label + reserved_labels

        if (!cases.is_empty()):
            lines.push(indent + 'jump ' + label_name(next_label + 1))
        else if (!default_nodes.is_empty()):
            lines.push(indent + 'jump ' + default_label)

        int case_index = 0
        while (case_index < cases.length()):
            Node case_node = cases[case_index]
            string check_label = label_name(next_label + 1 + case_index * 2)
            string body_label = label_name(next_label + 2 + case_index * 2)
            string next_check_label = after_label
            if (case_index + 1 < cases.length()):
                next_check_label = label_name(next_label + 1 + (case_index + 1) * 2)
            else if (!default_nodes.is_empty()):
                next_check_label = default_label

            lines.push(indent + 'label ' + check_label)
            TempResult case_value = lower_linear_value(case_node.children[0], current_temp)
            lines = append_indented_lines(lines, case_value.lines, indent)
            string compare_name = temp_name(case_value.next_temp)
            lines.push(indent + compare_name + ' = binary == ' + subject.name + ' ' + case_value.name)
            lines.push(indent + 'branch_if ' + compare_name + ' ' + body_label + ' ' + next_check_label)
            lines.push(indent + 'label ' + body_label)
            LinearListResult body = lower_linear_statement_list(switch_case_body(case_node), case_value.next_temp + 1, current_next_label, indent, break_label, continue_label)
            lines = append_lines(lines, body.lines)
            lines.push(indent + 'jump ' + after_label)
            current_temp = body.next_temp
            current_next_label = body.next_label
            case_index += 1
        if (!default_nodes.is_empty()):
            lines.push(indent + 'label ' + default_label)
            LinearListResult default_body = lower_linear_statement_list(default_nodes, current_temp, current_next_label, indent, break_label, continue_label)
            lines = append_lines(lines, default_body.lines)
            lines.push(indent + 'jump ' + after_label)
            current_temp = default_body.next_temp
            current_next_label = default_body.next_label
        lines.push(indent + 'label ' + after_label)
        LinearListResult rest = lower_linear_statement_list_from(nodes, start + 1, current_temp, current_next_label, indent, break_label, continue_label)
        lines = append_lines(lines, rest.lines)
        return LinearListResult(lines, rest.next_temp, rest.next_label)

    return LinearListResult([indent + 'unsupported-linear ' + node.kind], next_temp, next_label)

LinearListResult lower_linear_statement_list(Node[] nodes, int next_temp, int next_label, string indent, string break_label, string continue_label):
    return lower_linear_statement_list_from(nodes, 0, next_temp, next_label, indent, break_label, continue_label)

LinearIRListResult lower_linear_statement_list_ir_from(Node[] nodes, int start, int next_temp, int next_label, string break_label, string continue_label):
    if (start >= nodes.length()):
        LinearInstruction[] empty_instructions = []
        return LinearIRListResult(empty_instructions, next_temp, next_label)

    Node node = nodes[start]

    if (node.kind == 'Break'):
        if (break_label == ''):
            return LinearIRListResult([LinearInstruction('unsupported', '', '', '', 'Break', [])], next_temp, next_label)
        return LinearIRListResult([LinearInstruction('jump', '', '', '', break_label, [])], next_temp, next_label)

    if (node.kind == 'Continue'):
        if (continue_label == ''):
            return LinearIRListResult([LinearInstruction('unsupported', '', '', '', 'Continue', [])], next_temp, next_label)
        return LinearIRListResult([LinearInstruction('jump', '', '', '', continue_label, [])], next_temp, next_label)

    if (is_straight_line_statement(node)):
        LinearIRBlockResult statement = lower_linear_statement_ir(node, next_temp)
        LinearIRListResult rest = lower_linear_statement_list_ir_from(nodes, start + 1, statement.next_temp, next_label, break_label, continue_label)
        return LinearIRListResult(append_instructions(statement.instructions, rest.instructions), rest.next_temp, rest.next_label)

    if (node.kind == 'If'):
        TempIRResult condition = lower_linear_value_ir(node.children[0], next_temp)
        string then_label = label_name(next_label)
        string else_label = label_name(next_label + 1)
        string after_label = label_name(next_label + 2)
        LinearIRListResult then_part = lower_linear_statement_list_ir(if_then_nodes(node), condition.next_temp, next_label + 3, break_label, continue_label)
        LinearIRListResult else_part = lower_linear_statement_list_ir(if_else_nodes(node), then_part.next_temp, then_part.next_label, break_label, continue_label)
        LinearIRListResult rest = lower_linear_statement_list_ir_from(nodes, start + 1, else_part.next_temp, else_part.next_label, break_label, continue_label)

        LinearInstruction[] instructions = []
        instructions = append_instructions(instructions, condition.instructions)
        instructions.push(LinearInstruction('branch_if', '', '', '', '', [condition.name, then_label, else_label]))
        instructions.push(LinearInstruction('label', '', '', '', then_label, []))
        instructions = append_instructions(instructions, then_part.instructions)
        instructions.push(LinearInstruction('jump', '', '', '', after_label, []))
        instructions.push(LinearInstruction('label', '', '', '', else_label, []))
        instructions = append_instructions(instructions, else_part.instructions)
        instructions.push(LinearInstruction('jump', '', '', '', after_label, []))
        instructions.push(LinearInstruction('label', '', '', '', after_label, []))
        instructions = append_instructions(instructions, rest.instructions)
        return LinearIRListResult(instructions, rest.next_temp, rest.next_label)

    if (node.kind == 'While'):
        string cond_label = label_name(next_label)
        string body_label = label_name(next_label + 1)
        string end_label = label_name(next_label + 2)
        TempIRResult condition = lower_linear_value_ir(node.children[0], next_temp)
        LinearIRListResult body = lower_linear_statement_list_ir_from(node.children, 1, condition.next_temp, next_label + 3, end_label, cond_label)
        LinearIRListResult rest = lower_linear_statement_list_ir_from(nodes, start + 1, body.next_temp, body.next_label, break_label, continue_label)

        LinearInstruction[] instructions = [LinearInstruction('jump', '', '', '', cond_label, []), LinearInstruction('label', '', '', '', cond_label, [])]
        instructions = append_instructions(instructions, condition.instructions)
        instructions.push(LinearInstruction('branch_if', '', '', '', '', [condition.name, body_label, end_label]))
        instructions.push(LinearInstruction('label', '', '', '', body_label, []))
        instructions = append_instructions(instructions, body.instructions)
        instructions.push(LinearInstruction('jump', '', '', '', cond_label, []))
        instructions.push(LinearInstruction('label', '', '', '', end_label, []))
        instructions = append_instructions(instructions, rest.instructions)
        return LinearIRListResult(instructions, rest.next_temp, rest.next_label)

    if (node.kind == 'For'):
        string cond_label = label_name(next_label)
        string body_label = label_name(next_label + 1)
        string update_label = label_name(next_label + 2)
        string end_label = label_name(next_label + 3)
        LinearIRBlockResult init_statement = lower_linear_statement_ir(node.children[0], next_temp)
        TempIRResult condition = lower_linear_value_ir(node.children[1], init_statement.next_temp)
        LinearIRListResult body = lower_linear_statement_list_ir(lowerer_for_body_nodes(node), condition.next_temp, next_label + 4, end_label, update_label)
        LinearIRBlockResult update_statement = lower_linear_statement_ir(node.children[2], body.next_temp)
        LinearIRListResult rest = lower_linear_statement_list_ir_from(nodes, start + 1, update_statement.next_temp, body.next_label, break_label, continue_label)

        LinearInstruction[] instructions = []
        instructions = append_instructions(instructions, init_statement.instructions)
        instructions.push(LinearInstruction('jump', '', '', '', cond_label, []))
        instructions.push(LinearInstruction('label', '', '', '', cond_label, []))
        instructions = append_instructions(instructions, condition.instructions)
        instructions.push(LinearInstruction('branch_if', '', '', '', '', [condition.name, body_label, end_label]))
        instructions.push(LinearInstruction('label', '', '', '', body_label, []))
        instructions = append_instructions(instructions, body.instructions)
        instructions.push(LinearInstruction('jump', '', '', '', update_label, []))
        instructions.push(LinearInstruction('label', '', '', '', update_label, []))
        instructions = append_instructions(instructions, update_statement.instructions)
        instructions.push(LinearInstruction('jump', '', '', '', cond_label, []))
        instructions.push(LinearInstruction('label', '', '', '', end_label, []))
        instructions = append_instructions(instructions, rest.instructions)
        return LinearIRListResult(instructions, rest.next_temp, rest.next_label)

    if (node.kind == 'ForEach'):
        string cond_label = label_name(next_label)
        string body_label = label_name(next_label + 1)
        string end_label = label_name(next_label + 2)
        string continue_loop_label = label_name(next_label + 3)
        string index_name = loop_index_name(next_label)
        TempIRResult iterable = lower_linear_value_ir(node.children[0], next_temp)
        string index_init = temp_name(iterable.next_temp)
        string index_check = temp_name(iterable.next_temp + 1)
        string iterable_len = temp_name(iterable.next_temp + 2)
        string cond_value = temp_name(iterable.next_temp + 3)
        string index_item = temp_name(iterable.next_temp + 4)
        string item_value = temp_name(iterable.next_temp + 5)
        LinearIRListResult body = lower_linear_statement_list_ir_from(node.children, 1, iterable.next_temp + 6, next_label + 4, end_label, continue_loop_label)
        int post_body_temp = body.next_temp + 4
        LinearIRListResult rest = lower_linear_statement_list_ir_from(nodes, start + 1, post_body_temp, body.next_label, break_label, continue_label)

        LinearInstruction[] instructions = []
        instructions = append_instructions(instructions, iterable.instructions)
        instructions.push(LinearInstruction('value', index_init, 'int', 'plain', 'int', ['0']))
        instructions.push(LinearInstruction('set', '', '', '', 'int ' + index_name, [index_init]))
        instructions.push(LinearInstruction('jump', '', '', '', cond_label, []))
        instructions.push(LinearInstruction('label', '', '', '', cond_label, []))
        instructions.push(LinearInstruction('value', index_check, 'unknown', 'borrowed', 'identifier', [index_name]))
        instructions.push(LinearInstruction('value', iterable_len, 'int', 'plain', 'method-call', ['length', iterable.name]))
        instructions.push(LinearInstruction('value', cond_value, 'unknown', 'unknown', 'binary', ['<', index_check, iterable_len]))
        instructions.push(LinearInstruction('branch_if', '', '', '', '', [cond_value, body_label, end_label]))
        instructions.push(LinearInstruction('label', '', '', '', body_label, []))
        instructions.push(LinearInstruction('value', index_item, 'unknown', 'borrowed', 'identifier', [index_name]))
        instructions.push(LinearInstruction('value', item_value, 'unknown', 'borrowed', 'index', [iterable.name, index_item]))
        instructions.push(LinearInstruction('set', '', '', '', node.value, [item_value]))
        instructions = append_instructions(instructions, body.instructions)
        instructions.push(LinearInstruction('label', '', '', '', continue_loop_label, []))
        string next_index_ref = temp_name(body.next_temp)
        string one_value = temp_name(body.next_temp + 1)
        string bumped_index = temp_name(body.next_temp + 2)
        instructions.push(LinearInstruction('value', next_index_ref, 'unknown', 'borrowed', 'identifier', [index_name]))
        instructions.push(LinearInstruction('value', one_value, 'int', 'plain', 'int', ['1']))
        instructions.push(LinearInstruction('value', bumped_index, 'unknown', 'unknown', 'binary', ['+', next_index_ref, one_value]))
        instructions.push(LinearInstruction('assign_local', '', '', '', index_name, [bumped_index]))
        instructions.push(LinearInstruction('jump', '', '', '', cond_label, []))
        instructions.push(LinearInstruction('label', '', '', '', end_label, []))
        instructions = append_instructions(instructions, rest.instructions)
        return LinearIRListResult(instructions, rest.next_temp, rest.next_label)

    if (node.kind == 'Try'):
        string catch_label = label_name(next_label)
        string after_label = label_name(next_label + 1)
        Node catch_part = catch_node(node)
        LinearIRListResult try_part = lower_linear_statement_list_ir(try_body_nodes(node), next_temp, next_label + 2, break_label, continue_label)
        LinearIRListResult catch_part_instructions = lower_linear_statement_list_ir(catch_part.children, try_part.next_temp, try_part.next_label, break_label, continue_label)
        LinearIRListResult rest = lower_linear_statement_list_ir_from(nodes, start + 1, catch_part_instructions.next_temp, catch_part_instructions.next_label, break_label, continue_label)

        LinearInstruction[] instructions = [LinearInstruction('try', '', '', '', catch_label, [])]
        instructions = append_instructions(instructions, try_part.instructions)
        instructions.push(LinearInstruction('jump', '', '', '', after_label, []))
        instructions.push(LinearInstruction('label', '', '', '', catch_label, []))
        instructions.push(LinearInstruction('catch', '', '', '', catch_part.value, []))
        instructions = append_instructions(instructions, catch_part_instructions.instructions)
        instructions.push(LinearInstruction('jump', '', '', '', after_label, []))
        instructions.push(LinearInstruction('label', '', '', '', after_label, []))
        instructions = append_instructions(instructions, rest.instructions)
        return LinearIRListResult(instructions, rest.next_temp, rest.next_label)

    if (node.kind == 'Switch'):
        Node[] cases = []
        Node[] default_nodes = []
        for (Node child : tail_nodes(node.children, 1)):
            if (child.kind == 'Case'):
                cases.push(child)
            else if (child.kind == 'Default'):
                default_nodes = child.children
        TempIRResult subject = lower_linear_value_ir(node.children[0], next_temp)
        int reserved_labels = 1 + cases.length() * 2
        if (!default_nodes.is_empty()):
            reserved_labels += 1
        string after_label = label_name(next_label)
        string default_label = after_label
        if (!default_nodes.is_empty()):
            default_label = label_name(next_label + 1 + cases.length() * 2)

        LinearInstruction[] instructions = []
        instructions = append_instructions(instructions, subject.instructions)
        int current_temp = subject.next_temp
        int current_next_label = next_label + reserved_labels

        if (!cases.is_empty()):
            instructions.push(LinearInstruction('jump', '', '', '', label_name(next_label + 1), []))
        else if (!default_nodes.is_empty()):
            instructions.push(LinearInstruction('jump', '', '', '', default_label, []))

        int case_index = 0
        while (case_index < cases.length()):
            Node case_node = cases[case_index]
            string check_label = label_name(next_label + 1 + case_index * 2)
            string body_label = label_name(next_label + 2 + case_index * 2)
            string next_check_label = after_label
            if (case_index + 1 < cases.length()):
                next_check_label = label_name(next_label + 1 + (case_index + 1) * 2)
            else if (!default_nodes.is_empty()):
                next_check_label = default_label

            instructions.push(LinearInstruction('label', '', '', '', check_label, []))
            TempIRResult case_value = lower_linear_value_ir(case_node.children[0], current_temp)
            instructions = append_instructions(instructions, case_value.instructions)
            string compare_name = temp_name(case_value.next_temp)
            instructions.push(LinearInstruction('value', compare_name, 'unknown', 'unknown', 'binary', ['==', subject.name, case_value.name]))
            instructions.push(LinearInstruction('branch_if', '', '', '', '', [compare_name, body_label, next_check_label]))
            instructions.push(LinearInstruction('label', '', '', '', body_label, []))
            LinearIRListResult body = lower_linear_statement_list_ir(switch_case_body(case_node), case_value.next_temp + 1, current_next_label, break_label, continue_label)
            instructions = append_instructions(instructions, body.instructions)
            instructions.push(LinearInstruction('jump', '', '', '', after_label, []))
            current_temp = body.next_temp
            current_next_label = body.next_label
            case_index += 1
        if (!default_nodes.is_empty()):
            instructions.push(LinearInstruction('label', '', '', '', default_label, []))
            LinearIRListResult default_body = lower_linear_statement_list_ir(default_nodes, current_temp, current_next_label, break_label, continue_label)
            instructions = append_instructions(instructions, default_body.instructions)
            instructions.push(LinearInstruction('jump', '', '', '', after_label, []))
            current_temp = default_body.next_temp
            current_next_label = default_body.next_label
        instructions.push(LinearInstruction('label', '', '', '', after_label, []))
        LinearIRListResult rest = lower_linear_statement_list_ir_from(nodes, start + 1, current_temp, current_next_label, break_label, continue_label)
        instructions = append_instructions(instructions, rest.instructions)
        return LinearIRListResult(instructions, rest.next_temp, rest.next_label)

    return LinearIRListResult([LinearInstruction('unsupported', '', '', '', node.kind, [])], next_temp, next_label)

LinearIRListResult lower_linear_statement_list_ir(Node[] nodes, int next_temp, int next_label, string break_label, string continue_label):
    return lower_linear_statement_list_ir_from(nodes, 0, next_temp, next_label, break_label, continue_label)

string[] lower_block_lines(Node[] statements, string indent):
    string[] lines = [indent + 'block']
    for (Node statement in statements):
        string[] child_lines = lower_statement_lines(statement, indent + '  ')
        for (string line in child_lines):
            lines.push(line)
    return lines

string[] lower_value_lines(Node node, string indent):
    if (node.kind == 'Int'):
        return [indent + 'int ' + node.value]
    if (node.kind == 'Num'):
        return [indent + 'num ' + node.value]
    if (node.kind == 'String'):
        return [indent + 'string ' + quote_string(node.value)]
    if (node.kind == 'Bool'):
        return [indent + 'bool ' + node.value]
    if (node.kind == 'Identifier'):
        return [indent + 'identifier ' + node.value]
    if (node.kind == 'Array'):
        string[] lines = [indent + 'array']
        for (Node child in node.children):
            string[] child_lines = lower_value_lines(child, indent + '  ')
            for (string line in child_lines):
                lines.push(line)
        return lines
    if (node.kind == 'Set'):
        string[] lines = [indent + 'set']
        for (Node child in node.children):
            string[] child_lines = lower_value_lines(child, indent + '  ')
            for (string line in child_lines):
                lines.push(line)
        return lines
    if (node.kind == 'Map'):
        string[] lines = [indent + 'map']
        for (Node map_item : node.children):
            lines.push(indent + '  entry')
            lines.push(indent + '    key')
            string[] key_lines = lower_value_lines(map_item.children[0], indent + '      ')
            for (string line in key_lines):
                lines.push(line)
            lines.push(indent + '    value')
            string[] value_lines = lower_value_lines(map_item.children[1], indent + '      ')
            for (string line in value_lines):
                lines.push(line)
        return lines
    if (node.kind == 'Binary'):
        string[] lines = [indent + 'binary ' + node.value]
        string[] left_lines = lower_value_lines(node.children[0], indent + '  ')
        for (string line in left_lines):
            lines.push(line)
        string[] right_lines = lower_value_lines(node.children[1], indent + '  ')
        for (string line in right_lines):
            lines.push(line)
        return lines
    if (node.kind == 'Unary'):
        string[] lines = [indent + 'unary ' + node.value]
        string[] operand_lines = lower_value_lines(node.children[0], indent + '  ')
        for (string line in operand_lines):
            lines.push(line)
        return lines
    if (node.kind == 'Call'):
        string[] lines = [indent + 'call ' + node.value]
        for (Node child in node.children):
            string[] child_lines = lower_value_lines(child, indent + '  ')
            for (string line in child_lines):
                lines.push(line)
        return lines
    if (node.kind == 'CallExpr'):
        string[] lines = [indent + 'call-expr']
        for (Node child in node.children):
            string[] child_lines = lower_value_lines(child, indent + '  ')
            for (string line in child_lines):
                lines.push(line)
        return lines
    if (node.kind == 'Field'):
        string[] lines = [indent + 'field ' + node.value]
        string[] base_lines = lower_value_lines(node.children[0], indent + '  ')
        for (string line in base_lines):
            lines.push(line)
        return lines
    if (node.kind == 'Slice'):
        string[] lines = [indent + 'slice']
        for (Node child in node.children):
            string[] child_lines = lower_value_lines(child, indent + '  ')
            for (string line in child_lines):
                lines.push(line)
        return lines
    if (node.kind == 'MethodCall'):
        string[] lines = [indent + 'method-call ' + node.value]
        string[] base_lines = lower_value_lines(node.children[0], indent + '  ')
        for (string line in base_lines):
            lines.push(line)
        int index = 1
        while (index < node.children.length()):
            string[] arg_lines = lower_value_lines(node.children[index], indent + '  ')
            for (string line in arg_lines):
                lines.push(line)
            index += 1
        return lines
    if (node.kind == 'Index'):
        string[] lines = [indent + 'index']
        string[] base_lines = lower_value_lines(node.children[0], indent + '  ')
        for (string line in base_lines):
            lines.push(line)
        string[] item_lines = lower_value_lines(node.children[1], indent + '  ')
        for (string line in item_lines):
            lines.push(line)
        return lines
    return [indent + '<unsupported-value ' + node.kind + '>']

string[] lower_statement_lines(Node node, string indent):
    if (node.kind == 'VarDecl'):
        string[] lines = [indent + 'let ' + node.value]
        lines.push(indent + '  init')
        string[] value_lines = lower_value_lines(node.children[0], indent + '    ')
        for (string line in value_lines):
            lines.push(line)
        return lines
    if (node.kind == 'Assign'):
        string[] lines = [indent + 'assign']
        lines.push(indent + '  target')
        string[] target_lines = lower_value_lines(node.children[0], indent + '    ')
        for (string line in target_lines):
            lines.push(line)
        lines.push(indent + '  value')
        string[] value_lines = lower_value_lines(node.children[1], indent + '    ')
        for (string line in value_lines):
            lines.push(line)
        return lines
    if (node.kind == 'ExprStmt'):
        string[] lines = [indent + 'expr']
        string[] value_lines = lower_value_lines(node.children[0], indent + '  ')
        for (string line in value_lines):
            lines.push(line)
        return lines
    if (node.kind == 'Return'):
        string[] lines = [indent + 'return']
        if (!node.children.is_empty()):
            lines.push(indent + '  value')
            string[] value_lines = lower_value_lines(node.children[0], indent + '    ')
            for (string line in value_lines):
                lines.push(line)
        return lines
    if (node.kind == 'Break'):
        return [indent + 'break']
    if (node.kind == 'Continue'):
        return [indent + 'continue']
    if (node.kind == 'ImportDecl'):
        return [indent + 'import ' + node.value]
    if (node.kind == 'Throw'):
        string[] lines = [indent + 'throw']
        lines.push(indent + '  value')
        string[] value_lines = lower_value_lines(node.children[0], indent + '    ')
        for (string line in value_lines):
            lines.push(line)
        return lines
    if (node.kind == 'FieldDecl'):
        return [indent + 'field ' + node.value]
    if (node.kind == 'EnumValue'):
        return [indent + 'value ' + node.value]
    if (node.kind == 'RecordDecl'):
        string[] lines = [indent + 'record ' + node.value]
        for (Node child in node.children):
            lines.push(lower_statement_lines(child, indent + '  ')[0])
        return lines
    if (node.kind == 'EnumDecl'):
        string[] lines = [indent + 'enum ' + node.value]
        for (Node child in node.children):
            lines.push(lower_statement_lines(child, indent + '  ')[0])
        return lines
    if (node.kind == 'Function' || node.kind == 'CachedFunction'):
        string head = 'func '
        if (node.kind == 'CachedFunction'):
            head = 'cached func '
        string[] lines = [indent + head + node.value]
        lines.push(indent + '  params')
        Node[] body_nodes = []
        for (Node child in node.children):
            if (child.kind == 'Param'):
                lines.push(indent + '    param ' + child.value)
            else:
                body_nodes.push(child)
        string[] body_lines = []
        if (is_linear_body(body_nodes)):
            body_lines = [indent + '  entry']
            LinearListResult linear = lower_linear_statement_list(body_nodes, 0, 1, indent + '    ', '', '')
            body_lines = append_lines(body_lines, linear.lines)
        else:
            body_lines = lower_block_lines(body_nodes, indent + '  ')
        for (string line in body_lines):
            lines.push(line)
        return lines
    if (node.kind == 'While'):
        string[] lines = [indent + 'while']
        lines.push(indent + '  cond')
        string[] condition_lines = lower_value_lines(node.children[0], indent + '    ')
        for (string line in condition_lines):
            lines.push(line)
        lines.push(indent + '  body')
        Node[] body_nodes = []
        int index = 1
        while (index < node.children.length()):
            body_nodes.push(node.children[index])
            index += 1
        string[] body_lines = lower_block_lines(body_nodes, indent + '    ')
        for (string line in body_lines):
            lines.push(line)
        return lines
    if (node.kind == 'For'):
        string[] lines = [indent + 'for']
        lines.push(indent + '  init')
        string[] init_lines = lower_statement_lines(node.children[0], indent + '    ')
        for (string line in init_lines):
            lines.push(line)
        lines.push(indent + '  cond')
        string[] condition_lines = lower_value_lines(node.children[1], indent + '    ')
        for (string line in condition_lines):
            lines.push(line)
        lines.push(indent + '  update')
        string[] update_lines = lower_statement_lines(node.children[2], indent + '    ')
        for (string line in update_lines):
            lines.push(line)
        lines.push(indent + '  body')
        string[] body_lines = lower_block_lines(lowerer_for_body_nodes(node), indent + '    ')
        for (string line in body_lines):
            lines.push(line)
        return lines
    if (node.kind == 'ForEach'):
        string[] lines = [indent + 'foreach ' + node.value]
        lines.push(indent + '  iterable')
        string[] iterable_lines = lower_value_lines(node.children[0], indent + '    ')
        for (string line in iterable_lines):
            lines.push(line)
        lines.push(indent + '  body')
        Node[] body_nodes = []
        int index = 1
        while (index < node.children.length()):
            body_nodes.push(node.children[index])
            index += 1
        string[] body_lines = lower_block_lines(body_nodes, indent + '    ')
        for (string line in body_lines):
            lines.push(line)
        return lines
    if (node.kind == 'Try'):
        string[] lines = [indent + 'try']
        lines.push(indent + '  body')
        string[] try_lines = lower_block_lines(try_body_nodes(node), indent + '    ')
        for (string line in try_lines):
            lines.push(line)
        Node catch_part = catch_node(node)
        lines.push(indent + '  catch ' + catch_part.value)
        string[] catch_lines = lower_block_lines(catch_part.children, indent + '    ')
        for (string line in catch_lines):
            lines.push(line)
        return lines
    if (node.kind == 'Switch'):
        string[] lines = [indent + 'switch']
        lines.push(indent + '  subject')
        string[] subject_lines = lower_value_lines(node.children[0], indent + '    ')
        for (string line in subject_lines):
            lines.push(line)
        for (Node child : tail_nodes(node.children, 1)):
            if (child.kind == 'Case'):
                lines.push(indent + '  case')
                string[] case_value_lines = lower_value_lines(child.children[0], indent + '    ')
                for (string line in case_value_lines):
                    lines.push(line)
                lines.push(indent + '    body')
                string[] body_lines = lower_block_lines(switch_case_body(child), indent + '      ')
                for (string line in body_lines):
                    lines.push(line)
            else if (child.kind == 'Default'):
                lines.push(indent + '  default')
                string[] body_lines = lower_block_lines(child.children, indent + '    ')
                for (string line in body_lines):
                    lines.push(line)
        return lines
    if (node.kind == 'If'):
        string[] lines = [indent + 'if']
        lines.push(indent + '  cond')
        string[] condition_lines = lower_value_lines(node.children[0], indent + '    ')
        for (string line in condition_lines):
            lines.push(line)
        lines.push(indent + '  then')
        Node[] then_nodes = []
        Node[] else_nodes = []
        int index = 1
        while (index < node.children.length()):
            Node child = node.children[index]
            if (child.kind == 'Else'):
                else_nodes = child.children
            else:
                then_nodes.push(child)
            index += 1
        string[] then_lines = lower_block_lines(then_nodes, indent + '    ')
        for (string line in then_lines):
            lines.push(line)
        if (!else_nodes.is_empty()):
            lines.push(indent + '  else')
            string[] else_lines = lower_block_lines(else_nodes, indent + '    ')
            for (string line in else_lines):
                lines.push(line)
        return lines
    return [indent + '<unsupported-stmt ' + node.kind + '>']

BindingIR[] const_copy_bindings(BindingIR[] bindings):
    BindingIR[] copied = []
    for (BindingIR binding : bindings):
        copied.push(binding)
    return copied

BindingIR const_lookup_binding(BindingIR[] bindings, string name):
    int index = bindings.length() - 1
    while (index >= 0):
        if (bindings[index].name == name):
            return bindings[index]
        index -= 1
    return BindingIR('', '')

string const_target_root(Node target):
    if (target.kind == 'Identifier'):
        return target.value
    if ((target.kind == 'Field' || target.kind == 'Index') && target.children.length() > 0):
        return const_target_root(target.children[0])
    return ''

bool const_type_is_array(string type_name):
    return type_name.ends_with('[]')

bool const_method_mutates_type(string method, string type_name):
    string value_type = type_name
    if (value_type.starts_with('const ')):
        value_type = value_type.substring(6)
    if (method == 'add'):
        return value_type.starts_with('set<')
    if (method == 'push' || method == 'pop'):
        return const_type_is_array(value_type) || value_type.starts_with('prio_q<')
    if (method == 'fill'):
        return value_type == 'int[]' || value_type == 'bool[]' || value_type == 'string[]' || value_type == 'int[][]' || value_type == 'string[][]'
    if (method == 'insert' || method == 'remove_at' || method == 'clear' || method == 'sort'):
        return const_type_is_array(value_type)
    return false

string const_type_of_expression(Node expression, BindingIR[] bindings, Node[] record_nodes):
    if (expression.kind == 'Identifier'):
        return const_lookup_binding(bindings, expression.value).type_name.substring(0)
    if (expression.kind == 'Index' && expression.children.length() > 0):
        string base_type = const_type_of_expression(expression.children[0], bindings, record_nodes)
        if (base_type.starts_with('const ')):
            base_type = base_type.substring(6)
        if (base_type.ends_with('[]') && base_type.length() > 2):
            return base_type.substring(0, base_type.length() - 2)
        if (base_type.starts_with('map<')):
            int depth = 0
            int index = 0
            while (index < base_type.length()):
                string ch = base_type[index]
                if (ch == '<'):
                    depth += 1
                else if (ch == '>'):
                    depth -= 1
                else if (ch == ',' && depth == 1):
                    return base_type.substring(index + 2, base_type.length() - 1)
                index += 1
    if (expression.kind == 'Field' && expression.children.length() > 0):
        string record_type = const_type_of_expression(expression.children[0], bindings, record_nodes)
        if (record_type.starts_with('const ')):
            record_type = record_type.substring(6)
        for (Node record_node : record_nodes):
            if (record_type == record_node.value):
                for (Node field_node : record_node.children):
                    BindingIR field = ir_parse_binding_decl(field_node.value)
                    if (field.name == expression.value):
                        return field.type_name.substring(0)
    return ''

bool const_method_mutates_receiver(string method, Node receiver, BindingIR[] bindings, Node[] record_nodes):
    return const_method_mutates_type(method, const_type_of_expression(receiver, bindings, record_nodes))

bool const_function_mutates_first_arg(string name):
    return name == 'push' || name == 'pop' || name == 'insert' || name == 'remove_at' || name == 'clear' || name == 'sort' || name == 'add' || name == 'fill'

bool const_record_name_exists(Node[] record_nodes, string name):
    for (Node record_node : record_nodes):
        if (record_node.value == name):
            return true
    return false

void const_reject_mutation(BindingIR[] bindings, string root, bool assignment):
    if (root == ''):
        return
    BindingIR binding = const_lookup_binding(bindings, root)
    if (binding.name != '' && binding.type_name.starts_with('const ')):
        if (assignment):
            throw 'Cannot assign to const variable: ' + root
        throw 'Cannot mutate const variable: ' + root

void validate_const_expression(Node node, BindingIR[] bindings, string[] function_names, Node[] record_nodes):
    if (node.kind == 'Lambda'):
        BindingIR[] inner = const_copy_bindings(bindings)
        inner.push(ir_parse_binding_decl(node.value))
        if (node.children.length() > 0):
            validate_const_expression(node.children[0], inner, function_names, record_nodes)
        return
    if (node.kind == 'Lambda2'):
        BindingIR[] inner = const_copy_bindings(bindings)
        int separator = node.value.index_of(' | ')
        if (separator >= 0):
            inner.push(ir_parse_binding_decl(node.value.substring(0, separator)))
            inner.push(ir_parse_binding_decl(node.value.substring(separator + 3)))
        if (node.children.length() > 0):
            validate_const_expression(node.children[0], inner, function_names, record_nodes)
        return
    if (node.kind == 'Call'):
        if (node.value == 'fill'):
            if (!(node.value in function_names) && !const_record_name_exists(record_nodes, node.value) && node.children.length() > 0):
                string root = const_target_root(node.children[0])
                if (const_method_mutates_receiver(node.value, node.children[0], bindings, record_nodes)):
                    const_reject_mutation(bindings, root, false)
        else if (node.value == 'clear'):
            if (node.children.length() > 0):
                string receiver_type = const_type_of_expression(node.children[0], bindings, record_nodes)
                if (receiver_type.starts_with('const ')):
                    receiver_type = receiver_type.substring(6)
                if (receiver_type == 'int[][]' || receiver_type == 'string[][]'):
                    if (!(node.value in function_names) && !const_record_name_exists(record_nodes, node.value) && const_method_mutates_receiver(node.value, node.children[0], bindings, record_nodes)):
                        string root = const_target_root(node.children[0])
                        const_reject_mutation(bindings, root, false)
                else if (!(node.value in function_names) && const_function_mutates_first_arg(node.value) && const_method_mutates_receiver(node.value, node.children[0], bindings, record_nodes)):
                    string root = const_target_root(node.children[0])
                    const_reject_mutation(bindings, root, false)
        else if (node.value == 'pop'):
            if (!(node.value in function_names)):
                if (node.children.length() > 0):
                    if (!const_record_name_exists(record_nodes, node.value)):
                        string root = const_target_root(node.children[0])
                        if (const_method_mutates_receiver(node.value, node.children[0], bindings, record_nodes)):
                            const_reject_mutation(bindings, root, false)
        else if (node.value == 'remove_at' || node.value == 'insert' || node.value == 'push'):
            if (!(node.value in function_names) && !const_record_name_exists(record_nodes, node.value) && node.children.length() > 0):
                string root = const_target_root(node.children[0])
                if (const_method_mutates_receiver(node.value, node.children[0], bindings, record_nodes)):
                    const_reject_mutation(bindings, root, false)
        else if (!(node.value in function_names) && const_function_mutates_first_arg(node.value) && node.children.length() > 0):
            string root = const_target_root(node.children[0])
            if (const_method_mutates_receiver(node.value, node.children[0], bindings, record_nodes)):
                const_reject_mutation(bindings, root, false)
        for (Node child : node.children):
            validate_const_expression(child, bindings, function_names, record_nodes)
        return
    if (node.kind == 'MethodCall'):
        if (node.children.length() > 0):
            if (node.value == 'fill'):
                if (!(node.value in function_names) && !const_record_name_exists(record_nodes, node.value) && const_method_mutates_receiver(node.value, node.children[0], bindings, record_nodes)):
                    string root = const_target_root(node.children[0])
                    const_reject_mutation(bindings, root, false)
            else if (node.value == 'pop'):
                string receiver_type = const_type_of_expression(node.children[0], bindings, record_nodes)
                if (receiver_type.starts_with('const ')):
                    receiver_type = receiver_type.substring(6)
                if (receiver_type == 'bool[]' || receiver_type == 'string[]' || receiver_type == 'int[][]' || receiver_type == 'string[][]'):
                    if (!(node.value in function_names)):
                        string root = const_target_root(node.children[0])
                        const_reject_mutation(bindings, root, false)
                else if (const_method_mutates_receiver(node.value, node.children[0], bindings, record_nodes)):
                    string root = const_target_root(node.children[0])
                    const_reject_mutation(bindings, root, false)
            else:
                string receiver_type = const_type_of_expression(node.children[0], bindings, record_nodes)
                if (receiver_type.starts_with('const ')):
                    receiver_type = receiver_type.substring(6)
                bool user_string_remove_at = node.value == 'remove_at' && receiver_type == 'string[]' && node.value in function_names
                bool user_string_insert = node.value == 'insert' && receiver_type == 'string[]' && node.value in function_names
                bool user_nested_clear = node.value == 'clear' && (receiver_type == 'int[][]' || receiver_type == 'string[][]') && node.value in function_names
                string root = const_target_root(node.children[0])
                if (!user_string_remove_at && !user_string_insert && !user_nested_clear && const_method_mutates_receiver(node.value, node.children[0], bindings, record_nodes)):
                    const_reject_mutation(bindings, root, false)
        for (Node child : node.children):
            validate_const_expression(child, bindings, function_names, record_nodes)
        return
    for (Node child : node.children):
        validate_const_expression(child, bindings, function_names, record_nodes)

void validate_const_statement(Node node, BindingIR[] bindings, string[] function_names, Node[] record_nodes):
    if (node.kind == 'VarDecl'):
        if (node.children.length() > 0):
            validate_const_expression(node.children[0], bindings, function_names, record_nodes)
        bindings.push(ir_parse_binding_decl(node.value))
        return
    if (node.kind == 'Assign'):
        if (node.children.length() > 0):
            string root = const_target_root(node.children[0])
            const_reject_mutation(bindings, root, node.children[0].kind == 'Identifier')
            validate_const_expression(node.children[0], bindings, function_names, record_nodes)
        if (node.children.length() > 1):
            validate_const_expression(node.children[1], bindings, function_names, record_nodes)
        return
    if (node.kind == 'ExprStmt' || node.kind == 'Return' || node.kind == 'Throw'):
        for (Node child : node.children):
            validate_const_expression(child, bindings, function_names, record_nodes)
        return
    if (node.kind == 'If'):
        if (node.children.length() > 0):
            validate_const_expression(node.children[0], bindings, function_names, record_nodes)
        BindingIR[] then_bindings = const_copy_bindings(bindings)
        BindingIR[] else_bindings = const_copy_bindings(bindings)
        for (Node child : if_then_nodes(node)):
            validate_const_statement(child, then_bindings, function_names, record_nodes)
        for (Node child : if_else_nodes(node)):
            validate_const_statement(child, else_bindings, function_names, record_nodes)
        return
    if (node.kind == 'While'):
        if (node.children.length() > 0):
            validate_const_expression(node.children[0], bindings, function_names, record_nodes)
        BindingIR[] body_bindings = const_copy_bindings(bindings)
        for (Node child : tail_nodes(node.children, 1)):
            validate_const_statement(child, body_bindings, function_names, record_nodes)
        return
    if (node.kind == 'For'):
        BindingIR[] loop_bindings = const_copy_bindings(bindings)
        if (node.children.length() > 0):
            validate_const_statement(node.children[0], loop_bindings, function_names, record_nodes)
        if (node.children.length() > 1):
            validate_const_expression(node.children[1], loop_bindings, function_names, record_nodes)
        if (node.children.length() > 2):
            validate_const_statement(node.children[2], loop_bindings, function_names, record_nodes)
        BindingIR[] body_bindings = const_copy_bindings(loop_bindings)
        for (Node child : lowerer_for_body_nodes(node)):
            validate_const_statement(child, body_bindings, function_names, record_nodes)
        return
    if (node.kind == 'ForEach'):
        if (node.children.length() > 0):
            validate_const_expression(node.children[0], bindings, function_names, record_nodes)
        BindingIR[] body_bindings = const_copy_bindings(bindings)
        body_bindings.push(ir_parse_binding_decl(node.value))
        for (Node child : tail_nodes(node.children, 1)):
            validate_const_statement(child, body_bindings, function_names, record_nodes)
        return
    if (node.kind == 'Switch'):
        if (node.children.length() > 0):
            validate_const_expression(node.children[0], bindings, function_names, record_nodes)
        for (Node branch : tail_nodes(node.children, 1)):
            BindingIR[] branch_bindings = const_copy_bindings(bindings)
            int start = 0
            if (branch.kind == 'Case'):
                if (branch.children.length() > 0):
                    validate_const_expression(branch.children[0], bindings, function_names, record_nodes)
                start = 1
            for (Node child : tail_nodes(branch.children, start)):
                validate_const_statement(child, branch_bindings, function_names, record_nodes)
        return
    if (node.kind == 'Try'):
        BindingIR[] try_bindings = const_copy_bindings(bindings)
        Node catch_part = catch_node(node)
        for (Node child : try_body_nodes(node)):
            validate_const_statement(child, try_bindings, function_names, record_nodes)
        BindingIR[] catch_bindings = const_copy_bindings(bindings)
        catch_bindings.push(ir_parse_binding_decl(catch_part.value))
        for (Node child : catch_part.children):
            validate_const_statement(child, catch_bindings, function_names, record_nodes)
        return
    for (Node child : node.children):
        validate_const_expression(child, bindings, function_names, record_nodes)

void validate_const_bindings(Node program):
    BindingIR[] globals = []
    string[] function_names = []
    Node[] record_nodes = []
    for (Node child : program.children):
        if (child.kind == 'VarDecl'):
            globals.push(ir_parse_binding_decl(child.value))
        if (child.kind == 'Function' || child.kind == 'CachedFunction'):
            BindingIR signature = ir_parse_binding_decl(child.value)
            function_names.push(signature.name)
        if (child.kind == 'RecordDecl'):
            record_nodes.push(child)
    for (Node child : program.children):
        if (child.kind == 'VarDecl' && child.children.length() > 0):
            validate_const_expression(child.children[0], globals, function_names, record_nodes)
        if (child.kind == 'Function' || child.kind == 'CachedFunction'):
            BindingIR[] function_bindings = const_copy_bindings(globals)
            for (Node fn_child : child.children):
                if (fn_child.kind == 'Param'):
                    function_bindings.push(ir_parse_binding_decl(fn_child.value))
            for (Node fn_child : child.children):
                if (fn_child.kind != 'Param'):
                    validate_const_statement(fn_child, function_bindings, function_names, record_nodes)

string[] lower_program(Node program):
    validate_const_bindings(program)
    string[] lines = ['program']
    for (Node child in program.children):
        string[] child_lines = lower_statement_lines(child, '  ')
        for (string line in child_lines):
            lines.push(line)
    return lines

string[] lower_source(string source):
    Node program = parse_source(source)
    return lower_program(program)

BindingIR[] collect_function_locals(LinearInstruction[] instructions):
    BindingIR[] locals = []
    for (LinearInstruction op : instructions):
        if (op.kind == 'set' || op.kind == 'catch'):
            BindingIR local_decl = ir_parse_binding_decl(op.detail)
            string local_type_name = local_decl.type_name
            if (local_type_name.starts_with('const ')):
                local_type_name = local_type_name.substring(6)
            bool seen = false
            for (BindingIR existing : locals):
                string existing_type_name = existing.type_name
                if (existing_type_name.starts_with('const ')):
                    existing_type_name = existing_type_name.substring(6)
                if (existing_type_name == local_type_name && existing.name == local_decl.name):
                    seen = true
            if (!seen):
                locals.push(local_decl)
    return locals

bool top_level_function_starts(Token[] tokens, int index):
    if (!(token_at(tokens, index).kind == 'KEYWORD' || token_at(tokens, index).kind == 'IDENTIFIER')):
        return false
    if (!could_start_type(tokens, index)):
        return false
    int after_type = type_end(tokens, index)
    if (after_type + 1 >= tokens.length()):
        return false
    if (token_at(tokens, after_type).kind != 'IDENTIFIER'):
        return false
    if (!token_is(token_at(tokens, after_type + 1), 'SYMBOL', '(')):
        return false
    int current = after_type + 2
    int paren_depth = 1
    while (current < tokens.length()):
        Token token = token_at(tokens, current)
        if (token_is(token, 'SYMBOL', '(')):
            paren_depth += 1
        else if (token_is(token, 'SYMBOL', ')')):
            paren_depth -= 1
            if (paren_depth == 0):
                current += 1
                break
        current += 1
    if (paren_depth != 0 || current >= tokens.length()):
        return false
    return token_is(token_at(tokens, current), 'SYMBOL', ':') || token_is(token_at(tokens, current), 'SYMBOL', '{')

LoweredFunctionDeclIR lower_function_declaration_from_parts(FunctionDeclParseResult function_decl):
    BindingIR[] params = []
    for (string param_binding in function_decl.params):
        params.push(ir_parse_binding_decl(param_binding))
    if (!is_linear_body(function_decl.body_nodes)):
        throw 'shared bootstrap IR currently requires linear entry lowering'
    LinearIRListResult linear = lower_linear_statement_list_ir(function_decl.body_nodes, 0, 1, '', '')
    BindingIR[] locals = collect_function_locals(linear.instructions)
    BlockIR[] blocks = linear_instructions_to_blocks(linear.instructions)
    string header = 'func ' + function_decl.return_type + ' ' + function_decl.name
    if (function_decl.is_cached):
        header = 'cached func ' + function_decl.return_type + ' ' + function_decl.name
    return LoweredFunctionDeclIR(ParsedFunction(header, function_decl.name.substring(0), function_decl.return_type.substring(0), params, locals, blocks), function_decl.next_index)

TerminatorIR empty_terminator():
    string[] empty_args = []
    return TerminatorIR('', empty_args)

TerminatorIR lower_block_terminator(LinearInstruction op):
    if (op.kind == 'jump'):
        return TerminatorIR('jump', [op.detail])
    if (op.kind == 'branch_if'):
        return TerminatorIR('branch_if', op.args)
    if (op.kind == 'return'):
        return TerminatorIR('return', op.args)
    if (op.kind == 'throw'):
        return TerminatorIR('throw', op.args)
    throw 'unsupported block terminator instruction: ' + op.kind

BlockIR make_block(string label, LinearInstruction[] instructions, TerminatorIR terminator):
    return BlockIR(label, instructions, terminator)

BlockIR[] linear_instructions_to_blocks(LinearInstruction[] instructions):
    BlockIR[] blocks = []
    string current_label = 'entry'
    LinearInstruction[] current_instructions = []
    TerminatorIR current_terminator = empty_terminator()

    for (LinearInstruction op : instructions):
        if (op.kind == 'label'):
            if (current_label != '' && (current_label != 'entry' || !current_instructions.is_empty() || current_terminator.kind != '')):
                blocks.push(make_block(current_label, current_instructions, current_terminator))
            current_label = op.detail.substring(0)
            current_instructions = []
            current_terminator = empty_terminator()
            continue
        if (current_label == ''):
            continue
        if (op.kind == 'jump' || op.kind == 'branch_if' || op.kind == 'return' || op.kind == 'throw'):
            current_terminator = lower_block_terminator(op)
            blocks.push(make_block(current_label, current_instructions, current_terminator))
            current_label = ''
            current_instructions = []
            current_terminator = empty_terminator()
            continue
        current_instructions.push(op)
    if (current_label != '' && (current_label != 'entry' || !current_instructions.is_empty() || current_terminator.kind != '')):
        blocks.push(make_block(current_label, current_instructions, current_terminator))
    if (blocks.is_empty()):
        blocks.push(make_block('entry', current_instructions, empty_terminator()))
    return blocks

ProgramIR lower_program_ir(Node program):
    SubmitLambdaRewrite rewritten = rewrite_submit_lambdas_in_program(program)
    program = rewritten.node
    validate_const_bindings(program)
    ImportDeclIR[] imports = []
    GlobalDeclIR[] globals = []
    RecordDeclIR[] records = []
    EnumDeclIR[] enums = []
    ParsedFunction[] functions = []
    for (Node child : program.children):
        if (child.kind == 'ImportDecl'):
            imports.push(ImportDeclIR('import ' + child.value))
        else if (child.kind == 'VarDecl'):
            TempIRResult value = lower_linear_value_ir(child.children[0], 0)
            globals.push(GlobalDeclIR('global ' + child.value, value.instructions, value.name))
        else if (child.kind == 'RecordDecl'):
            string[] fields = []
            for (Node field_decl : child.children):
                fields.push('field ' + field_decl.value)
            records.push(RecordDeclIR('record ' + child.value, fields))
        else if (child.kind == 'EnumDecl'):
            string[] values = []
            for (Node value_decl : child.children):
                values.push('value ' + value_decl.value)
            enums.push(EnumDeclIR('enum ' + child.value, values))
        else if (child.kind == 'Function' || child.kind == 'CachedFunction'):
            BindingIR[] params = []
            Node[] body_nodes = []
            for (Node fn_child : child.children):
                if (fn_child.kind == 'Param'):
                    params.push(ir_parse_binding_decl(fn_child.value))
                else:
                    body_nodes.push(fn_child)
            if (!is_linear_body(body_nodes)):
                throw 'shared bootstrap IR currently requires linear entry lowering'
            LinearIRListResult linear = lower_linear_statement_list_ir(body_nodes, 0, 1, '', '')
            BindingIR[] locals = collect_function_locals(linear.instructions)
            BlockIR[] blocks = linear_instructions_to_blocks(linear.instructions)
            string header = 'func ' + child.value
            if (child.kind == 'CachedFunction'):
                header = 'cached func ' + child.value
            BindingIR signature_binding = ir_parse_binding_decl(child.value)
            functions.push(ParsedFunction(header, signature_binding.name.substring(0), signature_binding.type_name.substring(0), params, locals, blocks))
        else:
            throw 'unsupported top-level node in shared bootstrap IR: ' + child.kind
    return ProgramIR(imports, globals, records, enums, functions)

ProgramIR lower_tokens_ir(Token[] tokens):
    bool has_submit_identifier = false
    bool has_arrow_symbol = false
    for (Token token : tokens):
        if (token_is(token, 'IDENTIFIER', 'submit')):
            has_submit_identifier = true
        if (token_is(token, 'SYMBOL', '->')):
            has_arrow_symbol = true
    if (has_submit_identifier && has_arrow_symbol):
        return lower_program_ir(parse_program(tokens))

    bool has_const = false
    for (Token token : tokens):
        if (token_is(token, 'KEYWORD', 'const')):
            has_const = true
    if (has_const):
        validate_const_bindings(parse_program(tokens))
    ImportDeclIR[] imports = []
    GlobalDeclIR[] globals = []
    RecordDeclIR[] records = []
    EnumDeclIR[] enums = []
    ParsedFunction[] functions = []

    int current = skip_statement_separators(tokens, 0)
    while (!token_is(token_at(tokens, current), 'EOF', '')):
        Token token = token_at(tokens, current)
        if (token_is(token, 'KEYWORD', 'cached')):
            FunctionDeclParseResult function_decl = parse_function_declaration_parts(tokens, current + 1, true)
            LoweredFunctionDeclIR lowered_function = lower_function_declaration_from_parts(function_decl)
            functions.push(lowered_function.function_ir)
            current = skip_statement_separators(tokens, lowered_function.next_index)
            continue
        if (top_level_function_starts(tokens, current)):
            FunctionDeclParseResult function_decl = parse_function_declaration_parts(tokens, current, false)
            LoweredFunctionDeclIR lowered_function = lower_function_declaration_from_parts(function_decl)
            functions.push(lowered_function.function_ir)
            current = skip_statement_separators(tokens, lowered_function.next_index)
            continue
        ParseResult statement = parse_statement(tokens, current)
        Node child = statement.node
        if (child.kind == 'ImportDecl'):
            imports.push(ImportDeclIR('import ' + child.value))
        else if (child.kind == 'VarDecl'):
            TempIRResult value = lower_linear_value_ir(child.children[0], 0)
            globals.push(GlobalDeclIR('global ' + child.value, value.instructions, value.name))
        else if (child.kind == 'RecordDecl'):
            string[] fields = []
            for (Node field_decl : child.children):
                fields.push('field ' + field_decl.value)
            records.push(RecordDeclIR('record ' + child.value, fields))
        else if (child.kind == 'EnumDecl'):
            string[] values = []
            for (Node value_decl : child.children):
                values.push('value ' + value_decl.value)
            enums.push(EnumDeclIR('enum ' + child.value, values))
        else if (child.kind == 'Function' || child.kind == 'CachedFunction'):
            BindingIR[] params = []
            Node[] body_nodes = []
            for (Node fn_child : child.children):
                if (fn_child.kind == 'Param'):
                    params.push(ir_parse_binding_decl(fn_child.value))
                else:
                    body_nodes.push(fn_child)
            if (!is_linear_body(body_nodes)):
                throw 'shared bootstrap IR currently requires linear entry lowering'
            LinearIRListResult linear = lower_linear_statement_list_ir(body_nodes, 0, 1, '', '')
            BindingIR[] locals = collect_function_locals(linear.instructions)
            BlockIR[] blocks = linear_instructions_to_blocks(linear.instructions)
            string header = 'func ' + child.value
            if (child.kind == 'CachedFunction'):
                header = 'cached func ' + child.value
            BindingIR signature_binding = ir_parse_binding_decl(child.value)
            functions.push(ParsedFunction(header, signature_binding.name.substring(0), signature_binding.type_name.substring(0), params, locals, blocks))
        else:
            throw 'unsupported top-level node in shared bootstrap IR: ' + child.kind
        current = skip_statement_separators(tokens, statement.next_index)
    return ProgramIR(imports, globals, records, enums, functions)

ProgramIR lower_source_ir(string source):
    Token[] tokens = lex_source(source)
    return lower_tokens_ir(tokens)
