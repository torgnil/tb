            return refined_value_op(op, 'void', 'plain')
        string normalized_base_type = normalize_llvm_type_name(base_type)
        if (method_name == 'slice' && (normalized_base_type == 'bool[]' || normalized_base_type == 'int[]' || normalized_base_type == 'string[]') && lookup_function_return_type(functions, method_name) == 'unknown'):
            throw 'array slice methods are not supported; use values[start:end]'
        if (method_name == 'to_int' && normalized_base_type == 'string'):
            return refined_value_op(op, 'int', 'plain')
        if (method_name == 'to_num'):
            if (lookup_function_return_type(functions, method_name) == 'unknown'):
                if (!record_type_exists(record_names, method_name)):
                    if (normalized_base_type != 'string'):
                        throw 'to_num requires string receiver; got ' + normalized_base_type
                    if (op.args.length() != 2):
                        throw 'to_num expects no arguments'
                    return refined_value_op(op, 'num', 'plain')
        if (method_name == 'push' && normalized_base_type.ends_with('[]')):
            string push_item_type = array_item_type(normalized_base_type)
            bool supported_push_type = push_item_type == 'int' || push_item_type == 'bool' || push_item_type == 'string' || push_item_type == 'int[]' || push_item_type == 'string[]'
            if (!supported_push_type && record_name_from_type(push_item_type) != ''):
                supported_push_type = record_type_exists(record_names, push_item_type)
            if (supported_push_type):
                if (op.args.length() != 3):
                    throw 'array push requires exactly one value'
                string push_value_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2]))
                if (push_value_type != push_item_type):
                    throw 'array push requires ' + push_item_type + '; got ' + push_value_type
                return refined_value_op(op, 'int', 'plain')
        if ((method_name == 'insert' || method_name == 'remove_at') && normalized_base_type == 'int[]'):
            if (method_name == 'insert'):
                if (op.args.length() != 4):
                    throw 'int[] insert requires an int index and int value (exactly two arguments)'
                string insert_index_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2]))
                string insert_value_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[3]))
                if (insert_index_type != 'int' || insert_value_type != 'int'):
                    throw 'int[] insert requires an int index and int value; got ' + insert_index_type + ' and ' + insert_value_type
                return refined_value_op(op, 'int', 'plain')
            if (op.args.length() != 3):
                throw 'int[] remove_at requires an int index (exactly one argument)'
            string remove_index_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2]))
            if (remove_index_type != 'int'):
                throw 'int[] remove_at requires an int index; got ' + remove_index_type
            return refined_value_op(op, 'int', 'plain')
        if (method_name == 'remove_at' && normalize_llvm_type_name(base_type) == 'string[]' && lookup_function_return_type(functions, 'remove_at') == 'unknown'):
            if (op.args.length() != 3):
                throw 'string[] remove_at requires exactly one index'
            string remove_index_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2]))
            if (remove_index_type != 'int'):
                throw 'string[] remove_at requires an int index; got ' + remove_index_type
            return refined_value_op(op, 'string', 'managed')
        if (method_name == 'insert' && normalize_llvm_type_name(base_type) == 'string[]' && lookup_function_return_type(functions, 'insert') == 'unknown'):
            if (op.args.length() != 4):
                throw 'string[] insert requires an index and a string value'
            string insert_index_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2]))
            string insert_value_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[3]))
            if (insert_index_type != 'int' || insert_value_type != 'string'):
                throw 'string[] insert requires an int index and string value; got ' + insert_index_type + ' and ' + insert_value_type
            return refined_value_op(op, 'void', 'plain')
        if ((method_name == 'insert' || method_name == 'remove_at') && normalize_llvm_type_name(base_type) == 'bool[]' && lookup_function_return_type(functions, method_name) == 'unknown'):
            if (method_name == 'insert'):
                if (op.args.length() != 4):
                    throw 'bool[] insert requires an index and a bool value'
                string index_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2]))
                string value_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[3]))
                if (index_type != 'int' || value_type != 'bool'):
                    throw 'bool[] insert requires an int index and bool value; got ' + index_type + ' and ' + value_type
                return refined_value_op(op, 'void', 'plain')
            if (op.args.length() != 3):
                throw 'bool[] remove_at requires exactly one index'
            string remove_index_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2]))
            if (remove_index_type != 'int'):
                throw 'bool[] remove_at requires an int index; got ' + remove_index_type
            return refined_value_op(op, 'bool', 'plain')
        if (method_name == 'pop'):
            string pop_type = normalize_llvm_type_name(base_type)
            if ((pop_type == 'int[][]' || pop_type == 'string[][]') && lookup_function_return_type(functions, 'pop') == 'unknown'):
                if (op.args.length() != 2):
                    throw 'pop requires exactly one array receiver'
                return refined_value_op(op, array_item_type(pop_type), 'owned')
            if (pop_type == 'bool[]' || pop_type == 'string[]'):
                if (lookup_function_return_type(functions, 'pop') == 'unknown'):
                    if (record_type_exists(record_names, 'pop')):
                        if (op.args.length() != 2):
                            throw 'pop requires exactly one array receiver'
                        if (pop_type == 'bool[]'):
                            return refined_value_op(op, 'bool', 'plain')
                        return refined_value_op(op, 'string', refine_ownership_mode(op, 'string'))
                    if (op.args.length() != 2):
                        throw 'pop requires exactly one array receiver'
                    if (pop_type == 'bool[]'):
                        return LinearInstruction(op.kind.substring(0), op.lhs.substring(0), 'bool', 'plain', 'call', ['pop', op.args[1]])
                    return LinearInstruction(op.kind.substring(0), op.lhs.substring(0), 'string', refine_ownership_mode(op, 'string'), 'call', ['pop', op.args[1]])
        if (method_name == 'fill'):
            if (lookup_function_return_type(functions, 'fill') == 'unknown' && !record_type_exists(record_names, 'fill')):
                if (op.args.length() != 3):
                    throw 'fill requires exactly one value'
                string fill_type = normalize_llvm_type_name(base_type)
                string value_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2]))
                if (!((fill_type == 'int[]' && value_type == 'int') || (fill_type == 'bool[]' && value_type == 'bool') || (fill_type == 'string[]' && value_type == 'string') || (fill_type == 'int[][]' && value_type == 'int[]') || (fill_type == 'string[][]' && value_type == 'string[]'))):
                    throw 'fill requires int[] with int, bool[] with bool, string[] with string, int[][] with int[], or string[][] with string[]; got ' + fill_type + ' and ' + value_type
                return LinearInstruction(op.kind.substring(0), op.lhs.substring(0), 'void', 'plain', 'call', ['fill', op.args[1], op.args[2]])
        if (method_name == 'copy'):
            if (lookup_function_return_type(functions, 'copy') == 'unknown' && !record_type_exists(record_names, 'copy')):
                if (op.args.length() != 2):
                    throw 'copy requires exactly one array argument'
                string copy_type = normalize_llvm_type_name(base_type)
                if (!is_array_copy_type(copy_type)):
                    throw 'copy requires int[], bool[], string[], int[][], or string[][]; got ' + copy_type
                return LinearInstruction(op.kind.substring(0), op.lhs.substring(0), copy_type.substring(0), 'owned', 'call', ['copy', op.args[1]])
        if (base_type.starts_with('const ')):
            string canonical_base_type = normalize_llvm_type_name(base_type)
            if (is_thread_pool_type(canonical_base_type) || is_future_type(canonical_base_type) || canonical_base_type.starts_with('map<') || ((method_name == 'sum') && (canonical_base_type == 'int[]' || canonical_base_type == 'bool[]'))):
                base_type = canonical_base_type
        if (method_name == 'abs'):
            string canonical_base_type = normalize_llvm_type_name(base_type)
            if (canonical_base_type == 'int' || canonical_base_type == 'num'):
                return refined_value_op(op, canonical_base_type, refine_ownership_mode(op, canonical_base_type))
        if ((method_name == 'min' || method_name == 'max') && op.args.length() == 3):
            string left_type = normalize_llvm_type_name(base_type)
            string right_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2]))
            if (left_type == right_type && (left_type == 'int' || left_type == 'num')):
                return refined_value_op(op, left_type, refine_ownership_mode(op, left_type))
        if (method_name == 'submit' && base_type == 'thread_pool' && (op.args.length() == 3 || op.args.length() == 4)):
            string future_type = thread_pool_submit_result_type(functions, op.args[2], op.args.length() - 3)
            if (op.args.length() == 4):
                FunctionSigIR worker_sig = lookup_function_sig(functions, op.args[2])
                string expected_type = normalize_llvm_type_name(worker_sig.param_types[0])
                string actual_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[3]))
                if (expected_type != actual_type):
                    throw 'thread_pool.submit argument for ' + op.args[2] + ' requires ' + expected_type + '; got ' + actual_type
            return refined_value_op(op, future_type, refine_ownership_mode(op, future_type))
        if (method_name == 'contains'):
            string result_type = infer_method_call_type_cached(method_name, base_type, functions, TYPE_IR_FUNCTION_TYPE_CACHE_NAMES, TYPE_IR_FUNCTION_TYPE_CACHE_VALUES)
            return refined_value_op(op, result_type, refine_ownership_mode(op, result_type))
        if (method_name == 'starts_with' || method_name == 'ends_with' || method_name == 'starts_with_at' || method_name == 'is_alpha' || method_name == 'is_digit' || method_name == 'is_alnum' || method_name == 'is_space' || method_name == 'is_whitespace'):
            string predicate_receiver_type = normalize_enum_type_name(normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[1])), enum_types)
            if (predicate_receiver_type != 'string'):
                throw method_name + ' requires string receiver; got ' + predicate_receiver_type
            int expected_arity = 2
            if (method_name == 'starts_with' || method_name == 'ends_with'):
                expected_arity = 3
            if (method_name == 'starts_with_at'):
                expected_arity = 4
            if (op.args.length() != expected_arity):
                throw method_name + ' expects ' + (expected_arity - 2).to_string() + ' arguments; got ' + (op.args.length() - 2).to_string()
            if (method_name == 'starts_with' || method_name == 'ends_with' || method_name == 'starts_with_at'):
                string prefix_type = normalize_enum_type_name(normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2])), enum_types)
                if (prefix_type != 'string'):
                    throw method_name + ' argument 1 requires string; got ' + prefix_type
            if (method_name == 'starts_with_at'):
                string index_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[3]))
                if (index_type != 'int'):
                    throw 'starts_with_at argument 2 requires int; got ' + index_type
            return refined_value_op(op, 'bool', 'plain')
        if (method_name == 'char_at' || method_name == 'replace' || method_name == 'trim' || method_name == 'trim_left' || method_name == 'trim_right' || method_name == 'substring' || method_name == 'to_string'):
            return refined_value_op(op, 'string', 'managed')
        if (method_name == 'split' || method_name == 'split_lines'):
            return refined_value_op(op, 'string[]', 'owned')
        string result_type = infer_method_call_type_cached(method_name, base_type, functions, TYPE_IR_FUNCTION_TYPE_CACHE_NAMES, TYPE_IR_FUNCTION_TYPE_CACHE_VALUES)
        return refined_value_op(op, result_type, refine_ownership_mode(op, result_type))
    if (op.detail == 'method-call-lambda'):
        string base_type = 'unknown'
        if (op.args.length() >= 2):
            base_type = lookup_temp_type_slot(temp_types, op.args[1])
            if (op.args[0] == 'sum_grid_eq' && base_type == 'int[][]'):
                return refined_value_op(op, 'int', 'plain')
            if (op.args[0] == 'filter_bounds' && base_type == 'int[][]'):
                return refined_value_op(op, 'int[][]', 'owned')
            if (op.args[0] == 'create_prio_q_int_desc' && base_type == 'int[]'):
                return refined_value_op(op, 'prio_q<int>', 'owned')
            if (op.args[0] == 'create_prio_q_record_field_desc' && base_type.ends_with('[]') && record_name_from_type(array_item_type(base_type)) != ''):
                return refined_value_op(op, 'prio_q<' + array_item_type(base_type) + '>', 'owned')
            if (op.args[0] == 'sort_int_desc' && base_type == 'int[]'):
                return refined_value_op(op, 'int[]', 'borrowed')
            if (op.args[0] == 'sort_int_asc' && base_type == 'int[]'):
                return refined_value_op(op, 'int[]', 'borrowed')
            if (op.args[0] == 'sort_record_field_asc' && base_type.ends_with('[]') && record_name_from_type(array_item_type(base_type)) != ''):
                return refined_value_op(op, base_type, 'borrowed')
            if (op.args[0] == 'map_to_parse_point' && base_type == 'string[]'):
                return refined_value_op(op, 'Point[]', 'owned')
            if (op.args[0] == 'map_to_string_length' && base_type == 'string[]'):
                return refined_value_op(op, 'int[]', 'owned')
            if (op.args[0] == 'map_to_edge_distance' && base_type == 'int[]'):
                return refined_value_op(op, 'Edge[]', 'owned')
            if (op.args[0] == 'flat_map_edges_for_point' && base_type == 'int[]'):
                return refined_value_op(op, 'Edge[]', 'owned')
        if (op.args.length() >= 3):
            BindingIR binding = ir_parse_binding_decl(op.args[2])
            if (op.args[0] == 'map_to' && base_type == 'int[]' && binding.type_name == 'int'):
                return refined_value_op(op, 'int[]', 'owned')
        return op
    if (op.detail == 'target-index'):
        if (op.args.length() < 2):
            return op
        string index_type = lookup_temp_type_slot(temp_types, op.args[1])
        return refined_value_op(op, index_type, refine_ownership_mode(op, index_type))
    if (op.detail == 'assign-index-key'):
        if (op.args.length() < 2):
            return op
        string index_type = lookup_temp_type_slot(temp_types, op.args[1])
        return refined_value_op(op, index_type, refine_ownership_mode(op, index_type))
    if (op.detail == 'index'):
        if (op.args.is_empty()):
            return op
        string base_type = lookup_temp_type_slot(temp_types, op.args[0])
        if (base_type.starts_with('const ')):
            string canonical_base_type = normalize_llvm_type_name(base_type)
            if (canonical_base_type.starts_with('map<') || canonical_base_type == 'string'):
                base_type = canonical_base_type
        if (base_type == 'string'):
            return refined_value_op(op, 'string', 'managed')
        if (base_type == 'string[]'):
            return refined_value_op(op, 'string', 'managed')
        if (base_type.ends_with('[]')):
            string result_type = array_item_type(base_type)
            return refined_value_op(op, result_type, refine_ownership_mode(op, result_type))
        if (base_type.starts_with('set<')):
            string result_type = set_item_type(base_type)
            return refined_value_op(op, result_type, refine_ownership_mode(op, result_type))
        if (base_type.starts_with('map<')):
            string result_type = map_value_type(base_type)
            return refined_value_op(op, result_type, refine_ownership_mode(op, result_type))
        return op
    if (op.detail == 'slice'):
        if (op.args.is_empty()):
            return op
        string base_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[0]))
        if (base_type == 'string' || base_type == 'string[]' || base_type == 'int[]' || base_type == 'bool[]' || base_type == 'int[][]' || base_type == 'string[][]'):
            int bound_index = 1
            while (bound_index < op.args.length()):
                string bound_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[bound_index]))
                if (bound_type != 'int'):
                    throw 'slice bound requires int; got ' + bound_type
                bound_index += 1
        if (base_type == 'string'):
            return refined_value_op(op, 'string', 'managed')
        if (base_type == 'string[]'):
            return refined_value_op(op, 'string[]', 'owned')
        if (base_type == 'int[]'):
            return refined_value_op(op, 'int[]', 'owned')
        if (base_type == 'bool[]'):
            return refined_value_op(op, 'bool[]', 'owned')
        if (base_type == 'int[][]'):
            return refined_value_op(op, 'int[][]', 'owned')
        if (base_type == 'string[][]'):
            return refined_value_op(op, 'string[][]', 'owned')
        return op
    if (op.detail == 'array'):
        string[] item_types = []
        for (string arg in op.args):
            item_types.push(lookup_temp_type_slot(temp_types, arg))
        string result_type = infer_container_type(item_types, '', '[]')
        return refined_value_op(op, result_type, refine_ownership_mode(op, result_type))
    if (op.detail == 'set'):
        string[] item_types = []
        for (string arg in op.args):
            item_types.push(lookup_temp_type_slot(temp_types, arg))
        string result_type = infer_container_type(item_types, 'set<', '>')
        return refined_value_op(op, result_type, refine_ownership_mode(op, result_type))
    if (op.detail == 'map'):
        string[] entry_types = []
        for (string arg in op.args):
            entry_types.push(lookup_temp_type_slot(temp_types, arg))
        string result_type = infer_map_literal_type(entry_types)
        return refined_value_op(op, result_type, refine_ownership_mode(op, result_type))
    return op

void validate_sequence_index_type(string base_type, string index_type):
    string normalized_base_type = normalize_llvm_type_name(base_type)
    if (normalized_base_type == 'string' || normalized_base_type.ends_with('[]')):
        string normalized_index_type = normalize_llvm_type_name(index_type)
        if (normalized_index_type != 'int'):
            throw 'sequence index requires int; got ' + normalized_index_type

void validate_map_index_type(string base_type, string index_type):
    string normalized_base_type = normalize_llvm_type_name(base_type)
    if (normalized_base_type.starts_with('map<')):
        string expected_type = normalize_llvm_type_name(map_key_type(normalized_base_type))
        string actual_type = normalize_llvm_type_name(index_type)
        if (actual_type != expected_type):
            throw 'map index requires ' + expected_type + '; got ' + actual_type

void validate_future_binding_type(string binding_name, string expected_type, string actual_type):
    string normalized_expected_type = normalize_llvm_type_name(expected_type)
    string normalized_actual_type = normalize_llvm_type_name(actual_type)
    if (normalized_expected_type != 'unknown' && normalized_actual_type != 'unknown'):
        if (is_future_type(normalized_expected_type) || is_future_type(normalized_actual_type)):
            if (normalized_actual_type != normalized_expected_type):
                throw 'future binding ' + ir_source_binding_name(binding_name) + ' requires ' + normalized_expected_type + '; got ' + normalized_actual_type

void validate_map_binding_type(string binding_name, string expected_type, string actual_type):
    string normalized_expected_type = normalize_llvm_type_name(expected_type)
    string normalized_actual_type = normalize_llvm_type_name(actual_type)
    if (normalized_expected_type != 'unknown' && normalized_actual_type != 'unknown'):
        if (normalized_expected_type.starts_with('map<') || normalized_actual_type.starts_with('map<')):
            if (normalized_actual_type != normalized_expected_type):
                throw 'map binding ' + ir_source_binding_name(binding_name) + ' requires ' + normalized_expected_type + '; got ' + normalized_actual_type

RefineInstructionsResult refine_instructions(LinearInstruction[] instructions, BindingIR[] globals, BindingIR[] params, BindingIR[] locals, FunctionSigIR[] functions, RecordFieldIR[] record_fields, string[] record_names, EnumTypeIR[] enum_types, LinearInstruction[] prior_instructions, string[] temp_types, bool regex_imported):
    BindingIR[] bindings = []
    for (BindingIR binding in globals):
        bindings.push(binding)
    for (BindingIR binding in params):
        bindings.push(binding)
    for (BindingIR binding in locals):
        bindings.push(binding)

    bool has_integer_enum = false
    for (EnumTypeIR enum_type : enum_types):
        if (enum_type.integer_backed):
            has_integer_enum = true
            break
    LinearInstruction[] block_refined = []
    int op_index = 0
    while (op_index < instructions.length()):
        LinearInstruction op = instructions[op_index]
        if (has_integer_enum && op.kind == 'value' && op.detail == 'identifier' && !op.args.is_empty()):
            string identifier = op.args[0]
            if (integer_enum_exists(enum_types, identifier) && lookup_binding_type(bindings, identifier) == 'unknown'):
                if (op_index + 1 >= instructions.length()):
                    throw 'integer enum name requires a member: ' + identifier
                LinearInstruction member_access = instructions[op_index + 1]
                if (member_access.kind != 'value' || member_access.detail != 'field' || member_access.args.length() < 2):
                    throw 'integer enum name requires a member: ' + identifier
                if (member_access.args[1] != op.lhs):
                    throw 'integer enum name requires a member: ' + identifier
        if (op.kind == 'range_guard'):
            for (string bound in op.args):
                validate_range_bound_type(bound, temp_types, enum_types)
        if (op.kind == 'value' && op.detail == 'call'):
            if (op.args.length() >= 2):
                if (op.args[0] == 'range'):
                    if (op.args.length() == 2 || op.args.length() == 3):
                        int bound_index = 1
                        while (bound_index < op.args.length()):
                            validate_range_bound_type(op.args[bound_index], temp_types, enum_types)
                            bound_index += 1
        if (op.kind == 'value' && (op.detail == 'index' || op.detail == 'target-index' || op.detail == 'assign-index-key') && op.args.length() >= 2):
            string index_base_type = lookup_temp_type_slot(temp_types, op.args[0])
            string index_type = lookup_temp_type_slot(temp_types, op.args[1])
            validate_sequence_index_type(index_base_type, index_type)
            validate_map_index_type(index_base_type, index_type)
        LinearInstruction current = refine_value_instruction(op, bindings, functions, record_fields, record_names, enum_types, temp_types)
        if (current.kind == 'value' && (current.detail == 'call' || current.detail == 'method-call')):
            if (current.args.length() == 3):
                if (current.args[0] == 'split'):
                    string receiver_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, current.args[1]))
                    if (receiver_type == 'string'):
                        string separator_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, current.args[2]))
                        if (separator_type == 'Regex' && regex_imported):
                            current = LinearInstruction('value', current.lhs, 'string[]', 'owned', 'call', ['__tb_regex_split', current.args[1], current.args[2]])
                        else if (separator_type != 'string' && separator_type != 'unknown'):
                            throw 'split separator requires string or imported Regex; got ' + separator_type
        if (current.kind == 'value' && (current.detail == 'call' || current.detail == 'method-call') && enum_name_exists(enum_types, current.result_type)):
            string enum_result_type = normalize_enum_type_name(current.result_type, enum_types)
            current = refined_value_op(current, enum_result_type, refine_ownership_mode(current, enum_result_type))
        if (current.kind == 'value'):
            if (current.detail == 'call'):
                if (!current.args.is_empty()):
                    if (record_type_exists(record_names, current.args[0])):
                        string[] arg_types = record_constructor_arg_types(record_fields, current.args[0])
                        int index = 1
                        while (index < current.args.length() && index - 1 < arg_types.length()):
                            string arg_type_name = arg_types[index - 1]
                            string normalized_arg_type = normalize_llvm_type_name(arg_type_name)
                            if (normalized_arg_type.starts_with('map<') && current.result_type == current.args[0] && lookup_function_return_type(functions, current.args[0]) == 'unknown'):
                                RefineInstructionsResult contextual_map = contextualize_map_literal_rows(block_refined, temp_types, current.args[index], normalized_arg_type, record_names)
                                block_refined = contextual_map.instructions
                                temp_types = contextual_map.temp_types
                            string arg_val_type = lookup_temp_type_slot(temp_types, current.args[index])
                            if (arg_val_type == '[]' && arg_type_name.ends_with('[]')):
                                block_refined = set_temp_type(block_refined, current.args[index], arg_type_name)
                                temp_types = set_temp_type_slot(temp_types, current.args[index], arg_type_name)
                            else if (is_untyped_array_shape(arg_val_type) && arg_type_name.ends_with('[]')):
                                block_refined = set_temp_type(block_refined, current.args[index], arg_type_name)
                                temp_types = set_temp_type_slot(temp_types, current.args[index], arg_type_name)
                                string item_type = array_item_type(arg_type_name)
                                LinearInstruction candidate = lookup_instruction_pair(block_refined, prior_instructions, current.args[index])
                                if (candidate.lhs == current.args[index]):
                                    for (string arg_name in candidate.args):
                                        if (lookup_temp_type_slot(temp_types, arg_name) == '[]' && item_type.ends_with('[]')):
                                            block_refined = set_temp_type(block_refined, arg_name, item_type)
                                            temp_types = set_temp_type_slot(temp_types, arg_name, item_type)
                            string expected_arg_type = normalize_llvm_type_name(arg_types[index - 1])
                            if (lookup_temp_type_slot(temp_types, current.args[index]) == 'unknown' && current.result_type == current.args[0] && lookup_function_return_type(functions, current.args[0]) == 'unknown' && expected_arg_type.starts_with('map<')):
                                LinearInstruction candidate = lookup_instruction_pair(block_refined, prior_instructions, current.args[index])
                                if (candidate.lhs == current.args[index]):
                                    if (candidate.kind == 'value'):
                                        if (candidate.detail == 'map'):
                                            if (candidate.args.is_empty()):
                                                block_refined = set_temp_type(block_refined, current.args[index], expected_arg_type)
                                                temp_types = set_temp_type_slot(temp_types, current.args[index], expected_arg_type)
                            index += 1
                    else:
                        FunctionSigIR call_sig = lookup_function_sig(functions, current.args[0])
                        FunctionSigIR[] empty_functions = []
                        bool builtin_call = infer_call_type(current.args[0], empty_functions) != 'unknown'
                        bool ambiguous_direct_builtin = current.args[0] == 'print' || current.args[0] == 'sum' || current.args[0] == 'min' || current.args[0] == 'max'
                        if (call_sig.name != '' && !builtin_call && !ambiguous_direct_builtin && current.args.length() == call_sig.param_types.length() + 1):
                            int index = 1
                            while (index < current.args.length()):
                                string expected_type = normalize_llvm_type_name(call_sig.param_types[index - 1])
                                string actual_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, current.args[index]))
                                if (expected_type.starts_with('map<')):
                                    RefineInstructionsResult contextual_map = contextualize_map_literal_rows(block_refined, temp_types, current.args[index], expected_type, record_names)
                                    block_refined = contextual_map.instructions
                                    temp_types = contextual_map.temp_types
                                    actual_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, current.args[index]))
                                if (is_untyped_array_shape(actual_type) && is_supported_call_array_type(expected_type)):
                                    RefineInstructionsResult contextual_array = contextualize_call_array_literal(block_refined, temp_types, current.args[index], expected_type)
                                    block_refined = contextual_array.instructions
                                    temp_types = contextual_array.temp_types
                                index += 1
            else if (current.detail == 'method-call' && current.args.length() >= 2):
                string method_name = current.args[0]
                FunctionSigIR method_sig = lookup_function_sig(functions, method_name)
                bool user_priority_copy_fill = (method_name == 'copy' || method_name == 'fill') && method_sig.name != '' && !record_type_exists(record_names, method_name)
                if (method_sig.name != '' && !record_type_exists(record_names, method_name) && (!is_builtin_ufcs_array_context_name(method_name) || user_priority_copy_fill) && current.args.length() == method_sig.param_types.length() + 1):
                    int index = 1
                    while (index < current.args.length()):
                        string expected_type = normalize_llvm_type_name(method_sig.param_types[index - 1])
                        string actual_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, current.args[index]))
                        if (expected_type.starts_with('map<')):
                            RefineInstructionsResult contextual_map = contextualize_map_literal_rows(block_refined, temp_types, current.args[index], expected_type, record_names)
                            block_refined = contextual_map.instructions
                            temp_types = contextual_map.temp_types
                            actual_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, current.args[index]))
                        if (is_untyped_array_shape(actual_type) && is_supported_call_array_type(expected_type)):
                            RefineInstructionsResult contextual_array = contextualize_call_array_literal(block_refined, temp_types, current.args[index], expected_type)
                            block_refined = contextual_array.instructions
                            temp_types = contextual_array.temp_types
                        index += 1
        if (current.kind == 'set'):
            BindingIR parsed_binding = ir_parse_binding_decl(current.detail)
            BindingIR binding = normalize_enum_binding(parsed_binding, enum_types)
            if (binding.type_name != parsed_binding.type_name):
                current = LinearInstruction(current.kind, current.lhs, current.result_type, current.ownership_mode, binding.type_name + ' ' + binding.name, clone_instruction_args(current.args))
            if (current.args.length() == 1):
                string value_type = lookup_temp_type_slot(temp_types, current.args[0])
                validate_future_binding_type(binding.name, binding.type_name, value_type)
                if (value_type == 'unknown' && binding.type_name.starts_with('set<')):
                    block_refined = set_temp_type(block_refined, current.args[0], binding.type_name)
                    temp_types = set_temp_type_slot(temp_types, current.args[0], binding.type_name)
                string declared_map_type = normalize_llvm_type_name(binding.type_name)
                if (value_type == 'unknown' && declared_map_type.starts_with('map<')):
                    LinearInstruction candidate = lookup_instruction_pair(block_refined, prior_instructions, current.args[0])
                    if (candidate.kind == 'value'):
                        if (candidate.detail == 'map'):
                            if (candidate.args.is_empty()):
                                block_refined = set_temp_type(block_refined, current.args[0], declared_map_type)
                                temp_types = set_temp_type_slot(temp_types, current.args[0], declared_map_type)
                if (declared_map_type.starts_with('map<')):
                    RefineInstructionsResult contextual_map = contextualize_map_literal_rows(block_refined, temp_types, current.args[0], declared_map_type, record_names)
                    block_refined = contextual_map.instructions
                    temp_types = contextual_map.temp_types
                validate_map_binding_type(binding.name, binding.type_name, lookup_temp_type_slot(temp_types, current.args[0]))
                if (value_type == '[]' && binding.type_name.ends_with('[]')):
                    block_refined = set_temp_type(block_refined, current.args[0], binding.type_name)
                    temp_types = set_temp_type_slot(temp_types, current.args[0], binding.type_name)
                else if (is_untyped_array_shape(value_type) && binding.type_name.ends_with('[]')):
                    block_refined = set_temp_type(block_refined, current.args[0], binding.type_name)
                    temp_types = set_temp_type_slot(temp_types, current.args[0], binding.type_name)
                    string item_type = array_item_type(binding.type_name)
                    LinearInstruction candidate = lookup_instruction_pair(block_refined, prior_instructions, current.args[0])
                    if (candidate.lhs == current.args[0]):
                        for (string arg_name in candidate.args):
                            if (lookup_temp_type_slot(temp_types, arg_name) == '[]' && item_type.ends_with('[]')):
                                block_refined = set_temp_type(block_refined, arg_name, item_type)
                                temp_types = set_temp_type_slot(temp_types, arg_name, item_type)
        if (current.kind == 'assign_field'):
            if (current.args.length() >= 2):
                string base_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, current.args[0]))
                string record_name = record_name_from_type(base_type)
                if (record_name != ''):
                    string field_type = normalize_llvm_type_name(lookup_record_field_type(record_fields, record_name, current.detail))
                    if (field_type.ends_with('[]')):
                        string value_name = current.args[1]
                        if (lookup_temp_type_slot(temp_types, value_name) == '[]'):
                            LinearInstruction candidate = lookup_instruction_pair(block_refined, prior_instructions, value_name)
                            if (candidate.lhs == value_name):
                                if (candidate.kind == 'value'):
                                    if (candidate.detail == 'array'):
                                        if (candidate.args.is_empty()):
                                            block_refined = set_temp_type(block_refined, value_name, field_type)
                                            temp_types = set_temp_type_slot(temp_types, value_name, field_type)
                    if (field_type.starts_with('map<') && lookup_temp_type_slot(temp_types, current.args[1]) == 'unknown'):
                        LinearInstruction candidate = lookup_instruction_pair(block_refined, prior_instructions, current.args[1])
                        if (candidate.lhs == current.args[1]):
                            if (candidate.kind == 'value'):
                                if (candidate.detail == 'map'):
                                    if (candidate.args.is_empty()):
                                        block_refined = set_temp_type(block_refined, current.args[1], field_type)
                                        temp_types = set_temp_type_slot(temp_types, current.args[1], field_type)
                    if (field_type.starts_with('map<')):
                        RefineInstructionsResult contextual_map = contextualize_map_literal_rows(block_refined, temp_types, current.args[1], field_type, record_names)
                        block_refined = contextual_map.instructions
                        temp_types = contextual_map.temp_types
                    if (is_checked_record_field_assignment_type(record_names, field_type)):
                        string actual_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, current.args[1]))
                        if (actual_type != field_type):
                            throw 'record field assignment requires ' + field_type + '; got ' + actual_type
        if ((current.kind == 'assign_index' || current.kind == 'assign_index_add') && current.args.length() >= 3):
            string base_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, current.args[0]))
            validate_sequence_index_type(base_type, lookup_temp_type_slot(temp_types, current.args[1]))
            validate_map_index_type(base_type, lookup_temp_type_slot(temp_types, current.args[1]))
        if (current.kind == 'assign_index'):
            if (current.args.length() >= 3):
                string base_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, current.args[0]))
                if (base_type == 'int[][]' || base_type == 'string[][]'):
                    string item_type = array_item_type(base_type)
                    string value_name = current.args[2]
                    if (lookup_temp_type_slot(temp_types, value_name) == '[]'):
                        LinearInstruction candidate = lookup_instruction_pair(block_refined, prior_instructions, value_name)
                        if (candidate.lhs == value_name):
                            if (candidate.kind == 'value'):
                                if (candidate.detail == 'array'):
                                    if (candidate.args.is_empty()):
                                        block_refined = set_temp_type(block_refined, value_name, item_type)
                                        temp_types = set_temp_type_slot(temp_types, value_name, item_type)
                    string value_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, value_name))
                    if (value_type != item_type):
                        throw 'indexed row assignment requires ' + item_type + '; got ' + value_type
                if (base_type == 'int[]' || base_type == 'bool[]' || base_type == 'string[]' || (base_type.ends_with('[]') && record_type_exists(record_names, array_item_type(base_type)))):
                    string expected_item_type = array_item_type(base_type)
                    string actual_stored_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, current.args[2]))
                    if (actual_stored_type != expected_item_type):
                        throw 'array element assignment requires ' + expected_item_type + '; got ' + actual_stored_type
                if (base_type.starts_with('map<')):
                    string expected_value_type = normalize_llvm_type_name(map_value_type(base_type))
                    string value_name = current.args[2]
                    string actual_value_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, value_name))
                    bool empty_array_value = actual_value_type == '[]' && is_supported_empty_map_array_value_type(record_names, expected_value_type)
                    bool empty_map_value = actual_value_type == 'unknown' && expected_value_type.starts_with('map<')
                    if (empty_array_value || empty_map_value):
                        LinearInstruction candidate = lookup_instruction(block_refined, value_name)
                        if (candidate.lhs == value_name && candidate.kind == 'value' && candidate.args.is_empty()):
                            if ((empty_array_value && candidate.detail == 'array' && candidate.result_type == '[]') || (empty_map_value && candidate.detail == 'map' && candidate.result_type == 'unknown')):
                                block_refined = set_temp_type(block_refined, value_name, expected_value_type)
                                temp_types = set_temp_type_slot(temp_types, value_name, expected_value_type)
                                actual_value_type = expected_value_type
                    if (actual_value_type != expected_value_type):
                        throw 'map element assignment requires ' + expected_value_type + '; got ' + actual_value_type
        if (current.kind == 'assign_local'):
            string binding_type = lookup_binding_type(bindings, current.detail)
            if (current.args.length() == 1):
                string value_type = lookup_temp_type_slot(temp_types, current.args[0])
                validate_future_binding_type(current.detail, binding_type, value_type)
                if (value_type == 'unknown' && binding_type.starts_with('set<')):
                    block_refined = set_temp_type(block_refined, current.args[0], binding_type)
                    temp_types = set_temp_type_slot(temp_types, current.args[0], binding_type)
                if (value_type == 'unknown' && binding_type.starts_with('map<')):
                    LinearInstruction candidate = lookup_instruction_pair(block_refined, prior_instructions, current.args[0])
                    if (candidate.kind == 'value'):
                        if (candidate.detail == 'map'):
                            if (candidate.args.is_empty()):
                                block_refined = set_temp_type(block_refined, current.args[0], binding_type)
                                temp_types = set_temp_type_slot(temp_types, current.args[0], binding_type)
                string normalized_binding_type = normalize_llvm_type_name(binding_type)
                if (normalized_binding_type.starts_with('map<')):
                    RefineInstructionsResult contextual_map = contextualize_map_literal_rows(block_refined, temp_types, current.args[0], normalized_binding_type, record_names)
                    block_refined = contextual_map.instructions
                    temp_types = contextual_map.temp_types
                validate_map_binding_type(current.detail, binding_type, lookup_temp_type_slot(temp_types, current.args[0]))
                if (value_type == '[]' && binding_type.ends_with('[]')):
                    block_refined = set_temp_type(block_refined, current.args[0], binding_type)
                    temp_types = set_temp_type_slot(temp_types, current.args[0], binding_type)
                else if (is_untyped_array_shape(value_type) && binding_type.ends_with('[]')):
                    block_refined = set_temp_type(block_refined, current.args[0], binding_type)
                    temp_types = set_temp_type_slot(temp_types, current.args[0], binding_type)
                    string item_type = array_item_type(binding_type)
                    LinearInstruction candidate = lookup_instruction_pair(block_refined, prior_instructions, current.args[0])
                    if (candidate.lhs == current.args[0]):
                        for (string arg_name in candidate.args):
                            if (lookup_temp_type_slot(temp_types, arg_name) == '[]' && item_type.ends_with('[]')):
                                block_refined = set_temp_type(block_refined, arg_name, item_type)
                                temp_types = set_temp_type_slot(temp_types, arg_name, item_type)
        if (current.lhs != ''):
            temp_types = set_temp_type_slot(temp_types, current.lhs, current.result_type)
        block_refined.push(current)
        op_index += 1
    return RefineInstructionsResult(block_refined, temp_types)

BlockIR refine_block(BlockIR block, BindingIR[] globals, BindingIR[] params, BindingIR[] locals, FunctionSigIR[] functions, RecordFieldIR[] record_fields, string[] record_names, EnumTypeIR[] enum_types, LinearInstruction[] prior_instructions):
    string[] temp_types = collect_temp_type_slots(prior_instructions)
    reset_type_ir_lookup_caches()
    RefineInstructionsResult refined = refine_instructions(block.instructions, globals, params, locals, functions, record_fields, record_names, enum_types, prior_instructions, temp_types, false)
    return BlockIR(block.label.substring(0), refined.instructions, clone_terminator_ir(block.terminator))

GlobalDeclIR refine_global(GlobalDeclIR global_decl, BindingIR[] globals, FunctionSigIR[] functions, RecordFieldIR[] record_fields, string[] record_names, EnumTypeIR[] enum_types, LinearInstruction[] prior_instructions):
    BindingIR[] empty_params = []
    BindingIR[] empty_locals = []
    reset_type_ir_lookup_caches()
    string[] temp_types = collect_temp_type_slots(prior_instructions)
    RefineInstructionsResult refined_result = refine_instructions(global_decl.instructions, globals, empty_params, empty_locals, functions, record_fields, record_names, enum_types, prior_instructions, temp_types, false)
    LinearInstruction[] refined = refined_result.instructions
    BindingIR binding = ir_parse_binding_decl(strip_prefix(global_decl.header, 'global '))
    string value_type = lookup_temp_type(refined, global_decl.value_name)
    validate_future_binding_type(binding.name, binding.type_name, value_type)
    if (value_type == 'unknown' && binding.type_name.starts_with('set<')):
        refined = set_temp_type(refined, global_decl.value_name, binding.type_name)
    string declared_map_type = normalize_llvm_type_name(binding.type_name)
    if (value_type == 'unknown' && declared_map_type.starts_with('map<')):
        refined = set_temp_type(refined, global_decl.value_name, declared_map_type)
    if (declared_map_type.starts_with('map<')):
        RefineInstructionsResult contextual_map = contextualize_map_literal_rows(refined, refined_result.temp_types, global_decl.value_name, declared_map_type, record_names)
        refined = contextual_map.instructions
    validate_map_binding_type(binding.name, binding.type_name, lookup_temp_type(refined, global_decl.value_name))
    if (value_type == '[]' && binding.type_name.ends_with('[]')):
        refined = set_temp_type(refined, global_decl.value_name, binding.type_name)
    else if (is_untyped_array_shape(value_type) && binding.type_name.ends_with('[]')):
        refined = set_temp_type(refined, global_decl.value_name, binding.type_name)
    return GlobalDeclIR(global_decl.header.substring(0), refined, global_decl.value_name.substring(0))

# Arm stores precede the merge's type metadata. Resolve them only after all
# blocks have been refined, without reading either arm at runtime at the merge.
ParsedFunction resolve_conditional_bindings(ParsedFunction function_ir):
    BindingIR[] locals = clone_binding_irs(function_ir.locals)
    string[] temp_types = []
    for (BlockIR block in function_ir.blocks):
        for (LinearInstruction op in block.instructions):
            if (op.kind == 'value' && op.detail == 'ternary'):
                locals.push(BindingIR(op.result_type, 'choice.' + op.lhs))
                temp_types = set_temp_type_slot(temp_types, op.lhs, op.result_type)
    BlockIR[] blocks = []
    for (BlockIR block in function_ir.blocks):
        LinearInstruction[] instructions = []
        for (LinearInstruction op in block.instructions):
            if (op.kind == 'choice_set'):
                string result_type = lookup_temp_type_slot(temp_types, op.detail.substring(7))
                instructions.push(LinearInstruction('set', '', '', '', result_type + ' ' + op.detail, clone_instruction_args(op.args)))
            else if (op.kind == 'value' && op.detail == 'ternary'):
                instructions.push(LinearInstruction('value', op.lhs, op.result_type, op.ownership_mode, 'identifier', ['choice.' + op.lhs]))
            else:
                instructions.push(op)
        blocks.push(BlockIR(block.label, instructions, block.terminator))
    return ParsedFunction(function_ir.header, function_ir.name, function_ir.return_type, function_ir.params, locals, blocks)

ParsedFunction refine_function(ParsedFunction function_ir, BindingIR[] globals, FunctionSigIR[] functions, RecordFieldIR[] record_fields, string[] record_names, EnumTypeIR[] enum_types, bool regex_imported):
    string function_return_type = function_return_type_from_header(function_ir.header)
    string normalized_return_type = normalize_llvm_type_name(normalize_integer_enum_type_name(function_return_type, enum_types))
    BindingIR[] params = normalize_enum_bindings(function_ir.params, enum_types)
    BindingIR[] locals = normalize_enum_bindings(function_ir.locals, enum_types)
    BlockIR[] blocks = []
    LinearInstruction[] prior_instructions = []
    string[] temp_types = []
    reset_type_ir_lookup_caches()
    for (BlockIR block in function_ir.blocks):
        RefineInstructionsResult refined_result = refine_instructions(block.instructions, globals, params, locals, functions, record_fields, record_names, enum_types, prior_instructions, temp_types, regex_imported)
        BlockIR refined_block = BlockIR(block.label.substring(0), refined_result.instructions, clone_terminator_ir(block.terminator))
        temp_types = refined_result.temp_types
        if ((refined_block.terminator.kind == 'return' || refined_block.terminator.kind == 'return_owned') && refined_block.terminator.args.length() == 1 && normalized_return_type.ends_with('[]')):
            string return_temp = refined_block.terminator.args[0]
            if (is_untyped_array_shape(lookup_temp_type(refined_block.instructions, return_temp))):
                refined_block = BlockIR(refined_block.label, set_temp_type(refined_block.instructions, return_temp, normalized_return_type), refined_block.terminator)
        if ((refined_block.terminator.kind == 'return' || refined_block.terminator.kind == 'return_owned') && refined_block.terminator.args.length() == 1 && normalized_return_type.starts_with('map<')):
            string return_temp = refined_block.terminator.args[0]
            RefineInstructionsResult contextual_map = contextualize_map_literal_rows(refined_block.instructions, temp_types, return_temp, normalized_return_type, record_names)
            LinearInstruction[] return_instructions = contextual_map.instructions
            temp_types = contextual_map.temp_types
            LinearInstruction return_op = lookup_instruction(return_instructions, return_temp)
            if (return_op.lhs == return_temp):
                if (return_op.kind == 'value' && return_op.detail == 'map' && return_op.args.is_empty()):
                    return_instructions = set_temp_type(return_instructions, return_temp, normalized_return_type)
                    temp_types = set_temp_type_slot(temp_types, return_temp, normalized_return_type)
            refined_block = BlockIR(refined_block.label, return_instructions, refined_block.terminator)
        if ((refined_block.terminator.kind == 'return' || refined_block.terminator.kind == 'return_owned') && refined_block.terminator.args.length() == 1 && normalized_return_type == 'set<int>'):
            string return_temp = refined_block.terminator.args[0]
            LinearInstruction return_op = lookup_instruction(refined_block.instructions, return_temp)
            if (return_op.lhs == return_temp && return_op.kind == 'value' && return_op.detail == 'map' && return_op.args.is_empty()):
                LinearInstruction[] return_instructions = set_temp_type(refined_block.instructions, return_temp, normalized_return_type)
                temp_types = set_temp_type_slot(temp_types, return_temp, normalized_return_type)
                refined_block = BlockIR(refined_block.label, return_instructions, refined_block.terminator)
        blocks.push(refined_block)
        int block_op_index = 0
        while (block_op_index < refined_block.instructions.length()):
            prior_instructions.push(refined_block.instructions[block_op_index])
            block_op_index += 1
    string normalized_header = normalize_enum_function_header(function_ir.header, enum_types).substring(0)
    return resolve_conditional_bindings(ParsedFunction(normalized_header, function_name_from_header(normalized_header).substring(0), function_return_type_from_header(normalized_header).substring(0), clone_binding_irs(params), clone_binding_irs(locals), blocks))

ProgramIR refine_program_ir_with_regex(ProgramIR program, bool regex_imported):
    if (regex_imported):
        int helper_count = 0
        for (ParsedFunction function_ir : program.functions):
            if (function_ir.name == '__tb_regex_split'):
                helper_count += 1
        if (helper_count != 1):
            throw 'regex split internal helper must be declared exactly once'
    EnumTypeIR[] enum_types = collect_enum_types(program.enums)
    bool has_integer_enum = validate_integer_enum_declared_types(program, enum_types)
    bool has_string_enum_record_field = has_string_enum_record_fields(program.records, enum_types)
    bool normalize_records = has_integer_enum || has_string_enum_record_field
    RecordDeclIR[] records = []
    RecordFieldIR[] record_fields = collect_record_fields(program.records)
    string[] record_names = collect_declared_record_names(program.records)
    if (normalize_records):
        records = normalize_enum_record_fields(program.records, enum_types)
        record_fields = collect_record_fields(records)
        record_names = collect_declared_record_names(records)
    BindingIR[] globals = normalize_enum_bindings(collect_global_bindings(program.globals), enum_types)
    FunctionSigIR[] functions = collect_function_sigs(program.functions, enum_types)

    GlobalDeclIR[] refined_globals = []
    LinearInstruction[] prior_global_instructions = []
    string[] prior_global_temp_types = []
    for (GlobalDeclIR global_decl in program.globals):
        reset_type_ir_lookup_caches()
        BindingIR[] empty_params = []
        BindingIR[] empty_locals = []
        RefineInstructionsResult refined_global_result = refine_instructions(global_decl.instructions, globals, empty_params, empty_locals, functions, record_fields, record_names, enum_types, prior_global_instructions, prior_global_temp_types, regex_imported)
        BindingIR binding = ir_parse_binding_decl(strip_prefix(global_decl.header, 'global '))
        string normalized_global_type = normalize_integer_enum_type_name(binding.type_name, enum_types)
        string global_header = global_decl.header
        if (normalized_global_type != binding.type_name):
            global_header = 'global ' + normalized_global_type + ' ' + binding.name
            binding = BindingIR(normalized_global_type, binding.name)
        GlobalDeclIR refined_global = GlobalDeclIR(global_header.substring(0), refined_global_result.instructions, global_decl.value_name.substring(0))
        string value_type = lookup_temp_type(refined_global.instructions, global_decl.value_name)
        validate_future_binding_type(binding.name, binding.type_name, value_type)
        if (value_type == 'unknown' && binding.type_name.starts_with('set<')):
            refined_global = GlobalDeclIR(refined_global.header, set_temp_type(refined_global.instructions, global_decl.value_name, binding.type_name), refined_global.value_name)
        string declared_map_type = normalize_llvm_type_name(binding.type_name)
        if (value_type == 'unknown' && declared_map_type.starts_with('map<')):
            refined_global = GlobalDeclIR(refined_global.header, set_temp_type(refined_global.instructions, global_decl.value_name, declared_map_type), refined_global.value_name)
        if (declared_map_type.starts_with('map<')):
            RefineInstructionsResult contextual_map = contextualize_map_literal_rows(refined_global.instructions, refined_global_result.temp_types, global_decl.value_name, declared_map_type, record_names)
            refined_global = GlobalDeclIR(refined_global.header, contextual_map.instructions, refined_global.value_name)
            refined_global_result.temp_types = contextual_map.temp_types
        validate_map_binding_type(binding.name, binding.type_name, lookup_temp_type(refined_global.instructions, global_decl.value_name))
        prior_global_temp_types = refined_global_result.temp_types
        if (value_type == '[]' && normalized_global_type.ends_with('[]')):
            refined_global = GlobalDeclIR(refined_global.header, set_temp_type(refined_global.instructions, global_decl.value_name, normalized_global_type), refined_global.value_name)
        else if (is_untyped_array_shape(value_type) && normalized_global_type.ends_with('[]')):
            refined_global = GlobalDeclIR(refined_global.header, set_temp_type(refined_global.instructions, global_decl.value_name, normalized_global_type), refined_global.value_name)
        refined_globals.push(refined_global)
        int global_op_index = 0
        while (global_op_index < refined_global.instructions.length()):
            prior_global_instructions.push(refined_global.instructions[global_op_index])
            global_op_index += 1

    ParsedFunction[] refined_functions = []
    for (ParsedFunction function_ir in program.functions):
        refined_functions.push(refine_function(function_ir, globals, functions, record_fields, record_names, enum_types, regex_imported))
    if (normalize_records):
        return ProgramIR(program.imports, refined_globals, records, program.enums, refined_functions)
    return ProgramIR(program.imports, refined_globals, program.records, program.enums, refined_functions)

ProgramIR refine_program_ir(ProgramIR program):
    return refine_program_ir_with_regex(program, false)

ProgramIR typed_source_ir(string source):
    ProgramIR lowered = lower_source_ir(source)
    return refine_program_ir(lowered)

ProgramIR typed_tokens_ir(Token[] tokens):
    return refine_program_ir(lower_tokens_ir(tokens))
