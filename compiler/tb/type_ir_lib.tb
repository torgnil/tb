import ir_lib;
import lowerer;
import foreign_modules;

record FunctionSigIR(string name, string return_type, string[] param_types);
record RecordFieldIR(string record_name, string field_name, string field_type);
record EnumTypeIR(string name, string[] values, bool integer_backed);
record RefineInstructionsResult(LinearInstruction[] instructions, string[] temp_types);

int TYPE_IR_PROFILE_ACTIVE = 0;
int TYPE_IR_LOOKUP_BINDING_CALLS = 0;
int TYPE_IR_LOOKUP_BINDING_SCAN_TOTAL = 0;
int TYPE_IR_LOOKUP_FUNCTION_CALLS = 0;
int TYPE_IR_LOOKUP_FUNCTION_SCAN_TOTAL = 0;
int TYPE_IR_LOOKUP_RECORD_FIELD_CALLS = 0;
int TYPE_IR_LOOKUP_RECORD_FIELD_SCAN_TOTAL = 0;
int TYPE_IR_RECORD_TYPE_EXISTS_CALLS = 0;
int TYPE_IR_RECORD_TYPE_EXISTS_SCAN_TOTAL = 0;
int TYPE_IR_RECORD_CONSTRUCTOR_ARG_TYPES_CALLS = 0;
int TYPE_IR_RECORD_CONSTRUCTOR_ARG_TYPES_SCAN_TOTAL = 0;
int TYPE_IR_LOOKUP_TEMP_TYPE_CALLS = 0;
int TYPE_IR_LOOKUP_TEMP_TYPE_SCAN_TOTAL = 0;
int TYPE_IR_LOOKUP_INSTRUCTION_CALLS = 0;
int TYPE_IR_LOOKUP_INSTRUCTION_SCAN_TOTAL = 0;
int TYPE_IR_LOOKUP_INSTRUCTION_PAIR_CALLS = 0;
int TYPE_IR_CLONE_INSTRUCTION_ARGS_CALLS = 0;
int TYPE_IR_CLONE_INSTRUCTION_ARGS_ITEMS = 0;
int TYPE_IR_CLONE_LINEAR_INSTRUCTION_CALLS = 0;
int TYPE_IR_CLONE_LINEAR_INSTRUCTIONS_ITEMS = 0;
string[] TYPE_IR_FUNCTION_TYPE_CACHE_NAMES = [];
string[] TYPE_IR_FUNCTION_TYPE_CACHE_VALUES = [];
string[] TYPE_IR_BINDING_TYPE_CACHE_NAMES = [];
string[] TYPE_IR_BINDING_TYPE_CACHE_VALUES = [];
string[] TYPE_IR_FIELD_TYPE_CACHE_KEYS = [];
string[] TYPE_IR_FIELD_TYPE_CACHE_VALUES = [];

void reset_type_ir_profile_stats():
    TYPE_IR_PROFILE_ACTIVE = 1
    TYPE_IR_LOOKUP_BINDING_CALLS = 0
    TYPE_IR_LOOKUP_BINDING_SCAN_TOTAL = 0
    TYPE_IR_LOOKUP_FUNCTION_CALLS = 0
    TYPE_IR_LOOKUP_FUNCTION_SCAN_TOTAL = 0
    TYPE_IR_LOOKUP_RECORD_FIELD_CALLS = 0
    TYPE_IR_LOOKUP_RECORD_FIELD_SCAN_TOTAL = 0
    TYPE_IR_RECORD_TYPE_EXISTS_CALLS = 0
    TYPE_IR_RECORD_TYPE_EXISTS_SCAN_TOTAL = 0
    TYPE_IR_RECORD_CONSTRUCTOR_ARG_TYPES_CALLS = 0
    TYPE_IR_RECORD_CONSTRUCTOR_ARG_TYPES_SCAN_TOTAL = 0
    TYPE_IR_LOOKUP_TEMP_TYPE_CALLS = 0
    TYPE_IR_LOOKUP_TEMP_TYPE_SCAN_TOTAL = 0
    TYPE_IR_LOOKUP_INSTRUCTION_CALLS = 0
    TYPE_IR_LOOKUP_INSTRUCTION_SCAN_TOTAL = 0
    TYPE_IR_LOOKUP_INSTRUCTION_PAIR_CALLS = 0
    TYPE_IR_CLONE_INSTRUCTION_ARGS_CALLS = 0
    TYPE_IR_CLONE_INSTRUCTION_ARGS_ITEMS = 0
    TYPE_IR_CLONE_LINEAR_INSTRUCTION_CALLS = 0
    TYPE_IR_CLONE_LINEAR_INSTRUCTIONS_ITEMS = 0

string type_ir_profile_report():
    string lines = 'lookup_binding_calls=' + TYPE_IR_LOOKUP_BINDING_CALLS.to_string()
    lines += '\nlookup_binding_scan_total=' + TYPE_IR_LOOKUP_BINDING_SCAN_TOTAL.to_string()
    lines += '\nlookup_function_calls=' + TYPE_IR_LOOKUP_FUNCTION_CALLS.to_string()
    lines += '\nlookup_function_scan_total=' + TYPE_IR_LOOKUP_FUNCTION_SCAN_TOTAL.to_string()
    lines += '\nlookup_record_field_calls=' + TYPE_IR_LOOKUP_RECORD_FIELD_CALLS.to_string()
    lines += '\nlookup_record_field_scan_total=' + TYPE_IR_LOOKUP_RECORD_FIELD_SCAN_TOTAL.to_string()
    lines += '\nrecord_type_exists_calls=' + TYPE_IR_RECORD_TYPE_EXISTS_CALLS.to_string()
    lines += '\nrecord_type_exists_scan_total=' + TYPE_IR_RECORD_TYPE_EXISTS_SCAN_TOTAL.to_string()
    lines += '\nrecord_constructor_arg_types_calls=' + TYPE_IR_RECORD_CONSTRUCTOR_ARG_TYPES_CALLS.to_string()
    lines += '\nrecord_constructor_arg_types_scan_total=' + TYPE_IR_RECORD_CONSTRUCTOR_ARG_TYPES_SCAN_TOTAL.to_string()
    lines += '\nlookup_temp_type_calls=' + TYPE_IR_LOOKUP_TEMP_TYPE_CALLS.to_string()
    lines += '\nlookup_temp_type_scan_total=' + TYPE_IR_LOOKUP_TEMP_TYPE_SCAN_TOTAL.to_string()
    lines += '\nlookup_instruction_calls=' + TYPE_IR_LOOKUP_INSTRUCTION_CALLS.to_string()
    lines += '\nlookup_instruction_scan_total=' + TYPE_IR_LOOKUP_INSTRUCTION_SCAN_TOTAL.to_string()
    lines += '\nlookup_instruction_pair_calls=' + TYPE_IR_LOOKUP_INSTRUCTION_PAIR_CALLS.to_string()
    lines += '\nclone_instruction_args_calls=' + TYPE_IR_CLONE_INSTRUCTION_ARGS_CALLS.to_string()
    lines += '\nclone_instruction_args_items=' + TYPE_IR_CLONE_INSTRUCTION_ARGS_ITEMS.to_string()
    lines += '\nclone_linear_instruction_calls=' + TYPE_IR_CLONE_LINEAR_INSTRUCTION_CALLS.to_string()
    lines += '\nclone_linear_instructions_items=' + TYPE_IR_CLONE_LINEAR_INSTRUCTIONS_ITEMS.to_string()
    return lines

void reset_type_ir_lookup_caches():
    TYPE_IR_FUNCTION_TYPE_CACHE_NAMES = []
    TYPE_IR_FUNCTION_TYPE_CACHE_VALUES = []
    TYPE_IR_BINDING_TYPE_CACHE_NAMES = []
    TYPE_IR_BINDING_TYPE_CACHE_VALUES = []
    TYPE_IR_FIELD_TYPE_CACHE_KEYS = []
    TYPE_IR_FIELD_TYPE_CACHE_VALUES = []

string strip_prefix(string value, string prefix):
    if (value.starts_with(prefix)):
        return value.substring(prefix.length())
    return value

string strip_cached_prefix(string header):
    return strip_prefix(header, 'cached ')

string function_name_from_header(string header):
    string signature = strip_prefix(strip_cached_prefix(header), 'func ')
    int split = ir_last_space_index(signature)
    if (split < 0):
        return signature
    return signature.substring(split + 1)

string function_return_type_from_header(string header):
    string signature = strip_prefix(strip_cached_prefix(header), 'func ')
    int split = ir_last_space_index(signature)
    if (split < 0):
        return ''
    return signature.substring(0, split)

string global_type_from_header(string header):
    string binding = strip_prefix(header, 'global ')
    return ir_parse_binding_decl(binding).type_name

bool is_thread_pool_type(string type_name):
    return type_name == 'thread_pool'

bool is_future_type(string type_name):
    return type_name.starts_with('future<') && type_name.ends_with('>')

string future_value_type(string type_name):
    if (is_future_type(type_name)):
        return type_name.substring(7, type_name.length() - 1)
    return 'unknown'

bool is_thread_pool_submit_arg_type(string type_name):
    type_name = normalize_llvm_type_name(type_name)
    return type_name == 'int' || type_name == 'bool' || type_name == 'string' || type_name == 'int[]' || type_name == 'int[][]'

bool is_thread_pool_submit_return_type(string type_name):
    type_name = normalize_llvm_type_name(type_name)
    return type_name == 'int' || type_name == 'bool' || type_name == 'string' || type_name == 'int[]' || type_name == 'int[][]'

string record_name_from_type(string type_name):
    if (type_name == '' || type_name == 'int' || type_name == 'bool' || type_name == 'num' || type_name == 'string' || type_name == 'file' || is_thread_pool_type(type_name) || is_future_type(type_name)):
        return ''
    if (type_name.ends_with('[]')):
        return ''
    if (type_name.starts_with('set<') || type_name.starts_with('map<') || type_name.starts_with('prio_q<')):
        return ''
    return type_name

bool could_be_named_type(string name):
    if (name == ''):
        return false
    string first = name[0]
    return first == 'A' || first == 'B' || first == 'C' || first == 'D' || first == 'E' || first == 'F' || first == 'G' || first == 'H' || first == 'I' || first == 'J' || first == 'K' || first == 'L' || first == 'M' || first == 'N' || first == 'O' || first == 'P' || first == 'Q' || first == 'R' || first == 'S' || first == 'T' || first == 'U' || first == 'V' || first == 'W' || first == 'X' || first == 'Y' || first == 'Z'

string array_item_type(string type_name):
    if (type_name.ends_with('[]')):
        return type_name.substring(0, type_name.length() - 2)
    return 'unknown'

string set_item_type(string type_name):
    if (type_name.starts_with('set<') && type_name.ends_with('>')):
        return type_name.substring(4, type_name.length() - 1)
    return 'unknown'

string map_key_type(string type_name):
    if (!(type_name.starts_with('map<') && type_name.ends_with('>'))):
        return 'unknown'
    string inner = type_name.substring(4, type_name.length() - 1)
    int index = 0
    int depth = 0
    while (index < inner.length()):
        string ch = inner[index]
        if (ch == '<'):
            depth += 1
        else if (ch == '>'):
            depth -= 1
        else if (ch == ',' && depth == 0):
            return inner.substring(0, index).trim()
        index += 1
    return 'unknown'

string map_value_type(string type_name):
    if (!(type_name.starts_with('map<') && type_name.ends_with('>'))):
        return 'unknown'
    string inner = type_name.substring(4, type_name.length() - 1)
    int index = 0
    int depth = 0
    while (index < inner.length()):
        string ch = inner[index]
        if (ch == '<'):
            depth += 1
        else if (ch == '>'):
            depth -= 1
        else if (ch == ',' && depth == 0):
            return inner.substring(index + 1).trim()
        index += 1
    return 'unknown'

string prio_q_item_type(string type_name):
    if (type_name.starts_with('prio_q<') && type_name.ends_with('>')):
        return type_name.substring(7, type_name.length() - 1)
    return 'unknown'

bool is_untyped_array_shape(string type_name):
    if (type_name == ''):
        return false
    int current = 0
    while (current + 1 < type_name.length()):
        if (type_name[current] != '[' || type_name[current + 1] != ']'):
            return false
        current += 2
    return current == type_name.length()

bool is_supported_call_array_type(string type_name):
    string normalized_type = normalize_llvm_type_name(type_name)
    return normalized_type == 'int[]' || normalized_type == 'bool[]' || normalized_type == 'string[]' || normalized_type == 'int[][]' || normalized_type == 'string[][]'

bool can_contextualize_call_array_literal(LinearInstruction[] instructions, string[] temp_types, string array_name, string expected_type):
    string normalized_expected_type = normalize_llvm_type_name(expected_type)
    if (!is_supported_call_array_type(normalized_expected_type)):
        return false
    string actual_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, array_name))
    if (actual_type == normalized_expected_type):
        return true
    if (!is_untyped_array_shape(actual_type)):
        return false
    LinearInstruction array_op = lookup_instruction(instructions, array_name)
    if (array_op.lhs != array_name || array_op.kind != 'value' || array_op.detail != 'array'):
        return false
    string expected_item_type = array_item_type(normalized_expected_type)
    if (!expected_item_type.ends_with('[]')):
        return actual_type == normalized_expected_type || array_op.args.is_empty()
    for (string row_name in array_op.args):
        string row_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, row_name))
        if (row_type == expected_item_type):
            continue
        if (!is_untyped_array_shape(row_type)):
            return false
        if (!can_contextualize_call_array_literal(instructions, temp_types, row_name, expected_item_type)):
            return false
    return true

RefineInstructionsResult contextualize_call_array_literal(LinearInstruction[] instructions, string[] temp_types, string array_name, string expected_type):
    string normalized_expected_type = normalize_llvm_type_name(expected_type)
    string actual_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, array_name))
    if (!is_untyped_array_shape(actual_type)):
        return RefineInstructionsResult(instructions, temp_types)
    if (!can_contextualize_call_array_literal(instructions, temp_types, array_name, normalized_expected_type)):
        return RefineInstructionsResult(instructions, temp_types)
    LinearInstruction array_op = lookup_instruction(instructions, array_name)
    string expected_item_type = array_item_type(normalized_expected_type)
    if (expected_item_type.ends_with('[]')):
        for (string row_name in array_op.args):
            string row_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, row_name))
            if (row_type != expected_item_type):
                RefineInstructionsResult contextual_row = contextualize_call_array_literal(instructions, temp_types, row_name, expected_item_type)
                instructions = contextual_row.instructions
                temp_types = contextual_row.temp_types
    if (actual_type != normalized_expected_type):
        instructions = set_temp_type(instructions, array_name, normalized_expected_type)
        temp_types = set_temp_type_slot(temp_types, array_name, normalized_expected_type)
    return RefineInstructionsResult(instructions, temp_types)

bool is_builtin_ufcs_array_context_name(string method_name):
    # Conservative eligibility check, not the compiler's authoritative dispatch resolver.
    FunctionSigIR[] empty_functions = []
    if (infer_call_type(method_name, empty_functions) != 'unknown'):
        return true
    if (infer_method_call_type(method_name, 'unknown', empty_functions) != 'unknown'):
        return true
    return method_name == 'abs' || method_name == 'add' || method_name == 'await' || method_name == 'char_at' || method_name == 'clear' || method_name == 'contains' || method_name == 'copy' || method_name == 'create_prio_q' || method_name == 'ends_with' || method_name == 'ends_with_at' || method_name == 'fill' || method_name == 'hash' || method_name == 'index_of' || method_name == 'insert' || method_name == 'is_alnum' || method_name == 'is_alpha' || method_name == 'is_digit' || method_name == 'is_done' || method_name == 'is_empty' || method_name == 'is_space' || method_name == 'is_whitespace' || method_name == 'join' || method_name == 'keys' || method_name == 'last' || method_name == 'max' || method_name == 'min' || method_name == 'pop' || method_name == 'print' || method_name == 'push' || method_name == 'remove_at' || method_name == 'replace' || method_name == 'sort' || method_name == 'starts_with' || method_name == 'starts_with_at' || method_name == 'submit' || method_name == 'sum' || method_name == 'to_int' || method_name == 'union' || method_name == 'values' || method_name == 'wait_for' || method_name == 'write_all'

bool is_same_known_type(string left, string right):
    return left != '' && left != 'unknown' && left == right

string lookup_binding_type(BindingIR[] bindings, string name):
    if (TYPE_IR_PROFILE_ACTIVE != 0):
        TYPE_IR_LOOKUP_BINDING_CALLS += 1
    int name_length = name.length()
    int index = bindings.length() - 1
    while (index >= 0):
        if (TYPE_IR_PROFILE_ACTIVE != 0):
            TYPE_IR_LOOKUP_BINDING_SCAN_TOTAL += 1
        BindingIR binding = bindings[index]
        if (binding.name.length() == name_length && binding.name == name):
            return binding.type_name.substring(0)
        index -= 1
    return 'unknown'

string lookup_function_return_type(FunctionSigIR[] functions, string name):
    if (TYPE_IR_PROFILE_ACTIVE != 0):
        TYPE_IR_LOOKUP_FUNCTION_CALLS += 1
    int name_length = name.length()
    int index = functions.length() - 1
    while (index >= 0):
        if (TYPE_IR_PROFILE_ACTIVE != 0):
            TYPE_IR_LOOKUP_FUNCTION_SCAN_TOTAL += 1
        FunctionSigIR function_sig = functions[index]
        if (function_sig.name.length() == name_length && function_sig.name == name):
            return function_sig.return_type.substring(0)
        index -= 1
    return 'unknown'

FunctionSigIR lookup_function_sig(FunctionSigIR[] functions, string name):
    int name_length = name.length()
    int index = functions.length() - 1
    while (index >= 0):
        FunctionSigIR function_sig = functions[index]
        if (function_sig.name.length() == name_length && function_sig.name == name):
            return FunctionSigIR(function_sig.name.substring(0), function_sig.return_type.substring(0), clone_string_array(function_sig.param_types))
        index -= 1
    return FunctionSigIR('', 'unknown', [])

string lookup_record_field_type(RecordFieldIR[] fields, string record_name, string field_name):
    if (TYPE_IR_PROFILE_ACTIVE != 0):
        TYPE_IR_LOOKUP_RECORD_FIELD_CALLS += 1
    int record_name_length = record_name.length()
    int field_name_length = field_name.length()
    int index = fields.length() - 1
    while (index >= 0):
        if (TYPE_IR_PROFILE_ACTIVE != 0):
            TYPE_IR_LOOKUP_RECORD_FIELD_SCAN_TOTAL += 1
        RecordFieldIR field = fields[index]
        if (field.record_name.length() == record_name_length && field.field_name.length() == field_name_length && field.record_name == record_name && field.field_name == field_name):
            return field.field_type.substring(0)
        index -= 1
    return 'unknown'

bool record_type_exists(string[] record_names, string record_name):
    if (TYPE_IR_PROFILE_ACTIVE != 0):
        TYPE_IR_RECORD_TYPE_EXISTS_CALLS += 1
    int record_name_length = record_name.length()
    int index = record_names.length() - 1
    while (index >= 0):
        if (TYPE_IR_PROFILE_ACTIVE != 0):
            TYPE_IR_RECORD_TYPE_EXISTS_SCAN_TOTAL += 1
        if (record_names[index].length() == record_name_length && record_names[index] == record_name):
            return true
        index -= 1
    return false

bool is_supported_empty_map_array_value_type(string[] record_names, string type_name):
    type_name = normalize_llvm_type_name(type_name)
    if (type_name == 'int[]' || type_name == 'bool[]' || type_name == 'string[]'):
        return true
    if (!type_name.ends_with('[]')):
        return false
    return record_type_exists(record_names, array_item_type(type_name))

bool is_checked_record_field_assignment_type(string[] record_names, string type_name):
    type_name = normalize_llvm_type_name(type_name)
    if (type_name == 'int' || type_name == 'bool' || type_name == 'num' || type_name == 'string'):
        return true
    if (type_name == 'int[]' || type_name == 'bool[]' || type_name == 'string[]' || type_name == 'int[][]' || type_name == 'string[][]'):
        return true
    if (type_name.starts_with('map<') && type_name.ends_with('>')):
        return true
    string record_name = record_name_from_type(type_name)
    return record_name != '' && record_type_exists(record_names, record_name)

string[] record_constructor_arg_types(RecordFieldIR[] fields, string record_name):
    if (TYPE_IR_PROFILE_ACTIVE != 0):
        TYPE_IR_RECORD_CONSTRUCTOR_ARG_TYPES_CALLS += 1
    string[] result = []
    for (RecordFieldIR field in fields):
        if (TYPE_IR_PROFILE_ACTIVE != 0):
            TYPE_IR_RECORD_CONSTRUCTOR_ARG_TYPES_SCAN_TOTAL += 1
        if (field.record_name == record_name):
            result.push(field.field_type.substring(0))
    return result

BindingIR[] set_binding_type(BindingIR[] bindings, string name, string type_name):
    int index = 0
    while (index < bindings.length()):
        if (bindings[index].name == name):
            bindings[index] = BindingIR(type_name, name)
            return bindings
        index += 1
    if (!(name == '')):
        bindings.push(BindingIR(type_name, name))
    return bindings

LinearInstruction[] set_temp_type(LinearInstruction[] instructions, string name, string type_name):
    int target_index = -1
    int scan_index = instructions.length() - 1
    while (scan_index >= 0):
        LinearInstruction op = clone_linear_instruction(instructions[scan_index])
        if (target_index < 0 && op.lhs == name):
            target_index = scan_index
        scan_index -= 1
    if (target_index < 0):
        return instructions
    LinearInstruction[] rewritten = []
    int index = 0
    while (index < instructions.length()):
        LinearInstruction op = clone_linear_instruction(instructions[index])
        if (index == target_index):
            rewritten.push(LinearInstruction(op.kind.substring(0), op.lhs.substring(0), type_name.substring(0), refine_ownership_mode(op, type_name).substring(0), op.detail.substring(0), clone_instruction_args(op.args)))
        else:
            rewritten.push(op)
        index += 1
    return rewritten

FunctionSigIR[] collect_function_sigs(ParsedFunction[] functions, EnumTypeIR[] enum_types):
    FunctionSigIR[] result = []
    for (ParsedFunction function_ir in functions):
        string[] param_types = []
        for (BindingIR param in function_ir.params):
            param_types.push(normalize_integer_enum_type_name(param.type_name, enum_types))
        string return_type = normalize_integer_enum_type_name(function_return_type_from_header(function_ir.header), enum_types)
        result.push(FunctionSigIR(function_name_from_header(function_ir.header), return_type, param_types))
    return result

string thread_pool_submit_result_type(FunctionSigIR[] functions, string function_name, int argument_count):
    FunctionSigIR function_sig = lookup_function_sig(functions, function_name)
    if (function_sig.name == ''):
        throw 'thread_pool.submit currently requires a top-level named function'
    if (argument_count == 0):
        if (function_sig.param_types.length() != 0):
            throw 'thread_pool.submit currently requires a function with signature T fn() or T fn(U) where T is int, bool, string, or int[] and U is int, bool, string, int[], or int[][]'
    else if (argument_count == 1):
        if (function_sig.param_types.length() != 1):
            throw 'thread_pool.submit currently requires a function with signature T fn() or T fn(U) where T is int, bool, string, or int[] and U is int, bool, string, int[], or int[][]'
        if (!is_thread_pool_submit_arg_type(function_sig.param_types[0])):
            throw 'thread_pool.submit currently requires a function with signature T fn() or T fn(U) where T is int, bool, string, or int[] and U is int, bool, string, int[], or int[][]'
    else:
        throw 'thread_pool.submit currently requires a function name with zero or one argument'
    if (!is_thread_pool_submit_return_type(function_sig.return_type)):
        throw 'thread_pool.submit currently requires a function with signature T fn() or T fn(U) where T is int, bool, string, int[], or int[][] and U is int, bool, string, int[], or int[][]'
    return 'future<' + function_sig.return_type + '>'

RecordFieldIR[] collect_record_fields(RecordDeclIR[] records):
    RecordFieldIR[] result = []
    for (RecordDeclIR record_decl in records):
        string record_name = strip_prefix(record_decl.header, 'record ')
        for (string field in record_decl.fields):
            BindingIR binding = ir_parse_binding_decl(strip_prefix(field, 'field '))
            result.push(RecordFieldIR(record_name, binding.name, binding.type_name))
    return result

string[] collect_declared_record_names(RecordDeclIR[] records):
    string[] result = []
    for (RecordDeclIR record_decl in records):
        result.push(strip_prefix(record_decl.header, 'record '))
    return result

EnumTypeIR[] collect_enum_types(EnumDeclIR[] enums):
    EnumTypeIR[] result = []
    for (EnumDeclIR enum_decl in enums):
        string enum_name = strip_prefix(enum_decl.header, 'enum ')
        string[] values = []
        for (string value in enum_decl.values):
            values.push(strip_prefix(value, 'value '))
        bool integer_backed = false
        if (!values.is_empty()):
            integer_backed = values[0].contains('=')
        result.push(EnumTypeIR(enum_name, values, integer_backed))
    return result

string enum_value_name(string value):
    int separator = value.index_of('=')
    if (separator >= 0):
        return value.substring(0, separator)
    return value

bool integer_enum_exists(EnumTypeIR[] enums, string name):
    for (EnumTypeIR enum_type : enums):
        if (enum_type.name == name):
            return enum_type.integer_backed
    return false

string integer_enum_value(EnumTypeIR[] enums, string enum_name, string value_name):
    for (EnumTypeIR enum_type : enums):
        if (enum_type.name == enum_name && enum_type.integer_backed):
            for (string value : enum_type.values):
                if (enum_value_name(value) == value_name):
                    return value.substring(value.index_of('=') + 1)
    return ''

bool enum_name_exists(EnumTypeIR[] enums, string name):
    int name_length = name.length()
    int index = enums.length() - 1
    while (index >= 0):
        if (enums[index].name.length() == name_length && enums[index].name == name):
            return true
        index -= 1
    return false

bool enum_has_value(EnumTypeIR[] enums, string enum_name, string value_name):
    int enum_name_length = enum_name.length()
    int value_name_length = value_name.length()
    int index = enums.length() - 1
    while (index >= 0):
        EnumTypeIR enum_type = enums[index]
        if (enum_type.name.length() == enum_name_length && enum_type.name == enum_name):
            for (string value in enum_type.values):
                string member_name = enum_value_name(value)
                if (member_name.length() == value_name_length && member_name == value_name):
                    return true
            return false
        index -= 1
    return false

string normalize_enum_type_name(string type_name, EnumTypeIR[] enums):
    string qualifier = ''
    string base_type = type_name
    if (type_name.starts_with('const ')):
        qualifier = 'const '
        base_type = type_name.substring(6)
    string integer_type = normalize_integer_enum_type_name(base_type, enums)
    if (integer_type != base_type):
        return qualifier + integer_type
    if (enum_name_exists(enums, base_type)):
        return qualifier + 'string'
    return type_name

void validate_range_bound_type(string bound, string[] temp_types, EnumTypeIR[] enum_types):
    string bound_type = normalize_enum_type_name(normalize_llvm_type_name(lookup_temp_type_slot(temp_types, bound)), enum_types)
    if (bound_type != 'int' && bound_type != 'unknown'):
        throw 'range requires integer bounds; got ' + bound_type

# Normalize integer enums in native map types without changing other
# composite types. Nested maps may contain scalar enums and one-dimensional
# enum arrays as values.
string normalize_integer_enum_map_key_type(string type_name, EnumTypeIR[] enums):
    if (integer_enum_exists(enums, type_name)):
        return 'int'
    return type_name

string normalize_integer_enum_map_value_type(string type_name, EnumTypeIR[] enums):
    if (integer_enum_exists(enums, type_name)):
        return 'int'
    if (type_name.ends_with('[]') && integer_enum_exists(enums, array_item_type(type_name))):
        return 'int[]'
    if (type_name.starts_with('map<') && type_name.ends_with('>')):
        return normalize_integer_enum_map_type_name(type_name, enums)
    return type_name

string normalize_integer_enum_map_type_name(string type_name, EnumTypeIR[] enums):
    string key_type = map_key_type(type_name)
    string value_type = map_value_type(type_name)
    if (key_type == 'unknown' || value_type == 'unknown'):
        return type_name
    string normalized_key_type = normalize_integer_enum_map_key_type(key_type, enums)
    string normalized_value_type = normalize_integer_enum_map_value_type(value_type, enums)
    return 'map<' + normalized_key_type + ', ' + normalized_value_type + '>'

string normalize_integer_enum_type_name(string type_name, EnumTypeIR[] enums):
    string qualifier = ''
    string base_type = type_name
    if (type_name.starts_with('const ')):
        qualifier = 'const '
        base_type = type_name.substring(6)
    if (base_type.starts_with('map<') && base_type.ends_with('>')):
        return qualifier + normalize_integer_enum_map_type_name(base_type, enums)
    if (integer_enum_exists(enums, base_type)):
        return qualifier + 'int'
    if (base_type.ends_with('[]') && integer_enum_exists(enums, array_item_type(base_type))):
        return qualifier + 'int[]'
    return qualifier + base_type

# Composite enum declarations need separate array, map and record layout work.
# Scan complete identifier tokens, so an unrelated longer type name is allowed.
bool type_contains_integer_enum(string type_name, EnumTypeIR[] enums):
    int index = 0
    while (index < type_name.length()):
        string character = type_name[index]
        if (character.is_alnum() || character == '_'):
            int start = index
            while (index < type_name.length()):
                string item = type_name[index]
                if (!(item.is_alnum() || item == '_')):
                    break
                index += 1
            if (integer_enum_exists(enums, type_name.substring(start, index))):
                return true
        else:
            index += 1
    return false

bool integer_enum_map_component_is_supported(string type_name, EnumTypeIR[] enums):
    if (!type_contains_integer_enum(type_name, enums)):
        return true
    if (integer_enum_exists(enums, type_name)):
        return true
    if (type_name.starts_with('map<') && type_name.ends_with('>')):
        return integer_enum_map_type_is_supported(type_name, enums)
    return false

bool integer_enum_map_value_is_supported(string type_name, EnumTypeIR[] enums):
    if (!type_contains_integer_enum(type_name, enums)):
        return true
    if (integer_enum_exists(enums, type_name)):
        return true
    if (type_name.ends_with('[]') && integer_enum_exists(enums, array_item_type(type_name))):
        return true
    if (type_name.starts_with('map<') && type_name.ends_with('>')):
        return integer_enum_map_type_is_supported(type_name, enums)
    return false

bool integer_enum_map_type_is_supported(string type_name, EnumTypeIR[] enums):
    string key_type = map_key_type(type_name)
    string value_type = map_value_type(type_name)
    if (key_type == 'unknown' || value_type == 'unknown'):
        return false
    return integer_enum_map_component_is_supported(key_type, enums) && integer_enum_map_value_is_supported(value_type, enums)

void validate_integer_enum_declared_type(string type_name, EnumTypeIR[] enums):
    string base_type = type_name
    if (base_type.starts_with('const ')):
        base_type = base_type.substring(6)
    if (integer_enum_exists(enums, base_type)):
        return
    if (base_type.ends_with('[]') && integer_enum_exists(enums, array_item_type(base_type))):
        return
    if (type_contains_integer_enum(base_type, enums)):
        if (base_type.starts_with('map<') && base_type.ends_with('>') && integer_enum_map_type_is_supported(base_type, enums)):
            return
        throw 'integer enum composite types are not yet supported: ' + type_name

bool has_string_enum_record_fields(RecordDeclIR[] records, EnumTypeIR[] enums):
    if (enums.is_empty()):
        return false
    for (RecordDeclIR record_decl : records):
        for (string field : record_decl.fields):
            BindingIR binding = ir_parse_binding_decl(strip_prefix(field, 'field '))
            string field_type = binding.type_name
            if (field_type.starts_with('const ')):
                field_type = field_type.substring(6)
            if (enum_name_exists(enums, field_type) && !integer_enum_exists(enums, field_type)):
                return true
    return false

RecordDeclIR[] normalize_enum_record_fields(RecordDeclIR[] records, EnumTypeIR[] enums):
    RecordDeclIR[] result = []
    for (RecordDeclIR record_decl : records):
        string[] fields = []
        for (string field : record_decl.fields):
            BindingIR binding = ir_parse_binding_decl(strip_prefix(field, 'field '))
            string type_name = normalize_enum_type_name(binding.type_name, enums)
            fields.push('field ' + type_name + ' ' + binding.name)
        result.push(RecordDeclIR(record_decl.header, fields))
    return result

bool validate_integer_enum_declared_types(ProgramIR program, EnumTypeIR[] enums):
    bool has_integer_enum = false
    for (EnumTypeIR enum_type : enums):
        if (enum_type.integer_backed):
            has_integer_enum = true
            break
    if (!has_integer_enum):
        return false
    for (GlobalDeclIR global_decl : program.globals):
        BindingIR binding = ir_parse_binding_decl(strip_prefix(global_decl.header, 'global '))
        validate_integer_enum_declared_type(binding.type_name, enums)
    for (RecordDeclIR record_decl : program.records):
        for (string field : record_decl.fields):
            BindingIR binding = ir_parse_binding_decl(strip_prefix(field, 'field '))
            validate_integer_enum_declared_type(binding.type_name, enums)
    for (ParsedFunction function_ir : program.functions):
        validate_integer_enum_declared_type(function_ir.return_type, enums)
        for (BindingIR param : function_ir.params):
            validate_integer_enum_declared_type(param.type_name, enums)
        for (BindingIR local : function_ir.locals):
            validate_integer_enum_declared_type(local.type_name, enums)
    return true

BindingIR normalize_enum_binding(BindingIR binding, EnumTypeIR[] enums):
    return BindingIR(normalize_enum_type_name(binding.type_name, enums), binding.name)

BindingIR[] normalize_enum_bindings(BindingIR[] bindings, EnumTypeIR[] enums):
    BindingIR[] result = []
    for (BindingIR binding in bindings):
        result.push(normalize_enum_binding(binding, enums))
    return result

string normalize_enum_function_header(string header, EnumTypeIR[] enums):
    string prefix = 'func '
    if (header.starts_with('cached func ')):
        prefix = 'cached func '
    string return_type = function_return_type_from_header(header)
    string function_name = function_name_from_header(header)
    return prefix + normalize_enum_type_name(return_type, enums) + ' ' + function_name

BindingIR[] collect_global_bindings(GlobalDeclIR[] globals):
    BindingIR[] result = []
    for (GlobalDeclIR global_decl in globals):
        BindingIR binding = ir_parse_binding_decl(strip_prefix(global_decl.header, 'global '))
        result.push(BindingIR(binding.type_name, binding.name))
    return result

string infer_container_type(string[] item_types, string prefix, string suffix):
    if (item_types.is_empty()):
        return prefix + suffix
    string first = normalize_llvm_type_name(item_types[0])
    if (first == '' || first == 'unknown'):
        return prefix + suffix
    int index = 1
    while (index < item_types.length()):
        if (normalize_llvm_type_name(item_types[index]) != first):
            return prefix + suffix
        index += 1
    return prefix + first + suffix

string infer_map_literal_type(string[] entry_types):
    string[] key_types = []
    string[] value_types = []
    int index = 0
    while (index + 1 < entry_types.length()):
        key_types.push(entry_types[index])
        value_types.push(entry_types[index + 1])
        index += 2
    string key_type = infer_container_type(key_types, '', '')
    string value_type = infer_container_type(value_types, '', '')
    if (key_type == '' || value_type == '' || key_type == 'unknown' || value_type == 'unknown'):
        return 'unknown'
    return 'map<' + key_type + ', ' + value_type + '>'

RefineInstructionsResult contextualize_map_literal_rows(LinearInstruction[] instructions, string[] temp_types, string map_name, string expected_map_type, string[] record_names):
    string normalized_expected_type = normalize_llvm_type_name(expected_map_type)
    if (!normalized_expected_type.starts_with('map<') || !normalized_expected_type.ends_with('>')):
        return RefineInstructionsResult(instructions, temp_types)
    string key_type = normalize_llvm_type_name(map_key_type(normalized_expected_type))
    string row_type = normalize_llvm_type_name(map_value_type(normalized_expected_type))
    bool array_rows = is_supported_empty_map_array_value_type(record_names, row_type)
    bool map_rows = row_type.starts_with('map<') && row_type.ends_with('>')
    if ((key_type != 'int' && key_type != 'string') || (!array_rows && !map_rows)):
        return RefineInstructionsResult(instructions, temp_types)
    LinearInstruction map_op = lookup_instruction(instructions, map_name)
    if (map_op.lhs != map_name || map_op.kind != 'value' || map_op.detail != 'map' || map_op.args.is_empty()):
        return RefineInstructionsResult(instructions, temp_types)
    bool changed_row = false
    int index = 0
    while (index + 1 < map_op.args.length()):
        string row_name = map_op.args[index + 1]
        LinearInstruction row_op = lookup_instruction(instructions, row_name)
        string actual_row_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, row_name))
        bool empty_array_literal = array_rows && actual_row_type == '[]' && row_op.lhs == row_name && row_op.kind == 'value' && row_op.detail == 'array' && row_op.result_type == '[]' && row_op.args.is_empty()
        bool empty_map_literal = map_rows && actual_row_type == 'unknown' && row_op.lhs == row_name && row_op.kind == 'value' && row_op.detail == 'map' && row_op.result_type == 'unknown' && row_op.args.is_empty()
        if (empty_array_literal || empty_map_literal):
            changed_row = true
        index += 2
    if (!changed_row):
        return RefineInstructionsResult(instructions, temp_types)
    index = 0
    while (index + 1 < map_op.args.length()):
        string key_name = map_op.args[index]
        string row_name = map_op.args[index + 1]
        string actual_key_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, key_name))
        if (actual_key_type != key_type):
            throw 'map literal key requires ' + key_type + '; got ' + actual_key_type
        string actual_row_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, row_name))
        LinearInstruction row_op = lookup_instruction(instructions, row_name)
        bool empty_array_literal = array_rows && actual_row_type == '[]' && row_op.lhs == row_name && row_op.kind == 'value' && row_op.detail == 'array' && row_op.result_type == '[]' && row_op.args.is_empty()
        bool empty_map_literal = map_rows && actual_row_type == 'unknown' && row_op.lhs == row_name && row_op.kind == 'value' && row_op.detail == 'map' && row_op.result_type == 'unknown' && row_op.args.is_empty()
        bool empty_row_literal = empty_array_literal || empty_map_literal
        if (!empty_row_literal && actual_row_type != row_type):
            throw 'map literal value requires ' + row_type + '; got ' + actual_row_type
        index += 2
    index = 0
    while (index + 1 < map_op.args.length()):
        string row_name = map_op.args[index + 1]
        string actual_row_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, row_name))
        LinearInstruction row_op = lookup_instruction(instructions, row_name)
        bool empty_array_literal = array_rows && actual_row_type == '[]' && row_op.lhs == row_name && row_op.kind == 'value' && row_op.detail == 'array' && row_op.result_type == '[]' && row_op.args.is_empty()
        bool empty_map_literal = map_rows && actual_row_type == 'unknown' && row_op.lhs == row_name && row_op.kind == 'value' && row_op.detail == 'map' && row_op.result_type == 'unknown' && row_op.args.is_empty()
        if (empty_array_literal || empty_map_literal):
            instructions = set_temp_type(instructions, row_name, row_type)
            temp_types = set_temp_type_slot(temp_types, row_name, row_type)
        index += 2
    map_op = lookup_instruction(instructions, map_name)
    string[] entry_types = []
    for (string argument in map_op.args):
        entry_types.push(lookup_temp_type_slot(temp_types, argument))
    string inferred_type = infer_map_literal_type(entry_types)
    if (inferred_type != normalized_expected_type):
        throw 'map literal requires ' + normalized_expected_type + '; got ' + inferred_type
    instructions = set_temp_type(instructions, map_name, inferred_type)
    temp_types = set_temp_type_slot(temp_types, map_name, inferred_type)
    return RefineInstructionsResult(instructions, temp_types)

string[] instruction_result_types(LinearInstruction[] instructions):
    string[] result = []
    for (LinearInstruction op in instructions):
        result.push(op.result_type.substring(0))
    return result

string lookup_temp_type(LinearInstruction[] instructions, string name):
    if (TYPE_IR_PROFILE_ACTIVE != 0):
        TYPE_IR_LOOKUP_TEMP_TYPE_CALLS += 1
    int index = instructions.length() - 1
    while (index >= 0):
        if (TYPE_IR_PROFILE_ACTIVE != 0):
            TYPE_IR_LOOKUP_TEMP_TYPE_SCAN_TOTAL += 1
        LinearInstruction op = instructions[index]
        if (op.lhs == name):
            return op.result_type.substring(0)
        index -= 1
    return 'unknown'

bool digits_only(string value):
    int index = 0
    while (index < value.length()):
        string ch = value[index]
        if (!ch.is_digit()):
            return false
        index += 1
    return !value.is_empty()

int digit_char_to_int(string ch):
    if (ch == '0'):
        return 0
    if (ch == '1'):
        return 1
    if (ch == '2'):
        return 2
    if (ch == '3'):
        return 3
    if (ch == '4'):
        return 4
    if (ch == '5'):
        return 5
    if (ch == '6'):
        return 6
    if (ch == '7'):
        return 7
    if (ch == '8'):
        return 8
    if (ch == '9'):
        return 9
    return -1

int temp_slot_index(string name):
    if (name.length() < 2 || name[0] != 't'):
        return -1
    int index = 1
    int value = 0
    while (index < name.length()):
        int digit = digit_char_to_int(name[index])
        if (digit < 0):
            return -1
        value = value * 10 + digit
        index += 1
    return value

string[] set_temp_type_slot(string[] slots, string name, string type_name):
    int index = temp_slot_index(name)
    if (index < 0):
        return slots
    while (slots.length() <= index):
        slots.push('unknown')
    slots[index] = type_name
    return slots

string lookup_temp_type_slot(string[] slots, string name):
    int index = temp_slot_index(name)
    if (index < 0 || index >= slots.length()):
        return 'unknown'
    return slots[index]

int[] set_temp_instruction_slot(int[] slots, string name, int instruction_index):
    int index = temp_slot_index(name)
    if (index < 0):
        return slots
    while (slots.length() <= index):
        slots.push(-1)
    slots[index] = instruction_index
    return slots

int lookup_temp_instruction_slot(int[] slots, string name):
    int index = temp_slot_index(name)
    if (index < 0 || index >= slots.length()):
        return -1
    return slots[index]

int[] collect_temp_instruction_slots(LinearInstruction[] instructions):
    int[] slots = []
    int index = 0
    while (index < instructions.length()):
        LinearInstruction op = instructions[index]
        if (op.lhs != ''):
            slots = set_temp_instruction_slot(slots, op.lhs, index)
        index += 1
    return slots

string[] collect_temp_type_slots(LinearInstruction[] instructions):
    string[] slots = []
    for (LinearInstruction op in instructions):
        if (op.lhs != ''):
            slots = set_temp_type_slot(slots, op.lhs, op.result_type)
    return slots

LinearInstruction lookup_instruction(LinearInstruction[] instructions, string name):
    if (TYPE_IR_PROFILE_ACTIVE != 0):
        TYPE_IR_LOOKUP_INSTRUCTION_CALLS += 1
    int index = instructions.length() - 1
    while (index >= 0):
        if (TYPE_IR_PROFILE_ACTIVE != 0):
            TYPE_IR_LOOKUP_INSTRUCTION_SCAN_TOTAL += 1
        if (instructions[index].lhs == name):
            return clone_linear_instruction(instructions[index])
        index -= 1
    return LinearInstruction('', '', '', '', '', [])

LinearInstruction lookup_instruction_pair(LinearInstruction[] first, LinearInstruction[] second, string name):
    if (TYPE_IR_PROFILE_ACTIVE != 0):
        TYPE_IR_LOOKUP_INSTRUCTION_PAIR_CALLS += 1
    LinearInstruction found = lookup_instruction(first, name)
    if (found.lhs != ''):
        return found
    return lookup_instruction(second, name)

LinearInstruction lookup_instruction_at_slot(LinearInstruction[] instructions, int[] instruction_slots, string name):
    int instruction_index = lookup_temp_instruction_slot(instruction_slots, name)
    if (instruction_index >= 0 && instruction_index < instructions.length()):
        return clone_linear_instruction(instructions[instruction_index])
    return LinearInstruction('', '', '', '', '', [])

LinearInstruction lookup_instruction_pair_at_slots(LinearInstruction[] first, int[] first_slots, LinearInstruction[] second, int[] second_slots, string name):
    LinearInstruction found = lookup_instruction_at_slot(first, first_slots, name)
    if (found.lhs != ''):
        return found
    return lookup_instruction_at_slot(second, second_slots, name)

LinearInstruction[] set_temp_type_at_slot(LinearInstruction[] instructions, int[] instruction_slots, string name, string type_name):
    int instruction_index = lookup_temp_instruction_slot(instruction_slots, name)
    if (instruction_index >= 0 && instruction_index < instructions.length()):
        LinearInstruction op = instructions[instruction_index]
        instructions[instruction_index] = LinearInstruction(op.kind.substring(0), op.lhs.substring(0), type_name.substring(0), refine_ownership_mode(op, type_name).substring(0), op.detail.substring(0), clone_instruction_args(op.args))
        return instructions
    return set_temp_type(instructions, name, type_name)

string infer_binary_type(string op_name, string left_type, string right_type):
    if (op_name == '+' && (left_type == 'string' || right_type == 'string')):
        return 'string'
    if (op_name == '+' && left_type == 'int' && right_type == 'int'):
        return 'int'
    if (op_name == '+' && (left_type == 'num' || right_type == 'num') && ((left_type == 'int' || left_type == 'num') && (right_type == 'int' || right_type == 'num'))):
        return 'num'
    if (op_name == '==' || op_name == '!=' || op_name == '<' || op_name == '>' || op_name == '<=' || op_name == '>=' || op_name == '&&' || op_name == '||' || op_name == 'and' || op_name == 'or' || op_name == 'in' || op_name == 'not in'):
        return 'bool'
    if ((op_name == '&' || op_name == '|' || op_name == '^' || op_name == '<<' || op_name == '>>') && left_type == 'int' && right_type == 'int'):
        return 'int'
    if ((op_name == '-' || op_name == '*' || op_name == '/' || op_name == '%') && left_type == 'int' && right_type == 'int'):
        return 'int'
    if ((op_name == '+' || op_name == '-' || op_name == '*' || op_name == '/') && (left_type == 'num' || right_type == 'num') && ((left_type == 'int' || left_type == 'num') && (right_type == 'int' || right_type == 'num'))):
        return 'num'
    return 'unknown'

string infer_unary_type(string op_name, string operand_type):
    if (op_name == '!' || op_name == 'not'):
        return 'bool'
    if (op_name == '-' && operand_type == 'int'):
        return 'int'
    if (op_name == '-' && operand_type == 'num'):
        return 'num'
    return 'unknown'

string infer_call_type(string name, FunctionSigIR[] functions):
    string foreign_return_type = foreign_function_return_type(name)
    if (foreign_return_type != 'unknown'):
        return foreign_return_type
    if (name == 'thread_pool'):
        return 'thread_pool'
    if (name == 'length'):
        return 'int'
    if (name == 'range'):
        return 'int[]'
    if (name == 'to_set'):
        return 'set<int>'
    if (name == 'hash'):
        return 'int'
    if (name == 'substring'):
        return 'string'
    if (name == 'trim' || name == 'trim_left' || name == 'trim_right'):
        return 'string'
    if (name == 'split'):
        return 'string[]'
    if (name == 'split_lines'):
        return 'string[]'
    if (name == 'read_lines'):
        return 'string[]'
    if (name == 'read_file'):
        return 'string'
    if (name == 'write_all'):
        return 'void'
    if (name == 'time_ms'):
        return 'int'
    if (name == 'random_bits'):
        return 'int'
    if (name == 'has_flag'):
        return 'bool'
    if (name == 'option_value'):
        return 'string'
    if (name == 'getenv'):
        return 'string'
    if (name == 'open'):
        return 'file'
    if (name == 'close'):
        return 'void'
    if (name == 'to_int'):
        return 'int'
    if (name == 'to_num'):
        return 'num'
    if (name == 'to_string'):
        return 'string'
    if (name == 'round'):
        return 'num'
    if (name == 'sqrt'):
        return 'num'
    if (name == 'abs'):
        return 'int'
    if (name == 'popcount'):
        return 'int'
    if (name == 'min' || name == 'max'):
        return 'unknown'
    if (name == 'write_line'):
        return 'void'
    if (name == 'write_lines'):
        return 'void'
    if (name == 'dump_runtime_activity'):
        return 'void'
    if (name == 'codegen_source' || name == 'lower_source'):
        return 'string[]'
    if (name == 'codegen_ir'):
        return 'string[]'
    if (name == 'lower_source_ir'):
        return 'ProgramIR'
    if (name == 'parse_source'):
        return 'Node'
    if (name == 'lex_source'):
        return 'Token[]'
    return lookup_function_return_type(functions, name)

string lookup_cached_name_type(string[] names, string[] types, string name):
    int name_length = name.length()
    int index = names.length() - 1
    while (index >= 0):
        if (names[index].length() == name_length && names[index] == name):
            return types[index]
        index -= 1
    return 'unknown'

string lookup_cached_field_type(string[] keys, string[] types, string record_name, string field_name):
    return lookup_cached_name_type(keys, types, record_name + '.' + field_name)

string infer_call_type_cached(string name, FunctionSigIR[] functions, string[] cache_names, string[] cache_types):
    if (name == 'random_bits' || name == 'to_num'):
        string user_result_type = lookup_function_return_type(functions, name)
        if (user_result_type != 'unknown'):
            return user_result_type
    if (name == 'write_all'):
        string user_result_type = lookup_function_return_type(functions, name)
        if (user_result_type != 'unknown'):
            return user_result_type
        return 'void'
    FunctionSigIR[] empty_functions = []
    string result_type = infer_call_type(name, empty_functions)
    if (result_type != 'unknown'):
        return result_type
    result_type = lookup_cached_name_type(cache_names, cache_types, name)
    if (result_type != 'unknown'):
        return result_type
    result_type = lookup_function_return_type(functions, name)
    if (result_type != 'unknown'):
        cache_names.push(name)
        cache_types.push(result_type)
    return result_type

bool is_native_contains_receiver_type(string base_type):
    string normalized_type = normalize_llvm_type_name(base_type)
    if (normalized_type == 'string' || normalized_type == 'int[]' || normalized_type == 'bool[]' || normalized_type == 'string[]'):
        return true
    return normalized_type.starts_with('map<') || normalized_type.starts_with('set<')

bool is_native_record_array_query_type(string base_type):
    if (!base_type.ends_with('[]')):
        return false
    return record_name_from_type(array_item_type(base_type)) != ''

bool is_native_set_query_type(string base_type):
    if (base_type == 'set<int>'):
        return true
    if (!base_type.starts_with('set<')):
        return false
    return record_name_from_type(set_item_type(base_type)) != ''

bool is_native_prio_q_query_type(string base_type):
    if (base_type == 'prio_q<int>'):
        return true
    if (!base_type.starts_with('prio_q<')):
        return false
    return record_name_from_type(prio_q_item_type(base_type)) != ''

bool is_native_query_receiver_type(string method_name, string base_type):
    string normalized_type = normalize_llvm_type_name(base_type)
    if (method_name == 'length'):
        if (normalized_type == 'string' || normalized_type == 'int[]' || normalized_type == 'bool[]' || normalized_type == 'string[]' || normalized_type == 'int[][]' || normalized_type == 'string[][]'):
            return true
        if (normalized_type.starts_with('map<') || is_native_set_query_type(normalized_type) || is_native_record_array_query_type(normalized_type)):
            return true
        return false
    if (method_name == 'is_empty'):
        if (normalized_type == 'string' || normalized_type == 'int[]' || normalized_type == 'bool[]' || normalized_type == 'string[]' || normalized_type == 'int[][]' || normalized_type == 'string[][]'):
            return true
        if (normalized_type.starts_with('map<') || is_native_set_query_type(normalized_type) || is_native_record_array_query_type(normalized_type) || is_native_prio_q_query_type(normalized_type)):
            return true
        return false
    if (method_name == 'index_of'):
        return normalized_type == 'string'
    if (method_name == 'hash'):
        return normalized_type == 'int' || normalized_type == 'num' || normalized_type == 'string'
    return false

string infer_method_call_type(string method_name, string base_type, FunctionSigIR[] functions):
    if (method_name == 'await' && is_future_type(base_type)):
        return future_value_type(base_type)
    if (method_name == 'is_done' && is_future_type(base_type)):
        return 'bool'
    if (method_name == 'wait_for' && is_future_type(base_type)):
        return 'bool'
    if (method_name == 'length' && is_native_query_receiver_type(method_name, base_type)):
        return 'int'
    if (method_name == 'add' && base_type.starts_with('set<')):
        return 'int'
    if (method_name == 'union' && base_type.starts_with('set<')):
        return base_type
    if (method_name == 'hash' && is_native_query_receiver_type(method_name, base_type)):
        return 'int'
    if (method_name == 'keys' && base_type.starts_with('map<')):
        return 'string[]'
    if (method_name == 'values' && base_type.starts_with('map<')):
        string value_type = map_value_type(base_type)
        if (value_type == 'int[]'):
            return 'int[][]'
        if (value_type == 'string[]'):
            return 'string[][]'
        if (value_type == 'bool'):
            return 'bool[]'
        if (value_type == 'int' || value_type == 'string'):
            return 'string[]'
        return 'unknown'
    if (method_name == 'join' && base_type == 'string[]'):
        return 'string'
    if (method_name == 'char_at'):
        return 'string'
    if (method_name == 'index_of' && is_native_query_receiver_type(method_name, base_type)):
        return 'int'
    if (method_name == 'starts_with' || method_name == 'ends_with' || method_name == 'starts_with_at'):
        return 'bool'
    if (method_name == 'contains' && is_native_contains_receiver_type(base_type)):
        return 'bool'
    if (method_name == 'is_alpha' || method_name == 'is_digit' || method_name == 'is_alnum' || method_name == 'is_space' || method_name == 'is_whitespace'):
        return 'bool'
    if (method_name == 'replace'):
        return 'string'
    if (method_name == 'to_string'):
        return 'string'
    if (method_name == 'sum' && (base_type == 'int[]' || base_type == 'bool[]')):
        return 'int'
    if (method_name == 'create_prio_q' && base_type == 'int[]'):
        return 'prio_q<int>'
    if (method_name == 'create_prio_q' && base_type.ends_with('[]') && record_name_from_type(array_item_type(base_type)) != ''):
        return 'prio_q<' + array_item_type(base_type) + '>'
    if (method_name == 'pop' && base_type.starts_with('prio_q<')):
        return prio_q_item_type(base_type)
    if (method_name == 'pop' && base_type == 'int[]'):
        return 'int'
    if (method_name == 'remove_at' && base_type == 'int[]'):
        return 'int'
    if (method_name == 'clear' && base_type == 'int[]'):
        return 'void'
    if (method_name == 'clear' && base_type == 'string[]'):
        return 'void'
    if (method_name == 'insert' && base_type == 'int[]'):
        return 'int'
    if (method_name == 'push'):
        return 'int'
    if (method_name == 'is_empty' && is_native_query_receiver_type(method_name, base_type)):
        return 'bool'
    if (method_name == 'trim' || method_name == 'trim_left' || method_name == 'trim_right'):
        return 'string'
    if (method_name == 'substring'):
        return 'string'
    if (method_name == 'split_lines'):
        return 'string[]'
    if (method_name == 'split'):
        return 'string[]'
    return lookup_function_return_type(functions, method_name)

string infer_method_call_type_cached(string method_name, string base_type, FunctionSigIR[] functions, string[] cache_names, string[] cache_types):
    if (method_name == 'write_all'):
        string user_result_type = lookup_function_return_type(functions, method_name)
        if (user_result_type != 'unknown'):
            return user_result_type
        return 'void'
    FunctionSigIR[] empty_functions = []
    string result_type = infer_method_call_type(method_name, base_type, empty_functions)
    if (result_type != 'unknown'):
        return result_type
    result_type = lookup_cached_name_type(cache_names, cache_types, method_name)
    if (result_type != 'unknown'):
        return result_type
    result_type = lookup_function_return_type(functions, method_name)
    if (result_type != 'unknown'):
        cache_names.push(method_name)
        cache_types.push(result_type)
    return result_type

bool is_managed_ir_type(string type_name):
    if (type_name == '' || type_name == 'unknown' || type_name == 'int' || type_name == 'bool' || type_name == 'num'):
        return false
    if (type_name == 'string'):
        return true
    if (is_thread_pool_type(type_name) || is_future_type(type_name)):
        return true
    if (type_name.ends_with('[]')):
        return true
    if (type_name.starts_with('set<') || type_name.starts_with('map<')):
        return true
    if (record_name_from_type(type_name) != ''):
        return true
    return false

bool ownership_is_owned_mode(string ownership_mode):
    return ownership_mode == 'owned' || ownership_mode == 'managed'

bool is_array_copy_type(string type_name):
    type_name = normalize_llvm_type_name(type_name)
    return type_name == 'int[]' || type_name == 'bool[]' || type_name == 'string[]' || type_name == 'int[][]' || type_name == 'string[][]'

string refine_ownership_mode(LinearInstruction op, string result_type):
    if (result_type == 'int' || result_type == 'bool' || result_type == 'num'):
        return 'plain'
    if (op.detail == 'identifier' || op.detail == 'field' || op.detail == 'index' || op.detail == 'target-index' || op.detail == 'assign-index-key'):
        if (is_managed_ir_type(result_type)):
            return 'borrowed'
        return 'plain'
    if (op.detail == 'string'):
        return 'borrowed'
    if (op.detail == 'array' || op.detail == 'set' || op.detail == 'map'):
        return 'owned'
    if (op.detail == 'call' || op.detail == 'call-expr' || op.detail == 'method-call' || op.detail == 'method-call-lambda' || op.detail == 'binary'):
        if (result_type == 'string'):
            return 'managed'
        if (is_managed_ir_type(result_type)):
            return 'owned'
        if (result_type != '' && result_type != 'unknown'):
            return 'plain'
    if (op.detail == 'unary'):
        if (result_type != '' && result_type != 'unknown'):
            return 'plain'
    return op.ownership_mode

string[] clone_instruction_args(string[] args):
    if (TYPE_IR_PROFILE_ACTIVE != 0):
        TYPE_IR_CLONE_INSTRUCTION_ARGS_CALLS += 1
        TYPE_IR_CLONE_INSTRUCTION_ARGS_ITEMS += args.length()
    string[] cloned = []
    for (string arg in args):
        cloned.push(arg.substring(0))
    return cloned

LinearInstruction refined_value_op(LinearInstruction op, string result_type, string ownership_mode):
    return LinearInstruction(op.kind.substring(0), op.lhs.substring(0), result_type.substring(0), ownership_mode.substring(0), op.detail.substring(0), clone_instruction_args(op.args))

bool is_integer_only_binary_operator(string op_name):
    return op_name == '%' || op_name == '&' || op_name == '|' || op_name == '^' || op_name == '<<' || op_name == '>>'

LinearInstruction clone_linear_instruction(LinearInstruction op):
    if (TYPE_IR_PROFILE_ACTIVE != 0):
        TYPE_IR_CLONE_LINEAR_INSTRUCTION_CALLS += 1
    return LinearInstruction(op.kind.substring(0), op.lhs.substring(0), op.result_type.substring(0), op.ownership_mode.substring(0), op.detail.substring(0), clone_instruction_args(op.args))

LinearInstruction[] clone_linear_instructions(LinearInstruction[] instructions):
    LinearInstruction[] cloned = []
    int index = 0
    while (index < instructions.length()):
        if (TYPE_IR_PROFILE_ACTIVE != 0):
            TYPE_IR_CLONE_LINEAR_INSTRUCTIONS_ITEMS += 1
        cloned.push(clone_linear_instruction(instructions[index]))
        index += 1
    return cloned

string[] clone_string_array(string[] items):
    string[] cloned = []
    for (string item in items):
        cloned.push(item.substring(0))
    return cloned

BindingIR clone_binding_ir(BindingIR binding):
    return BindingIR(binding.type_name.substring(0), binding.name.substring(0))

BindingIR[] clone_binding_irs(BindingIR[] bindings):
    BindingIR[] cloned = []
    for (BindingIR binding in bindings):
        cloned.push(clone_binding_ir(binding))
    return cloned

TerminatorIR clone_terminator_ir(TerminatorIR terminator):
    return TerminatorIR(terminator.kind.substring(0), clone_string_array(terminator.args))

BlockIR clone_block_ir(BlockIR block):
    return BlockIR(block.label.substring(0), clone_linear_instructions(block.instructions), clone_terminator_ir(block.terminator))

GlobalDeclIR clone_global_decl_ir(GlobalDeclIR global_decl):
    return GlobalDeclIR(global_decl.header.substring(0), clone_linear_instructions(global_decl.instructions), global_decl.value_name.substring(0))

bool is_string_signature_method(string method_name):
    return method_name == 'trim' || method_name == 'trim_left' || method_name == 'trim_right' || method_name == 'char_at' || method_name == 'substring' || method_name == 'replace'

bool has_matching_ufcs_signature(LinearInstruction op, string method_name, FunctionSigIR[] functions, EnumTypeIR[] enum_types, string[] temp_types):
    FunctionSigIR method_sig = lookup_function_sig(functions, method_name)
    if (method_sig.name == '' || op.args.length() != method_sig.param_types.length() + 1):
        return false
    int index = 0
    while (index < method_sig.param_types.length()):
        string expected_type = normalize_enum_type_name(normalize_llvm_type_name(method_sig.param_types[index]), enum_types)
        string actual_type = normalize_enum_type_name(normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[index + 1])), enum_types)
        if (expected_type != actual_type):
            return false
        index += 1
    return true

LinearInstruction refine_string_method_signature(LinearInstruction op, string method_name, EnumTypeIR[] enum_types, string[] temp_types):
    if (method_name == 'trim' || method_name == 'trim_left' || method_name == 'trim_right'):
        if (op.args.length() != 2):
            throw method_name + ' expects 0 arguments; got ' + (op.args.length() - 2).to_string()
        return refined_value_op(op, 'string', 'managed')
    if (method_name == 'char_at'):
        if (op.args.length() != 3):
            throw 'char_at expects 1 argument; got ' + (op.args.length() - 2).to_string()
        string char_at_index_type = normalize_enum_type_name(normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2])), enum_types)
        if (char_at_index_type != 'int'):
            throw 'char_at argument 1 requires int; got ' + char_at_index_type
        return refined_value_op(op, 'string', 'managed')
    if (method_name == 'substring'):
        if (op.args.length() != 3 && op.args.length() != 4):
            throw 'substring expects 1 or 2 arguments; got ' + (op.args.length() - 2).to_string()
        int substring_arg_index = 2
        while (substring_arg_index < op.args.length()):
            string substring_bound_type = normalize_enum_type_name(normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[substring_arg_index])), enum_types)
            if (substring_bound_type != 'int'):
                throw 'substring argument ' + (substring_arg_index - 1).to_string() + ' requires int; got ' + substring_bound_type
            substring_arg_index += 1
        return refined_value_op(op, 'string', 'managed')
    if (method_name == 'replace'):
        if (op.args.length() != 4):
            throw 'replace expects 2 arguments; got ' + (op.args.length() - 2).to_string()
        int replace_arg_index = 2
        while (replace_arg_index < op.args.length()):
            string replace_arg_type = normalize_enum_type_name(normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[replace_arg_index])), enum_types)
            if (replace_arg_type != 'string'):
                throw 'replace argument ' + (replace_arg_index - 1).to_string() + ' requires string; got ' + replace_arg_type
            replace_arg_index += 1
        return refined_value_op(op, 'string', 'managed')
    if (method_name == 'contains' || method_name == 'index_of'):
        if (op.args.length() != 3):
            throw method_name + ' expects 1 argument; got ' + (op.args.length() - 2).to_string()
        string query_needle_type = normalize_enum_type_name(normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2])), enum_types)
        if (query_needle_type != 'string'):
            throw method_name + ' argument 1 requires string; got ' + query_needle_type
        if (method_name == 'contains'):
            return refined_value_op(op, 'bool', 'plain')
        return refined_value_op(op, 'int', 'plain')
    return op

LinearInstruction refine_value_instruction(LinearInstruction op, BindingIR[] bindings, FunctionSigIR[] functions, RecordFieldIR[] record_fields, string[] record_names, EnumTypeIR[] enum_types, string[] temp_types):
    if (op.kind != 'value'):
        return op
    if (op.detail == 'foreach-value'):
        if (op.args.length() != 1):
            throw 'foreach iterable marker requires one source value'
        string iterable_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[0]))
        return refined_value_op(op, iterable_type, 'borrowed')
    if (op.detail == 'method-call'):
        if (op.args.length() >= 2):
            string method_name = op.args[0]
            if (is_string_signature_method(method_name)):
                string method_receiver_type = normalize_enum_type_name(normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[1])), enum_types)
                if (method_receiver_type == 'string'):
                    return refine_string_method_signature(op, method_name, enum_types, temp_types)
                if (method_receiver_type != 'unknown'):
                    if ((method_name == 'char_at' || method_name == 'substring') && !record_type_exists(record_names, method_name) && has_matching_ufcs_signature(op, method_name, functions, enum_types, temp_types)):
                        FunctionSigIR method_sig = lookup_function_sig(functions, method_name)
                        return refined_value_op(op, method_sig.return_type, refine_ownership_mode(op, method_sig.return_type))
                    throw method_name + ' requires string receiver; got ' + method_receiver_type
            if ((method_name == 'contains' || method_name == 'index_of') && normalize_enum_type_name(normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[1])), enum_types) == 'string'):
                return refine_string_method_signature(op, method_name, enum_types, temp_types)
            if (op.args[0] == 'last'):
                string last_receiver_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[1]))
                if (last_receiver_type == 'string'):
                    string last_user_result = lookup_function_return_type(functions, 'last')
                    if (last_user_result != 'unknown'):
                        return refined_value_op(op, last_user_result, refine_ownership_mode(op, last_user_result))
                    if (record_type_exists(record_names, 'last')):
                        return refined_value_op(op, 'last', refine_ownership_mode(op, 'last'))
                    if (op.args.length() != 2):
                        throw 'string last requires no arguments'
                    return refined_value_op(op, 'string', 'managed')
                if (last_receiver_type.ends_with('[]')):
                    if (last_receiver_type == 'int[]' || last_receiver_type == 'bool[]' || last_receiver_type == 'string[]' || last_receiver_type == 'int[][]' || last_receiver_type == 'string[][]'):
                        string last_user_result = lookup_function_return_type(functions, 'last')
                        if (last_user_result != 'unknown'):
                            return refined_value_op(op, last_user_result, refine_ownership_mode(op, last_user_result))
                        if (record_type_exists(record_names, 'last')):
                            return refined_value_op(op, 'last', refine_ownership_mode(op, 'last'))
                        if (op.args.length() != 2):
                            throw 'array last requires no arguments'
                        return refined_value_op(op, array_item_type(last_receiver_type), refine_ownership_mode(op, array_item_type(last_receiver_type)))
                    if (lookup_function_return_type(functions, 'last') == 'unknown' && !record_type_exists(record_names, 'last')):
                        throw 'array last requires int[], bool[], string[], int[][], or string[][]; got ' + last_receiver_type
            if (op.args[0] == 'index_of'):
                string unsupported_index_of_receiver_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[1]))
                if (unsupported_index_of_receiver_type.ends_with('[]')):
                    if (unsupported_index_of_receiver_type != 'int[]' && unsupported_index_of_receiver_type != 'bool[]' && unsupported_index_of_receiver_type != 'string[]'):
                        if (lookup_function_return_type(functions, 'index_of') == 'unknown'):
                            if (!record_type_exists(record_names, 'index_of')):
                                throw 'array index_of requires int[], bool[], or string[]; got ' + unsupported_index_of_receiver_type
            if (op.args[0] == 'index_of'):
                string index_of_receiver_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[1]))
                if (index_of_receiver_type == 'int[]' || index_of_receiver_type == 'bool[]' || index_of_receiver_type == 'string[]'):
                    string index_of_user_result = lookup_function_return_type(functions, 'index_of')
                    if (index_of_user_result != 'unknown'):
                        return refined_value_op(op, index_of_user_result, refine_ownership_mode(op, index_of_user_result))
                    if (record_type_exists(record_names, 'index_of')):
                        return refined_value_op(op, 'index_of', refine_ownership_mode(op, 'index_of'))
                    if (op.args.length() != 3):
                        throw 'array index_of requires exactly one needle argument'
                    string index_of_expected_type = array_item_type(index_of_receiver_type)
                    string index_of_actual_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2]))
                    if (index_of_actual_type != index_of_expected_type):
                        throw 'array index_of requires ' + index_of_expected_type + '; got ' + index_of_actual_type
                    return refined_value_op(op, 'int', 'plain')
            if (op.args[0] == 'sort'):
                string sort_receiver_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[1]))
                if (sort_receiver_type == 'int[]'):
                    if (op.args.length() != 3):
                        throw 'int[] sort requires exactly one comparator'
                    return refined_value_op(op, 'int[]', 'borrowed')
    if (op.detail == 'method-call' && op.args.length() >= 2):
        string query_method_name = op.args[0]
        if (query_method_name == 'length' || query_method_name == 'is_empty' || query_method_name == 'index_of' || query_method_name == 'hash'):
            string query_base_type = normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[1]))
            string query_result_type = infer_method_call_type_cached(query_method_name, query_base_type, functions, TYPE_IR_FUNCTION_TYPE_CACHE_NAMES, TYPE_IR_FUNCTION_TYPE_CACHE_VALUES)
            return refined_value_op(op, query_result_type, refine_ownership_mode(op, query_result_type))
    if (op.detail == 'binary' && op.args.length() >= 3):
        if (is_integer_only_binary_operator(op.args[0])):
            string integer_left_type = normalize_enum_type_name(normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[1])), enum_types)
            string integer_right_type = normalize_enum_type_name(normalize_llvm_type_name(lookup_temp_type_slot(temp_types, op.args[2])), enum_types)
            if ((integer_left_type != '' && integer_left_type != 'unknown' && integer_left_type != 'int') || (integer_right_type != '' && integer_right_type != 'unknown' && integer_right_type != 'int')):
                throw 'operator ' + op.args[0] + ' requires int operands; got ' + integer_left_type + ' and ' + integer_right_type
    if (op.detail == 'method-call-lambda' && op.args.length() == 5):
        if (op.args[0] == 'map_to'):
