import lexer;
import parser;
import lowerer;
import type_ir_lib;
import ownership_ir_lib;
import llvm_codegen;
import foreign_modules;

record LoadedSourceBundle(string text, string[] module_ids, string[] foreign_modules, bool regex_imported);
record ExpandedSourceLines(string[] lines, string[] module_ids);
record CompileOptions(string source_path, string output_path, bool profile_phases);

string path_dirname(string path):
    int index = path.length() - 1
    while (index >= 0):
        if (path[index] == '/'):
            if (index == 0):
                return '/'
            return path.substring(0, index)
        index -= 1
    return ''

string[] append_normalized_path_segment(string[] parts, string part, bool absolute):
    if (part == '' || part == '.'):
        return parts
    if (part == '..'):
        if (!parts.is_empty()):
            int last_index = parts.length() - 1
            if (parts[last_index] != '..'):
                string[] reduced_parts = []
                int part_index = 0
                while (part_index < last_index):
                    reduced_parts.push(parts[part_index])
                    part_index += 1
                parts = reduced_parts
            else if (!absolute):
                parts.push(part)
        else if (!absolute):
            parts.push(part)
        return parts
    parts.push(part)
    return parts

string normalize_lexical_path(string path):
    bool absolute = path.starts_with('/')
    string[] normalized_parts = []
    int segment_start = 0
    int index = 0
    while (index <= path.length()):
        bool at_end = index == path.length()
        if (at_end):
            normalized_parts = append_normalized_path_segment(normalized_parts, path.substring(segment_start, index), absolute)
        else if (path[index] == '/'):
            normalized_parts = append_normalized_path_segment(normalized_parts, path.substring(segment_start, index), absolute)
            segment_start = index + 1
        index += 1
    string result = ''
    for (string part : normalized_parts):
        if (result != ''):
            result += '/'
        result += part
    if (absolute):
        result = '/' + result
    if (result == ''):
        if (absolute):
            return '/'
        return '.'
    return result

string import_module_name(string line):
    string trimmed = line.trim()
    return trimmed.substring(7, trimmed.length() - 1).trim()

bool is_import_line(string line):
    string trimmed = line.trim()
    return trimmed.starts_with('import ') && trimmed.ends_with(';')

bool string_in_array(string[] values, string target):
    for (string value in values):
        if (value == target):
            return true
    return false

string[] string_array_with_last(string[] values, string value):
    string[] result = []
    int index = 0
    while (index < values.length()):
        result.push(values[index])
        index += 1
    result.push(value)
    return result

string resolve_import_path(string source_path, string module_name):
    string base_dir = path_dirname(normalize_lexical_path(source_path))
    if (base_dir == ''):
        return normalize_lexical_path(module_name + '.tb')
    return normalize_lexical_path(base_dir + '/' + module_name + '.tb')

string join_lines(string[] lines):
    string merged = ''
    bool first = true
    for (string line in lines):
        if (first):
            merged = line
            first = false
        else:
            merged += '\n' + line
    return merged

ExpandedSourceLines expand_source_lines_with_imports(string path, string[] lines, string[] seen, string[] active, string[] foreign_modules):
    string normalized_path = normalize_lexical_path(path)
    string[] merged = []
    string[] module_ids = []
    int line_index = 0
    while (line_index < lines.length()):
        if (is_import_line(lines[line_index])):
            string module_name = import_module_name(lines[line_index])
            if (module_name == 'regex' || module_name == 'random' || module_name == 'uuid'):
                string module_key = '<builtin:' + module_name + '>'
                if (string_in_array(active, module_key)):
                    throw 'import cycle detected: ' + module_key
                if (!string_in_array(seen, module_key)):
                    seen.push(module_key)
                    string[] next_active = string_array_with_last(active, module_key)
                    string[] module_lines = tb_builtin_module_text(module_name).split_lines()
                    ExpandedSourceLines imported = expand_source_lines_with_imports(module_key, module_lines, seen, next_active, foreign_modules)
                    for (int imported_index = 0; imported_index < imported.lines.length(); imported_index += 1):
                        merged.push(imported.lines[imported_index])
                        module_ids.push(imported.module_ids[imported_index])
            else if (is_foreign_module(module_name)):
                if (!string_in_array(foreign_modules, module_name)):
                    foreign_modules.push(module_name)
            else:
                string import_path = resolve_import_path(path, module_name)
                if (string_in_array(active, import_path)):
                    throw 'import cycle detected: ' + import_path
                if (!string_in_array(seen, import_path)):
                    seen.push(import_path)
                    string[] next_active = string_array_with_last(active, import_path)
                    ExpandedSourceLines imported = expand_source_lines_with_imports(import_path, read_lines(import_path), seen, next_active, foreign_modules)
                    for (int imported_index = 0; imported_index < imported.lines.length(); imported_index += 1):
                        merged.push(imported.lines[imported_index])
                        module_ids.push(imported.module_ids[imported_index])
        else:
            merged.push(lines[line_index])
            module_ids.push(normalized_path)
        line_index += 1
    return ExpandedSourceLines(merged, module_ids)

LoadedSourceBundle load_source_bundle_with_imports(string path, string source, string[] seen):
    string normalized_path = normalize_lexical_path(path)
    string[] foreign_modules = []
    string[] active = [normalized_path]
    if (!string_in_array(seen, normalized_path)):
        seen.push(normalized_path)
    ExpandedSourceLines expanded = expand_source_lines_with_imports(normalized_path, source.split_lines(), seen, active, foreign_modules)
    return LoadedSourceBundle(join_lines(expanded.lines), expanded.module_ids, foreign_modules, string_in_array(seen, '<builtin:regex>'))

void write_lines_file(string path, string[] lines):
    file out = open(path)
    write_lines(out, lines)
    close(out)

void write_text_file(string path, string text):
    file out = open(path)
    write_line(out, text)
    close(out)

void write_build_metadata(string output_path, string[] active_modules):
    string[] link_flags = foreign_module_link_flags(active_modules)
    for (string flag in llvm_runtime_link_flags()):
        link_flags.push(flag)
    string[] cflags = foreign_module_cflags(active_modules)
    for (string flag in llvm_runtime_c_flags()):
        cflags.push(flag)
    string[] csources = foreign_module_c_sources(active_modules)
    for (string source in llvm_runtime_c_sources()):
        string runtime_path = output_path + '.' + source
        write_text_file(runtime_path, llvm_embedded_runtime_text(source))
        csources.push(runtime_path)
    write_lines_file(output_path + '.linkflags', link_flags)
    write_lines_file(output_path + '.cflags', cflags)
    write_lines_file(output_path + '.csources', csources)

void print_ms(string label, int start_ms, int end_ms):
    print(label + '_ms=' + (end_ms - start_ms))

string compiler_usage():
    return 'usage: tb [--profile-phases] <file> [output.ll]\n       tb --version'

CompileOptions parse_compile_options(string[] args):
    string source_path = ''
    string output_path = ''
    bool profile_phases = false
    int index = 1
    while (index < args.length()):
        string arg = args[index]
        if (arg == '--profile-phases'):
            profile_phases = true
        else if (source_path == ''):
            source_path = arg
        else if (output_path == ''):
            output_path = arg
        else:
            throw compiler_usage()
        index += 1
    if (source_path == ''):
        throw compiler_usage()
    if (profile_phases && output_path == ''):
        throw '--profile-phases requires an output.ll path'
    return CompileOptions(source_path, output_path, profile_phases)

int run_compiler(CompileOptions options):
    int t0 = 0
    if (options.profile_phases):
        t0 = time_ms()
    string source = read_file(options.source_path)
    string[] active_foreign_modules = []
    bool regex_imported = false
    string[] seen = []
    LoadedSourceBundle loaded = load_source_bundle_with_imports(options.source_path, source, seen)
    source = loaded.text
    string[] module_ids = loaded.module_ids
    active_foreign_modules = loaded.foreign_modules
    regex_imported = loaded.regex_imported
    string injected = injected_foreign_module_declarations(active_foreign_modules)
    if (injected != ''):
        source = injected + '\n' + source
        string[] with_foreign_modules = []
        int injected_line_count = injected.split_lines().length()
        for (int line_index = 0; line_index < injected_line_count; line_index += 1):
            with_foreign_modules.push('')
        for (string module_id : module_ids):
            with_foreign_modules.push(module_id)
        module_ids = with_foreign_modules
    if (!active_foreign_modules.is_empty()):
        source = rewrite_foreign_module_uses(source, active_foreign_modules)
    if (!options.profile_phases):
        string[] lines = llvm_codegen_source_with_modules(source, module_ids, regex_imported)
        if (options.output_path != ''):
            write_lines_file(options.output_path, lines)
            write_build_metadata(options.output_path, active_foreign_modules)
        else:
            for (string line in lines):
                print(line)
        return 0
    int t1 = time_ms()

    Token[] tokens = lex_source_with_module_ids(source, module_ids)
    int t2 = time_ms()

    Node parsed = parse_program(tokens)
    int t3 = time_ms()

    ProgramIR lowered = lower_tokens_ir(tokens)
    int t4 = time_ms()

    reset_type_ir_profile_stats()
    ProgramIR typed = refine_program_ir_with_regex(lowered, regex_imported)
    int t5 = time_ms()

    reset_ownership_profile_stats()
    ProgramIR owned = owned_program_ir(typed)
    int t6 = time_ms()

    reset_llvm_backend_helper_stats()
    reset_llvm_user_call_stats()
    string[] lines = llvm_codegen_ir(owned)
    int t7 = time_ms()

    write_lines_file(options.output_path, lines)
    write_build_metadata(options.output_path, active_foreign_modules)

    print_ms('load_import', t0, t1)
    print_ms('lex', t1, t2)
    print_ms('parse_only', t2, t3)
    print_ms('lower', t3, t4)
    print_ms('type_refine', t4, t5)
    print_ms('ownership', t5, t6)
    print_ms('llvm_emit', t6, t7)
    print('tokens=' + tokens.length())
    print('parsed_top_level=' + parsed.children.length())
    print('functions=' + owned.functions.length())
    print('globals=' + owned.globals.length())
    print('llvm_lines=' + lines.length())
    print('--- type_ir_profile_report ---')
    for (string line in type_ir_profile_report().split_lines()):
        print(line)
    print('--- llvm_backend_helper_report ---')
    for (string line in llvm_backend_helper_report().split_lines()):
        print(line)
    print('--- ownership_profile_report ---')
    for (string line in ownership_profile_report().split_lines()):
        print(line)
    print('--- llvm_user_call_report ---')
    for (string line in llvm_user_call_report().split_lines()):
        print(line)
    return 0

int main(string[] args):
    if (args.length() < 2):
        print(compiler_usage())
        return 1
    if (args[1] == '--version'):
        if (args.length() != 2):
            print(compiler_usage())
            return 1
        print('tb ' + tb_compiler_version())
        return 0

    int exit_code = 0
    try:
        CompileOptions options = parse_compile_options(args)
        exit_code = run_compiler(options)
    catch (exception err):
        print(err)
        exit_code = 1
    return exit_code
