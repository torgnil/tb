int radius = 1

int[] make_values():
    radius = 3
    return [5, 10]

int[] expand(int value, int amount):
    return [value - amount, value + amount]

int main(string[] args):
    int[] result = make_values().flat_map(int value -> expand(value, radius))
    print(result.length())
    for (int index : range(result.length())):
        print(result[index])
    return 0
