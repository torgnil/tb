int main():
    thread_pool pool = thread_pool(1)
    string prefix = 'item-'
    bool enabled = true
    string[] values = ['value']
    future<string> result = pool.submit(string[] input -> {
        if (enabled) {
            return prefix + input[0]
        }
        return input[0]
    }, values)
    print(result.await())
    return 0
