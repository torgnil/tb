string separator = '-'

string[] prepare_lines():
    separator = ':'
    return ['red:blue', 'green:yellow']

string[] split_using(string line, string separator):
    return line.split(separator)

int main(string[] args):
    string[] words = prepare_lines().flat_map(string line -> split_using(line, separator))
    print(words.length())
    print(words[0])
    print(words[1])
    print(words[2])
    print(words[3])
    return 0
