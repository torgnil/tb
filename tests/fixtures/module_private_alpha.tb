# Calls in comments and strings do not become private references: helper(999).
private int helper(int value):
    if (value <= 0):
        return 1
    return helper_forward(value - 1) + 1

private int helper_forward(int value):
    return helper(value)

private int adjust(int value, int amount):
    return helper(value) + amount

private int length(int[] values):
    return 99

private int Color(int value):
    return value

private int order_values(int left, int right):
    return left - right

int alpha_answer(int value):
    return helper(value)

int alpha_adjust(int value):
    return value.adjust(3)

int alpha_submit(int value):
    thread_pool pool = thread_pool(1)
    future<int> result = pool.submit(helper, value)
    int answer = result.await()
    return answer

int alpha_private_length():
    int[] values = [1, 2, 3]
    return values.length()

int[] alpha_sorted():
    int[] values = [3, 1, 2]
    return values.sort(order_values)

string alpha_text():
    return 'helper(999)'
