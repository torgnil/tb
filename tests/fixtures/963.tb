string sum(const string[] values):
    if values.is_empty():
        return 'empty'
    return values.join('|')

int main():
    print(sum([]))
    print(sum(['first', 'second']))
    int[] numbers = [3, 4]
    bool[] flags = [true, false, true]
    print(sum(numbers))
    print(sum(flags))
    return 0
