

# Case 1
enum Code { A = 1 }
record Item(Code value);

int combined_case_1_main():
    return 0

# Case 2
enum Mode { READY, DONE }
record State(Mode value);

Mode make_mode():
    return 'mode ' + 'ready'

State make_state():
    Mode mode = make_mode()
    State state = State(mode)
    return state

int combined_case_2_main():
    State original = make_state()
    State copy = original
    print(copy.value)

    original.value = 'replacement ' + 'value'
    print(copy.value)
    print(original.value)
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main() != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main() != 0):
        return 1
    return 0
