import random;

int main(string[] args):
    print(random_below(1))
    print(random_between(-9, -8))
    print(random_between(9223372036854775806, 9223372036854775807))
    int positive = random_below(100)
    int cross_zero = random_between(-5, 5)
    print(positive >= 0 && positive < 100)
    print(cross_zero >= -5 && cross_zero < 5)
    return 0
