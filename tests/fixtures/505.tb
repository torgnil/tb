int main(string[] args):
    print(random(1))
    print(random(-9, -8))
    print(random(9223372036854775806, 9223372036854775807))
    int positive = random(100)
    int cross_zero = random(-5, 5)
    print(positive >= 0 && positive < 100)
    print(cross_zero >= -5 && cross_zero < 5)
    return 0
