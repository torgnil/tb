import uuid;

int main():
    Uuid nil = Uuid(0, 0)
    print(uuid_version(nil))
    print(uuid_has_rfc_variant(nil))
    Uuid v4 = uuid_parse('ffffffff-ffff-4fff-bfff-ffffffffffff')
    print(v4.uuid_version())
    print(v4.uuid_has_rfc_variant())
    Uuid high_bits = uuid_parse('ffffffff-ffff-ffff-8000-000000000000')
    print(uuid_version(high_bits))
    print(uuid_has_rfc_variant(high_bits))
    Uuid other = uuid_parse('00000000-0000-7000-c000-000000000000')
    print(uuid_version(other))
    print(uuid_has_rfc_variant(other))
    print(uuid_has_rfc_variant(Uuid(0, 4611686018427387904)))
    Uuid generated = uuid_parse(uuid())
    print(uuid_version(generated))
    print(uuid_has_rfc_variant(generated))
    return 0
