int[][] keys_from_local_map():
    map<int[], int> local = {[40, 41]: 4041}
    return local.keys()

map<int[], int> make_array_key_map(int value):
    return {[value, value + 1]: value}

int main():
    map<int[], int> items = {}
    int[] source = [4, 5]
    items[source] = 10
    source[0] = 90
    source.push(6)
    print(items[[4, 5]])
    print(items[[90, 5]])

    int[] equal_key = [4, 5]
    items[equal_key] = 11
    print(items[[4, 5]])
    items[[]] = 0

    for (int index : range(0, 30)):
        items[[index, 0 - index]] = index
    print(items.length())
    print(items.contains([29, -29]))
    print(items.contains([100, -100]))

    int[][] keys = items.keys()
    keys[0][0] = 700
    print(items[[4, 5]])
    print(items[[700, 5]])
    int[] values = items.values()
    values[0] = 999
    print(items[[4, 5]])
    print(keys[0][1])
    print(keys[1].length())
    print(values[1])

    const map<int[], int> fixed = {[8, 9]: 89}
    int[][] fixed_keys = fixed.keys()
    print(fixed[[8, 9]])
    print(fixed_keys[0][1])

    const map<int[], int> empty = {}
    int[][] empty_keys = empty.keys()
    int[] empty_values = empty.values()
    print(empty_keys.length())
    print(empty_values.length())

    int[][] detached_keys = keys_from_local_map()
    print(detached_keys[0][0])
    print(detached_keys[0][1])
    detached_keys[0][0] = 400
    print(detached_keys[0][0])

    print(make_array_key_map(4).length())
    print(make_array_key_map(4).is_empty())
    print(make_array_key_map(4).contains([4, 5]))
    print(contains(make_array_key_map(9), [9, 10]))
    int[][] temporary_keys = make_array_key_map(6).keys()
    print(temporary_keys[0][0])
    int[] temporary_values = make_array_key_map(7).values()
    print(temporary_values[0])
    print(make_array_key_map(11)[[11, 12]])
    print([8, 9] in make_array_key_map(8))
    print([0] not in make_array_key_map(8))
    return 0
