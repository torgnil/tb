record Item(int value);

map<int, Item[]> saved_items = {}

Item[] make_items(int value):
    return [Item(value), Item(value + 1)]

int save_items(Item[] items):
    saved_items[1] = items
    return items[0].value

int main():
    print(save_items(make_items(12)))
    print(saved_items[1][1].value)
    return 0
