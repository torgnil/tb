import union_find;

int[] component_sizes(const int[] groups):
    return groups.union_find_component_sizes()

int main():
    const int[] empty = union_find_new(0)
    int[] no_sizes = union_find_component_sizes(empty)
    print(no_sizes.length())

    int[] groups = union_find_new(6)
    union_find_union(groups, 3, 1)
    union_find_union(groups, 3, 4)
    union_find_union(groups, 5, 2)
    int[] sizes = component_sizes(groups)
    print(sizes.length())
    for (int size in sizes):
        print(size)

    sizes[0] = 99
    print(union_find_component_size(groups, 0))
    union_find_union(groups, 3, 5)
    print(sizes[1])
    int[] merged = union_find_component_sizes(groups)
    for (int size in merged):
        print(size)
    return 0
