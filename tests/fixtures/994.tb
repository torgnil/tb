int main():
    string path = ''
    for (int index = 0; index < 300; index += 1):
        path += 'x'

    try:
        bool exists = path_exists(path)
        print('not caught')
    catch (exception error):
        print(error == 'path_exists: unable to inspect ' + path)

    try:
        bool file = is_file(path)
        print('not caught')
    catch (exception error):
        print(error == 'is_file: unable to inspect ' + path)

    try:
        bool directory = is_dir(path)
        print('not caught')
    catch (exception error):
        print(error == 'is_dir: unable to inspect ' + path)

    print(path_exists('.'))
    return 0
