import regex;

bool check(Regex pattern, string input):
    return regex_contains(pattern, input)

int main():
    Regex tail = regex_compile('a+b$')
    string text = 'prefix-aaab\n'
    print(check(tail, text))
    print(text)
    print(regex_contains(regex_compile('^$'), ''))
    print(regex_contains(regex_compile('^..$'), 'é'))
    print(regex_contains(regex_compile('^.$'), 'é'))
    print(regex_contains(regex_compile('[a-z]+'), '---'))
    string long_text = 'x'
    for (int count = 0; count < 12; count += 1):
        long_text += long_text
    print(regex_contains(regex_compile('x+z'), long_text + 'z'))
    print(regex_contains(regex_compile('x+z'), long_text))
    return 0
