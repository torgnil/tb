record Pair(int left, int right);

bool contains_int(set<int> values, int needle):
    return values.contains(needle)

bool const_contains_int(const set<int> values, const int needle):
    return values.contains(needle)

bool contains_pair(set<Pair> values, Pair needle):
    return values.contains(needle)

bool contains_both(set<int> numbers, set<Pair> pairs, int number, Pair pair):
    return numbers.contains(number) && pairs.contains(pair)

bool contains_pair_set(set<int> numbers, const set<Pair> pairs, int seed):
    return numbers.contains(seed) && pairs.contains(Pair(seed + 1, seed + 11))

int main(string[] args):
    int seed = args.length()
    set<int> numbers = {seed, seed + 2}
    const set<int> fixed_numbers = {seed + 1}
    Pair target = Pair(seed, seed + 10)
    set<Pair> pairs = {target}
    const set<Pair> fixed_pairs = {Pair(seed + 1, seed + 11)}
    set<Pair> empty_pairs = {}

    print(contains_int(numbers, seed))
    print(const_contains_int(fixed_numbers, seed + 1))
    print(contains_pair(pairs, target))
    print(numbers.contains_int(seed + 2))
    print(numbers.contains_both(pairs, seed, target))
    print(numbers.contains_pair_set(fixed_pairs, seed))
    print(contains_pair(empty_pairs, target))
    print(numbers.contains_int(seed + 1))

    numbers.add(seed + 3)
    print(numbers.contains_int(seed + 3))
    print(numbers.contains_int(seed))
    print(pairs.contains_pair(target))
    return 0
