record Point(int x, int y);
record Empty();

int named_zero():
    return 7

int increment(const int value):
    return value + 2

int combine(int left, int right):
    return left * 10 + right

int mix(int left, int right):
    return left * 10 + right

cached int cached_double(const int value):
    return value * 2

string join(string left, string right):
    return left + right

int point_total(Point point):
    return point.x + point.y

int empty_value(Empty value):
    return 5

void consume(int value):
    print(value)

int main(string[] args):
    int seed = args.length()
    print(named_zero())
    print(seed.increment())
    print(combine(seed, increment(1)))
    print(seed.mix(4))
    print(combine(named_zero(), seed.mix(2)))
    print(cached_double(seed))
    print(join('a', 'b'))
    Point source = Point(2, 3)
    print(point_total(source))
    const Point fixed = Point(4, 5)
    print(point_total(fixed))
    print(empty_value(Empty()))
    consume(point_total(source))
    print(source.x)
    print(source.y)
    return 0
