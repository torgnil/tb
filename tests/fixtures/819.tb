int calls = 0

int[][] make_rows(int mode):
    calls += 1
    if (mode == 1) {
        int[][] empty = []
        return empty
    }
    if (mode == 2) {
        return [[9]]
    }
    return [[], [1, 2], [3, 4]]

int main():
    thread_pool pool = thread_pool(1)
    future<int> sum = pool.submit(int mode -> {
        int total = 0
        for (const int[] row : make_rows(mode)) {
            for (int value : row) {
                if (value == 2) {
                    continue
                }
                total += value
            }
        }
        return total
    }, 0)
    print(sum.await())

    future<int> empty = pool.submit(int mode -> {
        int total = 0
        for (const int[] row : make_rows(mode)) {
            total += row.length()
        }
        return total
    }, 1)
    print(empty.await())

    future<int> stopped = pool.submit(int mode -> {
        int total = 0
        for (const int[] row : make_rows(mode)) {
            total += row.length()
            if (row.length() > 0) {
                break
            }
        }
        return total
    }, 0)
    print(stopped.await())

    future<int> early = pool.submit(int mode -> {
        for (const int[] row : make_rows(mode)) {
            return row.length()
        }
        return -1
    }, 0)
    print(early.await())

    future<int> failure = pool.submit(int mode -> {
        int total = 0
        for (const int[] row : make_rows(mode)) {
            for (int value : row) {
                if (value == 9) {
                    throw 'grid-failure'
                }
                total += value
            }
        }
        return total
    }, 2)
    try:
        print(failure.await())
    catch (string error):
        print(error)
    print(calls)
    return 0
