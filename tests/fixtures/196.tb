

# Case 1
int double_value(int value):
    return value * 2

bool invert_value(bool value):
    return !value

string suffix_value(string value):
    return value + '!'

int inspect_values(int[] values):
    return values[0] + values[1]

int[][] copy_rows(int[][] rows):
    return rows

int no_argument_value():
    return 42

int combined_case_1_main(string[] args):
    const thread_pool pool = thread_pool(2)
    const int scalar = args.length() + 4
    const bool flag = args.length() == 1
    const string label = 'value' + args.length()
    int[] values = [args.length() + 10, 2]
    int[][] rows = [[args.length() + 20], [3]]

    const future<int> doubled = pool.submit(double_value, scalar)
    const future<bool> inverted = pool.submit(invert_value, flag)
    const future<string> suffixed = pool.submit(suffix_value, label)
    const future<int> inspected = pool.submit(inspect_values, values)
    const future<int[][]> copied_rows = pool.submit(copy_rows, rows)
    const future<int> no_argument = pool.submit(no_argument_value)

    values[0] = 99
    rows[0][0] = 88
    print('args=' + args.length())
    print('int=' + doubled.await())
    print(inverted.await())
    print('string=' + suffixed.await())
    print('array_snapshot=' + inspected.await())
    print('no_argument=' + no_argument.await())

    int[][] first_rows = copied_rows.await()
    first_rows[0][0] = 77
    int[][] second_rows = copied_rows.await()
    print('nested_snapshot=' + second_rows[0][0] + ',' + second_rows[1][0])
    return 0

# Case 2
int named_worker(int value):
    return value + 5

int combined_case_2_main(string[] args):
    int x = args.length() + 3
    thread_pool pool = thread_pool(2)
    future<int> first = pool.submit(int x -> x * 2 + 1, x)
    future<int> second = pool.submit(int x -> -x + 20, x + 1)
    const int constant = x + 2
    future<int> third = pool.submit(int x -> (x << 1) | 1, constant)
    future<int> named = pool.submit(named_worker, x + 3)

    print(first.await())
    print(second.await())
    print(third.await())
    print(named.await())
    print(first.await())

    if (x > 0):
        future<int> branch = pool.submit(int x -> x - 1, x)
        print(branch.await())
    for (int i = 0; i < 2; i++):
        future<int> each = pool.submit(int x -> x + 10, i)
        print(each.await())
    return 0

# Case 3
int combined_case_3_main(string[] args):
    int seed = args.length() + 3
    const bool ready = args.length() == 1
    thread_pool pool = thread_pool(2)
    future<bool> positive = pool.submit(int value -> value > 0, seed + 1)
    future<bool> even = pool.submit(int value -> (value % 2) == 0, seed + 1)
    future<bool> below_limit = pool.submit(int value -> value > 0 && value < 10, seed)
    future<bool> inverted = pool.submit(bool flag -> !flag, ready)
    future<bool> negated = pool.submit(bool flag -> not flag, ready)
    future<bool> conjunction = pool.submit(bool flag -> flag and true, ready)
    future<bool> symbolic_or = pool.submit(bool flag -> flag || false, ready)
    future<bool> disjunction = pool.submit(bool flag -> flag or false, ready)
    future<int> bool_result = pool.submit(bool flag -> 41, ready)
    future<int> integer_result = pool.submit(int value -> value * 2 + 1, seed)

    print(positive.await())
    print(even.await())
    print(below_limit.await())
    print(positive.await())
    print(inverted.await())
    print(negated.await())
    print(conjunction.await())
    print(symbolic_or.await())
    print(disjunction.await())
    print(bool_result.await())
    print(integer_result.await())
    print(ready or false)

    if (positive.await()):
        future<bool> in_branch = pool.submit(int value -> value == 4, seed)
        print(in_branch.await())
    for (int index = 0; index < 2; index++):
        future<bool> in_loop = pool.submit(bool flag -> flag == false, index == 0)
        print(in_loop.await())
    return 0

# Case 4
int scalar_worker(int value):
    return value + 1

bool bool_worker(int value):
    return value > 0

string string_worker(string value):
    return value + '!'

int[] array_worker(int value):
    return [value, value + 1]

int[][] rows_worker(int value):
    return [[value]]

int first_item(int[][] rows):
    return rows[0][0]

int combined_case_4_main(string[] args):
    int seed = args.length()
    thread_pool pool = thread_pool(2)
    future<int> scalar = pool.submit(scalar_worker, seed)
    const future<bool> flag = pool.submit(bool_worker, seed)
    future<string> text = pool.submit(string_worker, 'ready')
    future<int[]> values = pool.submit(array_worker, seed)
    future<int[][]> rows = pool.submit(rows_worker, seed)

    print(scalar.await())
    print(flag.await())
    print(text.await())
    print(values.await())
    print(first_item(rows.await()))
    print(scalar.await())

    scalar = pool.submit(int value -> value * 2, seed)
    print(scalar.await())
    if (flag.await()):
        future<int> branch = pool.submit(scalar_worker, seed + 2)
        print(branch.await())
    return 0

# Case 5
int combined_case_5_main(string[] args):
    int seed = args.length()
    const int fixed_seed = seed
    thread_pool pool = thread_pool(2)

    future<int> zero_arg = pool.submit(int value -> constant_value() + value, fixed_seed)
    future<int> multi_arg = pool.submit(int value -> add(value, 10), seed)
    future<bool> bool_result = pool.submit(int value -> is_positive(value), seed)
    future<int> bool_to_int = pool.submit(bool flag -> bool_score(flag), args.length() == 1)
    future<int> nested_call = pool.submit(int value -> add(value, constant_value()), seed)
    future<bool> bool_args = pool.submit(bool flag -> both(flag, true), false)
    future<int> forward_call = pool.submit(int value -> later_helper(value), seed)
    future<int> cached_call = pool.submit(int value -> cached_bump(value), seed)
    future<bool> collision = pool.submit(int value -> is_empty(value - 1), seed)
    future<int> block_call = pool.submit(int value -> {
        if (is_positive(value)) {
            return add(value, 4)
        } else {
            return constant_value()
        }
    }, seed)
    future<int> named_worker = pool.submit(named_helper, seed)
    future<int> expression_worker = pool.submit(int value -> value + 5, seed)

    print(zero_arg.await())
    print(multi_arg.await())
    print(bool_result.await())
    print(bool_to_int.await())
    print(nested_call.await())
    print(bool_args.await())
    print(forward_call.await())
    print(cached_call.await())
    print(collision.await())
    print(block_call.await())
    print(multi_arg.await())
    print(named_worker.await())
    print(expression_worker.await())

    for (int index = 0; index < 2; index++):
        future<int> loop_call = pool.submit(int value -> add(value, 1), seed + index)
        print(loop_call.await())

    future<int> failed = pool.submit(int value -> fail_helper(value), seed)
    int attempts = 0
    while (attempts < 2):
        try:
            int ignored = failed.await()
        catch (exception err):
            print(err)
        attempts += 1
    return 0

int constant_value():
    return 17

int add(int left, int right):
    return left + right

bool is_positive(int value):
    return value > 0

bool both(bool left, bool right):
    return left && right

int bool_score(bool flag):
    if (flag):
        return 6
    return 8

int later_helper(int value):
    return value * 3

int named_helper(int value):
    return value + 7

int fail_helper(int value):
    throw 'submit helper failure'

cached int cached_bump(int value):
    return value + 1

bool is_empty(int value):
    return value == 0

# Case 6
int score = 100

int twice(int value):
    return value * 2

int combined_case_6_main(string[] args):
    thread_pool pool = thread_pool(2)
    future<int> calculated = pool.submit(int value -> {
        int score = twice(value)
        score += 1
        const int result = score
        if (value > 0) {
            bool positive = result > 0
            if (positive) {
                return result
            } else {
                return 0
            }
        } else {
            int fallback = 7
            return fallback
        }
    }, args.length())
    print(calculated.await())
    print(calculated.await())

    future<bool> inverted = pool.submit(bool flag -> {
        bool result = flag
        result = !result
        const bool stable = result
        return stable
    }, args.length() == 1)
    print(inverted.await())

    future<int> fallback = pool.submit(int value -> {
        if (value > 0) {
            return value
        } else {
            int fallback_value = 7
            return fallback_value
        }
    }, 0 - args.length())
    print(fallback.await())

    future<int> changed_parameter = pool.submit(int value -> {
        value += 4
        return value
    }, args.length())
    print(changed_parameter.await())

    for (int index : range(args.length() - 1)) {
        future<int> loop_value = pool.submit(int value -> {
            int offset = value + 1
            return offset
        }, index + args.length())
        print(loop_value.await())
    }
    return 0

# Case 7
int named_failure():
    throw 'named failure'

int combined_case_7_main(string[] args):
    thread_pool pool = thread_pool(2)

    future<int> incremented = pool.submit(int value -> {
        if (value < 0) {
            throw 'negative value'
        } else {
            return value + 1
        }
    }, args.length())

    future<bool> positive = pool.submit(int value -> {
        if (value > 0) {
            return true
        } else {
            throw 'not positive'
        }
    }, 1)

    future<int> failed = pool.submit(int value -> {
        throw 'lambda\n failure'
        return value
    }, 7)
    future<int> empty_failure = pool.submit(int value -> {
        throw ''
        return value
    }, 7)
    future<int> named_failed = pool.submit(named_failure)

    print(incremented.await())
    print(incremented.await())
    print(positive.await())
    print(positive.await())
    try:
        int ignored = failed.await()
    catch (exception err):
        print(err)
    try:
        int ignored = failed.await()
    catch (exception err):
        print(err)
    try:
        int ignored = empty_failure.await()
    catch (exception err):
        print('empty:' + err)
    try:
        int ignored = named_failed.await()
    catch (exception err):
        print(err)
    try:
        int ignored = named_failed.await()
    catch (exception err):
        print(err)
    return 0

# Case 8
int combined_case_8_main(string[] args):
    thread_pool pool = thread_pool(2)
    int bound = 5
    future<int> captured = pool.submit(() -> {
        int total = 0
        for (int item : range(1, bound)) {
            total += item
            item = 99
        }
        return total
    })
    future<int> argument = pool.submit(int end -> {
        int total = 0
        for (int item : range(end)) {
            total += item
        }
        return total
    }, args.length() + 3)
    future<int> control = pool.submit(int limit -> {
        int total = 0
        int __tb_range_start_1 = 0
        int __tb_range_end_2 = 0
        int __tb_range_counter_3 = 0
        for (int outer : range(-2, 2)) {
            for (int nested_outer : range(1)) {
                for (int nested_inner : range(1)) {
                    total += 0
                }
            }
            int inner = 0
            while (inner < 3) {
                inner += 1
                for (int while_range : range(1)) {
                    total += 0
                }
                if (inner == 2) {
                    continue
                }
                if (outer < 0) {
                    switch (outer) {
                        case -2: {
                            for (int case_range : range(1)) {
                                total += 0
                            }
                            total += 1
                            break
                        }
                        default: {
                            for (int default_range : range(1)) {
                                total += 0
                            }
                            total += inner
                        }
                    }
                } else {
                    for (int else_range : range(1)) {
                        total += 0
                    }
                    total += outer
                }
            }
        }
        for (int index = 0; index < 4; index += 1) {
            for (int for_range : range(1)) {
                total += 0
            }
            if (index == 2) {
                continue
            }
            if (index == 3) {
                break
            }
            total += index
        }
        for (int empty : range(0)) {
            total += 100
        }
        for (int equal : range(3, 3)) {
            total += 100
        }
        for (int reversed : range(3, -1)) {
            total += 100
        }
        if (limit == 1) {
            for (int then_range : range(1)) {
                total += 10
            }
        } else {
            for (int else_branch_range : range(2)) {
                total += 10
            }
        }
        switch (limit) {
            case 1: {
                for (int case_branch_range : range(1)) {
                    total += 100
                }
            }
            default: {
                for (int default_branch_range : range(2)) {
                    total += 100
                }
            }
        }
        return total
    }, args.length())
    future<int> early = pool.submit(int end -> {
        for (int item : range(end)) {
            if (item == 3) {
                return item
            }
        }
        return -1
    }, 8)
    future<int> failure = pool.submit(int value -> {
        for (int item : range(1)) {
            if (value < 0) {
                throw 'negative'
            }
            return value
        }
        return -1
    }, -1)
    print(captured.await())
    print(argument.await())
    print(control.await())
    print(early.await())
    try:
        failure.await()
    catch (exception error):
        print(error)
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main(args) != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main(args) != 0):
        return 1
    print('=== case 3 ===')
    if (combined_case_3_main(args) != 0):
        return 1
    print('=== case 4 ===')
    if (combined_case_4_main(args) != 0):
        return 1
    print('=== case 5 ===')
    if (combined_case_5_main(args) != 0):
        return 1
    print('=== case 6 ===')
    if (combined_case_6_main(args) != 0):
        return 1
    print('=== case 7 ===')
    if (combined_case_7_main(args) != 0):
        return 1
    print('=== case 8 ===')
    if (combined_case_8_main(args) != 0):
        return 1
    return 0
