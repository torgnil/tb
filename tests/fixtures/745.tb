import strings;

int calls = 0
string source():
    calls += 1
    return 'banana'
string pattern():
    calls += 1
    return 'ana'

int main():
    print(byte_count(source(), pattern()))
    print(calls)
    print('aaaaa'.byte_count('aa'))
    print(byte_count('abcabcabc', 'abc'))
    print(byte_count('abc', 'abcd'))
    print(byte_count('', 'a'))
    print(byte_count('', ''))
    print(byte_count('abc', ''))
    string text = 'éé'
    print(byte_count(text, 'é'))
    print(byte_count(text, ''))
    string interior = text.substring(1, 2)
    print(text.byte_count(interior))
    print(byte_index_of('banana', 'ana'))
    return 0
