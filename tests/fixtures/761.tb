bool[][] make_rows():
    map<int, bool[]> flags = {1: [true, false], 2: []}
    return flags.values()

int main():
    map<int, bool[]> flags = {1: [true, false], 2: []}
    bool[][] rows = flags.values()
    const bool[][] fixed = flags.values()
    bool[][] direct = copy(rows)
    bool[][] method = fixed.copy()
    direct[0][0] = false
    method[0][1] = true
    print(rows[0][0])
    print(fixed[0][1])
    print(direct[0][0])
    print(method[0][1])
    map<int, bool[]> no_flags = {}
    bool[][] empty_outer = copy(no_flags.values())
    print(empty_outer.length())
    map<int, bool[]> empty_row_map = {1: []}
    bool[][] empty_row = empty_row_map.values().copy()
    print(empty_row.length())
    print(empty_row[0].length())
    bool[][] owned_direct = copy(make_rows())
    bool[][] owned_method = make_rows().copy()
    print(owned_direct[0][0])
    print(owned_method[0][1])
    return 0
