import process;

bool path_exists(string path):
    return false

int main():
    write_all('path-check.txt', 'contents')
    print(path_exists('.'))
    print(is_dir('.'))
    print(is_file('.'))
    print(path_exists('path-check.txt'))
    print(is_file('path-check.txt'))
    print(is_dir('path-check.txt'))
    print(path_exists('missing-path'))
    print(is_file('missing-path'))
    print(is_dir('missing-path'))
    print(path_exists(''))
    print(path_exists('path-check.txt/child'))
    print(path_exists('/dev/null'))
    print(is_file('/dev/null'))
    print(is_dir('/dev/null'))

    ProcessResult file_link = run_process(['ln', '-s', 'path-check.txt', 'file-link'])
    print(file_link.exit_code == 0)
    print(path_exists('file-link'))
    print(is_file('file-link'))
    print(is_dir('file-link'))

    ProcessResult dir_link = run_process(['ln', '-s', '.', 'dir-link'])
    print(dir_link.exit_code == 0)
    print(path_exists('dir-link'))
    print(is_file('dir-link'))
    print(is_dir('dir-link'))
    return 0
