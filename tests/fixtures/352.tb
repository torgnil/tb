int[] length(bool flag):
    if flag:
        return [5, 6]
    return [8, 9]

bool[] is_empty(bool flag):
    if flag:
        return [true, false]
    return [false, false]

string[] index_of(bool flag):
    if flag:
        return ['left', 'right']
    return ['up', 'down']

int[][] hash(bool flag):
    if flag:
        return [[3], [4, 5]]
    return [[6, 7], [8, 9]]

int[] echo_values(int[] values):
    return values

int main(string[] args):
    bool flag = args.length() == 1
    int[] first = flag.length()
    print(first.sum())
    print(sum(echo_values(flag.length())))
    int total = 0
    for (int value : flag.length()):
        total += value
    print(total)
    bool[] flags = flag.is_empty()
    print(flags.length())
    print(flags.sum())
    string[] words = flag.index_of()
    print(words[0])
    print(words.length())
    int[][] grid = flag.hash()
    print(grid[1].sum())
    print(flag.hash().length())
    return 0
