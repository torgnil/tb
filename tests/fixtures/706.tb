import regex;

int main():
    Regex empty = regex_compile('')
    Regex captures = regex_compile('(a?)')
    print(regex_find_all(empty, 'xy').length())
    print(regex_find_all_captures(captures, 'xy').length())
    print(regex_replace(captures, 'xy', '$1!'))
    print('xy'.split(empty).length())
    print('xy'.split(captures).length())
    print(regex_find_all(empty, '').length())
    print(regex_find_all_captures(captures, '').length())
    print(regex_replace(captures, '', '$1!'))
    print(''.split(empty).length())
    return 0
