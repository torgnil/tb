string missing_path(string suffix):
    return 'test-files/missing-open-parent/' + suffix

int main():
    string path = missing_path('dynamic')
    string dynamic_error = ''
    try:
        file bad = open(path)
        close(bad)
    catch (exception err):
        dynamic_error = err
    path = missing_path('changed')

    const string const_path = missing_path('const')
    string const_error = ''
    try:
        file bad = open(const_path)
        close(bad)
    catch (exception err):
        const_error = err

    string temporary_error = ''
    try:
        file bad = open(missing_path('temporary'))
        close(bad)
    catch (exception err):
        temporary_error = err

    file out = open('test-files/498.out')
    write_line(out, dynamic_error)
    write_line(out, const_error)
    write_line(out, temporary_error)
    write_line(out, 'successful open/write/close')
    close(out)
    return 0
