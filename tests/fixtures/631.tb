bool[] make_flags():
    return [true, false]

int main():
    thread_pool pool = thread_pool(1)
    future<int> result = pool.submit(bool[] input -> {
        int total = 0
        for (bool flag : make_flags()) {
            if (flag) {
                total += 1
            }
        }
        return total
    }, [false])
    print(result.await())
    return 0
