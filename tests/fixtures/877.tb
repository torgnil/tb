record GridBox(bool[][] rows);
bool[][] saved = []

bool[][] make_grid():
    return [[true], []]

void save_grid(const bool[][] source):
    saved = source

int main():
    bool[][] source = [[true], []]
    bool[][] first = source
    bool[][] target = [[false]]
    target = source
    source[0][0] = false
    print(first[0][0])
    print(target[0][0])
    print(source[0][0])
    target = target
    print(target[1].length())
    target = make_grid()
    print(target[0][0])
    GridBox box = GridBox(target)
    bool[][] from_field = box.rows
    target[0][0] = false
    print(from_field[0][0])
    save_grid(from_field)
    from_field[0][0] = false
    print(saved[0][0])
    saved = saved
    print(saved.length())
    return 0
