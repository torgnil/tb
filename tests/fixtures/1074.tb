import union_find;

int count_groups(const int[] groups):
    return groups.union_find_component_count()

int main():
    const int[] empty = union_find_new(0)
    print(union_find_component_count(empty))
    int[] groups = union_find_new(5)
    print(union_find_component_count(groups))
    union_find_union(groups, 0, 1)
    union_find_union(groups, 2, 3)
    print(count_groups(groups))
    print(union_find_union(groups, 1, 0))
    print(count_groups(groups))
    union_find_union(groups, 0, 2)
    int[] before = groups.copy()
    print(count_groups(groups))
    print(groups[3] == before[3])
    union_find_union(groups, 3, 4)
    print(union_find_component_count(groups))
    return 0
