int[] range_to(int limit):
    int[] values = []
    int value = 0
    while (value < limit):
        values.push(value)
        value += 1
    return values

int main(string[] args):
    thread_pool pool = thread_pool(1)
    future<int[]> result = pool.submit(range_to, 3)
    print(result.await())
    return 0
