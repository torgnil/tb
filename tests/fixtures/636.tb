int[][] make_grid():
    return [[1, 2], []]

int main():
    thread_pool pool = thread_pool(1)
    future<int> result = pool.submit(int[][] grid -> {
        int sum = 0
        for (const int[] row : make_grid()) {
            sum += row.length()
        }
        return sum
    }, [[3]])
    print(result.await())
    return 0
