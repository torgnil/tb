map<int, int[][]> GLOBAL_INT_GRIDS = {1: [[1, 2], [3]]}
map<string, string[][]> GLOBAL_STRING_GRIDS = {'global': [['g', 'h']]}
map<string, string[][]> GLOBAL_ALIAS_GRIDS = {'source': [['target-5']], 'target-5': [['old']]}

record GridBook(map<int, int[][]> numbers, map<string, string[][]> words);

int[][] make_int_grid(int value):
    return [[value, value + 1], [value + 2]]

string[][] make_string_grid(string value):
    return [[value, value + '-tail'], ['row']]

map<int, int[][]> make_int_grid_map(int value):
    int[][] local_grid = [[value, value + 1], [value + 2]]
    map<int, int[][]> rows = {value: local_grid}
    return rows

map<string, string[][]> make_string_grid_map(string value):
    string[][] local_grid = [[value, value + '-tail'], ['row']]
    map<string, string[][]> rows = {'result': local_grid}
    return rows

string[][] replace_alias_source(string value):
    GLOBAL_ALIAS_GRIDS['source'] = [['changed']]
    return [[value]]

map<int, int[][]> early_grid_map(int value):
    if (value > 0):
        return {1: [[value]]}
    return {}

int main(string[] args):
    int seed = args.length() + 4
    string label = 'tag-' + seed
    print(GLOBAL_INT_GRIDS.length())
    print(GLOBAL_INT_GRIDS[1][0][0])
    print(GLOBAL_STRING_GRIDS.length())
    print(GLOBAL_STRING_GRIDS['global'][0][1])

    int[][] empty_int_grid = []
    string[][] empty_string_grid = []
    int[][] borrowed_int_grid = [[seed, seed + 1], [seed + 2]]
    map<int, int[][]> int_grids = {1: borrowed_int_grid, 2: empty_int_grid}
    borrowed_int_grid[0][0] = 99
    print(int_grids.length())
    print(int_grids[1][0][0])
    print(borrowed_int_grid[0][0])
    print(int_grids[2].length())
    int_grids[1] = make_int_grid(seed + 10)
    print(int_grids[1][0][0])
    int_grids[1] = int_grids[1]
    print(int_grids[1][0][0])
    map<int, int[][]> copied_int_grids = int_grids
    copied_int_grids[1][0][0] = 77
    print(int_grids[1][0][0])
    print(copied_int_grids[1][0][0])
    int_grids[2] = int_grids[1]
    int_grids[1][0][1] = 88
    print(int_grids[2][0][1])

    string[][] borrowed_string_grid = [[label, label + '-tail'], ['row']]
    map<string, string[][]> string_grids = {'source': borrowed_string_grid, 'empty': empty_string_grid}
    borrowed_string_grid[0][0] = 'changed-source'
    print(string_grids['source'][0][0])
    print(borrowed_string_grid[0][0])
    string_grids['source'] = make_string_grid('owned')
    string_grids['source'] = string_grids['source']
    map<string, string[][]> copied_string_grids = string_grids
    copied_string_grids['source'][0][0] = 'copied'
    print(string_grids['source'][0][0])
    print(copied_string_grids['source'][0][0])
    print(string_grids['empty'].length())

    GLOBAL_ALIAS_GRIDS[GLOBAL_ALIAS_GRIDS['source'][0][0]] = replace_alias_source('new-target')
    print(GLOBAL_ALIAS_GRIDS['target-5'][0][0])
    print(GLOBAL_ALIAS_GRIDS['source'][0][0])

    GridBook book = GridBook({1: [[seed + 30, seed + 31]]}, {'entry': [['book']]})
    book.numbers[1] = make_int_grid(seed + 32)
    book.words['entry'] = make_string_grid('field')
    print(book.numbers[1][0][0])
    print(book.words['entry'][0][0])

    map<int, int[][]> duplicate_int_grids = {9: [[1]], 10: [[2]], 9: [[seed + 3]]}
    map<int, string[][]> duplicate_string_grids = {9: [['old']], 10: [['keep']], 9: [['last']]}
    print(duplicate_int_grids.length())
    print(duplicate_int_grids[9][0][0])
    print(duplicate_string_grids.length())
    print(duplicate_string_grids[9][0][0])

    map<int, int[][]> returned_int_grids = make_int_grid_map(seed + 40)
    map<string, string[][]> returned_string_grids = make_string_grid_map(label)
    print(returned_int_grids[seed + 40][0][0])
    print(returned_string_grids['result'][0][0])
    map<int, int[][]> early = early_grid_map(seed)
    print(early[1][0][0])

    map<string, string[][]> loop_grids = {}
    for (int index : range(2)):
        string[][] loop_grid = [['loop-' + index]]
        loop_grids = {'last': loop_grid}
    print(loop_grids.length())
    print(loop_grids['last'][0][0])

    const map<int, int[][]> fixed_grids = {1: [[seed + 50]]}
    print(fixed_grids[1][0][0])
    return 0
