int[] maybe_expand(int value):
    if (value == 1):
        return []
    if (value == 2):
        throw 'flat map failed'
    return [value, value + 100]

int[] source_values():
    return [1, 2, 3]

int[] pair(int value):
    return [value, value]

int main(string[] args):
    try:
        int[] expanded = source_values().flat_map(int value -> maybe_expand(value))
        print(expanded.length())
    catch (string error):
        print(error)
    int[] after_error = [7, 9].flat_map(int value -> pair(value))
    print(after_error.length())
    print(after_error[0])
    print(after_error[3])
    return 0
