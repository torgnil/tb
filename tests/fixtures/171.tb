# A comment may contain helpers/*.ll, */ and quotes ' " without changing lexer state.
int main(string[] args):
    print('first') # unmatched /*, */ and backslash \
    print('second')
    print('third') # unmatched '
    print('fourth')
    print('escaped \' quote') # ' /* must stay in the comment
    /* A hash and an unmatched quote ' remain inside this block comment.
       The closing delimiter still ends the block. */
    string text = 'multiline # /*
*/ string'
    print(text)
