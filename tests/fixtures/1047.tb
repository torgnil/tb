int main():
    thread_pool pool = thread_pool(2)
    string prefix = '<'
    string suffix = '>'
    string[] values = ['a', 'b']

    future<string> expression = pool.submit(string[] task -> prefix + task.length() + suffix, values)
    prefix = '('
    suffix = ')'
    values[0] = 'changed'
    print(expression.await())
    print(expression.await())

    future<string> block = pool.submit(string[] task -> {
        return prefix + task[0] + suffix
    }, ['x'])
    prefix = '['
    suffix = ']'
    print(block.await())

    future<string> failed = pool.submit(string[] task -> {
        if (prefix + suffix == '[]') {
            throw 'multi-capture worker failed'
        }
        return task[0]
    }, ['unused'])
    try:
        print(failed.await())
    catch (exception error):
        print(error)

    string recovery_prefix = 'after-'
    string recovery_suffix = 'failure'
    future<string> recovered = pool.submit(string[] task -> recovery_prefix + task[0] + recovery_suffix, ['pool '])
    recovery_prefix = 'changed-'
    recovery_suffix = 'changed'
    print(recovered.await())
    return 0
