string make_missing_path(string name):
    return 'test-files/missing-write-all-parent/' + name

void show_write_error(string path, bool use_ufcs):
    try:
        if use_ufcs:
            path.write_all('unused')
        else:
            write_all(path, 'unused')
    catch (exception err):
        print(err)

int main(string[] args):
    string path = make_missing_path('first')
    show_write_error(path, false)
    path = make_missing_path('second')
    show_write_error(path, true)
    show_write_error(make_missing_path('third'), false)
    string retained = ''
    path = make_missing_path('retained')
    try:
        write_all(path, 'unused')
    catch (exception err):
        retained = err
    path = make_missing_path('changed-after-catch')
    print(retained)
    return 0
