record Numbers(int[] values);

const int[] GLOBAL_VALUES = [30, 31]

int[] make_values(int n):
    return [n, n + 1]

void copy_parameter(int[] values):
    int[] copy = values
    copy[0] += 100
    print(values[0])
    print(copy[0])
    copy = values
    copy[1] += 200
    print(values[1])
    print(copy[1])

int main(string[] args):
    int n = args.length()
    int[] source = [n + 1, n + 2]
    int[] copy = source
    copy[0] += 100
    source[1] += 10
    print(source[0])
    print(copy[0])
    print(source[1])
    print(copy[1])
    copy = source
    source[0] += 20
    copy[1] += 200
    print(source[0])
    print(copy[0])
    print(source[1])
    print(copy[1])
    source = source
    copy = copy
    print(source[0])
    print(copy[1])

    const int[] fixed = [n + 3, n + 4]
    int[] from_fixed = fixed
    from_fixed[0] += 100
    print(fixed[0])
    print(from_fixed[0])
    from_fixed = fixed
    from_fixed[1] += 200
    print(fixed[1])
    print(from_fixed[1])
    copy_parameter(source)
    print(source[0])
    print(source[1])

    int[] from_global = GLOBAL_VALUES
    from_global[0] += n
    print(GLOBAL_VALUES[0])
    print(from_global[0])
    from_global = GLOBAL_VALUES
    from_global[1] += n
    print(GLOBAL_VALUES[1])
    print(from_global[1])

    int[][] rows = [[n + 5, n + 6]]
    int[] row = rows[0]
    row[0] += 100
    print(rows[0][0])
    print(row[0])
    row = rows[0]
    row[1] += 200
    print(rows[0][1])
    print(row[1])
    Numbers holder = Numbers([n + 7, n + 8])
    int[] field = holder.values
    field[0] += 100
    print(holder.values[0])
    print(field[0])
    field = holder.values
    field[1] += 200
    print(holder.values[1])
    print(field[1])

    int[] empty = []
    int[] empty_copy = empty
    empty_copy.push(n)
    print(empty.length())
    print(empty_copy[0])
    const int[] fixed_empty = []
    empty_copy = fixed_empty
    empty_copy.push(n + 1)
    print(fixed_empty.length())
    print(empty_copy[0])
    int[] owned = [n + 9]
    owned = make_values(n + 10)
    print(owned[0])
    int[] called = make_values(n + 11)
    print(called[0])
    for (int i = 0; i < 3; i++):
        owned = source
        owned[0] += i
    print(source[0])
    print(owned[0])

    if (n > 0):
        int[] branch_copy = source
        branch_copy[0] += 1
        print(branch_copy[0])
    switch (n):
        case 1:
            int[] switch_copy = source
            switch_copy[0] += 2
            print(switch_copy[0])
        default:
            print(0)
    try:
        int[] try_copy = source
        try_copy[0] += 3
        print(try_copy[0])
        throw 'copy'
    catch (exception err):
        int[] catch_copy = source
        catch_copy[0] += 4
        print(catch_copy[0])
    print(source[0])
    return 0
