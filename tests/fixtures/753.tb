int main(string[] args):
    const string path = 'test-files/753-append-output.tmp'
    write_all(path, 'start')
    append_all(path, '|direct')
    path.append_all('|method')
    append_all(path, '')
    print(read_file(path))

    const string new_path = 'test-files/753-append-new.tmp'
    append_all(new_path, 'created')
    append_all(new_path, '')
    print(read_file(new_path))

    const string empty_path = 'test-files/753-append-empty.tmp'
    append_all(empty_path, '')
    print(read_file(empty_path).length())

    try:
        append_all('test-files/missing-append-parent/out', 'unused')
    catch (exception error):
        print(error)
    return 0
