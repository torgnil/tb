import regex;

void show(RegexCapture found):
    print(found.matched)
    print(found.starts.length())
    for (int i = 0; i < found.starts.length(); i += 1):
        print(found.starts[i])
        print(found.ends[i])

int main():
    Regex pattern = regex_compile('(a|aa)(b)?')
    show(pattern.regex_match_captures_at('zaab', 0))
    show(pattern.regex_match_captures_at('zaab', 1))
    show(pattern.regex_match_captures_at('zaab', 2))
    show(regex_compile('^(a?)').regex_match_captures_at('a', 1))
    show(regex_compile('(a?)$').regex_match_captures_at('a', 1))
    show(pattern.regex_match_captures_at('zaab', -1))
    show(pattern.regex_match_captures_at('zaab', 5))
    return 0
