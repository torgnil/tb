bool[][] replace(bool[][] target):
    bool[][] local = [[true]]
    target = local
    print(local[0][0])
    local[0][0] = false
    print(target[0][0])
    return target

bool[][] pass_through(bool[][] value):
    return value

bool[][] constant_result():
    const bool[][] value = [[true]]
    return value

int main():
    bool[][] original = [[false]]
    bool[][] result = replace(original)
    print(original[0][0])
    print(result[0][0])
    bool[][] copied = pass_through(result)
    result[0][0] = false
    print(copied[0][0])
    bool[][] fixed = constant_result()
    print(fixed[0][0])
    return 0
