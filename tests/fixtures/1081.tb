import union_find;

int[] members_for(const int[] groups, int item):
    return groups.union_find_component_members(item)

int main():
    int[] groups = union_find_new(6)
    union_find_union(groups, 2, 0)
    union_find_union(groups, 4, 1)
    union_find_union(groups, 4, 2)
    int[] members = members_for(groups, 0)
    for (int member in members):
        print(member)
    print(groups[0])
    members[0] = 99
    int[] singleton = union_find_component_members(groups, 5)
    print(singleton[0])
    union_find_union(groups, 4, 5)
    print(members.length())
    print(union_find_component_members(groups, 0).length())
    try:
        int[] invalid = union_find_component_members(groups, 6)
        print(invalid.length())
    catch (exception error):
        print(error)
    return 0
