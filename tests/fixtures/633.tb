string[] make_words():
    return ['one', 'two']

int text_length(string text):
    return text.length()

int main():
    thread_pool pool = thread_pool(1)
    string[] values = ['input']
    future<int> result = pool.submit(string[] input -> {
        int total = 0
        for (string word : make_words()) {
            total += text_length(word)
        }
        return total
    }, values)
    print(result.await())
    return 0
