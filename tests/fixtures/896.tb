        varied += varied
    print(regex_contains(regex_compile('a+z'), varied))
    Regex changed = regex_compile('a')
    changed.characters[0] = 'b'
    print(regex_contains(changed, base))
    print(regex_contains(changed, base + 'b'))
    Regex damaged = regex_compile('a')
