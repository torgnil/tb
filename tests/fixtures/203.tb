string last_from_local(string suffix):
    string source = 'temporary-' + suffix
    return source.last()

int main(string[] args):
    int count = args.length()
    string source = 'value-' + count.to_string()
    string inferred = last(source)
    const string fixed = 'fixed-' + count.to_string()
    string explicit = fixed.last()
    string empty = ''
    string empty_last = last(empty)
    string one = 'Z'
    string one_last = one.last()

    print(inferred)
    print(explicit)
    print(empty_last)
    print(one_last)

    source = 'reassigned-' + count.to_string()
    print(inferred)
    print(source.last())
    print(last_from_local(count.to_string()))

    int[] ints = [count + 10, count + 20]
    bool[] flags = [count > 0, false]
    string[] words = ['first-' + count.to_string(), 'tail-' + count.to_string()]
    print(last(ints))
    print(flags.last())
    print(last(words))
    return 0
