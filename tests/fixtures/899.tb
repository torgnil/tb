record Item(int value)

int item_count(Item[] items):
    return items.length()

string item_label(Item[] items):
    if (items.is_empty()):
        return 'empty'
    return items[0].value.to_string()

int length(Item[] items):
    return 99

int main():
    Item[] items = [Item(7), Item(12)]
    print([].item_count())
    print([].item_label())
    print(items.item_count())
    print(items.item_label())
    print(item_count([]))
    print(item_label([]))
    print(items.length())
    return 0
