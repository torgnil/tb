import random;

string[] sample_words(RandomGenerator generator, const string[] words):
    return generator.random_sample_strings(words, words.length())

int main():
    RandomGenerator generator = seeded_random(42)
    RandomGenerator reference = seeded_random(42)
    int number = 8
    string word = number.to_string()
    string[] words = [word, 'red', word, 'blue']
    string[] sample = sample_words(generator, words)
    int[] indices = reference.random_sample_indices(words.length(), words.length())
    for (int i = 0; i < sample.length(); i += 1):
        print(sample[i] == words[indices[i]])
    print(generator.state == reference.state)
    words.clear()
    print(sample.length())
    print(sample.contains(word))
    print(generator.random_sample_strings(words, 0).length())
    try:
        print(generator.random_sample_strings(words, 1).length())
    catch (exception error):
        print(error)
    print(generator.state == reference.state)
    return 0
