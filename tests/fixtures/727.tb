import module_private_enum_a;

record Hidden(string label);
record Holder(Hidden value);

Hidden shared = Hidden('global')

Hidden echo(Hidden value):
    return value

int main():
    Holder item = Holder(echo(Hidden('caller')))
    print(item.value.label)
    print(shared.label)
    print(private_enum_a_value())
    return 0
