record Label(string text);

string concat(int n):
    return 'concat' + n

void discard(int n):
    concat(n)

int main(string[] args):
    int n = args.length()
    print(concat(n))
    discard(n)

    string local = 'local' + n
    print(local)
    local = 'again' + n
    print(local)

    string[] words = []
    words.push('array' + n)
    print(words[0])
    words[0] = 'changed' + n
    print(words[0])
    clear(words)

    Label label = Label('field' + n)
    label.text = 'updated' + n
    print(label.text)

    string borrowed = 'borrowed' + n
    string joined = borrowed + '-tail'
    print(joined)
    print(borrowed)
    print('literal' + n)

    for (int i : range(3)):
        local = 'loop' + i
        print(local)
    return 0
