int[] contains(int left, int right):
    return [left, left + right]

int sum_values(int[] values):
    return values[0] + values[1]

int main(string[] args):
    int seed = args.length() + 7
    int[] saved = seed.contains(3)
    print(saved.length())
    print(sum_values(saved))
    print(sum_values(seed.contains(4)))
    print(sum(seed.contains(5)))
