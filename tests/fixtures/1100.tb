import union_find;

int lookup(const int[] groups, int item):
    return groups.union_find_representative(item)

int main():
    int[] groups = union_find_new(5)
    groups.union_find_union(2, 0)
    groups.union_find_union(3, 1)
    groups.union_find_union(3, 2)
    print(lookup(groups, 0))
    print(groups[0])
    print(lookup(groups, 4))
    print(groups.union_find_find(0))
    print(groups[0])
    try:
        print(lookup(groups, -1))
    catch (exception error):
        print(error)
    try:
        print(lookup(groups, 5))
    catch (exception error):
        print(error)
    return 0
