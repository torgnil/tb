

# Case 1
record Item(int value);

int sum_values(int[] values):
    return values.sum()

int count_flags(bool[] flags):
    return flags.length()

int first_word_length(string[] words):
    return words[0].length()

int first_row_value(int[][] rows):
    return rows[0][0]

int first_item_value(Item[] items):
    return items[0].value

int count_words(string[] words):
    return words.length()

int count_rows(int[][] rows):
    return rows.length()

int combine_lengths(int[] values, int[] other):
    return values.length() + other.length()

void observe_values(int[] values):
    print(values.length())

int[] make_values():
    return [5, 6]

int combined_case_1_main(string[] args):
    int[] values = [4, 5]
    const int[] fixed_values = [6, 7]
    bool[] flags = [true, false]
    string[] words = ['tb']
    int[][] rows = [[8]]
    Item[] items = [Item(9)]
    int[] empty_values = []
    string[] empty_words = []
    int[][] empty_rows = []

    print(sum_values(values))
    print(sum_values(fixed_values))
    print(sum_values(make_values()))
    print(count_flags(flags))
    print(first_word_length(words))
    print(first_row_value(rows))
    print(first_item_value(items))
    print(values.combine_lengths(fixed_values))
    print(sum_values(empty_values))
    print(count_words(empty_words))
    print(count_rows(empty_rows))
    observe_values(values)
    return 0

# Case 2
enum Mode {
    READY,
    DONE
}

int keep_int(int value):
    return value + 1

bool keep_bool(bool value):
    return value

num keep_num(num value):
    return value

string keep_string(string value):
    return value + '!'

cached int cached_keep_int(const int value):
    return value + 2

void print_int(int value):
    print(value)

Mode keep_mode(Mode value):
    return value

int combined_case_2_main(string[] args):
    int seed = args.length()
    const int fixed = seed + 3
    const bool enabled = seed > 1
    const num amount = seed + 0.50
    const string label = 'item-' + seed

    print(keep_int(seed))
    print(seed.keep_int())
    print(keep_bool(enabled))
    print(enabled.keep_bool())
    print(keep_num(amount))
    print(amount.keep_num())
    print(keep_string(label))
    print(label.keep_string())
    print(cached_keep_int(fixed))
    print(keep_int(keep_int(seed)))
    print_int(fixed)

    Mode mode = keep_mode(Mode.READY)
    print(mode)
    return 0

# Case 3
record Point(int x, int y);
record Envelope(Point point);
record Empty();
record SameLayout(int value);

int point_sum(Point point):
    return point.x + point.y

int combine(int seed, Point point):
    return seed + point.x + point.y

void consume(Point point):
    print(point_sum(point))

cached int cached_point_sum(Point point):
    return point.x + point.y

Point copy_point(Point point):
    return point

int empty_value(Empty value):
    return 17

int nested_value(Envelope value):
    return value.point.x + value.point.y

int combined_case_3_main(string[] args):
    int seed = args.length() - 1
    Point source = Point(seed + 3, seed + 4)
    const Point fixed = Point(seed + 5, seed + 6)
    Envelope envelope = Envelope(Point(seed + 7, seed + 8))
    Empty empty = Empty()
    Point copied = copy_point(source)

    print(point_sum(source))
    print(source.point_sum())
    print(2.combine(source))
    print(point_sum(fixed))
    print(nested_value(envelope))
    print(empty_value(empty))
    print(cached_point_sum(source))
    consume(source)
    source.x = 30
    print(copied.x)
    print(copied.y)
    return 0

# Case 4
int lookup_int(map<int, int> values, int key):
    return values[key]

string lookup_text(const map<int, string> values, int key):
    return values[key]

string lookup_text_mutable(map<int, string> values, int key):
    return values[key]

int nested_text_length(map<int, map<string, string[]>> values, int key, string label):
    return values[key][label][0].length()

void print_text(map<int, string> values, int key):
    print(values[key])

int combined_case_4_main(string[] args):
    int seed = args.length() + 3
    map<int, int> numbers = {seed: seed + 10}
    const map<int, string> words = {seed: 'map-' + seed.to_string()}
    map<int, string> mutable_words = {seed: 'map-' + seed.to_string()}
    map<int, int> empty_numbers = {}
    map<int, map<string, string[]>> nested = {seed: {'item': ['nested']}}

    print(lookup_int(numbers, seed))
    print(numbers.lookup_int(seed))
    print(lookup_text(words, seed))
    print(words.lookup_text(seed))
    print(lookup_text(mutable_words, seed))
    print(lookup_text_mutable(words, seed))
    print(lookup_int(empty_numbers, seed))
    print(nested_text_length(nested, seed, 'item'))
    print(nested.nested_text_length(seed, 'item'))
    print_text(words, seed)
    print(numbers[seed])
    print(words[seed])
    print(mutable_words[seed])
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main(args) != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main(args) != 0):
        return 1
    print('=== case 3 ===')
    if (combined_case_3_main(args) != 0):
        return 1
    print('=== case 4 ===')
    if (combined_case_4_main(args) != 0):
        return 1
    return 0
