int calls = 0

int next_index():
    calls += 1
    return 0

map<int, bool[]> make_flags():
    return {4: [true, false]}

int main(string[] args):
    int row_index = args.length() - args.length()
    int column_index = -1
    map<int, bool[]> numbers = {2: [true, false]}
    map<string, bool[]> names = {'x': [false, true]}
    map<int[], bool[]> arrays = {[3]: [true, true]}
    print(numbers.values()[row_index][column_index])
    print(names.values()[row_index][column_index])
    print(arrays.values()[row_index][column_index])
    print(make_flags().values()[next_index()][0])
    print(calls)
    int index = 0
    while (index < 3):
        print(numbers.values()[0][0])
        index += 1
    print(false && numbers.values()[0][0])
    print(true && numbers.values()[0][0])
    bool[][] retained = numbers.values()
    print(retained[0][0])
    retained[0][0] = false
    print(retained[0][0])
    print(numbers[2][0])
    bool[] kept_row = retained[0]
    print(kept_row[1])
    print(retained[0][1])
    return 0
