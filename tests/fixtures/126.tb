int choose(int value):
    if (value < 0):
        return 10
    else:
        return 20

string describe(int value):
    if (value < 0):
        return 'negative ' + value
    else:
        return 'nonnegative ' + value

int switch_result(int value):
    switch (value):
        case 0:
            return 30
        default:
            return 40

int try_result(int value):
    try:
        if (value < 0):
            throw 'negative'
        else:
            return 50
    catch (exception error):
        return 60

int main(string[] args):
    int value = args.length()
    print(choose(value))
    print(choose(0 - value))
    print(describe(value))
    print(describe(0 - value))
    print(switch_result(value))
    print(switch_result(value - 1))
    print(try_result(value))
    print(try_result(0 - value))
    return 0
