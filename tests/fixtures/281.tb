enum Mode {
    READY,
    DONE
}

int keep_int(int value):
    return value + 1

bool keep_bool(bool value):
    return value

num keep_num(num value):
    return value

string keep_string(string value):
    return value + '!'

cached int cached_keep_int(const int value):
    return value + 2

void print_int(int value):
    print(value)

Mode keep_mode(Mode value):
    return value

int main(string[] args):
    int seed = args.length()
    const int fixed = seed + 3
    const bool enabled = seed > 1
    const num amount = seed + 0.50
    const string label = 'item-' + seed

    print(keep_int(seed))
    print(seed.keep_int())
    print(keep_bool(enabled))
    print(enabled.keep_bool())
    print(keep_num(amount))
    print(amount.keep_num())
    print(keep_string(label))
    print(label.keep_string())
    print(cached_keep_int(fixed))
    print(keep_int(keep_int(seed)))
    print_int(fixed)

    Mode mode = keep_mode(Mode.READY)
    print(mode)
    return 0
