import strings;
import strings;

int main(string[] args):
    string text = 'éaéabc'
    string needle = 'ab'
    if (args.length() > 1):
        needle = 'abc'
    print(byte_index_of(text, 'a'))
    print(text.byte_index_of(needle))
    print(byte_index_of_from(text, 'a', 3))
    print(text.byte_index_of_from('éa', 1))
    print(text.index_of('a'))
    int position = byte_index_of(text, 'a')
    print(text.substring(position, position + 1) == 'a')
    string interior = text.substring(1, 2)
    print(byte_index_of(text, interior))
    print(byte_index_of_from(text, interior, 2))
    print(byte_index_of('banana', 'ana'))
    print(byte_index_of_from('banana', 'ana', 2))
    print(byte_index_of('abc', 'abcd'))
    print(byte_index_of('abc', ''))
    print(byte_index_of_from('abc', '', 3))
    print(byte_index_of_from('abc', '', -1))
    print(byte_index_of_from('abc', '', 4))
    print(byte_index_of_from('abc', 'a', 9223372036854775807))
    print(byte_index_of_from('abc', 'a', -9223372036854775807 - 1))
    print(byte_index_of('', ''))
    print(byte_index_of('', 'a'))
    print(text == 'éaéabc')
    return 0
