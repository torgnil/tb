import regex;

int main():
    string text = ''
    int index = 0
    while (index < 20000):
        text += 'a'
        index++
    Regex repeated = regex_compile('a*')
    Regex late_mismatch = regex_compile('a*z')
    Regex anchored = regex_compile('^a*$')
    print(regex_match(repeated, text))
    print(regex_match(repeated, text))
    print(regex_match(late_mismatch, text))
    print(regex_match(regex_compile('z'), text))
    print(regex_match(anchored, text))
    print(regex_match(anchored, text + '\n'))
    print(text.length())
    print(text[0])
    print(text[-1])
    Regex invalid = regex_compile('(')
    print(regex_match(invalid, text))
    Regex damaged = regex_compile('a')
    damaged.start = 999
    print(regex_match(damaged, text))
    return 0
