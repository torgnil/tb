int main():
    thread_pool pool = thread_pool(2)
    string prefix = 'pre-'
    const string item = 'item'
    string suffix = '-end'

    future<string> joined = pool.submit(() -> prefix + item + suffix)
    future<int> size = pool.submit(() -> prefix.length() + item.length() + suffix.length())
    future<bool> valid = pool.submit(() -> {
        if (prefix == 'pre-' && item == 'item' && suffix == '-end') {
            return true
        }
        return false
    })
    prefix = 'changed-'
    suffix = 'changed'

    print(joined.await())
    print(size.await())
    print(valid.await())
    print(joined.await())

    string failure_prefix = 'worker '
    string failure_suffix = 'failed'
    future<string> failed = pool.submit(() -> {
        if (failure_prefix + failure_suffix == 'worker failed') {
            throw 'multi string worker failed'
        }
        return 'unexpected'
    })
    try:
        print(failed.await())
    catch (exception error):
        print(error)

    string recovery_prefix = 'after-'
    string recovery_suffix = 'failure'
    future<string> recovered = pool.submit(() -> recovery_prefix + recovery_suffix)
    recovery_prefix = 'changed-'
    print(recovered.await())
    return 0
