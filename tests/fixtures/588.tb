int main(string[] args):
    bool[] values = [true, false, true, false]
    values.sort()
    print(values[0])
    print(values[1])
    print(values[2])
    print(values[3])

    values = values.sort()
    print(values[0])
    print(values[3])

    bool[] literal_sorted = [true, true, false].sort()
    print(literal_sorted[0])
    print(literal_sorted[2])

    bool[] empty = []
    empty.sort()
    print(empty.length())

    bool[] one = [true]
    one.sort()
    print(one[0])
    return 0
