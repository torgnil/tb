record IndexCell(string name, int value);

int main(string[] args):
    int[] values = [10, 20, 30]
    int last_index = -1
    print(values[last_index])
    print(values[-values.length()])
    print(values[1])
    values[-1] += 5
    print(values[-1])
    values[-2] -= 3
    print(values[1])
    values[0] = 11
    print(values[-values.length()])
    values[-1] <<= 1
    print(values[2])

    bool[] flags = [true, false]
    print(flags[-1])
    flags[-1] = true
    print(flags[1])
    print(flags[-flags.length()])

    string[] words = ['first', 'middle', 'old last']
    print(words[-1])
    words[-1] = 'new last'
    print(words[-1])
    words[-1] = 'final last'
    print(words[-1])
    words[-words.length()] = 'new first'
    print(words[0])

    int[][] rows = [[1, 2], [3, 4]]
    print(rows[-1][-1])
    rows[-1] = [5, 6]
    print(rows[-1][-1])
    rows[-1] = [9, 10]
    print(rows[-1][-1])
    rows[-rows.length()] = [7, 8]
    print(rows[0][0])

    string[][] labels = [['a', 'b'], ['c', 'old d']]
    print(labels[-1][-1])
    labels[-1] = ['e', 'new f']
    print(labels[-1][-1])
    labels[-1] = ['g', 'final h']
    print(labels[-1][-1])
    labels[-labels.length()] = ['new g', 'h']
    print(labels[0][0])

    IndexCell[] cells = [IndexCell('first', 1), IndexCell('old last', 2)]
    print(cells[-1].name)
    cells[-1] = IndexCell('new last', 3)
    print(cells[-1].value)
    cells[-1] = IndexCell('final last', 5)
    print(cells[-1].value)
    cells[-cells.length()] = IndexCell('new first', 4)
    print(cells[0].name)

    int[] one = [7]
    print(one[-1])
    one.push(8)
    print(one[-one.length()])
    one.pop()
    print(one[-one.length()])

    map<int, int> lookup = {0: 12, -1: 34}
    print(lookup[-1])
    return 0
