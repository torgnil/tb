int main(string[] args):
    int seed = args.length()
    const int fixed_seed = seed
    thread_pool pool = thread_pool(2)

    future<int> zero_arg = pool.submit(int value -> constant_value() + value, fixed_seed)
    future<int> multi_arg = pool.submit(int value -> add(value, 10), seed)
    future<bool> bool_result = pool.submit(int value -> is_positive(value), seed)
    future<int> bool_to_int = pool.submit(bool flag -> bool_score(flag), args.length() == 1)
    future<int> nested_call = pool.submit(int value -> add(value, constant_value()), seed)
    future<bool> bool_args = pool.submit(bool flag -> both(flag, true), false)
    future<int> forward_call = pool.submit(int value -> later_helper(value), seed)
    future<int> cached_call = pool.submit(int value -> cached_bump(value), seed)
    future<bool> collision = pool.submit(int value -> is_empty(value - 1), seed)
    future<int> block_call = pool.submit(int value -> {
        if (is_positive(value)) {
            return add(value, 4)
        } else {
            return constant_value()
        }
    }, seed)
    future<int> named_worker = pool.submit(named_helper, seed)
    future<int> expression_worker = pool.submit(int value -> value + 5, seed)

    print(zero_arg.await())
    print(multi_arg.await())
    print(bool_result.await())
    print(bool_to_int.await())
    print(nested_call.await())
    print(bool_args.await())
    print(forward_call.await())
    print(cached_call.await())
    print(collision.await())
    print(block_call.await())
    print(multi_arg.await())
    print(named_worker.await())
    print(expression_worker.await())

    for (int index = 0; index < 2; index++):
        future<int> loop_call = pool.submit(int value -> add(value, 1), seed + index)
        print(loop_call.await())

    future<int> failed = pool.submit(int value -> fail_helper(value), seed)
    int attempts = 0
    while (attempts < 2):
        try:
            int ignored = failed.await()
        catch (exception err):
            print(err)
        attempts += 1
    return 0

int constant_value():
    return 17

int add(int left, int right):
    return left + right

bool is_positive(int value):
    return value > 0

bool both(bool left, bool right):
    return left && right

int bool_score(bool flag):
    if (flag):
        return 6
    return 8

int later_helper(int value):
    return value * 3

int named_helper(int value):
    return value + 7

int fail_helper(int value):
    throw 'submit helper failure'

cached int cached_bump(int value):
    return value + 1

bool is_empty(int value):
    return value == 0
