int[] from_bool(bool value):
    if (value):
        return [1]
    return [0]

int[] from_string(string value):
    return [value.length()]

int[] from_rows(int[][] rows):
    return [rows[0][0]]

int main(string[] args):
    int[][] rows = [[7]]
    thread_pool pool = thread_pool(1)
    future<int[]> a = pool.submit(from_bool, true)
    future<int[]> b = pool.submit(from_string, 'four')
    future<int[]> c = pool.submit(from_rows, rows)
    rows[0][0] = 99
    print(a.await())
    print(b.await())
    print(c.await())
    return 0
