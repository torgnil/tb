record pop(bool[] flags);
record Holder(pop item);

int main(string[] args):
    bool dynamic_value = args.length() > 1
    const bool[] seed = [true, dynamic_value]
    pop value = pop(seed)
    Holder holder = Holder(value)
    print(seed.length())
    print(holder.item.flags.pop())
    print(holder.item.flags.pop())
    print(holder.item.flags.pop())
    print(holder.item.flags.length())
    print(seed.length())
    return 0
