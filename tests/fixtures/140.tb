record Kept(string text, string[] words, int count);

void noop() {}

void borrowed(int n, bool flag, string text, string[] words, int[] numbers, Kept holder) {}

void comment_only() {
    # A comment does not create an instruction.
    /* Neither does a block comment. */
}

void explicit_return():
    return

int evaluated(int n):
    print('evaluated')
    return n + 1

int main(string[] args):
    int n = args.length() + 4
    string text = 'kept-' + n.to_string()
    string[] words = [text]
    int[] numbers = [n, n + 1]
    Kept holder = Kept(text, words, n)
    noop()
    comment_only()
    explicit_return()
    borrowed(evaluated(n), n > 0, text, words, numbers, holder)
    int i = 0
    while (i < 3):
        if (i % 2 == 0):
            borrowed(n, true, text, words, numbers, holder)
        else:
            noop()
            borrowed(n, false, text, words, numbers, holder)
        i += 1
    print(text)
    print(words[0])
    print(numbers[0])
    print(holder.text)
    print(holder.words[0])
    words.push('after')
    numbers[0] += 2
    holder.count += 3
    borrowed(n, true, text, words, numbers, holder)
    print(words[1])
    print(numbers[0])
    print(holder.count)
    return 0
