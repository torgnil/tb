bool[][] saved = []

void publish():
    bool[][] local = [[true], [false]]
    saved = local

int main():
    publish()
    print(saved[0][0])
    print(saved[1][0])
    bool[][] target = [[true]]
    try:
        bool[][] copied = target
        target = [[false]]
        print(copied[0][0])
        throw 'caught'
    catch (exception error):
        print(error)
    print(target[0][0])
    return 0
