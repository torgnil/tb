import uuid;

int main():
    Uuid a = uuid_parse('7fffffff-ffff-ffff-ffff-ffffffffffff')
    Uuid b = uuid_parse('80000000-0000-0000-0000-000000000000')
    Uuid c = uuid_parse('80000000-0000-0000-7fff-ffffffffffff')
    Uuid d = uuid_parse('80000000-0000-0000-8000-000000000000')
    Uuid same = uuid_parse('7FFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF')
    print(a.uuid_compare(b))
    print(b.uuid_compare(a))
    print(c.uuid_compare(d))
    print(d.uuid_compare(c))
    print(a.uuid_compare(same))
    Uuid[] values = [d, a, c, b]
    values.sort(uuid_compare)
    for (Uuid value in values):
        print(value.uuid_format())
    return 0
