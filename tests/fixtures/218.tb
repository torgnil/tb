record Box(int[] values);
record Holder(int value);

int push(int value, int extra):
    return value + extra

int main(string[] args):
    int n = args.length()
    const int value = n + 2
    int[] numbers = [n]
    numbers.push(value)
    print(numbers[-1])
    numbers.push(('' + n).to_int())
    print(numbers[-1])
    string[] number_text = [(n + 10).to_string()]
    numbers.push(number_text[0].to_int())
    print(numbers[-1])
    const bool flag = n == 1
    bool[] flags = []
    flags.push(flag)
    print(flags[0])
    const string word = 'word-' + n
    string[] words = []
    words.push(word)
    print(words[0])
    int[][] rows = []
    const int[] row = [n + 4]
    rows.push(row)
    rows[0][0] += 10
    print(row[0])
    print(rows[0][0])
    rows.push([n + 6])
    print(rows[1][0])
    rows[1][0] += 1
    print(rows[1][0])
    int[] empty_row = []
    rows.push(empty_row)
    print(rows[2].length())
    string[][] groups = []
    const string[] group = ['group-' + n]
    groups.push(group)
    groups[0][0] = 'changed'
    print(group[0])
    string[] empty_group = []
    groups.push(empty_group)
    print(groups[1].length())
    const Box box = Box([n])
    Box[] boxes = []
    boxes.push(box)
    boxes[0].values[0] += 20
    print(box.values[0])
    print(boxes[0].values[0])
    boxes.push(Box([n + 3]))
    print(boxes[1].values[0])
    Holder holder = Holder(n)
    print(holder.value.push(5))
    print(push(n, 7))
    return 0
