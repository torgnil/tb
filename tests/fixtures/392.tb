import regex;

# Case 1

void show(RegexMatch match):
    print(match.matched)
    print(match.start)
    print(match.end)

int combined_case_1_main():
    show(regex_find_from(regex_compile('a+'), 'xxaaab', 0))
    show(regex_find_from(regex_compile('a+'), 'xxaaab', 3))
    show(regex_find_from(regex_compile('a+'), 'xxaaab', 6))
    show(regex_find_from(regex_compile('a|aa'), 'aa', 0))
    show(regex_find_from(regex_compile('aa|a'), 'aa', 0))
    show(regex_find_from(regex_compile('a*'), 'baaa', 0))
    show(regex_find_from(regex_compile('a.*z|b'), 'abxxz', 0))
    show(regex_find_from(regex_compile('a.*z|b'), 'abxxz', 1))
    show(regex_find_from(regex_compile('((b*|ab)+)+'), 'bab', 0))
    show(regex_find_from(regex_compile('((b*|ab)+)+'), 'bab', 1))
    show(regex_find_from(regex_compile('((((^)*(^|.))){0,2}b)'), 'abb', 0))
    show(regex_find_from(regex_compile('((((^|[ab])){1,2}((.a)|b))|(a|(b|([ab]){1,2})))'), 'abb', 0))
    show(regex_find_from(regex_compile('(b*|ab){1,2}b'), 'abb', 0))
    show(regex_find_from(regex_compile('(a?){2,}'), 'aaab', 0))
    show(regex_find_from(regex_compile('^a|b+$'), 'abbb', 0))
    show(regex_find_from(regex_compile('^a|b+$'), 'abbb', 1))
    show(regex_find_from(regex_compile('$'), 'abc\n', 0))
    show(regex_find_from(regex_compile('$'), 'abc\n', 3))
    show(regex_find_from(regex_compile('$'), 'abc\n', 4))
    show(regex_find_from(regex_compile('^'), 'abc', 1))
    show(regex_find_from(regex_compile(''), '', 0))
    show(regex_find_from(regex_compile(''), 'abc', 3))
    show(regex_find_from(regex_compile('[a-c]+'), 'xabc', 0))
    show(regex_find_from(regex_compile('\\d+'), 'a12b', 0))
    show(regex_find_from(regex_compile('a'), 'a', -1))
    show(regex_find_from(regex_compile('a'), 'a', 2))
    show(regex_find_from(regex_compile('('), 'a', 0))
    show(regex_find_from(regex_compile('x'), 'éx', 0))
    show(regex_find_from(regex_compile('x'), 'éx', 1))
    show(regex_find(regex_compile('b+'), 'abbb'))
    Regex invalid = Regex(true, 0, [10], [0], [-1], [''])
    show(regex_find(invalid, 'a'))
    Regex bad_depth = Regex(true, 0, [11], [0], [0], [''])
    show(regex_find(bad_depth, 'a'))
    Regex bad_class = Regex(true, 0, [6, 4], [1, -1], [-1, -1], ['z-a', ''])
    show(regex_find(bad_class, ''))
    Regex bad_split = Regex(true, 0, [3, 4], [1, -1], [99, -1], ['', ''])
    show(regex_find(bad_split, ''))
    Regex bad_character = Regex(true, 0, [3, 4, 1], [1, -1, 99], [2, -1, -1], ['', '', 'a'])
    show(regex_find(bad_character, ''))
    Regex bad_epsilon = Regex(true, 0, [3, 4, 7], [1, -1, 99], [2, -1, -1], ['', '', ''])
    show(regex_find(bad_epsilon, ''))
    Regex unused_slots = Regex(true, 0, [4], [-1], [-1], [''])
    show(regex_find(unused_slots, ''))
    RegexMatch original = regex_find(regex_compile('b+'), 'abbb')
    RegexMatch copy = original
    original.start = 99
    show(copy)
    return 0

# Case 2

int combined_case_2_main():
    print(regex_compile('a{1000}').valid)
    print(regex_compile('(a{100}){100}').valid)
    print(regex_compile('((a{100}){1}){100}').valid)
    print(regex_compile('(a{100}){101}').valid)
    return 0

# Case 3

string[] split(string text, string separator):
    return ['user function']

int combined_case_3_main():
    print(split('a,b', ',')[0])
    print('a,b'.split(',')[0])
    print(split('a,b', regex_compile(','))[0])
    print('a,b'.split(regex_compile(','))[0])
    return 0

# Case 4

void show_full(string pattern, string text):
    RegexCapture capture = regex_match_captures(regex_compile(pattern), text)
    print(capture.matched)
    print(capture.starts[2])
    print(capture.ends[2])

int combined_case_4_main():
    show_full('((^)|a)+', 'a')
    RegexCapture search = regex_find_captures(regex_compile('((^)|a)+$'), 'aa')
    print(search.matched)
    print(search.starts[2])
    print(search.ends[2])
    Regex twelve = regex_compile('((((((((((((a)+)+)+)+)+)+)+)+)+)+)+)+')
    Regex thirteen = regex_compile('(((((((((((((a)+)+)+)+)+)+)+)+)+)+)+)+)+')
    print(regex_match_captures(twelve, 'a').matched)
    print(regex_find_captures(twelve, 'a').matched)
    try:
        print(regex_match_captures(thirteen, 'a').matched)
    catch (exception err):
        print(err)
    try:
        print(regex_find_captures(thirteen, 'a').matched)
    catch (exception err):
        print(err)
    print(regex_match(thirteen, 'a'))
    print(regex_find(thirteen, 'a').matched)
    Regex alternate = regex_compile('^|(((((((((((((a)+)+)+)+)+)+)+)+)+)+)+)+)+')
    print(regex_find_captures(alternate, 'a').matched)
    try:
        print(regex_match_captures(alternate, 'a').matched)
    catch (exception err):
        print(err)
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main() != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main() != 0):
        return 1
    print('=== case 3 ===')
    if (combined_case_3_main() != 0):
        return 1
    print('=== case 4 ===')
    if (combined_case_4_main() != 0):
        return 1
    return 0
