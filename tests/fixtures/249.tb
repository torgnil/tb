int EFFECT_COUNT = 0

const map<int, map<int, string>> GLOBAL_GROUPS = {
    -4: {1: 'global-old'},
    0: {0: 'zero'},
    -4: {1: 'global-new', 2: 'kept'}
}

record GroupBox(map<int, map<int, string>> groups);

map<int, string> make_inner(int seed):
    return {seed: 'old-' + seed.to_string(), seed + 1: 'middle-' + seed.to_string(), seed: 'new-' + seed.to_string()}

map<int, map<int, string>> make_groups(int key, int seed):
    return {key: make_inner(seed), key + 1: make_inner(seed + 1), key: make_inner(seed + 2)}

int next_key():
    EFFECT_COUNT += 1
    return 77

map<int, string> next_inner():
    EFFECT_COUNT += 1
    return {EFFECT_COUNT: 'effect-' + EFFECT_COUNT.to_string()}

int main(string[] args):
    int n = args.length()
    int base = 20 + n * 10
    string token = n.to_string()

    print(GLOBAL_GROUPS.length())
    print(GLOBAL_GROUPS.keys()[0])
    print(GLOBAL_GROUPS[-4][1])
    print(GLOBAL_GROUPS[-4][2])

    map<int, string> shared = {n: 'shared-' + token, n + 1: 'second-' + token}
    map<int, map<int, string>> runtime = {
        -base: shared,
        base + 2: {n: 'middle-' + token},
        base: {n: 'first-' + token},
        -base: {n: 'last-' + token, n + 1: 'last-second-' + token}
    }
    string[] runtime_keys = runtime.keys()
    print(runtime.length())
    print(runtime_keys[0])
    print(runtime_keys[1])
    print(runtime_keys[2])
    print(runtime[-base][n])
    print(runtime[-base][n + 1])
    shared[n] = 'changed-' + token
    print(shared[n])
    print(runtime[-base][n])

    map<int, map<string, int>> string_key_inner = {
        base: {'left-' + token: n, 'right-' + token: n + 1},
        base + 1: {'other-' + token: n + 2},
        base: {'left-' + token: n + 10, 'last-' + token: n + 11}
    }
    print(string_key_inner.length())
    print(string_key_inner[base]['left-' + token])
    print(string_key_inner[base]['last-' + token])

    const map<int, map<int, string>> fixed = {
        base: {1: 'const-old'},
        base + 1: {2: 'const-only'},
        base: {1: 'const-new'}
    }
    print(fixed.length())
    print(fixed[base][1])
    print(fixed[base + 1][2])

    map<int, map<int, string>> copied = runtime
    copied[-base][n] = 'copy-' + token
    print(runtime[-base][n])
    print(copied[-base][n])

    map<int, string> empty_inner = {}
    map<int, map<int, string>> empty_to_full = {
        base + 3: empty_inner,
        base + 4: {n: 'other-' + token},
        base + 3: {n: 'filled-' + token}
    }
    map<int, map<int, string>> full_to_empty = {
        base + 5: {n: 'removed-' + token},
        base + 6: {n: 'kept-' + token},
        base + 5: empty_inner
    }
    print(empty_to_full.length())
    print(empty_to_full[base + 3][n])
    print(full_to_empty.length())
    print(full_to_empty[base + 5].length())
    print(full_to_empty[base + 6][n])

    map<int, map<int, string>> calls = {
        base + 7: make_inner(base),
        base + 8: make_inner(base + 1),
        base + 7: make_inner(base + 2)
    }
    print(calls.length())
    print(calls[base + 7][base + 2])
    print(calls[base + 8][base + 1])

    map<int, map<int, string>> returned = make_groups(base + 9, base + 10)
    print(returned.length())
    print(returned[base + 9][base + 12])
    print(returned[base + 10][base + 11])

    GroupBox box = GroupBox({base + 11: {n: 'box-old'}, base + 12: {n: 'box-only'}, base + 11: {n: 'box-new'}})
    GroupBox clone = box
    clone.groups[base + 11][n] = 'clone-' + token
    print(box.groups.length())
    print(box.groups[base + 11][n])
    print(clone.groups[base + 11][n])

    map<int, map<int, map<string, string>>> deep = {
        base + 13: {n: {'leaf-' + token: 'deep-old'}},
        base + 14: {n: {'other-' + token: 'other'}},
        base + 13: {n: {'leaf-' + token: 'deep-new'}}
    }
    print(deep.length())
    print(deep[base + 13][n]['leaf-' + token])

    if (n > 0):
        map<int, map<int, string>> branched = {base + 15: {n: 'branch-old'}, base + 16: {n: 'branch'}, base + 15: {n: 'branch-new'}}
        print(branched.length())
        print(branched[base + 15][n])
    for (int i : range(2)):
        map<int, map<int, string>> looped = {base + 17 + i: {n: 'loop-old'}, base + 18 + i: {n: 'loop-middle'}, base + 17 + i: {n: 'loop-new'}}
        print(looped.length())
        print(looped[base + 17 + i][n])

    map<int, map<int, string>> effects = {next_key(): next_inner(), next_key(): next_inner(), next_key(): next_inner()}
    print(EFFECT_COUNT)
    print(effects.length())
    print(effects[77][6])

    map<int, map<int, string>> empty = {}
    map<int, map<int, string>> unique = {-1: {n: 'negative'}, 0: {n: 'zero'}, base + 19: {n: 'runtime-' + token}}
    print(empty.length())
    print(unique.length())
    print(unique[-1][n])
    print(unique[base + 19][n])
    return 0
