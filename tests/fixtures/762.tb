record Item(int id, string label, bool active)

int main():
    set<Item> values = {Item(1, 'one', true), Item(2, 'two', false), Item(3, 'three', true)}
    print(values.remove(Item(2, 'two', false)))
    print(values.length())
    print(values.contains(Item(1, 'one', true)))
    print(values.contains(Item(2, 'two', false)))
    print(values.remove(Item(2, 'different', false)))
    print(values.remove(Item(1, 'one', true)))
    print(values.remove(Item(3, 'three', true)))
    print(values.remove(Item(3, 'three', true)))
    print(values.is_empty())

    set<Item> empty = {}
    print(empty.remove(Item(4, 'four', false)))
    print(empty.length())
    print(values.add(Item(5, 'five', true)))
    print(values.contains(Item(5, 'five', true)))
    return 0
