bool[][] make_grid():
    return [[true, false], [], [false, true], [true]]

bool[][] select_middle(bool[][] source):
    return source[-3:-1]

int main():
    bool[][] grid = make_grid()
    bool[][] middle = select_middle(grid)
    print(middle.length())
    print(middle[0].length())
    print(middle[1][0])
    middle[1][0] = true
    print(grid[2][0])
    print(middle[1][0])

    bool[][] prefix = grid[:2]
    bool[][] suffix = grid[2:]
    bool[][] clamped = grid[-9:20]
    bool[][] reversed = grid[3:1]
    bool[][] equal = grid[2:2]
    print(prefix.length())
    print(prefix[1].length())
    print(suffix.length())
    print(suffix[0][1])
    print(clamped.length())
    print(reversed.length())
    print(equal.length())

    const bool[][] fixed = [[false], [true, false]]
    bool[][] fixed_rows = fixed[-2:]
    print(fixed_rows.length())
    print(fixed_rows[1][0])
    fixed_rows[1][0] = false
    print(fixed[1][0])

    bool[][] from_temporary = make_grid()[1:3]
    print(from_temporary.length())
    print(from_temporary[0].length())
    print(from_temporary[1][1])
    from_temporary[1][1] = false
    print(from_temporary[1][1])

    bool[][] empty = []
    bool[][] empty_slice = empty[0:]
    print(empty_slice.length())
    return 0
