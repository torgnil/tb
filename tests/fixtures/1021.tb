import process;

string[] walk_dir(string path):
    return ['shadowed']

int main():
    string[] fixture_assets = [
        'test-files/walk-dir/.hidden',
        'test-files/walk-dir/alpha.txt',
        'test-files/walk-dir/nested/child.txt',
        'test-files/walk-dir/nested/deep/grandchild.txt',
        'test-files/walk-dir/zeta.txt'
    ]
    ensure_dir('test-files/walk-dir/empty')
    ProcessResult link_result = run_process(['python3', '-I', '-S', 'test-files/process_child.py', 'symlink', 'nested', 'test-files/walk-dir/link', 'directory'])
    if (link_result.exit_code != 0):
        throw 'could not create symlink fixture: ' + link_result.stderr

    for (string path : walk_dir('test-files/walk-dir////')):
        print(path)
    print(walk_dir('test-files/walk-dir/empty').length())
    return 0
