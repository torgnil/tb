bool[] slice(bool[] values, int start, int end):
    return values[start:end]

int main(string[] args):
    bool[] values = [true, false]
    bool[] bool_part = values[0:1]
    int[] numbers = [1, 2]
    int[] int_part = numbers[0:1]
    string[] words = ['first', 'second']
    string[] string_part = words[0:1]

    bool[] direct = slice(values, 0, 1)
    bool[] ufcs = values.slice(0, 1)
    print(bool_part.length())
    print(int_part.length())
    print(string_part.length())
    print(direct.length())
    print(ufcs.length())
    return 0
