const map<string, int> GLOBAL_EMPTY = {}
const map<int, int> GLOBAL_ZERO = {7: 0}

bool contains(int left, int right):
    return left == right

void check_int(map<int, int> counts, int key):
    print(counts.contains(key))
    print(contains(counts, key))
    print(key in counts)
    print(key not in counts)
    print(counts.contains(key + 1000))
    print(contains(counts, key + 1000))
    print((key + 1000) in counts)
    print((key + 1000) not in counts)

void check_string(map<string, int> counts, string key, string missing):
    print(counts.contains(key))
    print(contains(counts, key))
    print(key in counts)
    print(key not in counts)
    print(counts.contains(missing))
    print(contains(counts, missing))
    print(missing in counts)
    print(missing not in counts)
    print(key)

int main(string[] args):
    int key = args.length() + 6
    string text_key = 'key-' + key.to_string()
    string absent = 'missing-' + key.to_string()
    map<int, int> counts = {key: 0}
    const map<int, int> fixed_counts = {key: 0}
    check_int(counts, key)
    check_int(fixed_counts, key)
    map<string, int> named = {text_key: 0}
    const map<string, int> fixed_named = {text_key: 0}
    check_string(named, text_key, absent)
    check_string(fixed_named, text_key, absent)

    map<int, string> labels = {key: ''}
    const map<int, string> fixed_labels = {key: ''}
    print(labels.contains(key))
    print(contains(fixed_labels, key))
    print(key in labels)
    print(key not in fixed_labels)
    print(labels.contains(key + 1))
    print(labels[key])
    map<string, string> names = {text_key: ''}
    const map<string, string> fixed_names = {text_key: ''}
    print(names.contains(text_key))
    print(contains(fixed_names, text_key))
    print(text_key in names)
    print(text_key not in fixed_names)
    print(names.contains(absent))
    print(names[text_key])

    const map<int, int> empty_int = {}
    const map<int, string> empty_label = {}
    const map<string, string> empty_name = {}
    print(empty_int.contains(key))
    print(contains(empty_label, key))
    print(text_key in empty_name)
    print(text_key not in GLOBAL_EMPTY)
    print(GLOBAL_ZERO.contains(key))
    print(GLOBAL_ZERO[7])

    counts[key] = key * 3
    named[text_key] = key * 3
    int i = 0
    while (i < 40):
        counts[i] = 0
        named['grow-' + i.to_string()] = 0
        i += 1
    int found = 0
    for (int j = 0; j < 40; j++):
        if (j in counts):
            found += 1
        if (contains(named, 'grow-' + j.to_string())):
            found += 1
    print(found)
    print(counts.length())
    print(named.length())
    print(counts.contains(1000 + key))
    print(named.contains(absent))
    print(named[text_key])
    print(text_key)

    if (key > 0):
        const map<int, int> branch_map = {key: 0}
        print(branch_map.contains(key))
    switch (key):
        case 7:
            print(contains(fixed_counts, key))
        default:
            print(false)
    try:
        print(text_key in fixed_named)
        throw 'query'
    catch (exception err):
        print(absent not in fixed_named)
    print(contains(key, key))
    print(key.contains(key))
    return 0
