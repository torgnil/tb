import strings;

void show(int[] matches):
    print(matches.length())
    for (int position in matches):
        print(position)

int main():
    show('aaaaa'.byte_find_all('aa'))
    show('aaaaa'.byte_find_all_from('aa', 1))
    show('abc'.byte_find_all_from('', 2))
    show('abc'.byte_find_all_from('', 3))
    show('abc'.byte_find_all_from('', 4))
    show('abc'.byte_find_all_from('', -1))
    show('abc'.byte_find_all('xyz'))
    show(''.byte_find_all(''))
    return 0
