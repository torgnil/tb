record Item(int code, string label);

map<int, int> GLOBAL_NUMBERS = {1: 10}
map<int, Item[]> GLOBAL_ROWS = {1: []}

map<int, int> make_numbers(int value):
    return {1: value, 2: value + 1}

map<int, int> pass_numbers(map<int, int> values):
    values = make_numbers(values[1])
    return values

void replace_numbers(map<int, int> target, map<int, int> replacement):
    target = replacement
    print(target[1])

int main(string[] args):
    int seed = args.length() + 4
    const map<int, int> fixed = {1: seed, 2: seed + 1}
    map<int, int> copied = fixed
    map<int, int> reassigned = {1: 0}
    reassigned = copied
    copied[1] = 90
    print(fixed[1])
    print(reassigned[1])
    print(copied[1])

    map<string, int[]> rows = {'empty': [], 'full': [seed, seed + 1]}
    map<string, int[]> row_copy = rows
    row_copy['full'][0] = 70
    print(rows['empty'].length())
    print(rows['full'][0])
    print(row_copy['full'][0])

    map<int, map<string, int>> nested = {1: {'leaf': seed}, 2: {}}
    map<int, map<string, int>> nested_copy = nested
    nested_copy[1]['leaf'] = 80
    print(nested[1]['leaf'])
    print(nested_copy[1]['leaf'])
    print(nested[2].length())

    map<int, Item> items = {1: Item(seed, 'first')}
    const map<int, Item> fixed_items = items
    map<int, Item> item_copy = fixed_items
    item_copy[1] = Item(seed + 10, 'copy')
    print(items[1].code)
    print(item_copy[1].code)

    map<string, Item[]> item_rows = {'empty': [], 'full': [Item(seed + 20, 'row')]}
    map<string, Item[]> item_rows_copy = item_rows
    item_rows_copy['full'][0].code = 99
    print(item_rows['empty'].length())
    print(item_rows['full'][0].code)
    print(item_rows_copy['full'][0].code)

    map<int, int> from_helper = pass_numbers(make_numbers(seed + 30))
    print(from_helper[1])
    print(from_helper[2])
    replace_numbers(from_helper, make_numbers(seed + 40))
    print(from_helper[1])

    map<int, int> branch = {1: seed}
    if (seed > 0):
        branch = {1: seed + 50}
    else:
        branch = {1: seed + 60}
    for (int index : range(2)):
        branch = {1: branch[1] + index}
    print(branch[1])

    GLOBAL_NUMBERS = {1: seed + 70}
    GLOBAL_ROWS = {2: [], 3: [Item(seed + 80, 'global')]}
    print(GLOBAL_NUMBERS[1])
    print(GLOBAL_ROWS[2].length())
    print(GLOBAL_ROWS[3][0].code)

    map<int, int> spaced = make_numbers(seed + 90)
    map< int , int > spaced_copy = spaced
    print(spaced_copy[2])
    map<int, int> empty_numbers = {}
    print(empty_numbers.length())
    return 0
