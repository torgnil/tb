record MapRows(map<int, string[]> rows);
record Cell(int value);

map<int, int> empty_int_int(int seed):
    if (seed == 1):
        return {}
    return {}

map<int, bool> empty_int_bool():
    return {}

map<int, string> empty_int_string():
    return {}

map<string, int> empty_string_int():
    return {}

map<string, bool> empty_string_bool():
    return {}

map<string, string> empty_string_string():
    return {}

map<int, int[]> empty_int_int_array():
    return {}

map<int, string[]> empty_int_string_array():
    return {}

map<string, int[]> empty_string_int_array():
    return {}

map<string, string[]> empty_string_string_array():
    return {}

map<int, map<string, int>> empty_nested_int_string():
    return {}

map<string, map<int, int>> empty_nested_string_int():
    return {}

map<int, Cell> empty_record_int():
    return {}

map<string, Cell> empty_record_string():
    return {}

int main(string[] args):
    int n = args.length()
    const map<int, int> untouched_int_int = empty_int_int(n)
    map<int, int> changed_int_int = empty_int_int(n)
    changed_int_int[n] = n + 10
    print(untouched_int_int.length())
    print(changed_int_int.length())
    print(changed_int_int[n])
    const map<int, bool> untouched_int_bool = empty_int_bool()
    map<int, bool> changed_int_bool = empty_int_bool()
    changed_int_bool[n] = true
    print(untouched_int_bool.length())
    print(changed_int_bool.length())
    print(changed_int_bool[n])
    const map<int, string> untouched_int_string = empty_int_string()
    map<int, string> changed_int_string = empty_int_string()
    changed_int_string[n] = 'v' + n.to_string()
    print(untouched_int_string.length())
    print(changed_int_string.length())
    print(changed_int_string[n])
    const map<string, int> untouched_string_int = empty_string_int()
    map<string, int> changed_string_int = empty_string_int()
    changed_string_int['k' + n.to_string()] = n + 20
    print(untouched_string_int.length())
    print(changed_string_int.length())
    print(changed_string_int['k' + n.to_string()])
    const map<string, bool> untouched_string_bool = empty_string_bool()
    map<string, bool> changed_string_bool = empty_string_bool()
    changed_string_bool['k' + n.to_string()] = true
    print(untouched_string_bool.length())
    print(changed_string_bool.length())
    print(changed_string_bool['k' + n.to_string()])
    const map<string, string> untouched_string_string = empty_string_string()
    map<string, string> changed_string_string = empty_string_string()
    changed_string_string['k' + n.to_string()] = 'v' + n.to_string()
    print(untouched_string_string.length())
    print(changed_string_string.length())
    print(changed_string_string['k' + n.to_string()])
    const map<int, int[]> untouched_int_int_array = empty_int_int_array()
    map<int, int[]> changed_int_int_array = empty_int_int_array()
    changed_int_int_array[n] = [n + 30]
    print(untouched_int_int_array.length())
    print(changed_int_int_array.length())
    print(changed_int_int_array[n].length())
    print(changed_int_int_array[n][0])
    const map<int, string[]> untouched_int_string_array = empty_int_string_array()
    map<int, string[]> changed_int_string_array = empty_int_string_array()
    changed_int_string_array[n] = ['row-' + n.to_string()]
    print(untouched_int_string_array.length())
    print(changed_int_string_array.length())
    print(changed_int_string_array[n].length())
    print(changed_int_string_array[n][0])
    const map<string, int[]> untouched_string_int_array = empty_string_int_array()
    map<string, int[]> changed_string_int_array = empty_string_int_array()
    changed_string_int_array['k' + n.to_string()] = [n + 40]
    print(untouched_string_int_array.length())
    print(changed_string_int_array.length())
    print(changed_string_int_array['k' + n.to_string()].length())
    print(changed_string_int_array['k' + n.to_string()][0])
    const map<string, string[]> untouched_string_string_array = empty_string_string_array()
    map<string, string[]> changed_string_string_array = empty_string_string_array()
    changed_string_string_array['k' + n.to_string()] = ['row-' + n.to_string()]
    print(untouched_string_string_array.length())
    print(changed_string_string_array.length())
    print(changed_string_string_array['k' + n.to_string()].length())
    print(changed_string_string_array['k' + n.to_string()][0])
    const map<int, map<string, int>> untouched_nested_int_string = empty_nested_int_string()
    map<int, map<string, int>> changed_nested_int_string = empty_nested_int_string()
    changed_nested_int_string[n] = {}
    changed_nested_int_string[n]['leaf'] = n + 50
    print(untouched_nested_int_string.length())
    print(changed_nested_int_string.length())
    print(changed_nested_int_string[n].length())
    print(changed_nested_int_string[n]['leaf'])
    const map<string, map<int, int>> untouched_nested_string_int = empty_nested_string_int()
    map<string, map<int, int>> changed_nested_string_int = empty_nested_string_int()
    changed_nested_string_int['k' + n.to_string()] = {}
    changed_nested_string_int['k' + n.to_string()][n] = n + 60
    print(untouched_nested_string_int.length())
    print(changed_nested_string_int.length())
    print(changed_nested_string_int['k' + n.to_string()].length())
    print(changed_nested_string_int['k' + n.to_string()][n])
    const map<int, Cell> untouched_record_int = empty_record_int()
    map<int, Cell> changed_record_int = empty_record_int()
    changed_record_int[n] = Cell(n + 70)
    print(untouched_record_int.length())
    print(changed_record_int.length())
    print(changed_record_int[n].value)
    const map<string, Cell> untouched_record_string = empty_record_string()
    map<string, Cell> changed_record_string = empty_record_string()
    changed_record_string['k' + n.to_string()] = Cell(n + 80)
    print(untouched_record_string.length())
    print(changed_record_string.length())
    print(changed_record_string['k' + n.to_string()].value)
    string[] source_row = ['owned-' + n.to_string()]
    map<int, string[]> managed_rows = empty_int_string_array()
    managed_rows[n + 1] = source_row
    source_row[0] = 'changed'
    print(managed_rows[n + 1][0])
    MapRows box = MapRows(empty_int_string_array())
    MapRows copied = box
    box.rows[n + 2] = ['field-' + n.to_string()]
    print(copied.rows.length())
    print(box.rows[n + 2][0])
    return 0
