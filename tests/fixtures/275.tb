record Box(string label, int value);
const int shadow_value = 100

int read_shadow(const int shadow_value):
    return shadow_value + 1

int branch_read(const int value, bool enabled):
    if (enabled):
        return value + 2
    return value + 1

cached int cached_read(const int value):
    return value + 10

int inspect_values(const int seed, const bool enabled, const string[] labels, const int[][] rows, const Box box, const map<string, int> counts):
    int total = seed
    if (enabled):
        total += labels[0].length()
    total += rows[0][1]
    total += box.value
    total += counts['key']
    return total

string first_label(const string[] labels):
    return borrow_text(labels[0])

string borrow_text(const string value):
    return value

int const_worker(const int value):
    return value + 5

int const_helper(const int value):
    return value + 20

bool const_bool_helper(const bool flag):
    return flag

int reassign_plain(int value):
    value = value + 1
    return value

int mutate_plain(int[] values):
    values[0] += 1
    return values[0]

int main(string[] args):
    int seed = args.length()
    bool enabled = seed > 1
    string[] labels = ['first', 'second']
    int[][] rows = [[seed, 4]]
    Box box = Box('box', 7)
    map<string, int> counts = {'key': 3}

    print(branch_read(seed, enabled))
    print(read_shadow(seed))
    print(cached_read(seed))
    print(inspect_values(seed, true, labels, rows, box, counts))
    string saved_label = first_label(labels)
    labels[0] = 'changed'
    rows[0][0] = 99
    box.value = 8
    counts['key'] = 4
    print(saved_label)
    print(labels[0])
    print(rows[0][0])
    print(box.value)
    print(counts['key'])
    print(reassign_plain(seed))

    int[] mutable_values = [seed]
    print(mutate_plain(mutable_values))
    print(mutable_values[0])

    thread_pool pool = thread_pool(2)
    future<int> direct = pool.submit(const_worker, seed)
    future<int> helper = pool.submit(int value -> const_helper(value), seed)
    future<bool> bool_helper = pool.submit(int value -> const_bool_helper(value > 0), seed)
    print(direct.await())
    print(helper.await())
    print(helper.await())
    print(bool_helper.await())
    return 0
