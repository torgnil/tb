string run(string[] source):
    const string[] fixed = ['oak', 'pine']
    string[] words = ['red', 'blue']

    string render(int index):
        return source[index] + ':' + words[index] + ':' + fixed[index]

    string forward(int index):
        return render(index)

    string all_words(int index):
        if index == source.length():
            return ''
        if index + 1 == source.length():
            return forward(index)
        return forward(index) + '|' + all_words(index + 1)

    string first_source_word():
        return source[0]

    int source_length():
        return source.length()

    print(source_length())
    print(render(0))
    string saved_first = first_source_word()
    source[0] = 'apricot'
    print(saved_first)
    print(first_source_word())
    source[1] = 'pear'
    print(forward(1))
    words[0] = 'green'
    words = ['new', 'set']
    print(render(0))
    return all_words(0)

int main():
    string[] source = ['apple', 'banana']
    print(run(source))
    return 0
