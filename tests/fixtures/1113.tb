import random;

int main():
    RandomGenerator generator = seeded_random(42)
    RandomGenerator reference = seeded_random(42)
    string[] empty = []
    int number = 17
    string[] singleton = [number.to_string()]
    generator.random_shuffle_strings(empty)
    generator.random_shuffle_strings(singleton)
    print(generator.state)
    print(singleton[0])
    string[] values = [number.to_string(), '', 'blue', 'blue', (number + 1).to_string()]
    string[] original = values.copy()
    int[] indices = range(values.length())
    generator.random_shuffle_strings(values)
    reference.random_shuffle_ints(indices)
    for (int i = 0; i < values.length(); i += 1):
        print(values[i] == original[indices[i]])
    print(generator.state == reference.state)
    return 0
