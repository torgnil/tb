map<int[], int> mutable_global = {[1, 2]: 11}
const map<int[], int> fixed_global = {[3, 4]: 22}
map<int[], int> empty_key_global = {[]: 33}
map<int[], int> second_array_global = {[5]: 44}

int read_global_value():
    return mutable_global[[1, 2]]

bool has_global_key(int[] key):
    return mutable_global.contains(key)

int main():
    print(read_global_value())
    print(fixed_global[[3, 4]])
    print(has_global_key([1, 2]))
    print(empty_key_global[[]])
    print(second_array_global[[5]])

    mutable_global[[1, 2]] = 33
    print(read_global_value())

    int[][] saved_keys = mutable_global.keys()
    saved_keys[0][0] = 99
    print(has_global_key([1, 2]))
    print(has_global_key([99, 2]))

    int[] saved_values = mutable_global.values()
    print(saved_values[0])
    return 0
