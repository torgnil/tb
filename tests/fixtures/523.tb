int add_label_length(int value, string label):
    return value + label.length()

bool above_label_length(int value, string label):
    return value > label.length()

string global_label = 'tag'

int main(string[] args):
    string label = 'xy'
    int[] values = [1, 3, 5]
    print(values.map_to(int item -> add_label_length(item, label)))
    print(values.map_to(int item -> item + label.length()))
    int[] block_mapped = values.map_to(int item -> {
        return add_label_length(item, label)
    })
    print(block_mapped)
    print(values.filter(int item -> above_label_length(item, label)))

    const string long_label = 'abcd'
    int[] block_filtered = values.filter(int item -> {
        if (item > long_label.length()) {
            return true
        } else {
            return false
        }
    })
    print(block_filtered)
    print(values.map_to(int item -> add_label_length(item, global_label)))

    label = 'z'
    print(values.map_to(int item -> add_label_length(item, label)))
    return 0
