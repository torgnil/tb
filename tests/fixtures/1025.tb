void remove_path(string path):
    print('shadowed remove_path')

void rename_path(string source, string destination):
    print('shadowed rename_path')

int main():
    write_all('test-files/source.txt', 'source')
    write_all('test-files/destination.txt', 'old destination')
    rename_path('test-files/source.txt', 'test-files/destination.txt')
    print(path_exists('test-files/source.txt'))
    print(read_file('test-files/destination.txt'))

    ensure_dir('test-files/source-dir')
    write_all('test-files/source-dir/inner.txt', 'inner')
    rename_path('test-files/source-dir', 'test-files/renamed-dir')
    print(path_exists('test-files/source-dir'))
    print(read_file('test-files/renamed-dir/inner.txt'))

    write_all('test-files/remove.txt', 'remove')
    remove_path('test-files/remove.txt')
    print(path_exists('test-files/remove.txt'))
    return 0
