int GLOBAL_ADJUST = 2
int CALLBACK_CALLS = 0
int PREDICATE_CALLS = 0
int LEGACY_CALLS = 0

string int_array_text(int[] values):
    string text = '['
    for (int index : range(values.length())):
        if (index > 0):
            text += ', '
        text += values[index]
    text += ']'
    return text

int[] global_values = [2, 3]
int[] global_mapped = global_values.map_to(int item -> item > 0 ? later_adjust(item, 1) : 0)

int forward_adjust(int value, int delta, const bool enabled):
    return enabled ? later_adjust(value, delta) : value

int main(string[] args):
    int seed = args.length()
    int[] values = [seed, 0 - seed, 0, seed + 2]
    print(int_array_text(global_mapped))

    int[] nested = values.map_to(int item -> cached_double(add_values(forward_adjust(item, seed, true), current_offset())))
    print(int_array_text(nested))

    const int delta = seed + 4
    int[] captured = values.map_to(int item -> add_values(item, delta))
    print(int_array_text(captured))
    if (true):
        const int delta = seed + 6
        int[] shadowed = values.map_to(int item -> add_values(item, delta))
        print(int_array_text(shadowed))

    int[] counted = values.map_to(int item -> count_item(item))
    print(int_array_text(counted))
    print(CALLBACK_CALLS)

    int[] selected = values.filter(int item -> item != 0 && count_positive(item))
    print(int_array_text(selected))
    print(PREDICATE_CALLS)

    int[] empty = []
    int[] empty_map = empty.map_to(int item -> count_item(item))
    int[] empty_filter = empty.filter(int item -> count_positive(item))
    print(empty_map.length())
    print(empty_filter.length())
    print(CALLBACK_CALLS)
    print(PREDICATE_CALLS)

    int[] legacy_empty = empty.map_to(int item -> item + bump_legacy())
    print(legacy_empty.length())
    print(LEGACY_CALLS)

    int[] ordered = change_receiver().map_to(int item -> add_current(item))
    print(int_array_text(ordered))
    print(GLOBAL_ADJUST)

    int[] pipeline = make_values(seed).filter(int item -> is_positive(item)).map_to(int item -> add_values(item, seed))
    print(int_array_text(pipeline))
    print(CALLBACK_CALLS)
    try:
        int[] throwing = values.map_to(int item -> throw_if_negative(item))
        print(int_array_text(throwing))
    catch (string error):
        print(error)
    return 0

int later_adjust(int value, int delta):
    return value + delta + GLOBAL_ADJUST

cached int cached_double(int value):
    return value * 2

int current_offset():
    return GLOBAL_ADJUST

int add_values(int left, int right):
    return left + right

int count_item(int value):
    CALLBACK_CALLS += 1
    return value + GLOBAL_ADJUST

bool is_positive(int value):
    return value > 0

bool count_positive(int value):
    PREDICATE_CALLS += 1
    return is_positive(value)

int bump_legacy():
    LEGACY_CALLS += 1
    return 10

int[] change_receiver():
    GLOBAL_ADJUST = 9
    return [1, 2]

int add_current(int value):
    return value + GLOBAL_ADJUST

int throw_if_negative(int value):
    if (value < 0):
        throw 'callback helper failure'
    return value

int[] make_values(int seed):
    return [seed, 0 - seed, 0, seed + 2]
