int first_value(const map<string, int> counts):
    for (const string key in counts):
        return counts[key]
    return -1

int main():
    map<string, int> counts = {'a': 2, 'b': 3, 'c': 5}
    string[] expected = counts.keys()
    int index = 0
    int total = 0
    for (string key in counts):
        print(key == expected[index])
        index += 1
        if (index == 1):
            counts['new'] = 100
            continue
        total += counts[key]
    print(index)
    print(total == 10 - counts[expected[0]])
    print(first_value(counts) == counts[counts.keys()[0]])
    for (string key in counts):
        print(key == counts.keys()[0])
        break
    map<string, int> empty = {}
    print(first_value(empty))
    try:
        for (string key in counts):
            throw 'map loop stopped'
    catch (exception error):
        print(error)
    print(counts.length())
    return 0
