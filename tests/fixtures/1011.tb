int element_calls = 0

int make_element(int value):
    element_calls += 1
    return value

int main():
    thread_pool pool = thread_pool(1)

    future<int> full = pool.submit(() -> {
        int total = 0
        for (int value : [make_element(1), make_element(2), make_element(3)]) {
            total += value
        }
        return total
    })
    print(full.await())
    print(element_calls)

    future<int> stopped = pool.submit(() -> {
        int total = 0
        for (const int value : [4, 5, 6]) {
            if (value == 5) {
                break
            }
            total += value
        }
        return total
    })
    print(stopped.await())

    future<int> early = pool.submit(() -> {
        for (int value : [7, 8, 9]) {
            if (value == 8) {
                return value
            }
        }
        return 0
    })
    print(early.await())

    future<int> failure = pool.submit(() -> {
        for (int value : [10, 11]) {
            if (value == 10) {
                throw 'literal-foreach-failure'
            }
        }
        return 0
    })
    try:
        print(failure.await())
    catch (string error):
        print(error)

    future<int> recovered = pool.submit(() -> {
        int total = 0
        for (int value : [12, 13]) {
            total += value
        }
        return total
    })
    print(recovered.await())
    return 0
