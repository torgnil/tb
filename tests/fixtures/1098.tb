import strings;

void show(string[] fields):
    print(fields.length())
    for (string field in fields):
        print('[' + field + ']')

int main():
    show('a:b:c:d'.byte_rsplit_n(':', 2))
    show('aaaaa'.byte_rsplit_n('aa', 2))
    show(':a::'.byte_rsplit_n(':', 8))
    show('a:b'.byte_rsplit_n(':', 0))
    show(''.byte_rsplit_n(':', 1))
    try:
        show('abc'.byte_rsplit_n('', 0))
    catch (exception error):
        print(error)
    try:
        show('abc'.byte_rsplit_n(':', -1))
    catch (exception error):
        print(error)
    return 0
