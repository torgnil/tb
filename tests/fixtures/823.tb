int calls = 0

bool[][] make_flags(int mode):
    calls += 1
    if (mode == 1) {
        bool[][] empty = []
        return empty
    }
    if (mode == 2) {
        return [[true]]
    }
    return [[true, false], [], [true]]

int main():
    thread_pool pool = thread_pool(1)
    future<int> sum = pool.submit(int mode -> {
        int total = 0
        for (const bool[] row : make_flags(mode)) {
            for (bool flag : row) {
                if (flag) {
                    total += 1
                }
            }
        }
        return total
    }, 0)
    print(sum.await())

    future<int> empty = pool.submit(int mode -> {
        int total = 0
        for (const bool[] row : make_flags(mode)) {
            total += row.length()
        }
        return total
    }, 1)
    print(empty.await())

    future<int> stopped = pool.submit(int mode -> {
        int total = 0
        for (const bool[] row : make_flags(mode)) {
            total += row.length()
            if (row.length() > 0) {
                break
            }
        }
        return total
    }, 0)
    print(stopped.await())

    future<int> early = pool.submit(int mode -> {
        for (const bool[] row : make_flags(mode)) {
            return row.length()
        }
        return -1
    }, 0)
    print(early.await())

    future<int> failure = pool.submit(int mode -> {
        int total = 0
        for (const bool[] row : make_flags(mode)) {
            for (bool flag : row) {
                if (flag) {
                    throw 'bool-grid-failure'
                }
                total += 1
            }
        }
        return total
    }, 2)
    try:
        print(failure.await())
    catch (string error):
        print(error)
    print(calls)
    return 0
