record State(string value);
record Envelope(State state, string note);
enum Mode { READY, DONE }
record EnumState(Mode value);

State GLOBAL = State('global');

State borrowed_parameter(State input):
    return input

State borrowed_global():
    return GLOBAL

State global_local():
    State local = GLOBAL
    return local

State borrowed_field(Envelope input):
    return input.state

State nested_field_local(Envelope input):
    State local = input.state
    return local

State conditional_return(bool choose_first, State first, State second):
    return choose_first ? first : second

State parameter_local(State input):
    State local = input
    return local

State alias_local(State input):
    State local = input
    State alias = local
    return alias

State reassigned_local(State input):
    State local = State('old')
    local = input
    return local

State const_local(string value):
    const State local = State(value)
    return local

State branch_return(bool choose_first, State first, State second):
    if (choose_first):
        State local = first
        return local
    State local = second
    return local

State branch_assign(bool choose_first, State first, State second):
    State local = State('initial')
    if (choose_first):
        local = first
    else:
        local = second
    return local

State early_return(bool take_local, State input):
    State local = State(input.value)
    if (take_local):
        return local
    return input

Envelope nested_local(string value):
    Envelope local = Envelope(State(value), 'nested')
    return local

EnumState enum_local(Mode value):
    EnumState local = EnumState(value)
    return local

State direct_constructor(string value):
    return State(value)

int main(string[] args):
    State owner = State('owner')
    State returned_parameter = borrowed_parameter(owner)
    State copied_parameter = parameter_local(owner)
    State copied_alias = alias_local(owner)
    State reassigned = reassigned_local(owner)
    State constant = const_local('constant')
    State branch_one = branch_return(true, owner, GLOBAL)
    State branch_two = branch_return(false, owner, GLOBAL)
    State assigned_one = branch_assign(true, owner, GLOBAL)
    State assigned_two = branch_assign(false, owner, GLOBAL)
    State early_copy = early_return(false, owner)
    State early_owner = early_return(true, owner)
    Envelope holder = Envelope(State('field owner'), 'holder')
    State returned_field = borrowed_field(holder)
    State copied_nested_field = nested_field_local(holder)
    Envelope nested = nested_local('nested value')
    EnumState enum_value = enum_local('mode ' + args.length())
    State direct = direct_constructor('direct')
    State global_copy = borrowed_global()
    State copied_global = global_local()
    State conditional_one = conditional_return(true, owner, GLOBAL)
    State conditional_two = conditional_return(false, owner, GLOBAL)

    owner.value = 'changed owner'
    holder.state.value = 'changed field'
    GLOBAL.value = 'changed global'

    print(returned_parameter.value)
    print(copied_parameter.value)
    print(copied_alias.value)
    print(reassigned.value)
    print(constant.value)
    print(branch_one.value)
    print(branch_two.value)
    print(assigned_one.value)
    print(assigned_two.value)
    print(early_copy.value)
    print(early_owner.value)
    print(returned_field.value)
    print(copied_nested_field.value)
    print(nested.state.value + ':' + nested.note)
    print(enum_value.value == 'mode ' + args.length())
    print(direct.value)
    print(global_copy.value)
    print(copied_global.value)
    print(conditional_one.value)
    print(conditional_two.value)
    return 0
