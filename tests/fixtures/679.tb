enum Code { A = 1, B = 2 }

map<int[], bool> forward_flags(map<int[], bool> source):
    return source

map<int[], bool> GLOBAL_FLAGS = {[7]: true}

record FlagStore(map<int[], bool> flags);

int main():
    map<int[], bool> flags = {}
    int[] key = [1, 2]
    flags[key] = true
    key[0] = 9
    print(flags[[1, 2]])
    print(flags[key])

    int[] equal_key = [1, 2]
    flags[equal_key] = false
    print(flags[[1, 2]])
    print(flags.length())
    print(flags.contains([1, 2]))
    print([1, 2] in flags)
    print(flags.contains([]))

    bool[] values = flags.values()
    print(values.length())
    print(values[0])
    values[0] = true
    print(flags[[1, 2]])

    map<int[], bool> copied = forward_flags(flags)
    copied[[1, 2]] = true
    print(flags[[1, 2]])
    print(copied[[1, 2]])

    const map<int[], bool> fixed = {[3]: true}
    print(fixed[[3]])
    print(GLOBAL_FLAGS[[7]])

    FlagStore store = FlagStore({[4]: false})
    store.flags[[4]] = true
    print(store.flags[[4]])

    Code[] enum_key = [Code.A, Code.B]
    map<Code[], bool> enum_flags = {enum_key: true}
    print(enum_flags[[Code.A, Code.B]])
    print(enum_flags[[1, 2]])
    enum_key[0] = Code.B
    print(enum_flags[[Code.A, Code.B]])
    return 0
