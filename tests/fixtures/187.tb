record FlagBox(bool[] values);

void clear_parameter(bool[] values):
    clear(values)

int main(string[] args):
    bool seed = args.length() > 1
    bool[] flags = [seed, !seed, true]
    print(flags.length())
    clear(flags)
    print(flags.length())
    clear(flags)
    flags.clear()
    print(flags.length())

    flags.push(seed)
    flags.insert(0, !seed)
    print(flags.length())
    print(flags[0])
    print(flags[1])
    bool inserted = flags.remove_at(0)
    print(inserted)
    bool popped = flags.pop()
    print(popped)
    print(flags.length())

    flags.push(seed)
    flags.push(!seed)
    bool[] snapshot = copy(flags)
    flags.clear()
    print(flags.length())
    print(snapshot.length())
    print(snapshot[0])
    print(snapshot[1])

    bool[] empty = []
    empty.clear()
    print(empty.length())
    empty.push(seed)
    print(empty[0])
    clear(empty)
    print(empty.length())

    bool[] borrowed = [seed, true]
    clear_parameter(borrowed)
    print(borrowed.length())
    borrowed.push(false)
    print(borrowed[0])

    FlagBox box = FlagBox([seed, true])
    box.values.clear()
    print(box.values.length())
    box.values.push(seed)
    print(box.values[0])
    return 0
