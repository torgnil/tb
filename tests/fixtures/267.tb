int main(string[] args):
    thread_pool pool = thread_pool(1)
    int[] left = [1]
    int[] right = [2]
    future<int> invalid = pool.submit(() -> {
        int total = 0
        for (int item : [left[0], right[0]]) {
            total += item
        }
        return total
    })
    print(invalid.await())
    return 0
