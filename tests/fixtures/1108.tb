import regex;

void show(RegexMatch[] matches):
    print(matches.length())
    for (RegexMatch match in matches):
        print(match.start)
        print(match.end)

int main():
    Regex pattern = regex_compile('a+')
    show(pattern.regex_find_n('aa ba aa', 2))
    show(pattern.regex_find_n_from('aa ba aa', 2, 1))
    show(pattern.regex_find_n('aa ba aa', 0))
    show(pattern.regex_find_n_from('aa ba aa', -1, 2))
    show(pattern.regex_find_n_from('aa ba aa', 9, 2))
    show(regex_compile('').regex_find_n_from('abc', 2, 4))
    print(pattern.regex_find_n('aaa ba', 8).length() == pattern.regex_find_all('aaa ba').length())
    try:
        show(pattern.regex_find_n('a', -1))
    catch (exception error):
        print(error)
    return 0
