record ExitState(int[] values, string[] words);

int main(string[] args):
    int n = args.length()
    const int[] source = [n, 20, 30]
    int[] selected = source[1:]
    string[] words = ['left-' + n, 'right-' + n]
    ExitState state = ExitState(selected, words)
    map<string, int> counts = {'seen': n}
    int[] empty_values = []
    const bool[] flags = [true, false]
    int[] mutable_values = [n, 21]
    const string[] empty_words = []

    if (n > 1):
        const string branch_text = 'branch-' + n
        state.words[0] = branch_text
    else:
        string branch_text_other = 'branch-' + n
        state.words[0] = branch_text_other

    int total = 0
    for (int i = 0; i < 2; i++):
        total += i
    counts['seen'] = counts['seen'] + total

    switch (n):
        case 1:
            print('one')
        default:
            print('many')

    try:
        throw 'caught-' + n
    catch (exception message):
        print(message == 'caught-' + n)

    print(state.values[0])
    print(state.words[0] == 'branch-' + n)
    print(counts['seen'])
    print(mutable_values[1])
    print(empty_values.length())
    print(empty_words.length())
    print(flags.length())
    if (n > 3):
        return 7
