import regex;

int main():
    Regex runs = regex_compile('a+')
    print(regex_count(runs, 'aa ba aaa'))
    print(regex_count_from(runs, 'aa ba aaa', 2))
    print(regex_count(runs, 'zzz'))
    print(regex_count(regex_compile('aa'), 'aaa'))
    Regex empty = regex_compile('')
    print(regex_count(empty, 'abc'))
    print(regex_count_from(empty, 'abc', 3))
    print(regex_count_from(empty, 'abc', 4))
    print(regex_count_from(empty, 'abc', -1))
    print(regex_count_from(regex_compile('^a'), 'aba', 1))
    print(regex_count(regex_compile('$'), 'abc'))
    print(regex_count(regex_compile('('), 'abc'))
    return 0
