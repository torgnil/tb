enum Opcode { READ = 1, WRITE = 2 }

int main():
    Opcode[] sequence = [Opcode.READ, Opcode.WRITE]
    map<Opcode[], int> counts = {sequence: 7}
    sequence[0] = Opcode.WRITE
    print(counts[[Opcode.READ, Opcode.WRITE]])
    print(counts.contains(sequence))

    int[] same_sequence = [Opcode.READ, Opcode.WRITE]
    counts[same_sequence] = 9
    print(counts.length())
    print(counts[[Opcode.READ, Opcode.WRITE]])
    int[][] keys = counts.keys()
    keys[0][0] = Opcode.WRITE
    print(counts[[Opcode.READ, Opcode.WRITE]])

    map<Opcode[], string> labels = {[Opcode.READ]: 'read', [Opcode.WRITE]: 'write'}
    print(labels[[Opcode.READ]])

    map<Opcode[], bool[]> flags = {[Opcode.WRITE]: [true, false]}
    bool[] snapshot = flags[[Opcode.WRITE]]
    snapshot[0] = false
    print(flags[[Opcode.WRITE]][0])
    print(flags.keys().length())
    return 0
