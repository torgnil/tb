record Item(int value);

Item[] maybe_items(bool fail):
    if (fail):
        throw 'producer failed'
    return [Item(9), Item(10)]

int sum_items(Item[] items):
    return items[0].value + items[1].value

int main():
    try:
        print(sum_items(maybe_items(true)))
    catch (exception error):
        print(error)
    print(sum_items(maybe_items(false)))
    return 0
