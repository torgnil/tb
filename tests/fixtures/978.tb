int calculate(int base):
    int offset = 10
    const int fixed_bonus = 1
    bool include_next = true

    int climb(int value):
        if value == 0:
            return offset
        return climb(value - 1) + 1

    int choose(int value):
        if include_next:
            return climb(value) + base + fixed_bonus
        return value

    int relay(int offset):
        return climb(offset)

    print(choose(2))
    offset = 20
    base = 5
    include_next = false
    print(choose(2))
    print(climb(1))
    print(relay(0))
    include_next = true
    print(choose(1))
    return 0

int main():
    int shadow(int offset):
        return offset + 1
    print(shadow(5))
    return calculate(3)
