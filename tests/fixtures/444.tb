enum Mode { READY, DONE }
record Box(string text);

string make_text(int seed):
    return 'made-' + seed

Mode saved = Mode.READY
Mode initialized = make_text(5)
const Mode initialized_copy = initialized
Mode initialized_alias = initialized

void save_local(int seed):
    string local = 'local-' + seed
    saved = local
    local = 'changed-local'

void save_const_local(int seed):
    const Mode local = 'const-' + seed
    saved = local

void save_field(int seed):
    Box box = Box('field-' + seed)
    saved = box.text
    box.text = 'changed-field'

void save_owned(int seed):
    saved = make_text(seed)

void store_parameter(const Mode value):
    saved = value

void replace_and_read(const Mode old):
    saved = 'replacement'
    print(old)

void save_empty():
    const Mode local = ''
    saved = local

int main(string[] args):
    int seed = args.length()
    print(initialized)
    initialized = make_text(9)
    print(initialized_copy)
    print(initialized_alias)
    save_local(seed)
    print(saved)
    save_const_local(seed + 1)
    print(saved)
    save_field(seed + 2)
    print(saved)
    save_owned(seed + 3)
    print(saved)
    store_parameter('parameter-' + seed)
    print(saved)
    replace_and_read(saved)
    print(saved)
    saved = saved
    saved = 'concat-' + seed
    print(saved)
    save_empty()
    print('[' + saved + ']')
    return 0
