enum Op { LOAD = 1, STORE = 2, HALT = -1 }
record Program(Op[] ops, string label);

Op[] GLOBAL_OPS = [Op.LOAD, 7]
Op[] EMPTY_GLOBAL_OPS = []
const Op[] CONST_GLOBAL_OPS = [Op.STORE]

Op[] make_ops(Op[] source):
    return source

Op[] empty_ops():
    return []

Op[] local_ops(int count):
    Op[] values = [count, count + 1]
    return values

int first_op(Op[] ops):
    return ops[0]

int main(string[] args):
    Op[] ops = [Op.LOAD, Op.STORE]
    ops = [Op.HALT, 4]
    print(ops[0])
    print(first_op(ops))
    print(GLOBAL_OPS[1])
    print(EMPTY_GLOBAL_OPS.length())
    print(CONST_GLOBAL_OPS[0])
    print(empty_ops().length())
    Op[] local_result = local_ops(args.length())
    print(local_result[0])
    print(local_result[1])

    const Op[] fixed = make_ops([Op.LOAD, Op.HALT])
    print(fixed.length())
    print(fixed[1])

    int[] integers = ops
    integers.push(Op.STORE)
    print(integers[2])
    Op[] enum_alias = make_ops(integers)
    print(enum_alias.length())
    print(integers[0])

    Program program = Program(make_ops([Op.STORE, 9]), 'direct field')
    print(program.ops[0])
    program.ops[1] = Op.HALT
    print(program.ops[1])
    program.ops = make_ops([Op.HALT])
    print(program.ops.length())
    print(program.ops[0])
    print(program.label)

    Program empty_program = Program([], 'empty field')
    print(empty_program.ops.length())

    int total = 0
    for (Op code : fixed):
        total += code
    print(total)
    return 0
