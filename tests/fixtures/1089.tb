int first_cell(const map<int[], int> cells):
    for (const int[] key in cells):
        return cells[key]
    return -1

int main():
    map<int[], int> cells = {[]: 7, [2, 3]: 11, [-1, 4]: 13}
    int visits = 0
    for (const int[] key in cells):
        print(cells[key])
        visits += 1
        if (visits == 1):
            cells[[8, 9]] = 100
            continue
    print(visits)
    print(cells.length())
    print(first_cell(cells))
    for (const int[] key in cells):
        print(key.length())
        break
    map<int[], int> empty = {}
    print(first_cell(empty))
    return 0
