int min(string value):
    return value.length()

string max(string left, string right):
    return left + right

int main():
    string value = 'hello'
    print(min(value))
    print(value.min())
    print(max('a', 'b'))
    print('a'.max('b'))
    print(min(4, 9))
    print(max(4, 9))
    print(round(min(2.50, 1.25), 2))
    return 0
