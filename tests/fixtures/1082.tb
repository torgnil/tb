import strings;

void show_fields(string[] fields):
    for (string field in fields):
        print('[' + field + ']')

string[] runtime_fields(int n):
    string delimiter = n.to_string()
    string text = 'a' + delimiter + 'b' + delimiter + 'c' + delimiter + 'd'
    return text.byte_split_n(delimiter, 2)

int main():
    show_fields(runtime_fields(42))
    show_fields(byte_split_n('::a::', ':', 8))
    show_fields(byte_split_n('a:b', ':', 0))
    show_fields(byte_split_n('aaaaa', 'aa', 2))
    show_fields(byte_split_n('', ':', 3))
    show_fields(byte_split_n('abc', ':', 3))
    try:
        show_fields(byte_split_n('abc', '', 0))
    catch (exception error):
        print(error)
    try:
        show_fields(byte_split_n('abc', ':', -1))
    catch (exception error):
        print(error)
    return 0
