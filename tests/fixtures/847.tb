string length(const int[] values):
    return 'length-function'

string is_empty(int[] values):
    return 'empty-function'

int main():
    print(length([]))
    print(is_empty([]))
    int[] values = [1]
    print(length(values))
    const int[] const_values = [2]
    print(is_empty(const_values))
    print(length('tb'))
    print(is_empty('tb'))
    return 0
