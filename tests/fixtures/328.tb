int global_count = 20;

int parameter_shadow(int value) {
    if (value > 0) {
        string value = 'parameter-' + value;
        print(value);
    }
    return value;
}

string retained_label(int seed) {
    string label = 'outer-' + seed;
    if (seed > 0) {
        string label = 'inner-' + seed;
        label += '!';
        print(label);
    }
    return label;
}

int branch_value(int choice) {
    int value = 7;
    switch (choice) {
        case 1: {
            string value = 'case';
            print(value);
        }
        default: {
            bool value = true;
            print(value);
        }
    }
    return value;
}

int main(string[] args) {
    int seed = args.length();
    int value = 3;
    if (seed > 0) {
        int value = value + 5;
        print(value);
    }
    print(value);
    if (seed == 1) {
        string value = 'one';
        print(value);
    } else {
        bool value = false;
        print(value);
    }
    print(parameter_shadow(seed));
    int global_count = global_count + seed;
    print(global_count);
    int value = value + 1;
    print(value);

    int total = 0;
    for (int item : [seed, 2]) {
        total += item;
    }
    for (const string item : ['x', 'yz']) {
        total += item.length();
    }
    for (const int item : [4]) {
        total += item;
    }
    print(total);
    int cursor = 10;
    for (int cursor = 0; cursor < 2; cursor += 1) {
        total += cursor;
        string cursor = 'body';
        print(cursor);
    }
    print(cursor);
    print(total);
    while (value < 6) {
        value += 1;
        bool value = true;
        print(value);
    }
    print(value);
    print(branch_value(1));
    print(branch_value(2));
    int error = 9;
    try {
        string error = 'try';
        throw error;
    } catch (exception error) {
        print(error);
    }
    print(error);

    string[] lines = ['a', 'bbb'];
    int[] lengths = [seed];
    for (const string line : lines) {
        if (line.length() > 0) {
            int line = line.length();
            lengths.push(line);
        }
    }
    if (seed > 0) {
        string[] lengths = ['private-' + seed];
        print(lengths[0]);
    }
    print(lengths.sum());
    print(retained_label(seed));

    int left = 90;
    int right = 80;
    int[] ordered = [3, 1, 2];
    ordered.sort((int left, int right) -> left - right);
    print(ordered[0]);
    print(left + right);
    int name = 40;
    int[] mapped = lines.map_to(string name -> length(name));
    print(mapped.sum());
    print(name);
    int d = 50;
    int r = 0;
    int c = 0;
    int WIDTH = 2;
    int HEIGHT = 2;
    int[][] directions = [[0, 1], [-1, 0], [1, 0]];
    int[][] kept = directions.filter(int[] d -> r + d[0] >= 0 and r + d[0] < WIDTH and c + d[1] >= 0 and c + d[1] < HEIGHT);
    print(kept.length());
    if (seed > 0) {
        int r = 1;
        int WIDTH = 1;
        int[][] kept = directions.filter(int[] d -> r + d[0] >= 0 and r + d[0] < WIDTH and c + d[1] >= 0 and c + d[1] < HEIGHT);
        print(kept.length());
    }
    print(r);
    print(d);

    thread_pool pool = thread_pool(1);
    const int config = seed + 10;
    future<int> result = pool.submit(() -> {
        int answer = config + 1;
        return answer;
    });
    print(result.await());
    return 0;
}
