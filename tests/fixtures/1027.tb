import process;

int main():
    write_all('test-files/target.txt', 'target')
    ProcessResult link_result = run_process(['/bin/ln', '-s', 'target.txt', 'test-files/link.txt'])
    print(link_result.exit_code)
    remove_path('test-files/link.txt')
    print(path_exists('test-files/link.txt'))
    print(read_file('test-files/target.txt'))
    return 0
