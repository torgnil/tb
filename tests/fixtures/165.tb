int main(string[] args):
    if (args.length() > 2):
        string helper = args[1]
        string path = args[2]
        if (helper == 'read_file'):
            string contents = read_file(path)
            print('contents=' + contents)
        else if (helper == 'read_lines'):
            string[] lines = read_lines(path)
            print('lines=' + lines.length())
            for (string line in lines):
                print(line)
        return 0

    try:
        string missing_file = read_file('test-files/165-missing-read-file.in')
        print(missing_file)
    catch (exception file_error):
        print(file_error)

    try:
        string[] missing_lines = read_lines('test-files/165-missing-read-lines.in')
        print(missing_lines.length())
    catch (exception lines_error):
        print(lines_error)
    return 0
