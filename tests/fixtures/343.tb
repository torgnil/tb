import regex;

# Case 1

void check(string pattern, string text):
    Regex r = regex_compile(pattern)
    print(r.valid && regex_match(r, text))
    return

int combined_case_1_main():
    check('[a-z]+', 'hello')
    check('[a-z]+', 'Hello')
    check('[^0-9]+', 'abc!')
    check('[^0-9]+', 'ab1')
    check('[a-zA-Z_][a-zA-Z_0-9]*', 'foo_42')
    check('[a-zA-Z_][a-zA-Z_0-9]*', '9foo')
    check('[\\dA-F]+', '1FA2')
    check('[\\D]+', 'abc')
    check('[-a]+', '-a-')
    check('[a-]+', 'a--')
    check('[a\\-z]+', 'a-z')
    check('[\\]\\\\]+', ']\\')
    check('[a^]+', 'a^')
    check('([a-c]|\\d)+', 'abc9')
    print(regex_compile('[]').valid)
    print(regex_compile('[^]').valid)
    print(regex_compile('[z-a]').valid)
    print(regex_compile('[a-\\d]').valid)
    print(regex_compile('[\\d-a]').valid)
    print(regex_compile('[a-b-c]').valid)
    print(regex_compile('[a').valid)
    print(regex_compile('[\\q]').valid)
    Regex damaged = regex_compile('[a]')
    damaged.characters[0] = 'z-a'
    print(regex_match(damaged, 'z'))
    Regex changed = regex_compile('[a]')
    changed.characters[0] = 'z'
    print(regex_match(changed, 'z'))
    print(regex_match(changed, 'a'))
    print(regex_match(regex_compile('[b-d]'), 'b'))
    print(regex_match(regex_compile('[b-d]'), 'd'))
    print(regex_match(regex_compile('[b-d]'), 'a'))
    print(regex_match(regex_compile('[b-d]'), 'e'))
    return 0

# Case 2

