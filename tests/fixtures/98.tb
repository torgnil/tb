int fail_value(int x):
    throw 'failed=' + x

int plus_five(int x):
    return x + 5

int main(string[] args):
    thread_pool pool = thread_pool(1)
    future<int> failed = pool.submit(fail_value, 3)
    future<int> succeeded = pool.submit(plus_five, 3)
    try:
        print(failed.await())
    catch (exception err):
        print(err)
    print(succeeded.await())
    return 0
