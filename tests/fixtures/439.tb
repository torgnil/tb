enum Tag { FIRST, LAST }
record Label(string text);

string decorate(const Tag value):
    return value + '!'

string make_tag(int seed):
    const Tag value = 'fixed-' + seed
    return value

string[] make_tags(int seed):
    const Tag value = 'row-' + seed
    return [value, value + '!']

Label make_label(int seed):
    const Tag value = 'label-' + seed
    return Label(value)

string branch_text(int seed):
    Tag value = 'branch-' + seed
    if (seed > 0):
        value = value + '!'
        return value
    return 'zero'

string loop_text(int count):
    int total = 0
    for (int i : range(count)):
        const Tag item = 'loop-' + i
        total += item.length()
    return 'loop-total-' + total

int main(string[] args):
    int seed = args.length()
    const Tag local = 'main-' + seed
    print(local)
    print(decorate(local))
    print(make_tag(seed))
    string[] labels = make_tags(seed)
    print(labels[0])
    print(labels[1])
    Label label = make_label(seed)
    print(label.text)
    print(branch_text(seed))
    print(loop_text(seed + 2))
    Tag changing = 'old-' + seed
    changing = 'new-' + seed
    print(changing)
    print(make_tag(seed) + '?')
    return 0
