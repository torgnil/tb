enum Mode { READY, BUSY }
enum Code { FIRST = 1, LAST = -1 }
record Box(string value);

string known_mode():
    return Mode.READY

int main():
    Box Mode = Box('field access')
    print(Mode.value)
    string ready = known_mode()
    int code = Code.FIRST
    print(ready)
    print(code)
    return 0
