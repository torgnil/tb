record LastBox(int[] values, bool[] flags);

int int_param_tail(int[] values):
    return values.last()

bool bool_param_tail(bool[] values):
    return last(values)

int main(string[] args):
    int count = args.length()

    int[] values = [count + 10, count + 20]
    print(last(values))
    print(values.last())
    print(values.length())
    print(int_param_tail(values))
    values.push(count + 30)
    print(last(values))
    print(values.pop())
    print(values.last())
    print(values.length())
    values.insert(0, count + 5)
    print(values.last())
    print(values.length())
    values.remove_at(0)
    print(values.last())
    print(values.length())

    bool[] flags = [count > 1, false]
    print(last(flags))
    print(flags.last())
    print(flags.length())
    print(bool_param_tail(flags))
    flags.push(count > 1)
    print(last(flags))
    print(flags.length())
    flags.pop()
    print(last(flags))
    print(flags.length())

    const int[] frozen_values = [count + 40]
    const bool[] frozen_flags = [count > 1]
    print(last(frozen_values))
    print(frozen_values.last())
    print(last(frozen_flags))
    print(frozen_flags.last())

    int[] singleton = [count + 50]
    bool[] one_flag = [count > 1]
    print(last(singleton))
    print(one_flag.last())

    LastBox box = LastBox([count + 60, count + 70], [false, count > 1])
    print(last(box.values))
    print(box.values.last())
    print(last(box.flags))
    print(box.flags.last())
    print(box.values.length())
    print(box.flags.length())
    return 0
