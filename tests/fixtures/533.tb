int main():
    int[] source_key = [1, 2]
    int[] source_row = [10, 20]
    map<int[], int[]> values = {}
    values[source_key] = source_row
    source_key[0] = 9
    source_row[0] = 99

    print(values.contains([1, 2]))
    print(values.contains(source_key))
    print(values[[1, 2]][0])
    print(values[[1, 2]][1])

    int[] read_row = values[[1, 2]]
    read_row[0] = 77
    print(values[[1, 2]][0])

    values[[3]] = [30]
    values[[1, 2]] = [11, 21]
    int[][] ordered_values = values.values()
    print(ordered_values.length())
    print(ordered_values[0][0])
    print(ordered_values[1][0])
    ordered_values[0][0] = 88
    ordered_values[0].push(89)
    print(values[[1, 2]][0])
    print(values[[1, 2]].length())

    int[] missing = values[[404]]
    print(missing.length())
    missing.push(1)
    print(values.contains([404]))

    map<int[], int[]> copied = values
    copied[[1, 2]] = [66]
    print(values[[1, 2]][0])
    print(copied[[1, 2]][0])
    return 0
