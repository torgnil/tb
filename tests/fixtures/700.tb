bool[][] returned_rows():
    map<string, bool[]> source = {'first': [true, false], 'second': [false]}
    return source.values()

map<int, bool[]> make_flags():
    return {4: [true], 5: [false]}

int main():
    map<int, bool[]> numbers = {}
    map<string, bool[]> names = {}
    print(numbers.values().length())
    print(names.values().is_empty())
    numbers[3] = [true, false]
    numbers[1] = [false, true]
    numbers[3] = [false, false]
    bool[][] rows = numbers.values()
    print(rows.length())
    print(rows[0][0])
    print(rows[1][1])
    rows[1][1] = false
    print(numbers[1][1])
    numbers[3] = [true, true]
    print(rows[0][0])
    bool[][] newer = numbers.values()
    print(newer[0][0])
    names['one'] = [true]
    names['two'] = [false, true]
    names['one'] = [false]
    bool[][] named_rows = names.values()
    print(named_rows.length())
    print(named_rows[0][0])
    print(named_rows[1][1])
    named_rows[1][1] = false
    print(names['two'][1])
    const map<string, bool[]> fixed = {'a': [true], 'b': []}
    bool[][] fixed_rows = fixed.values()
    print(fixed_rows[0][0])
    print(fixed_rows[1].length())
    bool[][] returned = returned_rows()
    print(returned[0][0])
    print(returned[1][0])
    print(make_flags().values().length())
    return 0
