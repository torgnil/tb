record Item(int id, string label, bool active)
record Marker(int value)

set<int> intersection(set<int> left, set<int> right):
    return {99}

set<Marker> difference(set<Marker> left, set<Marker> right):
    return {Marker(66)}

int main(string[] args):
    set<Item> left = {Item(2, 'two', true), Item(1, 'one', false), Item(3, 'three', false)}
    set<Item> right = {Item(3, 'three', false), Item(2, 'two', true), Item(4, 'four', true)}
    set<Item> shared = left.intersection(right)
    set<Item> remaining = left.difference(right)
    for (Item item in shared):
        print(item.id)
        print(item.label)
        print(item.active)
    for (Item item in remaining):
        print(item.id)
        print(item.label)
        print(item.active)

    const set<Item> read_only = {Item(2, 'two', true)}
    set<Item> empty = {}
    print(read_only.intersection(shared).length())
    print(read_only.difference(empty).length())
    print(left.intersection(left).length())
    print(left.difference(left).length())
    print(empty.intersection(left).length())
    print(left.difference(empty).length())

    shared.remove(Item(2, 'two', true))
    shared.add(Item(4, 'four', true))
    print(left.contains(Item(2, 'two', true)))
    print(right.contains(Item(2, 'two', true)))
    print(left.length())
    print(right.length())
    for (Item item in shared):
        print(item.id)
        print(item.label)
        print(item.active)

    set<int> numbers = {1}
    set<int> other_numbers = {1}
    print(numbers.intersection(other_numbers).contains(99))
    set<Marker> markers = {Marker(1)}
    print(markers.difference(markers).contains(Marker(66)))
    return 0
