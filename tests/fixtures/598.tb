void try_direct(string value):
    try:
        print(to_int(value))
    catch (exception error):
        print(error)

void try_method(string value):
    try:
        print(value.to_int())
    catch (exception error):
        print(error)

int main(string[] args):
    try_direct('')
    try_method('   ')
    try_direct('+')
    try_method('-')
    try_direct('12tail')
    try_method('tail12')
    try_direct('9223372036854775808')
    try_method('-9223372036854775809')
    try:
        print(to_int('12tail'.substring(0, 6)))
    catch (exception error):
        print(error)
    try:
        print('12tail'.substring(0, 6).to_int())
    catch (exception error):
        print(error)
    map<string, string> values = {}
    try_direct(values['missing'])
    print('continued')
    return 0
