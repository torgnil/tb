set<int> receiver_allowed = {2}

int[] prepare_values():
    receiver_allowed.add(4)
    return [2, 4, 6]

int main(string[] args):
    const set<int> low = {2}
    set<int> high = {4}
    int[] values = [1, 2, 3, 4, 5]

    int[] selected = values.filter(int item -> low.contains(item) || high.contains(item))
    print(selected)

    int[] mapped = values.map_to(int item -> high.contains(item) ? item + 10 : item)
    print(mapped)

    int[] prepared = prepare_values().filter(int item -> receiver_allowed.contains(item))
    print(prepared)
    return 0
