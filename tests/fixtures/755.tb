int main(string[] args):
    set<int> values = {1, 9, 17, 25}
    print(values.remove(9))
    print(values.contains(9))
    print(values.contains(17))
    print(values.contains(25))
    print(values.length())
    for (int value in values):
        print(value)

    print(values.remove(1))
    print(values.remove(25))
    print(values.length())
    for (int value in values):
        print(value)

    print(values.remove(17))
    print(values.remove(17))
    print(values.is_empty())

    set<int> empty = {}
    print(empty.remove(4))
    print(empty.length())

    set<int> signed_values = {-17, -9223372036854775807 - 1}
    print(signed_values.contains(-9223372036854775807 - 1))
    print(signed_values.remove(-9223372036854775807 - 1))
    print(signed_values.contains(-17))

    values.add(9)
    values.add(25)
    values.add(17)
    print(values.remove(9))
    print(values.add(33))
    print(values.contains(17))
    print(values.contains(25))
    print(values.contains(33))
    set<int> combined = values.union({50, 51})
    print(combined.length())
    print(values.length())
    return 0
