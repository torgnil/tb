int main(string[] args):
    string[] lines = ['one']
    string[] result = lines.flat_map(string line -> {
        if (line.is_empty()) {
            return []
        }
        return [line]
    })
    print(result)

    string[] empty_chunks = lines.flat_map(string line -> {
        return []
    })
    print(empty_chunks.length())
    return 0
