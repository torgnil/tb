const int[] RETURN_GLOBAL = [40, 41]
const int[] RETURN_EMPTY_GLOBAL = []

int[] return_local(int n):
    int[] values = [n, n + 1]
    int[] spare = [n + 9]
    return values

int[] return_empty():
    int[] values = []
    return values

int[] return_empty_global():
    return RETURN_EMPTY_GLOBAL

int[] return_literal(int n):
    return [n, n + 1]

int[] return_call(int n):
    return return_local(n)

int[] return_const(int n):
    const int[] values = [n, n + 1]
    return values

int[] return_const_empty():
    const int[] values = []
    return values

int[] return_copy(int[] source):
    int[] values = source
    values[0] += 10
    return values

int[] return_reassigned(int n):
    int[] values = [n + 20]
    values = return_local(n)
    return values

int[] return_borrowed(int[] source):
    return source

int[] return_global():
    return RETURN_GLOBAL

int[] return_branch(int n):
    if (n > 0):
        int[] values = [n, n + 1]
        return values
    int[] values = [n - 1, n - 2]
    return values

int[] return_switch(int n):
    switch (n):
        case 1:
            int[] values = [n, n + 1]
            return values
        default:
            int[] values = [n + 2]
            return values

int[] return_loop(int n):
    int[] values = []
    for (int i = 0; i < 2; i++):
        values = [n + i, n + i + 1]
        if (i == 1):
            return values
    return values

int[] return_try(int n):
    try:
        int[] values = [n, n + 1]
        return values
    catch (exception err):
        int[] values = [n + 2]
        return values

int[] return_catch(int n):
    try:
        throw 'return-catch'
    catch (exception err):
        int[] values = [n, n + 1]
        return values

int main(string[] args):
    int n = args.length()
    int[] local = return_local(n)
    local[0] += 10
    print(local[0])
    print(local[1])
    int[] empty = return_empty()
    print(empty.length())
    int[] const_empty = return_const_empty()
    const_empty.push(n)
    print(const_empty[0])
    int[] empty_global = return_empty_global()
    empty_global.push(n)
    print(RETURN_EMPTY_GLOBAL.length())
    print(empty_global[0])
    int[] fixed = return_const(n)
    print(fixed[0])
    int[] source = [n + 3, n + 4]
    int[] copied = return_copy(source)
    print(source[0])
    print(copied[0])
    int[] reassigned = return_reassigned(n)
    print(reassigned[0])
    int[] borrowed = return_borrowed(source)
    borrowed[0] += 100
    print(source[0])
    print(borrowed[0])
    int[] global_copy = return_global()
    global_copy[0] += n
    print(RETURN_GLOBAL[0])
    print(global_copy[0])
    int[] branch = return_branch(n)
    print(branch[0])
    int[] branch_else = return_branch(-n)
    print(branch_else[0])
    int[] switched = return_switch(n)
    print(switched[0])
    int[] switch_default = return_switch(n + 2)
    print(switch_default[0])
    int[] literal = return_literal(n)
    print(literal[0])
    int[] called_result = return_call(n)
    print(called_result[0])
    int[] looped = return_loop(n)
    print(looped[0])
    int[] tried = return_try(n)
    print(tried[0])
    int[] caught = return_catch(n)
    print(caught[0])
    try:
        int[] restored = return_try(n)
        throw 'caller-throw'
    catch (exception err):
        print(7)
    int[] direct = [n + 50, n + 51]
    direct = return_local(n + 1)
    print(direct[0])
    for (int i = 0; i < 40; i++):
        int[] repeated = return_local(n + i)
        print(repeated[1])
    return 0
