int[] int_keys(const map<int, string> labels):
    return [999]

int first_key(const map<int, string> labels):
    for (const int key in labels):
        return key
    return -1

int main():
    const map<int, string> labels = {-17: 'label'}
    print(first_key(labels))
    print(labels.int_keys()[0])

    map<int, bool> flags = {-700: true, 50: true}
    int sum = 0
    for (const int key in flags):
        sum += key
        flags[3] = true
        continue
    print(sum)

    sum = 0
    for (int key in flags):
        sum += key
    print(sum)

    try:
        for (int key in flags):
            throw 'stop'
    catch (exception error):
        print(error)

    int visits = 0
    for (int key in flags):
        visits += 1
        break
    const map<int, bool> empty = {}
    for (int key in empty):
        visits += 10
    print(visits)
    return 0
