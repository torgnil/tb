string describe(const map<string, string> settings):
    string result = ''
    for (const string key in settings):
        result += key + '=' + settings[key] + ';'
    return result

int main():
    map<string, string> settings = {'mode': 'batch', 'region': 'north'}
    print(describe(settings))
    map<string, bool[]> flags = {'first': [true, false], 'second': [false]}
    for (string key in flags):
        print(key)
        print(flags[key][0])
        flags['later'] = [true]
    print(flags.length())
    const map<string, string> empty = {}
    print('[' + describe(empty) + ']')
    return 0
