import regex;

int main(string[] args):
    Regex deep = regex_compile('(((((((((((((a)+)+)+)+)+)+)+)+)+)+)+)+)+')
    print(regex_replace(deep, 'a', 'X'))
    print(regex_replace(regex_compile('(a)(b)'), 'ab ab', '$2-$1:$0'))
    print(regex_replace(regex_compile('(a|b)+'), 'ab ba', '$1/$0'))
    print(regex_replace(regex_compile('(a)?b'), 'b ab', '<$1>'))
    print(regex_replace(regex_compile('(a)(b)'), 'ab', '$12,$0,$3'))
    print(regex_replace(regex_compile('(a)'), 'a', '$x $$ $$1 \\'))
    print(regex_replace(regex_compile('z'), 'unchanged', '$0'))
    print(regex_replace(regex_compile('('), 'unchanged', '$0'))
    print(regex_replace(regex_compile(''), 'ab', '[$0]'))
    print(regex_replace(regex_compile('^|$'), 'abc', '<$0>'))
    return 0
