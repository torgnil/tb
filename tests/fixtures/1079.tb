import strings;

void show_partition(string[] pieces):
    print(pieces.length())
    for (string piece in pieces):
        print('[' + piece + ']')

string[] partition_runtime(int value):
    string delimiter = value.to_string()
    string text = 'first' + delimiter + 'rest' + delimiter
    return text.byte_partition(delimiter)

int main():
    string[] pieces = partition_runtime(42)
    show_partition(pieces)
    show_partition(byte_partition('a==b==c', '=='))
    show_partition(byte_partition('a=', '='))
    show_partition(byte_partition('=a', '='))
    show_partition(byte_partition('abc', '='))
    show_partition(byte_partition('abc', ''))
    show_partition(byte_partition('', '='))
    return 0
