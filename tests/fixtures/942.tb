int width = 3
const string label = 'xy'
const bool keep_chunks = true
int calls = 0

int[] configured_chunk(int value, int radius, bool include, string suffix):
    calls += 1
    width = 1
    if (include):
        return [value - radius, value + radius, suffix.length()]
    return []

int main(string[] args):
    int value = 100
    int[] values = [5, 9]
    int[] result = values.flat_map(int value -> configured_chunk(value, width, keep_chunks, label))
    print(result.length())
    for (int index : range(result.length())):
        print(result[index])
    print(value)
    print(width)
    print(calls)

    int[] empty_values = []
    int[] empty = empty_values.flat_map(int item -> configured_chunk(item, width, keep_chunks, label))
    print(empty.length())
    print(calls)

    const int offset = 4
    int[] literal = [1, 2].flat_map(int item -> [item + offset])
    print(literal.length())
    print(literal[0])
    print(literal[1])
    return 0
