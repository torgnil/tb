int run(string prefix):
    const string separator = ':'
    string suffix = '!'

    string format(string word):
        return prefix + separator + word + suffix

    string forwarded(int remaining, string word):
        if (remaining == 0):
            return format(word)
        return forwarded(remaining - 1, word)

    string via_sibling(string word):
        return format(word)

    string captured_prefix():
        return prefix

    string shadow(string prefix):
        return prefix + ' local'

    print(format('one'))
    suffix = '?'
    print(via_sibling('two'))
    print(forwarded(2, 'three'))
    print(captured_prefix())
    print(shadow('B'))
    return 0

int main(string[] args):
    run('A')
    return 0
