record Entry(int value);
record Payload(int[] numbers, bool[] flags, string[] words, int[][] rows, string[][] word_rows, Entry[] entries);
record Holder(Payload payload);

int next_index(int[] calls):
    calls[0] += 1
    return 0

int main(string[] args):
    int argc = args.length()
    Payload box = Payload([argc], [argc > 0], ['seed'], [[argc]], [['seed']], [Entry(argc)])

    box.numbers = []
    box.numbers.push(argc + 10)
    print(box.numbers[0])
    box.numbers = []
    print(box.numbers.length())

    box.flags = []
    box.flags.push(argc > 1)
    print(box.flags[0])
    box.words = []
    box.words.push('word')
    print(box.words[0])

    box.rows = []
    box.rows.push([argc + 20])
    print(box.rows[0][0])
    box.word_rows = []
    print(box.word_rows.length())
    box.word_rows = [['row']]
    box.word_rows[0].push('inner')
    print(box.word_rows[0][0])
    print(box.word_rows[0][1])
    box.entries = []
    box.entries.push(Entry(argc + 30))
    print(box.entries[0].value)

    Holder nested = Holder(box)
    nested.payload.flags = []
    nested.payload.flags.push(true)
    print(nested.payload.flags[0])

    int[] calls = [0]
    Payload[] indexed = [box]
    indexed[next_index(calls)].numbers = []
    indexed[0].numbers.push(argc + 40)
    print(indexed[0].numbers[0])
    print(calls[0])

    if (argc >= 1):
        box.words = []
        box.words.push('branch')
    print(box.words[0])

    int loop = 0
    while (loop < 1):
        box.flags = []
        box.flags.push(false)
        loop++
    print(box.flags[0])

    switch (argc):
        case 1:
            box.rows = []
            box.rows.push([51])
        default:
            box.rows = []
            box.rows.push([52])
    print(box.rows[0][0])

    try:
        box.word_rows = []
        box.word_rows = [['try']]
        throw 'field reset'
    catch (exception err):
        box.word_rows = []
        box.word_rows = [['catch']]
    print(box.word_rows[0][0])
    box.word_rows = []
    print(box.word_rows.length())
    return 0
