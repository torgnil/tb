import regex;

void check(string pattern, string text):
    Regex compiled = regex_compile(pattern)
    print(compiled.valid && regex_match(compiled, text))
    return

int main():
    check('\\d+', '0123456789')
    check('\\d+', '12a')
    check('\\D+', 'abc_!')
    check('\\D+', 'a0')
    check('\\w+', 'Az09_')
    check('\\w+', 'x-')
    check('\\W+', '-.! ')
    check('\\W+', '-a')
    check('\\s+', ' \t\n\r')
    check('\\s+', ' a')
    check('\\S+', 'a1_')
    check('\\S+', 'a\t')
    check('(\\d|\\w)+\\s\\D?', 'a1 Z')
    check('(\\d|\\w)+\\s\\D?', 'a1 5')
    check('\\d*', '')
    check('\\d', '')
    check('\\.\\*\\[\\]', '.*[]')
    print(regex_compile('\\q').valid)
    print(regex_compile('[a-z]').valid)
    return 0
