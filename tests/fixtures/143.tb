map<int, int> temporary(int key):
    return {key: key + 2}

map<int, int> from_call(int key):
    map<int, int> called = temporary(key)
    return called

map<int, int> reassigned(int key):
    map<int, int> replaced = {key: 0}
    replaced = from_call(key)
    return replaced

map<int, int> borrowed(map<int, int> source):
    return source

map<int, int> local_copy(map<int, int> source):
    map<int, int> copied = source
    return copied

map<int, int> global_copy():
    return GLOBAL_COUNTS

map<int, int> branch(int key):
    if (key % 2 == 0):
        map<int, int> even = {key: key + 1}
        return even
    else:
        map<int, int> odd = {key: key + 2}
        return odd

map<int, int> in_loop(int key):
    while (key > 0):
        map<int, int> loop_map = {key: key + 3}
        return loop_map
    map<int, int> no_loop = {}
    return no_loop

map<int, int> in_switch(int key):
    switch (key):
        case 7:
            map<int, int> selected = {key: key + 4}
            return selected
        default:
            map<int, int> other_case = {key: key + 5}
            return other_case

map<int, int> in_try(int key):
    try:
        if (key > 0):
            map<int, int> try_map = {key: key + 6}
            return try_map
        throw 'map'
    catch (exception err):
        map<int, int> catch_map = {key: key + 7}
        return catch_map

