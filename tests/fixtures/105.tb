int report_sum(int[] values):
    print(values.sum())
    return 0

int report_first(int[][] rows):
    print(rows[0][0])
    return 0

int main(string[] args):
    int[] values = [2, 3]
    int[][] rows = [[4], [5]]
    thread_pool pool = thread_pool(1)
    future<int> first = pool.submit(report_sum, values)
    future<int> second = pool.submit(report_first, rows)
    values[0] = 99
    rows[0][0] = 88
    return 0
