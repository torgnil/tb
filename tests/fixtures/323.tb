record Counter(int value);

num initial_num():
    return 1.5

int GLOBAL_INT = 5;
num GLOBAL_NUM = initial_num();
const int STEP = 2;

void update_globals(int amount, num decimal_amount):
    GLOBAL_INT += amount
    GLOBAL_NUM += decimal_amount

int add_parameter(int value, int amount):
    value += amount
    return value

int add_parameter_explicit(int value, int amount):
    value = value + amount
    return value

int main(string[] args):
    int count = args.length()
    int total = count
    total += STEP
    total = total + count
    print(total)
    print(add_parameter(count, STEP))
    print(add_parameter_explicit(count, STEP))

    num amount = 2.5
    num sum = amount
    sum += count
    sum = sum + 1.25
    print(sum)

    update_globals(count, 0.5)
    print(GLOBAL_INT)
    print(GLOBAL_NUM)

    string text = 'count-'
    text += count
    text += '-ok'
    print(text)

    int[] values = [count]
    values[0] += STEP
    print(values[0])
    Counter counter = Counter(count)
    counter.value += STEP
    print(counter.value)
    return 0
