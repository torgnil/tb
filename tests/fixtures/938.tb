string suffix = '!'

string[] make_words():
    return ['ok', 'bad', 'later']

string[] append_or_throw(string word, string suffix):
    if (word == 'bad'):
        throw 'captured flat_map failure'
    return [word + suffix]

int main(string[] args):
    try:
        string[] result = make_words().flat_map(string word -> append_or_throw(word, suffix))
        print(result)
    catch (string error):
        print(error)
    print('recovered ' + suffix)
    return 0
