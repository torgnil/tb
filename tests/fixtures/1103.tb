import strings;

int main():
    print('a:a:a'.byte_replace_n('a', 'aa', 2))
    print('aaaaa'.byte_replace_n('aa', '-', 2))
    print('x::y::'.byte_replace_n('::', '', 1))
    print('abc'.byte_replace_n('z', '!', 2))
    print('abc'.byte_replace_n('a', '!', 0))
    print('a-a'.byte_replace_n('a', '$1', 1))
    try:
        print('abc'.byte_replace_n('', '!', 0))
    catch (exception error):
        print(error)
    try:
        print('abc'.byte_replace_n('a', '!', -1))
    catch (exception error):
        print(error)
    return 0
