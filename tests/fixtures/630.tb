int main():
    thread_pool pool = thread_pool(2)
    bool[] flags = [true, false, true, true]

    future<int> count = pool.submit(bool[] input -> {
        int total = 0
        for (bool flag : input) {
            if (flag) {
                total += 1
            }
        }
        return total
    }, flags)

    future<int> limited = pool.submit(bool[] input -> {
        int total = 0
        for (const bool flag : input) {
            if (!flag) {
                continue
            }
            total += 1
            if (total == 2) {
                break
            }
        }
        return total
    }, flags)

    flags[0] = false
    print(count.await())
    print(count.await())
    print(limited.await())

    bool[] empty = []
    future<int> empty_count = pool.submit(bool[] input -> {
        int total = 0
        for (bool flag : input) {
            if (flag) {
                total += 1
            }
        }
        return total
    }, empty)
    print(empty_count.await())
    return 0
