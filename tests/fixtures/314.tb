const int minimum_value = 5
const bool global_enabled = true
int task_calls = 0

int[] next_task(int seed):
    task_calls += 1
    return [seed]

int mutate_first(int[] values, int amount):
    values[0] += amount
    return values[0]

int fail_array(int[] values, bool should_fail):
    if (should_fail) {
        throw 'array capture failed'
    }
    return values.length()

future<int> submit_scoped_row(thread_pool pool, int[] source):
    int adjustment = 3
    return pool.submit(int[] row -> mutate_first(row, adjustment), source)

int main(string[] args):
    thread_pool pool = thread_pool(2)
    int[] source = [4, 8]
    int adjustment = args.length() + 2
    bool enabled = true

    future<int> changed = pool.submit(int[] row -> mutate_first(row, adjustment), source)
    future<bool> accepted = pool.submit(int[] row -> {
        int value = mutate_first(row, adjustment)
        if (enabled) {
            return value >= minimum_value
        }
        return false
    }, source)
    future<int> empty = pool.submit(int[] row -> row.length() + adjustment, [])
    future<bool> global_values = pool.submit(int[] row -> row[0] >= minimum_value && global_enabled, source)
    future<int> task_order = pool.submit(int[] row -> row[0] + task_calls, next_task(args.length()))
    future<int> scoped = submit_scoped_row(pool, source)
    future<int> failed = pool.submit(int[] row -> fail_array(row, enabled), source)

    source[0] = 99
    adjustment = 100
    enabled = false

    print(changed.await())
    print(changed.await())
    print(accepted.await())
    print(accepted.await())
    print(empty.await())
    print(global_values.await())
    print(task_order.await())
    print(task_calls)
    print(scoped.await())
    print(source[0])
    try:
        failed.await()
    catch (string error):
        print(error)
    try:
        failed.await()
    catch (string error):
        print(error)
    return 0
