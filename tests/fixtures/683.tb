enum Code { A = 1, B = 2 }

map<int[][], bool> preserve_grid_flags(map<int[][], bool> flags):
    return flags

map<Code[][], bool> GLOBAL_GRID_FLAGS = {}

record GridStore(map<Code[][], bool> flags);

int main():
    Code[][] grid = [[Code.A, Code.B], [], [Code.B]]
    map<Code[][], bool> seen = {}
    seen[grid] = true
    grid[0][0] = Code.B
    print(seen[[[Code.A, Code.B], [], [Code.B]]])
    print(seen[grid])

    int[][] same_grid = [[1, 2], [], [2]]
    seen[same_grid] = false
    print(seen.length())
    print(seen[[[1, 2], [], [2]]])
    print(seen.contains([[Code.A, Code.B], [], [Code.B]]))

    int[][] different_rows = [[1], [2], []]
    seen[different_rows] = true
    print(seen.length())
    print(seen[[[1], [2], []]])
    print(seen[[[1, 2], [], [2]]])
    seen[[]] = true
    print(seen[[]])
    print(seen.length())

    map<int[][], bool> copied = preserve_grid_flags(seen)
    copied[[[1, 2], [], [2]]] = true
    print(copied[[[1, 2], [], [2]]])
    print(seen[[[1, 2], [], [2]]])
    print(copied.values().length())

    GLOBAL_GRID_FLAGS[[[Code.B]]] = true
    print(GLOBAL_GRID_FLAGS[[[2]]])
    GridStore store = GridStore({[[Code.A]]: false})
    print(store.flags[[[1]]])
    store.flags[[[Code.A]]] = true
    print(store.flags[[[1]]])
    return 0
