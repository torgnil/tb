record Item(int id, bool active, string label, int key, int rank);
record Other(string label, bool active, int key);

int compare_item_id(Item left, Item right):
    return left.id - right.id

int main(string[] args):
    int argc = args.length()
    Item[] items = [Item(1, false, 'one', 12 - argc, 4), Item(2, true, 'two', -5 + argc, 8), Item(3, true, 'three', 4, 1), Item(4, false, 'four', 4, 5)]
    Item[] sorted = items.sort((Item left, Item right) -> left.key - right.key)
    items.sort((Item left, Item right) -> left.key - right.key)
    print(sorted[0].key)
    print(sorted[1].key)
    print(sorted[2].key)
    print(sorted[3].key)

    items.sort((Item left, Item right) -> left.rank - right.rank)
    print(items[0].rank)
    print(items[1].rank)
    print(items[2].rank)
    print(items[3].rank)

    items[0] = Item(99, true, 'changed', -100, 0)
    print(sorted[0].id)
    items.sort(compare_item_id)
    print(items[0].id)
    print(items[1].id)
    print(items[2].id)
    print(items[3].id)

    prio_q<Item> by_key = items.create_prio_q((Item left, Item right) -> right.key - left.key)
    print(by_key.pop().key)
    print(by_key.pop().key)
    print(by_key.pop().key)
    print(by_key.pop().key)

    Other[] others = [Other('a', true, 5), Other('b', false, -2), Other('c', true, 5)]
    others.sort((Other left, Other right) -> left.key - right.key)
    print(others[0].key)
    print(others[1].key)
    print(others[2].key)

    Item[] empty_items = []
    empty_items.sort((Item left, Item right) -> left.key - right.key)
    print(empty_items.length())
    Item[] one_item = [Item(7, true, 'only', 3, 9)]
    one_item.sort((Item left, Item right) -> left.key - right.key)
    print(one_item[0].key)
    return 0
