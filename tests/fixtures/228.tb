record Empty();
record lowercase();
record _Marker();
record Holder(Empty value);
record Item(int value);
record pop();
record copy();
record last();
record index_of();

Empty make_empty():
    return Empty()

lowercase make_lowercase():
    return lowercase()

_Marker make_marker():
    return _Marker()

int main(string[] args):
    const Empty fixed = Empty()
    Empty[] empties = []
    empties.push(fixed)
    empties.push(make_empty())
    empties[0] = Empty()
    print(empties.length())

    lowercase[] lower_values = [lowercase()]
    lower_values.push(make_lowercase())
    print(lower_values.length())

    _Marker[] markers = []
    markers.push(make_marker())
    print(markers.length())

    Empty assigned = Empty()
    assigned = make_empty()
    Holder holder = Holder(assigned)
    holder.value = Empty()

    Item[] items = [Item(3)]
    items.push(Item(8))
    items[0] = Item(5)
    print(items[1].value)

    pop pop_value = pop()
    copy copy_value = copy()
    last last_value = last()
    index_of index_value = index_of()
    print(args.length())
    return 0
