import process;

int main(string[] args):
    if (args.length() > 1):
        if (args[1] == 'marker'):
            print(read_file('marker.txt').trim())
        else if (args[1] == 'check'):
            print(is_file('test-files/process-cwd/marker.txt'))
        else if (args[1] == 'recover'):
            print('recovered')
        return 0

    if (!is_file('test-files/process-cwd/marker.txt')):
        return 5
    string original_cwd_check = run_process([args[0], 'check']).stdout.trim()
    ProcessResult file = run_process_in_directory(
        [args[0], 'marker'], 'test-files/process-cwd')
    print(file.exit_code)
    print(file.stdout.trim())
    print(file.stderr == '')
    print(original_cwd_check == 'true' && run_process([args[0], 'check']).stdout.trim() == original_cwd_check)

    try:
        ProcessResult empty = run_process_in_directory([args[0], 'check'], '')
        print('unexpected-empty-directory-success')
    catch (exception error):
        print(error)

    try:
        ProcessResult missing = run_process_in_directory(
            [args[0], 'check'], 'test-files/no-such-process-directory')
        print('unexpected-missing-directory-success')
    catch (exception error):
        print(error == 'run_process: unable to run ' + args[0])

    try:
        ProcessResult not_directory = run_process_in_directory(
            [args[0], 'check'], 'test-files/process-cwd/marker.txt')
        print('unexpected-file-directory-success')
    catch (exception error):
        print(error == 'run_process: unable to run ' + args[0])

    ProcessResult recovered = run_process_in_directory(
        [args[0], 'recover'], 'test-files/process-cwd')
    print(recovered.stdout.trim())
    return 0
