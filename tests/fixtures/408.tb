enum Mode { READY }
record Indexer(int value);
record Counter(int value);

string trim(string text):
    return 'named:' + text

string char_at(Indexer item, int index):
    return 'custom'

int substring(Counter item, int start):
    return 73

int main(string[] args):
    string text = 'hello'
    string padded = ' hello '
    print(padded.trim())
    print(padded.trim_left() + '|')
    print(padded.trim_right() + '|')
    print(text.char_at(1))
    print(text.substring(1))
    print(text.substring(1, 4))
    print(text.replace('ell', 'ipp'))
    print(text.contains('ell'))
    print(text.index_of('ll'))
    print(Mode.READY.contains('EA'))
    print(trim('direct'))
    Indexer item = Indexer(1)
    print(item.char_at(0))
    Counter counter = Counter(1)
    print(counter.substring(0))
    return 0
