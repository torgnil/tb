import random;

int main(string[] args):
    try:
        random_below(0)
    catch (exception error):
        print(error)
    try:
        random_between(4, 4)
    catch (exception error):
        print(error)
    try:
        random_below(-1)
    catch (exception error):
        print(error)
    try:
        random_between(5, -5)
    catch (exception error):
        print(error)
    return 0
