int main(string[] args):
    try:
        random(0)
    catch (exception error):
        print(error)
    try:
        random(4, 4)
    catch (exception error):
        print(error)
    try:
        random(-1)
    catch (exception error):
        print(error)
    try:
        random(5, -5)
    catch (exception error):
        print(error)
    return 0
