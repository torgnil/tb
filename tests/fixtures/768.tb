int main():
    map<int[], bool[]> flags = {}
    flags[[1]] = [false]
    flags[[2]] = [false, false, true]
    flags[[3]] = []
    bool[][] rows = flags.values()
    bool[] replacement = [true, false]
    fill(rows, replacement)
    print(rows.length())
    print(rows[0].length())
    print(rows[1].length())
    print(rows[2].length())
    print(rows[0][0])
    print(rows[1][1])
    print(flags[[1]][0])
    replacement[0] = false
    print(rows[1][0])
    rows[0][0] = false
    print(rows[1][0])

    rows[0][0] = true
    rows.fill(rows[0])
    print(rows[1][0])
    print(rows[1][1])
    rows[0][0] = false
    print(rows[1][0])

    bool[] empty_replacement = []
    fill(rows, empty_replacement)
    print(rows[0].length())
    print(rows[1].length())

    map<int[], bool[]> no_flags = {}
    bool[][] empty = no_flags.values()
    empty.fill([true])
    print(empty.length())
    no_flags.values().fill([false])
    return 0
