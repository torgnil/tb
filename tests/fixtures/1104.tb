import union_find;

bool connected(const int[] parents, int left, int right):
    return parents.union_find_connected_readonly(left, right)

int main():
    int[] parents = union_find_new(5)
    parents.union_find_union(2, 0)
    parents.union_find_union(3, 1)
    parents.union_find_union(3, 2)
    print(connected(parents, 0, 1))
    print(connected(parents, 0, 4))
    print(connected(parents, 4, 4))
    print(parents[0])
    print(parents.union_find_connected(0, 1))
    print(parents[0])
    try:
        print(connected(parents, -1, -1))
    catch (exception error):
        print(error)
    try:
        print(connected(parents, 0, 5))
    catch (exception error):
        print(error)
    return 0
