enum Marker { LETTER }

string text_for_digit(int value):
    return value.to_string()

int main():
    print(is_alpha('a'))
    print(is_digit('7'))
    print(is_alnum('2'))
    print(is_space(' '))
    print(is_whitespace('\n'))
    print(is_alpha(Marker.LETTER))
    print(is_digit(text_for_digit(7)))
    string retained = text_for_digit(8)
    print(is_digit(retained))
    print(retained)
    return 0
