int[][] make_rows():
    return [[2, 3], [4]]

int first_item(int[][] rows):
    return rows[0][0]

int tail_item(int[][] rows):
    return rows[1][0]

int main(string[] args):
    thread_pool pool = thread_pool(1)
    future<int[][]> result = pool.submit(make_rows)
    int[][] first = result.await()
    first[0][0] = 99
    int[][] second = result.await()
    print(first_item(first))
    print(first_item(second))
    print(tail_item(second))
    return 0
