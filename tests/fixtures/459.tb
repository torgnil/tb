int count_true(const bool[] flags):
    return flags.sum()

int main(string[] args):
    bool[] empty = []
    bool[] empty_copy = empty.copy()
    bool[] empty_slice = empty[0:0]
    print(empty.length())
    print(empty_copy.length())
    print(empty_slice.length())

    bool[] initialized = [args.length() > 0, false]
    print(initialized.length())
    print(initialized[0])
    print(initialized[1])

    empty.push(true)
    empty.insert(-9, false)
    empty.insert(99, true)
    empty.insert(1, false)
    print(empty.length())
    print(empty[0])
    print(empty[1])
    print(empty[2])
    print(empty[3])
    print(count_true(empty))

    bool[] snapshot = empty.copy()
    bool[] middle = empty[1:3]
    snapshot[0] = true
    print(empty[0])
    print(snapshot[0])
    print(middle.length())
    print(middle[0])
    print(middle[1])

    empty.clear()
    print(empty.length())
    print(empty.pop())
    empty.push(false)
    print(empty.length())
    print(empty[0])
    return 0
