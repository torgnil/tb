bool[][] make_flags():
    return [[true, false]]

int main():
    thread_pool pool = thread_pool(1)
    future<int> result = pool.submit(int mode -> {
        int count = 0
        for (const bool[] row : make_flags()) {
            count += row.length()
        }
        return count
    }, 0)
    print(result.await())
    return 0
