

# Case 1
int random(int upper):
    return upper + 40

int combined_case_1_main(string[] args):
    print(random(2))
    return 0

# Case 2
string uuid():
    return 'user uuid'

int combined_case_2_main():
    print(uuid())
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main(args) != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main() != 0):
        return 1
    return 0
