record RowBox(int[] values);

int calls = 0
int[][] global_rows = [[70, 71]]
const int[][] const_rows = [[80, 81]]

int[][] make_grid(int seed):
    calls += 1
    return [[seed, seed + 1], [seed + 2], []]

int[] return_factory_row(int seed):
    return make_grid(seed)[1]

int first(int[] values):
    return values[0]

int nested_value(int seed):
    return make_grid(seed)[0][1]

int sum_direct_foreach(int seed):
    int total = 0
    for (int value in make_grid(seed)[0]):
        total += value
    return total

int sum_bound_foreach(int seed):
    int[] row = make_grid(seed)[0]
    int total = 0
    for (int value in row):
        total += value
    return total

int main(string[] args):
    int seed = args.length() + 4

    int[] returned = return_factory_row(seed)
    print(returned[0])

    int[] literal_row = [[seed], [seed + 1, seed + 2]][-1]
    print(literal_row[1])
    print(nested_value(seed))
    print(make_grid(seed)[-1].length())
    print(sum_direct_foreach(seed))
    print(sum_bound_foreach(seed))
    int call_start = calls
    int single_result = first(make_grid(seed)[0])
    print(single_result)
    print(calls - call_start)

    make_grid(seed)[0]
    print(calls - call_start)

    int[][] wrapped = [make_grid(seed)[0]]
    print(wrapped[0][1])
    map<int, int[]> mapped = {seed: make_grid(seed)[1]}
    print(mapped[seed][0])
    RowBox box = RowBox(make_grid(seed)[1])
    print(box.values[0])

    thread_pool pool = thread_pool(1)
    future<int[]> worker = pool.submit(int value -> make_grid(value)[0], seed)
    int[] worker_result = worker.await()
    print(worker_result[0])

    int[][] named = [[10, 11]]
    int[] borrowed_named = named[0]
    borrowed_named[0] = 12
    print(named[0][0])
    print(global_rows[0][0])
    print(const_rows[0][0])
    int[][] field_rows = [[30, 31]]
    RowBox field_box = RowBox(field_rows[0])
    print(field_box.values[1])

    return 0
