enum Mode { READY, DONE }
record State(Mode value);

Mode make_mode():
    return 'mode ' + 'ready'

State make_state():
    Mode mode = make_mode()
    State state = State(mode)
    return state

int main():
    State original = make_state()
    State copy = original
    print(copy.value)

    original.value = 'replacement ' + 'value'
    print(copy.value)
    print(original.value)
    return 0
