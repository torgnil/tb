import regex;

void show_at(RegexMatch found):
    print(found.matched)
    print(found.start)
    print(found.end)

int main():
    Regex runs = regex_compile('a+')
    show_at(regex_match_at(runs, 'baa', 0))
    show_at(regex_find_from(runs, 'baa', 0))
    show_at(regex_match_at(runs, 'baa', 1))
    show_at(regex_match_at(regex_compile('a|aa'), 'baa', 1))
    show_at(regex_match_at(regex_compile('^a'), 'aa', 1))
    show_at(regex_match_at(regex_compile('$'), 'ba\n', 2))
    show_at(regex_match_at(regex_compile(''), 'ba', 2))
    show_at(regex_match_at(runs, 'baa', -1))
    show_at(regex_match_at(runs, 'baa', 4))
    show_at(regex_match_at(regex_compile('('), 'baa', 0))
    return 0
