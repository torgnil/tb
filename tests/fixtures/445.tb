enum Mode { READY, DONE }
record Packet(string text);

string saved_text = ''
Mode saved_mode = Mode.READY
exception saved_error = ''
const exception saved_error_copy = saved_error

string replace_text(string value, int seed):
    value = 'value-' + seed
    value += '!'
    value = value
    return value

string return_early(string value, int seed):
    value = 'early-' + seed
    if seed > 0:
        return value
    return 'unreachable'

string catch_and_continue(string value, int seed):
    value = 'caught-' + seed
    try {
        throw 'local throw'
    } catch (string ignored) {
        value += ':local'
    }
    return value

string read_const(const string value):
    return value

string shadow_const(const string value, int seed):
    if seed > 0:
        string value = 'shadow-' + seed
        return value
    return value

Mode read_const_mode(const Mode value):
    return value

string[] make_row(string value, int seed):
    value = 'row-' + seed
    return [value]

map<int, string> make_map(string value, int seed):
    value = 'map-' + seed
    map<int, string> result = {}
    result[seed] = value
    return result

Packet make_packet(string value, int seed):
    value = 'packet-' + seed
    return Packet(value)

void save_text(string value, int seed):
    value = 'saved-' + seed
    saved_text = value
    return

void save_mode(Mode value):
    value = Mode.DONE
    saved_mode = value

void replace_and_throw(exception value, int seed):
    value = 'thrown-' + seed
    saved_error = value
    throw value

int main(string[] args):
    int seed = args.length() + 2
    string caller = 'caller'
    print(replace_text(caller, seed))
    print(caller)
    print(read_const('fixed'))
    print(read_const_mode(Mode.READY))
    string[] row = make_row('source', seed)
    print(row[0])
    map<int, string> values = make_map('source', seed)
    print(values[seed])
    Packet packet = make_packet('source', seed)
    print(packet.text)
    save_mode(Mode.READY)
    print(saved_mode)
    try {
        replace_and_throw('source', seed);
    } catch (string message) {
        print(message);
    }
    print(saved_error)
    print('[' + saved_error_copy + ']')
    save_text('source', seed)
    print(saved_text)
    print(catch_and_continue('source', seed))
    print(return_early(caller, seed))
    print(caller)
    print(shadow_const(caller, seed))
    return 0
