import regex;

int main(string[] args):
    print(regex_replace_from(regex_compile('a'), 'baac', 'X', 0))
    print(regex_replace_from(regex_compile('a'), 'baac', 'X', 2))
    print(regex_replace_from(regex_compile('a'), 'éa', 'X', 2))
    print(regex_replace_from(regex_compile('a'), 'baac', 'X', 4))
    print(regex_replace_from(regex_compile('a'), 'baac', 'X', -1))
    print(regex_replace_from(regex_compile('a'), 'baac', 'X', 5))
    print(regex_replace_from(regex_compile('a'), 'baac', '$$1', 1))
    print(regex_replace_from(regex_compile('(a)(b)'), 'zab ab!', '$2-$1:$0', 1))
    print(regex_replace_from(regex_compile('(a)(b)'), 'ab ab', '$2-$1', 3))
    print(regex_replace_from(regex_compile('(a*)'), 'abc', '<$1>', 1))
    print(regex_replace_from(regex_compile('(a)'), 'baac', '$1', -1))
    print(regex_replace_from(regex_compile(''), 'abc', '-', 1))
    print(regex_replace_from(regex_compile(''), 'abc', 'X', 3))
    print(regex_replace_from(regex_compile('^a'), 'abc', 'X', 1))
    print(regex_replace_from(regex_compile('$'), 'abc', '>', 1))
    print(regex_replace_from(regex_compile('z'), 'abc', 'X', 1))
    print(regex_replace_from(regex_compile('('), 'abc', 'X', 1))
    print(regex_replace(regex_compile('a'), 'baac', 'X'))
    print(regex_replace_from(regex_compile('a'), 'baac', 'X', 0))
    return 0
