record Item(int value);

int compare_int(int left, int right):
    return left - right

int compare_item(Item left, Item right):
    return left.value - right.value

int is_empty(int value):
    return value + 3

int main():
    print(is_empty(4))
    set<Item> items = {Item(1)}
    set<Item> empty_items = {}
    print(is_empty(items))
    print(is_empty(empty_items))

    int[] values = [1, 2]
    int[] no_values = []
    prio_q<int> queue = values.create_prio_q(compare_int)
    prio_q<int> empty_queue = no_values.create_prio_q(compare_int)
    print(is_empty(queue))
    print(is_empty(empty_queue))

    Item[] item_values = [Item(2)]
    Item[] no_items = []
    prio_q<Item> item_queue = item_values.create_prio_q(compare_item)
    prio_q<Item> empty_item_queue = no_items.create_prio_q(compare_item)
    print(is_empty(item_queue))
    print(is_empty(empty_item_queue))
    return 0
