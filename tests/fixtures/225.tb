string make_key(int value):
    return 'owned-' + value

string make_managed_key(int value):
    return 'managed-' + value

string compound_key(int value):
    print('key-call')
    return 'compound-' + value

int compound_rhs():
    print('rhs-call')
    return 2

int main(string[] args):
    int count = args.length()
    string borrowed = 'borrowed-' + count
    const string fixed = 'fixed-' + count
    map<string, int> scores = {borrowed: 1, fixed: 2, 'literal': 3, '': 4, 'owned-' + count: 5, 'concat-' + count: 6, 'slice-' + count: 7, 'c': 8, 'compound-' + count: 4}

    print(scores[borrowed])
    print(scores[fixed])
    print(scores['literal'])
    print(scores[''])
    print(scores[make_key(count)])
    print(scores['concat-' + count])
    string full_key = 'slice-' + count + '-tail'
    print(scores[full_key[0:full_key.length() - 5]])
    string char_source = 'char-' + count
    print(scores[char_source.char_at(0)])

    scores[make_key(count)] = 9
    print(scores['owned-' + count])
    borrowed = 'changed'
    print(scores['borrowed-' + count])

    map<string, string> names = {'string-value': 'before'}
    names[make_key(count + 1)] = 'after-' + count
    print(names['owned-' + (count + 1)])
    print(names['string-value'])

    map<string, int[]> rows = {'managed-' + count: [count]}
    rows[make_managed_key(count)] = [count + 1]
    print(rows['managed-' + count][0])
    print(rows[make_managed_key(count)][0])

    map<string, map<string, int>> nested = {'owned-' + (count + 2): {'leaf': count}}
    print(nested[make_key(count + 2)]['leaf'])
    nested[make_key(count + 2)] = {'leaf': count + 1}
    print(nested['owned-' + (count + 2)]['leaf'])

    map<string, int> totals = {'compound-' + count: 4}
    totals[compound_key(count)] += compound_rhs()
    print(totals['compound-' + count])

    int index = 0
    while (index < 3):
        print(scores[make_key(count)])
        index += 1

    map<int, int> integer_keys = {count: 10}
    print(integer_keys[count])
    integer_keys[count] = 11
    print(integer_keys[count])
    return 0
