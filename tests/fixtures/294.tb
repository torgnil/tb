int main(string[] args) {
    int seed = args.length();
    int[] values = [2, seed];
    int total = 0;
    for (const int item : values) {
        total += item;
        print(item);
    }
    for (int item : values) {
        item += 10;
        total += item;
        print(item);
    }
    print(values[0]);
    print(values[1]);

    for (int reverse_item : values) {
        reverse_item += 20;
        print(reverse_item);
    }
    for (const int reverse_item : values) {
        print(reverse_item);
    }

    bool[] flags = [true, false];
    for (const bool flag : flags) {
        print(flag);
    }
    for (bool flag : flags) {
        flag = !flag;
        print(flag);
    }
    print(flags[0]);
    print(flags[1]);

    string[] words = ['fixed', 'runtime-' + args.length()];
    for (const string word : words) {
        print(word);
    }
    for (string word : words) {
        word = word + '-changed';
        print(word);
    }
    print(words[0]);
    print(words[1]);

    int[][] rows = [[3, seed], [seed + 1]];
    for (const int[] row : rows) {
        total += row.length();
        print(row[0]);
    }
    for (int[] row : rows) {
        row = [];
        print(row.length());
    }
    print(rows[0][0]);
    print(rows[1][0]);
    print(total);

    const int[] empty_values = [];
    for (const int empty : empty_values) {
        total += empty;
    }
    print(total);
    return 0;
}
