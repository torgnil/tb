record Item(int value);

Item[] observed_items = []

Item[] make_items(int value):
    return [Item(value), Item(value + 1)]

void observe_items(Item[] items):
    observed_items = items

int main():
    observe_items(make_items(20))
    print(observed_items[0].value)
    print(observed_items[1].value)
    return 0
