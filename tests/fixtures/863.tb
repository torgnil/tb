string[] task_words():
    return ['oak', 'fir']

int[] fail_with_array():
    throw 'worker local failure'

int main():
    thread_pool pool = thread_pool(2)

    future<int> local_sum = pool.submit(() -> {
        const string label = 'row-' + 'sum'
        int[] values = [2, 4]
        int[][] rows = [[1, 3], [5]]
        string[] words = task_words()
        int sum = label.length()
        for (int value : values) {
            sum = sum + value
        }
        for (const int[] row : rows) {
            for (int row_value : row) {
                sum = sum + row_value
            }
        }
        for (string word : words) {
            sum = sum + word.length()
        }
        return sum
    })
    print(local_sum.await())

    future<int[]> returned = pool.submit(() -> {
        int[] result = [11, 12]
        return result
    })
    int[] result = returned.await()
    print(result[0] + result[1])

    future<int> bool_array_sum = pool.submit(bool[] input -> {
        bool[] local_input = input
        int count = 0
        for (bool value : local_input) {
            if (value) {
                count = count + 1
            }
        }
        return count
    }, [true, false, true])
    print(bool_array_sum.await())

    future<int> string_grid_length = pool.submit(string[][] input -> {
        string[][] local_input = input
        return local_input[0][0].length()
    }, [['maple']])
    print(string_grid_length.await())

    future<int> bool_grid_value = pool.submit(bool[][] input -> {
        bool[][] local_input = input
        return local_input[0][0] ? 1 : 0
    }, [[true]])
    print(bool_grid_value.await())

    future<int> failure_one = pool.submit(() -> {
        int[] retained = [20, 30]
        int[] missing = fail_with_array()
        return retained.length() + missing.length()
    })
    try:
        print(failure_one.await())
    catch (exception error_one):
        print(error_one)

    future<int> failure_two = pool.submit(() -> {
        int[] retained_two = [20, 30]
        int[] missing_two = fail_with_array()
        return retained_two.length() + missing_two.length()
    })
    try:
        print(failure_two.await())
    catch (exception error_two):
        print(error_two)

    future<int> failure_three = pool.submit(() -> {
        int[] retained_three = [20, 30]
        int[] missing_three = fail_with_array()
        return retained_three.length() + missing_three.length()
    })
    try:
        print(failure_three.await())
    catch (exception error_three):
        print(error_three)

    future<int> after_failure = pool.submit(() -> {
        string local = 'pool-reused'
        return local.length()
    })
    print(after_failure.await())
    return 0
