int GLOBAL_NEGATED = -17
num GLOBAL_PRECISE = -2.750

int negate_constant(const int value):
    return -value

num negate_number(const num value):
    return -value

bool invert(bool value):
    return not value

int main(string[] args):
    const int seed = args.length() + 4
    const num precise = args.length() + 0.50
    bool is_default = args.length() == 1

    print(-seed)
    print(-negate_constant(seed))
    print(-(-seed))
    print(-precise)
    print(-negate_number(precise))
    print(-(-precise))
    print(!is_default)
    print(not is_default)
    print(invert(is_default))
    print(GLOBAL_NEGATED)
    print(GLOBAL_PRECISE)

    if (is_default):
        print(-3)
    else:
        print(-4)

    int loop_total = 0
    for (int index : range(3)):
        loop_total += -index
    print(loop_total)
    return 0
