int contains(int left, int right):
    return left + right

int main(string[] args):
    int seed = args.length() + 7
    const int fixed_seed = seed + 10
    print(contains(seed, 3))
    print(seed.contains(3))
    print(fixed_seed.contains(1))
    for (int offset : range(2)):
        print((seed + offset).contains(2))

    print('alpha'.contains('ph'))
    const int[] numbers = [seed, seed + 1]
    print(numbers.contains(seed + 1))
    print(numbers.contains(99))
    bool[] flags = [true, false]
    print(flags.contains(false))
    print(flags.contains(true))
    string[] words = ['alpha', 'beta']
    print(words.contains('beta'))
    print(words.contains('missing'))
    map<int, int> counts = {seed: seed}
    print(counts.contains(seed))
    print(counts.contains(seed + 1))
    set<int> seen = {seed, seed + 1}
    print(seen.contains(seed + 1))
    print(seen.contains(99))
