record ChoiceBox(string text);
enum ChoiceMode {
    LEFT,
    RIGHT
}

int trace = 0
int global_first = condition(1, true) ? mark(2) : mark(9)
int global_second = condition(3, false) ? mark(9) : mark(4)
string global_text = false ? fail_text() : make_text(5)

bool condition(int digit, bool value):
    trace = trace * 10 + digit
    return value

int mark(int digit):
    trace = trace * 10 + digit
    return digit

int fail_value():
    throw 'selected'

string fail_text():
    throw 'unselected'

string make_text(int seed):
    return 'word-' + seed.to_string()

string[] make_words(int seed):
    return [make_text(seed)]

int read_words(string[] words):
    return words[0].length()

string choose_text(bool flag, string left, string right):
    return flag ? left : right

string[] choose_words(bool flag, string[] left, string[] right):
    return flag ? left : right

map<string, int> choose_map(bool flag, map<string, int> left, map<string, int> right):
    return flag ? left : right

ChoiceBox choose_box(bool flag, ChoiceBox left, ChoiceBox right):
    return flag ? left : right

ChoiceBox make_box(int seed):
    return ChoiceBox(make_text(seed))

ChoiceBox choose_owned_box(bool flag, int seed):
    return flag ? make_box(seed) : make_box(seed + 1)

int main(string[] args):
    print(global_first)
    print(global_second)
    print(trace)
    print(global_text)
    bool yes = args.length() > 0
    bool no = args.length() < 0
    bool flip = args.length() == 1
    trace = 0
    print(condition(1, yes) ? mark(2) : mark(9))
    print(condition(3, no) ? mark(9) : mark(4))
    print(trace)
    print(yes ? 8 : fail_value())
    print(no ? fail_value() : 9)
    print(yes ? 10 : 1 / (args.length() - args.length()))
    print(yes ? 11 : args[1000].length())
    print(no ? 0 : yes && !no ? 12 : 0)
    print((yes ? no : yes) || yes)
    int selected = no ? 1 : 2
    selected = yes ? selected + 1 : 100
    if (yes ? true : false):
        print(selected)
    int loops = 0
    while (loops < 3 ? yes : no):
        loops += 1
    for (int i = 0; yes ? i < 2 : false; i += 1):
        loops += 1
    print(loops)
    try:
        print(no ? fail_value() : 13)
        print(yes ? fail_value() : 0)
    catch (string message):
        print(message)
    const int fixed = 14
    print(yes ? fixed : selected)
    print((flip ? ChoiceMode.LEFT : ChoiceMode.RIGHT) == (flip ? 'LEFT' : 'RIGHT'))
    print(choose_text(flip, make_text(1), make_text(3)) == make_text(args.length()))
    string text = flip ? make_text(1) : make_text(3)
    print(text == make_text(args.length()))
    print(read_words(flip ? make_words(1) : make_words(3)))
    string[] left = ['left']
    string[] right = ['right']
    string[] words = choose_words(flip, left, right)
    words.push('copy')
    print(left.length())
    print(right.length())
    print(words.length())
    map<string, int> first = {'key': 1}
    map<string, int> second = {'key': 2}
    map<string, int> copied = choose_map(flip, first, second)
    copied['key'] = 9
    print(first['key'])
    print(second['key'])
    print(copied['key'])
    ChoiceBox one = ChoiceBox(make_text(1))
    ChoiceBox two = ChoiceBox(make_text(2))
    ChoiceBox box = choose_box(flip, one, two)
    box.text = 'changed'
    print(one.text)
    print(two.text)
    print(box.text)
    ChoiceBox owned = choose_owned_box(flip, args.length())
    print(owned.text == make_text(flip ? 1 : 4))
    box.text = flip ? make_text(1) : make_text(3)
    global_text = flip ? make_text(1) : make_text(3)
    print(box.text == global_text)
    print(make_words(args.length()).contains(flip ? make_text(1) : make_text(3)))
    int sum = 0
    for (int i = 0; i < 4; i += 1):
        string[] row = i % 2 == 0 ? make_words(i) : make_words(i + 10)
        sum += row.length()
    print(sum)
    thread_pool pool = thread_pool(1)
    future<int> integer = pool.submit(() -> flip ? 71 : 72)
    future<bool> boolean = pool.submit(() -> flip ? true : false)
    print(integer.await() == (flip ? 71 : 72))
    print(boolean.await() == flip)
    return 0
