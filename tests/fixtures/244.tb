record Box(string text);

string repeated(string value):
    Box box = Box(value)
    box = Box(box.text)
    box = Box(box.text)
    return box.text

string concatenated(string value):
    Box box = Box(value)
    box = Box('wrapped-' + box.text)
    return box.text

string branched(string value, bool choose):
    Box box = Box(value)
    if (choose):
        box = Box(box.text + '-yes')
    else:
        box = Box(box.text + '-no')
    return box.text

string looped(string value):
    Box box = Box(value)
    int index = 0
    while (index < 2):
        box = Box(box.text + '-loop')
        index++
    return box.text

int main(string[] args):
    int argc = args.length()
    string value = 'value-' + argc.to_string()
    print(repeated(value))
    print(concatenated(value))
    print(branched(value, true))
    print(branched(value, false))
    print(looped(value))
    Box first = Box('first-' + argc.to_string())
    Box second = Box('second-' + argc.to_string())
    print(first.text)
    print(second.text)
    Box literal = Box('acyclic-literal')
    print(literal.text)
    print('acyclic-after-cycles')
    return 0
