int main(string[] args):
    thread_pool pool = thread_pool(2)
    int bound = 5
    future<int> captured = pool.submit(() -> {
        int total = 0
        for (int item : range(1, bound)) {
            total += item
            item = 99
        }
        return total
    })
    future<int> argument = pool.submit(int end -> {
        int total = 0
        for (int item : range(end)) {
            total += item
        }
        return total
    }, args.length() + 3)
    future<int> control = pool.submit(int limit -> {
        int total = 0
        int __tb_range_start_1 = 0
        int __tb_range_end_2 = 0
        int __tb_range_counter_3 = 0
        for (int outer : range(-2, 2)) {
            for (int nested_outer : range(1)) {
                for (int nested_inner : range(1)) {
                    total += 0
                }
            }
            int inner = 0
            while (inner < 3) {
                inner += 1
                for (int while_range : range(1)) {
                    total += 0
                }
                if (inner == 2) {
                    continue
                }
                if (outer < 0) {
                    switch (outer) {
                        case -2: {
                            for (int case_range : range(1)) {
                                total += 0
                            }
                            total += 1
                            break
                        }
                        default: {
                            for (int default_range : range(1)) {
                                total += 0
                            }
                            total += inner
                        }
                    }
                } else {
                    for (int else_range : range(1)) {
                        total += 0
                    }
                    total += outer
                }
            }
        }
        for (int index = 0; index < 4; index += 1) {
            for (int for_range : range(1)) {
                total += 0
            }
            if (index == 2) {
                continue
            }
            if (index == 3) {
                break
            }
            total += index
        }
        for (int empty : range(0)) {
            total += 100
        }
        for (int equal : range(3, 3)) {
            total += 100
        }
        for (int reversed : range(3, -1)) {
            total += 100
        }
        if (limit == 1) {
            for (int then_range : range(1)) {
                total += 10
            }
        } else {
            for (int else_branch_range : range(2)) {
                total += 10
            }
        }
        switch (limit) {
            case 1: {
                for (int case_branch_range : range(1)) {
                    total += 100
                }
            }
            default: {
                for (int default_branch_range : range(2)) {
                    total += 100
                }
            }
        }
        return total
    }, args.length())
    future<int> early = pool.submit(int end -> {
        for (int item : range(end)) {
            if (item == 3) {
                return item
            }
        }
        return -1
    }, 8)
    future<int> failure = pool.submit(int value -> {
        for (int item : range(1)) {
            if (value < 0) {
                throw 'negative'
            }
            return value
        }
        return -1
    }, -1)
    print(captured.await())
    print(argument.await())
    print(control.await())
    print(early.await())
    try:
        failure.await()
    catch (exception error):
        print(error)
    return 0
