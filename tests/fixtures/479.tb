bool filter_then_throw(int item):
    print('filter callback ' + item)
    if item == 4:
        throw 'filter callback failure'
    return item % 2 == 1

bool filter_throw_first(int item):
    throw 'filter first callback failure'

bool nested_filter_callback(int item):
    if item == 2:
        try:
            throw 'inner filter failure'
        catch (exception err):
            print('caught ' + err)
    if item == 3:
        throw 'outer filter failure'
    return item % 2 == 1

int main(string[] args):
    int[] values = [1, 2, 3, 4, 5]
    try:
        int[] first_failure = values.filter(int item -> filter_throw_first(item))
        print(first_failure)
    catch (exception err):
        print('caught ' + err)
    try:
        int[] selected = values.filter(int item -> filter_then_throw(item))
        print(selected)
    catch (exception err):
        print('caught ' + err)
    print('continued after filter')

    int[] normal = values.filter(int item -> item % 2 == 1)
    print(normal)
    int[] empty = []
    int[] empty_filter = empty.filter(int item -> item % 2 == 1)
    print(empty_filter.length())

    try:
        int[] nested = values.filter(int item -> nested_filter_callback(item))
        print(nested)
    catch (exception err):
        print('caught ' + err)
    try:
        throw 'later filter throw'
    catch (exception err):
        print('caught ' + err)
    return 0
