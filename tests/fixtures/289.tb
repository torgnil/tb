int int_worker(int seed):
    return seed + 3

bool bool_worker(int seed):
    return seed == 1

string string_worker(int seed):
    return 'ready'

int[] array_worker(int seed):
    return [seed + 7]

int[][] nested_array_worker(int seed):
    return [[seed + 11]]

int read_int(future<int> value):
    return value.await()

int read_with(int offset, const future<int> value):
    return offset + value.await()

bool read_bool(const future<bool> value):
    return value.await()

string read_string(future<string> value):
    return value.await()

int read_int_array(future<int[]> value):
    int[] items = value.await()
    return items[0]

int read_nested_array(future<int[][]> value):
    int[][] rows = value.await()
    return rows[0][0]

int main(string[] args):
    thread_pool pool = thread_pool(2)
    int seed = args.length()
    const future<int> first = pool.submit(int_worker, seed)
    print(read_int(first))
    print(first.read_int())
    int offset = 1
    print(offset.read_with(first))
    print(first.await())

    future<bool> flag = pool.submit(bool_worker, seed)
    print(read_bool(flag))

    future<string> label = pool.submit(string_worker, seed)
    print(read_string(label))

    future<int[]> items = pool.submit(array_worker, seed)
    print(read_int_array(items))

    future<int[][]> rows = pool.submit(nested_array_worker, seed)
    print(read_nested_array(rows))
    return 0
