int fail_after_replacement(int[] values):
    throw 'escaped after replacement'

int main():
    thread_pool pool = thread_pool(1)
    future<int> task = pool.submit(() -> {
        int[] values = [1]
        values = [2, 3]
        return fail_after_replacement(values)
    })
    try:
        print(task.await())
    catch (exception error):
        print(error)
    future<int> next = pool.submit(() -> 7)
    print(next.await())
    return 0
