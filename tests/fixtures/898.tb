int ascending(int left, int right):
    if (left < right):
        return -1
    if (left > right):
        return 1
    return 0

int descending(int left, int right):
    return ascending(right, left)

int by_absolute(int left, int right):
    return ascending(left.abs(), right.abs())

void drain(prio_q<int> queue):
    while (!queue.is_empty()):
        print(queue.pop())

int main():
    int[] values = [4, -2, 4, 0, -9, 3]
    prio_q<int> low = values.create_prio_q(ascending)
    values[0] = 99
    low.push(-10)
    low.push(4)
    low.push(10)
    drain(low)
    print(low.is_empty())
    low.push(17)
    print(low.pop())
    print(low.pop())
    int[] empty = []
    prio_q<int> high = empty.create_prio_q(descending)
    high.push(-8)
    high.push(7)
    high.push(1)
    high.push(7)
    drain(high)
    int[] absolute_values = [5, -3, 2]
    prio_q<int> absolute = absolute_values.create_prio_q(by_absolute)
    absolute.push(-1)
    absolute.push(9)
    absolute.push(-6)
    drain(absolute)
    return 0
