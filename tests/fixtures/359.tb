    print(mixed.uuid_is_valid())
    print(uuid_is_valid('00000000-0000-0000-0000-000000000000'))
    print(uuid_is_valid('550e8400-e29b-01d4-0716-446655440000'))
    print(uuid_is_valid('550e8400e29b-41d4-a716-446655440000'))
