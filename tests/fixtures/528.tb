num from_int(int value):
    return value * 1.25

num failing_int(int value):
    throw 'numeric integer worker failed'

int main(string[] args):
    thread_pool pool = thread_pool(1)
    const int amount = 4
    future<num> result = pool.submit(from_int, amount)
    const future<num> alias = result
    print(alias.wait_for(10000))
    print(result.is_done())
    print(alias.await())
    print(result.await())

    future<num> failed = pool.submit(failing_int, amount)
    try:
        print(failed.await())
    catch (exception error):
        print(error)
    try:
        print(failed.await())
    catch (exception error):
        print(error)
    return 0
