import regex;

int main():
    print(regex_reserved('['))
    print(regex_reserved('[]'))
    print(regex_reserved(''))
    print(regex_class_escape('D'))
    print(regex_class_escape('dD'))
    print(regex_class_escape(''))
    print(regex_escapable('\\'))
    print(regex_escapable('??'))
    print(regex_escapable(''))
    print(regex_class_matches('DW', 'a'))
    print(regex_match(regex_compile('^a+b?c*$'), 'aabc'))
    print(regex_match(regex_compile('^a+b?c*$'), 'zaabc'))
    print(regex_escape('a*b+c?'))
    return 0
