import regex;

record RegexRepeat(int value);
record RegexPostfix(string label);

int main(string[] args):
    RegexRepeat repeat = RegexRepeat(args.length())
    RegexPostfix postfix = RegexPostfix('caller')
    print(repeat.value > 0)
    print(postfix.label)
    Regex pattern = regex_compile('(ab){2,3}')
    print(regex_match(pattern, 'abab'))
    RegexCapture capture = regex_find_captures(pattern, 'xababz')
    print(regex_group(capture, 'xababz', 0))
    print(regex_group(capture, 'xababz', 1))
    print(regex_replace_first(pattern, 'xababz', '<$1>'))
    return 0
