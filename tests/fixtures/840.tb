num choose_amount(bool choose_large, int amount):
    return choose_large ? amount + 0.25 : amount * 0.5

int main():
    thread_pool pool = thread_pool(1)
    bool choose_large = true
    int amount = 3
    future<num> result = pool.submit(() -> choose_amount(choose_large, amount))
    print(result.await())
    return 0
