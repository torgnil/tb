record Label(string text, int value);

map<string, int> make_counts():
    map<string, int> counts = {'first': 1, 'second': 2}
    counts['first'] = 3
    return counts

string pass_through(string value):
    return value

string plain_value():
    return 'returned literal'

int main(string[] args):
    map<string, int> counts = make_counts()
    print(counts['first'])
    print(counts['second'])
    counts['second'] = 4
    print(counts['second'])
    counts = {}
    print(counts.is_empty())

    string[] labels = ['old', 'keep']
    labels[0] = 'replacement'
    print(labels[0])
    labels = []
    labels.push('after reset')
    print(labels[0])

    Label item = Label('record literal', 5)
    item.text = 'record replacement'
    print(item.text)
    print(item.value)

    print(pass_through('parameter literal'))
    print(plain_value())
    print(pass_through(''))
    print('line one\nline two')

    string runtime_value = 'runtime-' + args.length()
    string[] mixed = ['literal', runtime_value, 'literal']
    print(mixed[0])
    print(mixed[1])
    print(mixed[2])
    return 0
