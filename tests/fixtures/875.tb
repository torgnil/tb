string[] words():
    return ['new', 'word']

int[] failure():
    throw 'replacement failed'

int main():
    thread_pool pool = thread_pool(1)
    future<int> task = pool.submit(string[][] input -> {
        string label = 'first'
        label = 'new'
        string[] row = words()
        row = words()
        string[][] grid = input
        grid = input
        int[][] numbers = [[1], [2]]
        numbers = [[3], [4]]
        int[] values = [5]
        int counter = 0
        while (counter < 2) {
            values = [counter, 7]
            counter = counter + 1
        }
        try {
            values = failure()
        } catch (exception error) {
            counter = counter + 1
        }
        return label.length() + row.length() + grid[0][0].length() + numbers[0][0] + values[0] + counter
    }, [['abc']])
    print(task.await())
    future<int> bool_task = pool.submit(bool[] input -> {
        bool[] flags = input
        flags = input
        return flags.length()
    }, [false, true])
    print(bool_task.await())
    return 0
