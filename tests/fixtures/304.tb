int global_capture = 12

int add_values(int left, int right):
    return left + right

future<int> submit_from_parameter(thread_pool pool, int value):
    int offset = 4
    return pool.submit(() -> value + offset)

int main(string[] args):
    thread_pool pool = thread_pool(2)
    int first = 10 + args.length()
    const int second = 7
    future<int> two_ints = pool.submit(() -> first + second)
    first = 100
    print(two_ints.await())
    print(two_ints.await())

    bool enabled = true
    const int adjustment = 3
    future<int> mixed = pool.submit(() -> {
        int result = add_values(first, adjustment)
        if (enabled) {
            return result
        } else {
            return 0
        }
    })
    enabled = false
    print(mixed.await())

    bool left = true
    const bool right = false
    future<int> bools = pool.submit(() -> {
        if (left && !right) {
            return 9
        }
        return 2
    })
    left = false
    print(bools.await())

    future<int> global_and_local = pool.submit(() -> global_capture + first)
    global_capture = 99
    print(global_and_local.await())

    future<int> global_and_parameter = submit_from_parameter(pool, global_capture)
    print(global_and_parameter.await())
    return 0
