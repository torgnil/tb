record IntCell(int value);
record BoolCell(bool value);

int rebuilt_int(int value):
    IntCell cell = IntCell(value)
    cell = IntCell(cell.value)
    cell = IntCell(cell.value)
    return cell.value

bool rebuilt_bool(bool value):
    BoolCell cell = BoolCell(value)
    cell = BoolCell(cell.value)
    cell = BoolCell(cell.value)
    return cell.value

int arithmetic(int value):
    IntCell cell = IntCell(value)
    cell = IntCell((cell.value + 4) * 2)
    return -cell.value

bool negated(bool value):
    BoolCell cell = BoolCell(value)
    cell = BoolCell(!cell.value)
    return cell.value

int branch_loop(int value):
    IntCell cell = IntCell(value)
    if (value > 1):
        cell = IntCell(cell.value + 3)
    else:
        cell = IntCell(cell.value - 2)
    int index = 0
    while (index < 2):
        cell = IntCell(cell.value + index)
        index++
    return cell.value

bool branch_loop_bool(bool value):
    BoolCell cell = BoolCell(value)
    if (value):
        cell = BoolCell(!cell.value)
    else:
        cell = BoolCell(true)
    int index = 0
    while (index < 2):
        cell = BoolCell(!cell.value)
        index++
    return cell.value

int main(string[] args):
    int value = args.length()
    bool flag = value > 1
    print(rebuilt_int(value))
    print(rebuilt_bool(flag))
    print(arithmetic(value))
    print(negated(flag))
    print(branch_loop(value))
    print(branch_loop_bool(flag))
    IntCell first = IntCell(value + 10)
    IntCell second = IntCell(value + 20)
    print(first.value)
    print(second.value)
    IntCell acyclic = IntCell(6 * 7)
    BoolCell acyclic_bool = BoolCell(true && false)
    print(acyclic.value)
    print(acyclic_bool.value)
    print('acyclic-after-cycles')
    return 0
