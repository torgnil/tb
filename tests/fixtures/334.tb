record Item(int value);
record Box(int[] values);

int side_effect_order = 0

int ordered_index():
    side_effect_order = side_effect_order * 10 + 1
    return -1

int ordered_value():
    side_effect_order = side_effect_order * 10 + 2
    return 44

int main(string[] args):
    int[] numbers = [10, 20, 30]
    print(numbers[0])
    print(numbers[-3])
    print(numbers[-1])
    numbers[1] = 25
    numbers[-1] += 2
    print(numbers[1])
    print(numbers[2])

    bool[] flags = [true, false]
    print(flags[-2])
    print(flags[-1])
    flags[-1] = true
    print(flags[1])

    string[] words = ['first', 'second']
    print(words[-2])
    words[-1] = 'updated'
    print(words[-1])

    int[][] grid = [[1, 2], [3, 4]]
    print(grid[-1][-2])
    grid[-2] = [5, 6]
    print(grid[0][1])

    string[][] labels = [['north'], ['south']]
    print(labels[-1][-1])
    labels[0] = ['east']
    print(labels[0][0])

    Item[] items = [Item(7), Item(8)]
    print(items[-1].value)
    items[-1] = Item(9)
    print(items[1].value)

    const int[] fixed = [5, 6]
    print(fixed[-1])

    Box box = Box([12, 13])
    print(box.values[-1])
    box.values[-1] = 14
    print(box.values[1])

    int[] ordered = [40, 50]
    ordered[ordered_index()] = ordered_value()
    print(side_effect_order)
    print(ordered[-1])

    int[][] expanded_numbers = [[]]
    expanded_numbers[2] = [31]
    print(expanded_numbers.length())
    print(expanded_numbers[1].length())
    print(expanded_numbers[2][0])
    expanded_numbers[-1] = [32]
    print(expanded_numbers[-1][0])

    string[][] expanded_words = [[]]
    expanded_words[3] = ['tail']
    print(expanded_words.length())
    print(expanded_words[1].length())
    print(expanded_words[3][0])
    expanded_words[-1] = ['replacement']
    print(expanded_words[-1][0])
    return 0
