int main(string[] args):
    int offset = args.length() - args.length()
    int start = offset - 3
    int end = offset - 1
    int[] values = [10, 20, 30, 40]
    int[] middle = values[start:end]
    print(middle)
    middle[0] = 99
    print(values)
    print(values[:-1])
    print(values[-2:])
    print(values[-20:20])
    print(values[3:1])
    print(values[10:])
    print(values[:-20])
    int[] empty = []
    print(empty[-2:3])
    const int[] const_empty = []
    int[] const_empty_slice = const_empty[-20:20]
    print(const_empty_slice.length())

    int low = -9223372036854775807 - 1
    int high = 9223372036854775807
    print(values[low:high])

    const int[] fixed = [1, 2, 3, 4]
    int[] fixed_middle = fixed[-3:-1]
    print(fixed_middle)
    fixed_middle[0] = 8
    print(fixed)
    print(fixed[:])

    string marker = args.length().to_string()
    string[] words = ['a-' + marker, 'b-' + marker, 'c-' + marker, 'd-' + marker]
    string[] pair = words[start:end]
    print(pair.length())
    pair[0] = 'changed'
    print(words[1] == 'b-' + marker)
    words.clear()
    print(pair[1] == 'c-' + marker)
    print(words.length())

    string[] wide_words = ['u-' + marker, 'v-' + marker, 'w-' + marker, 'x-' + marker]
    string[] wide_slice = wide_words[low:high]
    print(wide_slice.length())

    const string[] fixed_words = ['q-' + marker, 'r-' + marker, 's-' + marker, 't-' + marker]
    string[] fixed_pair = fixed_words[-3:-1]
    fixed_pair[0] = 'changed'
    print(fixed_words[1] == 'r-' + marker)
    print(fixed_pair[1] == 's-' + marker)
    const string[] empty_words = []
    string[] empty_words_slice = empty_words[-20:20]
    print(empty_words_slice.length())

    const string fixed_text = 'abcdef'
    print(fixed_text[-3:-1])
