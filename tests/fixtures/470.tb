record Item(int value, string label, int[] samples);

Item[] make_items(int seed):
    return [Item(seed, 'first', [seed]), Item(seed + 1, 'second', [seed + 1])]

int sum_items(Item[] items):
    return items[0].value + items[1].value

int main():
    int total = 0
    for (int i = 0; i < 10; i++):
        total += sum_items(make_items(i))
    print(total)
    return 0
