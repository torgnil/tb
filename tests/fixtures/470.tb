int count_values(int[] values, int scale):
    return values.length() * scale

string first_value(string[] values):
    return values[0]

record length(int value);

int main(string[] args):
    int[] values = [2, 3]
    string[] words = ['kept']
    length marker = length(7)
    print(values.length())
    print(count_values(values, 4))
    print(values.count_values(3))
    print(words.first_value())
    print(marker.value)
    return 0
