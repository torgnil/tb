int[][] GLOBAL_ROWS = [[], [80]]

int[][] return_const_rows(int n):
    const int[][] rows = [[n], []]
    return rows

int[][] return_literal_rows(int n):
    return [[n + 1], [], [n + 2]]

int[][] return_all_empty_rows():
    return [[], []]

int main(string[] args):
    int n = args.length()

    int[][] mutable_rows = [[n], []]
    mutable_rows[1].push(n + 7)
    print(mutable_rows[1][0])

    int[][] all_empty_rows = [[], []]
    all_empty_rows[0].push(n + 10)
    all_empty_rows[1].push(n + 11)
    print(all_empty_rows[0][0])
    print(all_empty_rows[1][0])

    int[][] empty_first_last = [[], [n + 20], []]
    empty_first_last[0].push(n + 21)
    empty_first_last[2].push(n + 22)
    print(empty_first_last[0][0])
    print(empty_first_last[1][0])
    print(empty_first_last[2][0])

    int[][] reassigned_rows = [[n + 30]]
    reassigned_rows = [[], [n + 31], []]
    reassigned_rows[0].push(n + 32)
    reassigned_rows[2].push(n + 33)
    print(reassigned_rows[0][0])
    print(reassigned_rows[1][0])
    print(reassigned_rows[2][0])

    int[][] const_rows = return_const_rows(n + 40)
    const_rows[1].push(n + 41)
    print(const_rows[1][0])

    int[][] literal_rows = return_literal_rows(n + 50)
    literal_rows[1].push(n + 51)
    print(literal_rows[0][0])
    print(literal_rows[1][0])
    print(literal_rows[2][0])

    int[][] all_empty_return = return_all_empty_rows()
    all_empty_return[0].push(n + 60)
    print(all_empty_return[0][0])

    int[][] global_rows = GLOBAL_ROWS
    global_rows[0].push(n + 70)
    print(global_rows[0][0])
    print(GLOBAL_ROWS[0].length())

    int[][] before_unrelated = [[], [n + 80]]
    bool[] unrelated_flags = [true]
    string[] unrelated_words = ['after']
    before_unrelated[0].push(n + 81)
    print(before_unrelated[0][0])
    print(unrelated_flags[0])
    print(unrelated_words[0])
    return 0
