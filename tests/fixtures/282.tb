int switch_case_value():
    return 1

int named_worker(int value):
    return value + 10

int main(string[] args):
    thread_pool pool = thread_pool(2)
    future<int> selected = pool.submit(int value -> {
        int result = 0
        switch (value) {
            case switch_case_value(): {
                int one_value = 10
                result = one_value
            }
            case 2: {
                int two_value = 20
                result = two_value
            }
            default: {
                int other_value = 30
                result = other_value
            }
        }
        return result + 5
    }, args.length())
    future<int> unmatched = pool.submit(int value -> {
        int result = 50
        switch (value) {
            case -1: {
                result = 1
            }
        }
        return result
    }, args.length())
    future<bool> flag = pool.submit(int value -> {
        switch (value) {
            case 0: {
                return false
            }
            case 1: {
                return true
            }
            default: {
                return value > 1
            }
        }
        return false
    }, args.length() - 1)
    future<int> looped = pool.submit(int value -> {
        int total = 0
        for (int index = 0; index < value + 3; index += 1) {
            switch (index) {
                case 0: {
                    continue
                }
                case 1: {
                    total += 2
                }
                case 2: {
                    total += 3
                    break
                }
                default: {
                    total += 10
                }
            }
            total += 1
        }
        return total
    }, args.length())
    future<int> nested = pool.submit(int value -> {
        int result = 0
        if (value > 0) {
            switch (value) {
                case 1: {
                    int nested_value = 4
                    result = nested_value
                }
                default: {
                    result = 8
                }
            }
        } else {
            result = -1
        }
        int cursor = 0
        while (cursor < value) {
            cursor += 1
            switch (cursor) {
                case 1: {
                    result += 2
                }
                default: {
                    result += 1
                }
            }
        }
        return result
    }, args.length())
    future<int> early = pool.submit(int value -> {
        switch (value) {
            case 1: {
                return 41
            }
            default: {
                if (value < 0) {
                    return -1
                }
            }
        }
        return 0
    }, args.length())
    future<int> named = pool.submit(named_worker, 2)
    future<int> expression = pool.submit(int value -> value * 3, 4)

    print(selected.await())
    print(unmatched.await())
    print(flag.await())
    print(looped.await())
    print(nested.await())
    print(early.await())
    print(named.await())
    print(expression.await())
    print(selected.await())
    return 0
