num initial_num():
    return 2.75

num DECIMAL_GLOBAL = 1.25
num INTEGER_GLOBAL = 5
const num CONST_GLOBAL = 0.40
num ZERO_GLOBAL = 0.0
num DYNAMIC_GLOBAL = initial_num()

num read_globals():
    return DECIMAL_GLOBAL + INTEGER_GLOBAL + CONST_GLOBAL + ZERO_GLOBAL + DYNAMIC_GLOBAL

int main(string[] args):
