num magnitude(num value):
    return abs(value)

num nested_magnitude(num value):
    return abs(abs(value))

num const_magnitude(num value):
    const num frozen = value
    return abs(frozen.abs() - 0.125)

int main(string[] args):
    num scale_zero = 0 - 25
    num scale_one = 0.0 - 2.5
    num scale_three = 0.000 - 0.125
    const num fixed_value = 0.000 - 4.250
    num positive = 2.500
    num zero = 0.000
    num runtime_value = 0 - args.length()

    print(magnitude(scale_zero))
    print(magnitude(scale_one))
    print(magnitude(scale_three))
    print(magnitude(positive))
    print(magnitude(zero))
    print(magnitude(fixed_value))
    print(fixed_value.abs())
    print(const_magnitude(0.0 - 5.0))
    print(abs(runtime_value))
    print(nested_magnitude(scale_three))
    print(abs(0.000 - 1.230))
    print(abs(0 - 42))
    print(abs(42))
    print(abs(0))
    return 0
