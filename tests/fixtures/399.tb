import random;
import uuid;

int draws = 0

int random_bits():
    draws += 1
    if (draws == 1):
        return 0
    if (draws == 2):
        return 18
    if (draws == 3):
        return -1
    return 0

# Case 1
int combined_case_1_main():
    print(random_below(10))
    print(draws)
    print(random_between(-9223372036854775807 - 1, 9223372036854775807))
    print(draws)
    draws = 2
    print(uuid())
    return 0

# Case 2
int combined_case_2_main():
    draws = 3
    string value = uuid()
    print(value)
    print(value.uuid_is_valid())
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main() != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main() != 0):
        return 1
    return 0
