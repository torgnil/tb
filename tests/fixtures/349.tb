num INITIAL = '2.50'.to_num()

num parse_decimal(string text):
    return text.to_num()

string make_decimal():
    return '3.1' + '4'

int main(string[] args):
    print(INITIAL)
    print(parse_decimal('1' + '.230'))
    print(make_decimal().to_num())
    const string fixed = '4.000'
    print(fixed.to_num())
    try:
        print('not a number'.to_num())
    catch (exception error):
        print(error)
    return 0
