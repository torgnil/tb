string active_prefix = '!'

string mutate_prefix(string value, string captured_prefix):
    active_prefix = '?'
    return value + captured_prefix

int main():
    string[] words = ['a', 'b']
    string[] mapped = words.map_to(string item -> mutate_prefix(item, active_prefix))
    print(mapped)
    print(active_prefix)
    return 0
