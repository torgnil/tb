int main(string[] args):
    set<int> left = {5, 1, 7, 3}
    set<int> right = {3, 5, 8}
    set<int> shared = left.intersection(right)
    set<int> remaining = left.difference(right)

    for (int value in shared):
        print(value)
    print('--')
    for (int value in remaining):
        print(value)

    print(left.length())
    print(right.length())
    print(left.intersection(left).length())
    print(left.difference(left).length())
    set<int> empty = {}
    print(empty.intersection(left).length())
    print(left.difference(empty).length())

    print(left.remove(5))
    print(shared.contains(5))
    print(remaining.contains(5))
    print(right.remove(3))
    print(shared.contains(3))
    print(left.length())
    print(right.length())
    return 0
