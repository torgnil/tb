record Item(int value);
record Holder(string[][] values);

int[][] no_rows = []

bool query_flags(bool[] values):
    return is_empty(values)

int main(string[] args):
    int seed = args.length() + 10

    int[] no_numbers = []
    int[] numbers = [seed]
    print(is_empty(no_numbers))
    print(is_empty(numbers))
    print(no_numbers.is_empty())
    print(numbers.is_empty())
    bool numbers_empty = is_empty(numbers)
    print(numbers_empty)

    const bool[] no_flags = []
    bool[] flags = [true, false]
    print(is_empty(no_flags))
    print(is_empty(flags))
    print(no_flags.is_empty())
    print(flags.is_empty())
    print(query_flags(no_flags))
    print(query_flags(flags))
    print(!is_empty(no_flags))
    flags.push(false)
    print(flags.length())
    print(flags[0])

    string[] no_words = []
    string[] words = ['kept-' + seed.to_string()]
    print(is_empty(no_words))
    print(is_empty(words))
    print(no_words.is_empty())
    print(words.is_empty())
    print(!is_empty(no_words))
    print(words[0])

    int[] empty_row = []
    int[] populated_row = [seed]
    int[][] one_empty_row = [empty_row]
    int[][] rows = [empty_row, populated_row]
    print(is_empty(no_rows))
    print(is_empty(one_empty_row))
    print(is_empty(rows))
    print(no_rows.is_empty())
    print(one_empty_row.is_empty())
    print(rows.is_empty())
    print(rows[1][0])

    string[][] no_word_rows = []
    string[] empty_word_row = []
    string[] populated_word_row = ['row-' + seed.to_string()]
    string[][] one_empty_word_row = [empty_word_row]
    string[][] word_rows = [empty_word_row, populated_word_row]
    print(is_empty(no_word_rows))
    print(is_empty(one_empty_word_row))
    Holder holder = Holder(word_rows)
    print(is_empty(holder.values))
    print(no_word_rows.is_empty())
    print(one_empty_word_row.is_empty())
    print(word_rows.is_empty())
    print(holder.values[1][0])

    if (is_empty(no_flags)):
        print(1)
    else:
        print(0)
    if (!is_empty(rows)):
        print(1)
    else:
        print(0)

    int loops = 0
    while (loops < 2 && !is_empty([loops + seed])):
        loops += 1
    print(loops)

    Item[] no_items = []
    Item[] items = [Item(seed)]
    print(is_empty(items))
    print(no_items.is_empty())
    return 0
