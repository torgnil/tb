int append_value(int[] values, int value):
    values.push(value)
    return values.length()

future<string> submit_scoped_text(thread_pool pool, int count):
    string local_text = 'scope' + count.to_string()
    future<string> original = pool.submit(() -> local_text)
    future<string> alias = original
    return alias

future<int[]> submit_with_error(thread_pool pool, int[] input):
    return pool.submit(int[] values -> {
        if (values.length() > 0) {
            throw 'lambda failed'
        }
        return values
    }, input)

int main(string[] args):
    thread_pool pool = thread_pool(2)
    int[] source = [args.length() + 2, 3]
    int bias = args.length() + 5
    int[][] grid = [[args.length() + 5, 7]]
    string label = 'managed' + args.length().to_string()

    future<string> text_parameter = pool.submit(string value -> value, label)
    future<int[]> array_parameter = pool.submit(int[] values -> {
        int length = append_value(values, bias)
        return values
    }, source)
    future<int[][]> grid_parameter = pool.submit(int[][] rows -> rows, grid)
    future<int[]> borrowed_row = pool.submit(int[][] rows -> rows[0], grid)
    future<string> text_capture = pool.submit(() -> label)
    future<string> scoped_text = submit_scoped_text(pool, args.length())
    future<int[]> array_capture = pool.submit(() -> {
        int length = append_value(source, bias)
        return source
    })
    future<int[]> failed = submit_with_error(pool, source)

    source[0] = 90
    grid[0][0] = 90
    label = 'changed'

    print(text_parameter.await())
    print(text_parameter.await())
    int[] first_array = array_parameter.await()
    print(first_array[0])
    print(first_array[2])
    first_array[0] = 999
    int[] second_array = array_parameter.await()
    print(second_array[0])
    int[][] first_grid = grid_parameter.await()
    print(first_grid[0][0])
    first_grid[0][0] = 999
    int[][] second_grid = grid_parameter.await()
    print(second_grid[0][0])
    int[] first_row = borrowed_row.await()
    print(first_row[0])
    first_row[0] = 888
    int[] second_row = borrowed_row.await()
    print(second_row[0])
    print(text_capture.await())
    int[] captured = array_capture.await()
    print(captured[0])
    print(captured[2])
    print(scoped_text.await())
    try {
        failed.await()
    } catch (string error) {
        print(error)
    }
    try {
        failed.await()
    } catch (string error) {
        print(error)
    }
    return 0
