int main(string[] args):
    int[][] numbers = []
    string[][] words = []

    print(numbers.length())
    print(words.length())

    numbers.push([1, 2])
    numbers.push([3])
    words.push(['a'])
    words.push(['b', 'c'])

    numbers[4] = [9, 10]
    words[3] = ['d']

    print(numbers.length())
    print(numbers[0][0])
    print(numbers[0][1])
    print(numbers[4][0])
    print(numbers[4][1])
    print(words.length())
    print(words[1][0])
    print(words[1][1])
    print(words[3][0])
