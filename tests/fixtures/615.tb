string format_item(string value, string prefix, int suffix, bool enabled):
    if (enabled):
        return prefix + suffix.to_string() + ':' + value
    return value

int main():
    string[] words = ['oak', 'pine']
    string prefix = 'v'
    int suffix = 7
    bool enabled = true
    string[] formatted = words.map_to(string item -> format_item(item, prefix, suffix, enabled))
    print(formatted)

    string item = 'outer'
    string[] shadowed = words.map_to(string item -> item + '!')
    print(item)
    print(shadowed)
    return 0
