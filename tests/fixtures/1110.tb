import union_find;

int[][] components(const int[] parents):
    return parents.union_find_components()

void show(int[][] groups):
    print(groups.length())
    for (const int[] group in groups):
        print(group.length())
        for (int item in group):
            print(item)

int main():
    int[] parents = union_find_new(7)
    parents.union_find_union(2, 0)
    parents.union_find_union(4, 1)
    parents.union_find_union(4, 2)
    parents.union_find_union(6, 3)
    int[][] snapshot = components(parents)
    show(snapshot)
    print(parents[0])
    snapshot[0][0] = 99
    parents.union_find_union(4, 6)
    print(snapshot[1].length())
    int[][] updated = parents.union_find_components()
    print(updated[0][0])
    print(updated[0].length())
    int[] empty = union_find_new(0)
    show(empty.union_find_components())
    return 0
