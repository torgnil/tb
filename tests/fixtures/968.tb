int parity(int value):
    return value + 100

int main():
    int parity(int value):
        if value == 0:
            return 1
        return opposite(value - 1)

    int opposite(int value):
        if value == 0:
            return 0
        return parity(value - 1)

    print(parity(4))
    print(parity_from_outside())
    return 0

int parity_from_outside():
    return parity(1)
