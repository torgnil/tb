int count_active(const bool[] flags):
    int c = 0
    for (bool f : flags):
        if (f):
            c += 1
    return c

bool all_true(const bool[] flags):
    for (bool f : flags):
        if (!f):
            return false
    return true

int count_active_or_throw(const bool[] flags):
    if (flags.length() > 0 && flags[0]):
        throw 'captured bool worker failed'
    return flags.length()

future<int> submit_scoped_flags(thread_pool pool):
    bool[] local_flags = [true, false, true, true]
    return pool.submit(() -> count_active(local_flags))

int main():
    thread_pool pool = thread_pool(1)
    bool[] flags = [true, false, true]
    future<int> first = pool.submit(() -> count_active(flags))
    flags[0] = false
    print(first.await())
    print(first.await())

    future<int> scoped = submit_scoped_flags(pool)
    print(scoped.await())

    bool[] empty = []
    future<int> empty_len = pool.submit(() -> empty.length())
    print(empty_len.await())
    future<bool> empty_empty = pool.submit(() -> empty.is_empty())
    print(empty_empty.await())

    const bool[] fixed_flags = [true, true]
    future<bool> fixed_all = pool.submit(() -> all_true(fixed_flags))
    print(fixed_all.await())

    bool[] failing = [true]
    future<int> failure = pool.submit(() -> count_active_or_throw(failing))
    try:
        failure.await()
    catch (exception error):
        print(error)

    future<int> after_failure = pool.submit(() -> count_active(flags))
    print(after_failure.await())
    return 0
