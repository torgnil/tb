import regex;

int main():
    print(regex_contains(regex_compile('([a-z]+|[0-9]+)'), '----------------------------------------'))
    print(regex_contains(regex_compile('([a-z]+|[0-9]+)'), '---------------------------------------a'))
    print(regex_contains(regex_compile('a$'), '------------------------a\n'))
    print(regex_contains(regex_compile('$'), '------------------------\n'))
    print(regex_contains(regex_compile('^a'), '------------------------a'))
    print(regex_contains(regex_compile('ab|b$'), '------------------------b'))
    print(regex_contains(regex_compile('ab|bc'), 'aaaaaaaaaaaaaaaaaaaaaaaaabc'))
    print(regex_contains(regex_compile('a.*z'), 'aaaaaaaaaaaaaaaaaaaaaaaaz'))
    print(regex_contains(regex_compile('a.*z'), 'aaaaaaaaaaaaaaaaaaaaaaaa-'))
    print(regex_contains(regex_compile('(a?)*$'), '------------------------\n'))
    return 0
