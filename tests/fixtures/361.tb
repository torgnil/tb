

# Case 1
int order = 0

int first_bound():
    order = order * 10 + 1
    return -2

int last_bound():
    order = order * 10 + 2
    return 3

int combined_case_1_main(string[] args):
    int total = 0
    for (int item : range(first_bound(), last_bound())):
        total += item
        item = 99
    print(order)
    print(total)

    int count = 0
    for (int outer : range(3)):
        for (int inner : range(4)):
            if (inner == 1):
                continue
            if (inner == 3):
                break
            count += 1
    print(count)

    int const_sum = 0
    for (const int item in range(4)):
        const_sum += item
    print(const_sum)

    int edges = 0
    for (int item : range(-9223372036854775807 - 1, -9223372036854775806)):
        edges += 1
    for (int item : range(9223372036854775805, 9223372036854775807)):
        edges += 1
    for (int item : range(4, 4)):
        edges += 100
    for (int item : range(9, 1)):
        edges += 100
    print(edges)

    int[] values = range(3)
    print(values.length())
    return 0

# Case 2
int combined_case_2_main():
    int[] values = [2]
    int[] mapped = values.map_to(int value -> value + 1)
    int total = 0
    for (int item : range(mapped[0])):
        total += item
    print(total)
    return 0

# Case 3
int[] range(int n):
    return [42]

int combined_case_3_main():
    for (int value : range(2)):
        print(value)
    return 0

# Case 4
int early(int end):
    for (int item : range(end)):
        if (item == 2):
            return item
    return -1

int throw_in_loop():
    for (int item : range(4)):
        if (item == 1):
            throw 'range stopped'
    return 0

int combined_case_4_main():
    print(early(4))
    print(early(2))
    try:
        print(throw_in_loop())
    catch (string error):
        print(error)
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main(args) != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main() != 0):
        return 1
    print('=== case 3 ===')
    if (combined_case_3_main() != 0):
        return 1
    print('=== case 4 ===')
    if (combined_case_4_main() != 0):
        return 1
    return 0
