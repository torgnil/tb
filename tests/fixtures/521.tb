int order = 0

int first_bound():
    order = order * 10 + 1
    return -2

int last_bound():
    order = order * 10 + 2
    return 3

int main(string[] args):
    int total = 0
    for (int item : range(first_bound(), last_bound())):
        total += item
        item = 99
    print(order)
    print(total)

    int count = 0
    for (int outer : range(3)):
        for (int inner : range(4)):
            if (inner == 1):
                continue
            if (inner == 3):
                break
            count += 1
    print(count)

    int const_sum = 0
    for (const int item in range(4)):
        const_sum += item
    print(const_sum)

    int edges = 0
    for (int item : range(-9223372036854775807 - 1, -9223372036854775806)):
        edges += 1
    for (int item : range(9223372036854775805, 9223372036854775807)):
        edges += 1
    for (int item : range(4, 4)):
        edges += 100
    for (int item : range(9, 1)):
        edges += 100
    print(edges)

    int[] values = range(3)
    print(values.length())
    return 0
