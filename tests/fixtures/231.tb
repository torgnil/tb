record GridBox(int[][] rows);

int calls = 0
int[][] global_rows = [[30, 31]]
const int[][] constant_rows = [[40, 41]]

int[] make_values(int seed):
    calls += 1
    return [seed, seed + 1, seed + 2]

int[] empty_values():
    return []

int[][] make_grid(int seed):
    calls += 1
    return [[seed, seed + 1], [], [seed + 2]]

int t3():
    return 73

int alias_symbols_and_literals():
    for (int value in global_rows[0]):
        int item = value
    return t3() + 't3'.length()

int sum_owned(int seed):
    int total = 0
    for (int value in make_values(seed)):
        total += value
    return total

int sum_owned_break(int seed):
    int total = 0
    for (int value in make_values(seed)):
        if (value == seed + 1):
            break
        total += value
    return total

int sum_owned_continue(int seed):
    int total = 0
    for (int value in make_values(seed)):
        if (value == seed + 1):
            continue
        total += value
    return total

int[] return_owned_early(int seed):
    for (int value in make_values(seed)):
        return [value]
    return []

int[] return_owned_grid_row(int seed):
    for (int value in make_grid(seed)[0]):
        return [value]
    return []

int sum_owned_literal(int seed):
    int total = 0
    for (int value in [seed, seed + 1]):
        total += value
    return total

int sum_owned_empty(int seed):
    int total = 0
    for (int value in empty_values()):
        total += value
    return total

int sum_owned_empty_grid_row(int seed):
    int total = 0
    for (int value in make_grid(seed)[1]):
        total += value
    return total

int sum_owned_negative_grid_row(int seed):
    int total = 0
    for (int value in make_grid(seed)[-1]):
        total += value
    return total

int sum_caught_throw(int seed):
    int total = 0
    try:
        for (int value in make_values(seed)):
            if (value == seed + 1):
                throw 'caught foreach throw'
            total += value
    catch (exception error):
        total += 100
    return total

int sum_reentered(int seed):
    int total = 0
    for (int round in range(3)):
        for (int value in make_values(seed + round)):
            total += value
    return total

int sum_borrowed(int[][] rows):
    int total = 0
    for (int value in rows[0]):
        total += value
    return total

int sum_box(GridBox box):
    int total = 0
    for (int value in box.rows[0]):
        total += value
    return total

int main(string[] args):
    int seed = args.length() + 4
    print(sum_owned(seed))
    print(sum_owned_break(seed))
    print(sum_owned_continue(seed))
    print(sum_owned_literal(seed))
    print(sum_owned_empty(seed))
    print(sum_owned_empty_grid_row(seed))
    print(sum_owned_negative_grid_row(seed))
    print(sum_caught_throw(seed))
    int[] early = return_owned_early(seed)
    print(early[0])
    int[] row = return_owned_grid_row(seed)
    print(row[0])
    print(sum_reentered(seed))
    int before_calls = calls
    print(sum_owned(seed))
    print(calls - before_calls)
    print(sum_borrowed([[20, 21]]))
    print(sum_borrowed(global_rows))
    print(sum_borrowed(constant_rows))
    print(sum_box(GridBox([[50, 51]])))
    print(alias_symbols_and_literals())
    return 0
