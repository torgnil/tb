int run(int[] source):
    const int[] fixed = [5, 8]
    int[] values = [1, 2]

    int combine(int index):
        return source[index] + values[index] + fixed[index]

    int forward(int index):
        return combine(index)

    int total(int index):
        if (index == source.length()):
            return 0
        return combine(index) + total(index + 1)

    print(forward(0))
    values[0] = 10
    print(combine(0))
    values = [3, 4]
    source[0] = 2
    print(forward(0))
    print(total(0))
    return 0

int main():
    int[] source = [1, 2]
    run(source)
    return 0
