int[] global_empty_range = range(-1)
int bound_order = 0

int range_start():
    bound_order = bound_order * 10 + 1
    return -2

int range_end():
    bound_order = bound_order * 10 + 2
    return 2

int main(string[] args):
    print(global_empty_range.length())

    int[] ordinary = range(5)
    print(ordinary.length())
    print(ordinary[0])
    print(ordinary[-1])

    int dynamic_end = args.length() + 4
    int[] dynamic_bounds = range(args.length(), dynamic_end)
    print(dynamic_bounds.length() == 4)

    int[] negative = range(-2, 3)
    print(negative.length())
    print(negative[0])
    print(negative[-1])

    const int low = -2
    const int high = 2
    int[] const_bounds = range(low, high)
    print(const_bounds.length())
    int[] ordered = range(range_start(), range_end())
    print(bound_order)
    print(ordered.length())

    int[] at_min = range(-9223372036854775807 - 1, -9223372036854775805)
    print(at_min.length())
    print(at_min[0])
    print(at_min[-1])

    int[] at_max = range(9223372036854775804, 9223372036854775807)
    print(at_max.length())
    print(at_max[0])
    print(at_max[-1])

    int[] equal = range(4, 4)
    int[] reversed = range(9, 3)
    int[] extreme_reversed = range(9223372036854775807, -9223372036854775807 - 1)
    print(equal.length())
    print(reversed.length())
    print(extreme_reversed.length())

    int total = 0
    for (int value : range(-2, 3)):
        total += value
    print(total)
    return 0
