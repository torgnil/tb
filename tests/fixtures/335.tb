import random;
import uuid;

string STARTUP_ID = uuid()

bool valid_uuid(string value):
    if (value.length() != 36):
        return false
    if (value[8] != '-' || value[13] != '-' || value[18] != '-' || value[23] != '-'):
        return false
    if (value[14] != '4'):
        return false
    string variant = value[19]
    return variant == '8' || variant == '9' || variant == 'a' || variant == 'b'

int next_random():
    return random()

string make_uuid():
    return uuid()

int main(string[] args):
    print(valid_uuid(STARTUP_ID))
    print(valid_uuid(uuid()))
    string returned_id = make_uuid()
    print(valid_uuid(returned_id))
    print(valid_uuid(uuid()))
    int sample = next_random()
    print(sample == sample)
    for (int index : range(5)):
        int ignored = random()
        print(valid_uuid(uuid()))
    return 0
