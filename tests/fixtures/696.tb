import regex;

int main():
    Regex pattern = regex_compile('(a)|(((((((((((((b)+)+)+)+)+)+)+)+)+)+)+)+)+')
    RegexCapture[] before = regex_find_all_captures(regex_compile('(a)'), 'aa')
    print(before.length())
    print(regex_group(before[1], 'aa', 1))
    int index = 0
    while (index < 2):
        try:
            print(regex_find_all_captures(pattern, 'ab').length())
        catch (exception error):
            print(error)
        index += 1
    try:
        print(regex_find_all_captures_from(pattern, 'xab', 1).length())
    catch (exception error):
        print(error)
    Regex later = regex_compile('(a)|(b(((((((((((((c)+)+)+)+)+)+)+)+)+)+)+)+)+)')
    try:
        print(regex_find_all_captures(later, 'abc').length())
    catch (exception error):
        print(error)
    try:
        print(regex_find_all_captures(pattern, 'b').length())
    catch (exception error):
        print(error)
    RegexCapture[] after = regex_find_all_captures(regex_compile('(a)'), 'aa')
    print(after.length())
    print(regex_group(before[0], 'aa', 1))
    print(regex_group(after[1], 'aa', 1))
    return 0
