record QueueItem(int priority, int id);

int compare_ints(int left, int right):
    return right - left

int compare_items(QueueItem left, QueueItem right):
    return right.priority - left.priority

int pop(int value):
    return value + 100

int main():
    int[] values = [4, 2]
    prio_q<int> queue = values.create_prio_q(compare_ints)
    print(pop(queue))
    print(queue.pop())
    print(pop(7))
    print(pop(queue))

    QueueItem[] items = [QueueItem(7, 70), QueueItem(3, 30)]
    prio_q<QueueItem> item_queue = items.create_prio_q(compare_items)
    QueueItem first = pop(item_queue)
    print(first.id)
    QueueItem second = item_queue.pop()
    print(second.id)
    print(item_queue.is_empty())
    return 0
