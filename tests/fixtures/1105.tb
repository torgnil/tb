import strings;

int main():
    print('a:b:c'.byte_rreplace_n(':', '/', 1))
    print('aaaaa'.byte_rreplace_n('aa', '-', 2))
    print('x::y::'.byte_rreplace_n('::', '', 1))
    print('abc'.byte_rreplace_n('z', '!', 2))
    print('abc'.byte_rreplace_n('a', '!', 0))
    print('a-a'.byte_rreplace_n('a', '$1', 1))
    try:
        print('abc'.byte_rreplace_n('', '!', 0))
    catch (exception error):
        print(error)
    try:
        print('abc'.byte_rreplace_n('a', '!', -1))
    catch (exception error):
        print(error)
    return 0
