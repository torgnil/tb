record Box(int value);

Box make_box(int value):
    return Box(value)

int main(string[] args):
    int count = args.length()
    const int fixed = count + 1
    int target = 0

    int[] values = [count, 0]
    values[-1] = fixed
    values[target] = count + 2
    print(values[0])
    print(values[1])

    const bool enabled = count == 1
    bool[] flags = [false]
    flags[target] = enabled
    print(flags[0])

    const string label = 'const-' + count
    string[] words = ['left', 'right']
    words[-1] = label
    words[target] = 'runtime-' + count
    print(words[0])
    print(words[1])

    Box[] boxes = [Box(count), Box(count + 1)]
    Box borrowed = boxes[0]
    boxes[-1] = borrowed
    borrowed.value = 90
    print(boxes[1].value)
    boxes[target] = make_box(count + 10)
    print(boxes[0].value)
    boxes[1] = boxes[0]
    boxes[0].value = 99
    print(boxes[1].value)

    int[][] rows = [[count], []]
    rows[1] = []
    rows[1] = [count + 4]
    print(rows[1][0])

    map<string, int> scores = {'key': count}
    scores['key'] = count + 5
    print(scores['key'])
    return 0
