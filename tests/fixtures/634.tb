int call_order = 0

int mark(int value):
    call_order = call_order * 10 + value
    return value

int main():
    int ascending = 0
    for (const int value : range(mark(1), mark(8), mark(3))):
        ascending += value
    print(ascending)
    print(call_order)

    int descending = 0
    for (int value : range(10, 0, -3)):
        descending += value
        value = -100
    print(descending)

    int control = 0
    for (int value : range(0, 10, 2)):
        if (value == 2):
            continue
        if (value == 8):
            break
        control = control * 10 + value
    print(control)

    int empty_iterations = 0
    for (int value : range(0, 10, -2)):
        empty_iterations += 1
    for (int value : range(10, 0, 2)):
        empty_iterations += 1
    print(empty_iterations)

    int minimum = -9223372036854775807 - 1
    for (int value : range(1, minimum, minimum)):
        print(value)
    for (int value : range(minimum, 0, 9223372036854775807)):
        print(value)

    return 0
