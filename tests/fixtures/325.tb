

# Case 1
int count_values(int[] values, int scale):
    return values.length() * scale

string first_value(string[] values):
    return values[0]

record length(int value);

int combined_case_1_main(string[] args):
    int[] values = [2, 3]
    string[] words = ['kept']
    length marker = length(7)
    print(values.length())
    print(count_values(values, 4))
    print(values.count_values(3))
    print(words.first_value())
    print(marker.value)
    return 0

# Case 2
bool starts_with(string text, string prefix):
    return true

int combined_case_2_main(string[] args):
    print(starts_with('text', 'wrong'))
    print('text'.starts_with('wrong'))
    return 0

# Case 3
num round_at(num value, int places):
    return round(value, places)

int combined_case_3_main(string[] args):
    print(round(123.45, -1))
    print(round(123.45, -2))
    print(round(125.0, -1))
    print(round(-125.0, -1))
    print(round(149.9, -1))
    print(round(-149.9, -1))
    print(round(4.9, -1))
    print(round(5.0, -1))
    print(round(-5.0, -1))
    print(round(123.45, 0))
    print(round(123.45, 1))
    print(round(123.45, 2))
    print(round(0.5000000000000000000, 0))
    num input = 123.45
    int places = args.length() - 2
    num rounded = round_at(input, places)
    print(rounded)
    print(rounded + 0.5)
    print(rounded > 100.0)
    print(round(0.0000000000000000001, -1))
    print(round(0.00000000000000000001, 0))
    num just_below_large_tie = 4999999999999999999
    print(round(just_below_large_tie, -19))
    int minimum_places = 0 - 9223372036854775807 - 1
    int maximum_places = 9223372036854775807
    print(round(1.23, minimum_places))
    print(round(123.45, maximum_places))
    num max_value = 9223372036854775807
    num min_value = 0 - 9223372036854775807 - 1
    print(round(max_value, -2))
    print(round(min_value, -2))
    return 0

# Case 4
num echo_num(num value):
    return value

int combined_case_4_main(string[] args):
    num scale18 = 0.000000000000000001
    num scale19 = 0.9223372036854775807
    num min_scale19 = -0.9223372036854775808
    num positive_scale20 = 0.09000000000000000000
    num negative_scale20 = -0.09000000000000000000
    num zero_scale20 = 0.00000000000000000000
    num tiny_scale20 = 0.00000000000000000001
    num min_scale20 = -0.09223372036854775808
    num ordinary = 12.34
    num negative_ordinary = -12.34
    num ordinary_zero = 0.0

    print(scale18)
    print(scale19)
    print(min_scale19)
    print(positive_scale20)
    print(negative_scale20)
    print(zero_scale20)
    print(tiny_scale20)
    print(min_scale20)
    print(ordinary)
    print(negative_ordinary)
    print(ordinary_zero)
    print(positive_scale20.hash())
    print(negative_scale20.hash())
    print(min_scale20.hash())
    print(min_scale19.hash())

    num runtime_value = echo_num(args.length() == 1 ? positive_scale20 : scale19)
    print(runtime_value)
    print(runtime_value.hash())
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main(args) != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main(args) != 0):
        return 1
    print('=== case 3 ===')
    if (combined_case_3_main(args) != 0):
        return 1
    print('=== case 4 ===')
    if (combined_case_4_main(args) != 0):
        return 1
    return 0
