import regex;

int main():
    Regex pair = regex_compile('(a)(b)')
    print(pair.regex_replace_at('zabab', 'X', 0))
    print(pair.regex_replace_at('zabab', 'X', 1))
    print(pair.regex_replace_at('zabab', '$2$1', 3))
    print(pair.regex_replace_at('zabab', '$2$1', 0))
    print(pair.regex_replace_first_from('zabab', '$2$1', 0))
    print(pair.regex_replace_at('zabab', 'X', -1))
    print(pair.regex_replace_at('zabab', 'X', 6))
    print(regex_compile('^ab').regex_replace_at('zab', 'X', 1))
    print(regex_compile('$').regex_replace_at('zab', '!', 3))
    return 0
