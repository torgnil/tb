int amount = 2
bool include_suffix = true
string prefix = '<'

void change_settings():
    amount = 0
    include_suffix = false
    prefix = '?'

string decorate(string word, int amount, bool include_suffix):
    change_settings()
    if (include_suffix):
        return word + amount.to_string()
    return word

int main(string[] args):
    string line = 'outer'
    string[] result = ['a', 'b'].flat_map(string line -> [prefix + line, decorate(line, amount, include_suffix)])
    print(result.length())
    print(result[0])
    print(result[1])
    print(result[2])
    print(result[3])
    print(amount)
    print(include_suffix)
    print(prefix)
    return 0
