int[] transform(int[] values):
    values[0] += 10
    return values

int main(string[] args):
    int[] input = [args.length(), 9]
    thread_pool pool = thread_pool(2)
    future<int[]> pending = pool.submit(transform, input)
    input[0] = 20
    int[] first = pending.await()
    first[0] = 99
    int[] second = pending.await()
    print('args=' + args.length())
    print('input=' + input[0])
    print('result=' + second[0] + ',' + second[1])
    return 0
