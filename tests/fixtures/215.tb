record Box(int value);

int INDEX_CALLS = 0

int last_index():
    INDEX_CALLS += 1
    return 0 - 1

int main(string[] args):
    int count = args.length()
    const int first = 0
    const int last = 0 - 1

    int[] values = [count, 10]
    print(values[first])
    print(values[last])
    values[first] = count + 1
    values[last] += 2
    print(values[0])
    print(values[1])
    values[last_index()] += 1
    print(INDEX_CALLS)
    print(values[last])

    bool[] flags = [count == 1, false]
    print(flags[first])
    print(flags[last])
    flags[last] = count == 3
    print(flags[last])

    string[] words = ['left', 'right']
    print(words[last])
    words[last] = 'word-' + count
    print(words[last])
    string text = 'text-' + count
    print(text[last])

    int[][] rows = [[count], [count + 2]]
    print(rows[last][first])
    rows[last][last] += 4
    print(rows[1][0])

    string[][] groups = [['a'], ['b-' + count]]
    print(groups[last][first])
    groups[last][first] = 'group-' + count
    print(groups[1][0])

    Box[] boxes = [Box(count + 1), Box(count + 2)]
    print(boxes[last].value)
    boxes[last].value += 4
    print(boxes[1].value)

    map<string, int> scores = {'key-' + count: count + 2}
    print(scores['key-' + count])
    scores['key-' + count] += 3
    print(scores['key-' + count])
    return 0
