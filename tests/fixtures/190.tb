record WordBox(string[] words);

int consume_words(string[] words):
    return words.length()

int[] make_int_result(int[] source):
    return [source.length(), source.length() + 1]

bool[] make_bool_result(bool[] source):
    return [source[0], false]

string[] make_string_result(string[] source):
    return [source[0] + '-copy']

int[][] make_int_rows(int[][] source):
    return [[source[0][0] + 1]]

string[][] make_string_rows(string[][] source):
    return [[source[0][0] + '-copy']]

int[] empty_int_result(int[] source):
    return []

bool[] empty_bool_result(bool[] source):
    return []

string[] empty_string_result(string[] source):
    return []

int[][] empty_int_rows(int[][] source):
    return []

string[][] empty_string_rows(string[][] source):
    return []

string[] returned_split(string text):
    return text.split(',')

int main(string[] args):
    string text = 'red,blue'
    string[] split_words = text.split(',')
    print(split_words)
    const string[] const_words = text.split(',')
    print(const_words)
    split_words = 'green,yellow'.split(',')
    print(split_words)
    print(text.split_lines())
    text.split(',')

    print(consume_words('cyan,white'.split(',')))
    string[] user_result_words = ['user']
    print(consume_words(user_result_words.make_string_result()))
    user_result_words.make_string_result()

    string[] returned_words = returned_split('north,south')
    print(returned_words)
    WordBox box = WordBox('old,words'.split(','))
    box.words = 'new,words'.split(',')
    print(box.words)
    string[][] nested_words = []
    nested_words.push('nested,words'.split(','))
    print(nested_words[0])

    string[] borrowed_source = ['source', 'tail']
    string[] result_snapshot = borrowed_source.make_string_result()
    result_snapshot[0] = 'changed'
    print(borrowed_source)
    print(result_snapshot)

    int[] int_result = [1, 2].make_int_result()
    bool[] bool_result = [true, true].make_bool_result()
    int[][] int_rows_result = [[3]].make_int_rows()
    string[][] string_rows_result = [['row']].make_string_rows()
    print(int_result)
    print(bool_result[0])
    print(bool_result[1])
    print(int_rows_result[0])
    print(string_rows_result[0])

    int[] empty_int_source = []
    bool[] empty_bool_source = []
    string[] empty_string_source = []
    int[][] empty_int_rows_source = []
    string[][] empty_string_rows_source = []
    int[] empty_ints = empty_int_source.empty_int_result()
    bool[] empty_bools = empty_bool_source.empty_bool_result()
    string[] empty_strings = empty_string_source.empty_string_result()
    int[][] empty_int_rows_result = empty_int_rows_source.empty_int_rows()
    string[][] empty_string_rows_result = empty_string_rows_source.empty_string_rows()
    print(empty_ints.length())
    print(empty_bools.length())
    print(empty_strings.length())
    print(empty_int_rows_result.length())
    print(empty_string_rows_result.length())
    return 0
