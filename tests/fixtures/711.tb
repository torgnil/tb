import regex;

int main():
    Regex repeated = regex_compile('a+')
    print(regex_replace_first(repeated, 'caaabaa', 'X'))
    print(regex_replace_first_from(repeated, 'a a a', 'X', 2))
    print(regex_replace_first(regex_compile('(a)(b)?'), 'ab a', '$2-$1-$$'))
    print(regex_replace_first(regex_compile('(a)(b)?'), 'a', '$2:$1:$9'))
    print(regex_replace_first(regex_compile('a|aa'), 'aa', 'X'))
    print(regex_replace_first(regex_compile('aa|a'), 'aa', 'X'))
    print(regex_replace_first(regex_compile(''), 'ab', '!'))
    print(regex_replace_first_from(regex_compile(''), 'ab', '!', 2))
    print(regex_replace_first_from(regex_compile('^a'), 'aa', 'X', 1))
    print(regex_replace_first(regex_compile('a'), 'a', '$$-$x-$'))
    print(regex_replace_first_from(regex_compile('a'), 'éa', '!', 1))
    print(regex_replace_first_from(repeated, 'aba', 'X', -1))
    print(regex_replace_first_from(repeated, 'aba', 'X', 4))
    print(regex_replace_first(regex_compile('('), 'aba', 'X'))
    print(regex_replace_first(regex_compile('z'), 'aba', 'X'))
    string input = 'a a'
    string result = regex_replace_first(regex_compile('a'), input, 'X')
    input = 'changed'
    print(result)
    print(regex_replace(regex_compile('a'), 'aba', 'X'))
    Regex deep = regex_compile('(((((((((((((a)+)+)+)+)+)+)+)+)+)+)+)+)+')
    print(regex_replace_first(deep, 'a', 'X'))
    try:
        print(regex_replace_first(deep, 'a', '$0'))
    catch (exception error):
        print(error)
    return 0
