enum Mode {
    READY,
    DONE
}

int bump(int value):
    value = value + 1
    return value

int main(string[] args):
    int seed = args.length()
    int value = bump(seed)
    value = value + 1
    bool enabled = value > 0
    enabled = !enabled
    const int fixed_value = value
    const bool fixed_flag = !enabled
    num amount = value
    amount = value + 1
    string label = 'ready'
    label = label + '!'
    string enum_label = Mode.READY
    enum_label = Mode.DONE
    try:
        if (value > 0):
            throw 'caught'
    catch (exception error):
        label = error
    print(value)
    print(enabled)
    print(fixed_value)
    print(fixed_flag)
    print(amount)
    print(label)
    print(enum_label)
    return 0
