int calls = 0

int[] make_values(int count):
    calls += 1
    return range(count)

int main():
    thread_pool pool = thread_pool(1)
    future<int> stopped = pool.submit(int limit -> {
        int total = 0
        for (int value : make_values(limit)) {
            if (value == 3) {
                break
            }
            total += value
        }
        return total
    }, 5)
    print(stopped.await())

    future<int> empty = pool.submit(int limit -> {
        int total = 0
        for (int value : make_values(limit)) {
            total += value
        }
        return total
    }, 0)
    print(empty.await())
    print(calls)
    return 0
