num round_at(num value, int places):
    return round(value, places)

int main(string[] args):
    print(round(123.45, -1))
    print(round(123.45, -2))
    print(round(125.0, -1))
    print(round(-125.0, -1))
    print(round(149.9, -1))
    print(round(-149.9, -1))
    print(round(4.9, -1))
    print(round(5.0, -1))
    print(round(-5.0, -1))
    print(round(123.45, 0))
    print(round(123.45, 1))
    print(round(123.45, 2))
    print(round(0.5000000000000000000, 0))
    num input = 123.45
    int places = args.length() - 2
    num rounded = round_at(input, places)
    print(rounded)
    print(rounded + 0.5)
    print(rounded > 100.0)
    print(round(0.0000000000000000001, -1))
    print(round(0.00000000000000000001, 0))
    num just_below_large_tie = 4999999999999999999
    print(round(just_below_large_tie, -19))
    int minimum_places = 0 - 9223372036854775807 - 1
    int maximum_places = 9223372036854775807
    print(round(1.23, minimum_places))
    print(round(123.45, maximum_places))
    num max_value = 9223372036854775807
    num min_value = 0 - 9223372036854775807 - 1
    print(round(max_value, -2))
    print(round(min_value, -2))
    return 0
