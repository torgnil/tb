int[] GLOBAL_SEARCH_INTS = [31, 32, 32]
bool[] GLOBAL_SEARCH_FLAGS = [true, false, true]
string[] GLOBAL_SEARCH_WORDS = ['global', 'global', 'tail']

record SearchFields(int[] ints, bool[] flags, string[] words);

int[] make_search_ints(int seed):
    return [seed, seed + 1, seed + 1]

bool[] make_search_flags(int seed):
    return [seed > 1, false, seed > 1]

string[] make_search_words(int seed):
    string word = 'word-' + seed.to_string()
    return [word, word, 'tail-' + seed.to_string()]

int[] make_empty_search_ints(int seed):
    return []

bool[] make_empty_search_flags(int seed):
    return []

string[] make_empty_search_words(int seed):
    return []

bool contains(bool value):
    return value

bool search_from_return(int seed):
    if (seed > 1):
        return 'word-' + seed.to_string() in make_search_words(seed)
    return 'absent' not in make_search_words(seed)

int main(string[] args):
    int argc = args.length()
    print(args.length() == argc)
    int seed = argc + 4
    string needle = 'word-' + seed.to_string()

    print(contains(make_search_ints(seed), seed + 1))
    print(make_search_ints(seed).contains(seed + 1))
    print(index_of(make_search_ints(seed), seed + 1))
    print(make_search_ints(seed).index_of(seed + 1))
    print((seed + 1) in make_search_ints(seed))
    print((seed + 8) not in make_search_ints(seed))

    print(contains(make_search_flags(seed), seed > 1))
    print(make_search_flags(seed).contains(seed > 1))
    print(index_of(make_search_flags(seed), seed > 1))
    print(make_search_flags(seed).index_of(seed > 1))
    print((seed > 1) in make_search_flags(seed))
    print((seed + 1 < 0) not in make_search_flags(seed))

    print(contains(make_search_words(seed), needle))
    print(make_search_words(seed).contains(needle))
    print(index_of(make_search_words(seed), needle))
    print(make_search_words(seed).index_of(needle))
    print(needle in make_search_words(seed))
    print('missing' not in make_search_words(seed))
    print(needle)

    print(contains([seed, seed], seed))
    print(make_search_ints(seed)[1:].index_of(seed + 1))
    print(make_search_ints(seed).copy().contains(seed + 1))
    print(seed not in make_empty_search_ints(seed))
    print(contains([seed > 1, false], seed > 1))
    print(make_search_flags(seed)[1:].index_of(false))
    print(make_search_flags(seed).copy().contains(seed > 1))
    print((seed > 1) not in make_empty_search_flags(seed))
    print(contains([needle, needle], needle))
    print(make_search_words(seed)[1:].index_of('tail-' + seed.to_string()))
    print(make_search_words(seed).copy().contains(needle))
    print(needle not in make_empty_search_words(seed))

    int[] ints = [seed, seed + 1, seed + 1]
    bool[] flags = [seed > 1, false, seed > 1]
    string[] words = [needle, needle, 'tail']
    const int[] frozen_ints = [seed + 1, seed + 2]
    const bool[] frozen_flags = [false, seed > 1]
    const string[] frozen_words = [needle, 'frozen']
    print(ints.contains(seed + 1))
    print(ints.index_of(seed + 1))
    print(frozen_ints.contains(seed + 2))
    print(flags.index_of(false))
    print(frozen_flags.contains(seed > 1))
    print(words.index_of(needle))
    print(frozen_words.contains(needle))

    SearchFields fields = SearchFields([seed, seed + 1], [false, seed > 1], [needle, 'field-tail'])
    print(fields.ints.contains(seed + 1))
    print(fields.flags.index_of(false))
    print(fields.words.contains(needle))
    print(GLOBAL_SEARCH_INTS.index_of(32))
    print(GLOBAL_SEARCH_FLAGS.contains(true))
    print(GLOBAL_SEARCH_WORDS.index_of('global'))

    int result = 0
    int turn = 0
    while (turn < 3):
        if (turn == 1):
            result += make_search_ints(seed).index_of(seed + 1)
        else:
            if (make_search_flags(seed).contains(seed > 1)):
                result += 1
        turn += 1
    print(result)
    print(search_from_return(seed))

    string later = needle
    print(make_search_words(seed).contains(later))
    print(later)
    print(ints.index_of(seed + 1))
    print(contains(seed > 0))
    print(make_empty_search_ints(seed).index_of(seed))
    print(make_empty_search_flags(seed).contains(true))
    print(make_empty_search_words(seed).index_of(needle))
    print(make_search_ints(seed).contains(seed + 20))
    print(make_search_words(seed).index_of('absent'))
    print(search_from_return(argc - argc))
    return 0
