int sum_values(int[] values):
    int total = 0
    for (int value : values):
        total += value
    return total

int main():
    thread_pool pool = thread_pool(1)
    int[] values = [2, 3]
    future<int> total = pool.submit(sum_values, values)
    values[0] = 9
    print(total.await())
    return 0
