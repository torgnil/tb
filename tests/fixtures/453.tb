record SetBox(set<int> ids);

set<int> global_ids = {0}
set<int> source_global = {70, 71}
set<int> initialized_global = source_global
set<int> empty_global = {}
set<int> initialized_empty = empty_global

set<int> make_set(int seed):
    return {seed, seed + 1}

void assign_local(int seed):
    set<int> local = {seed, seed + 1}
    global_ids = local
    local.add(99)

void assign_const(const set<int> source):
    global_ids = source

void assign_parameter(set<int> source):
    global_ids = source

void assign_field(int seed):
    SetBox box = SetBox({seed, seed + 1})
    global_ids = box.ids
    box.ids.add(99)

void assign_global():
    global_ids = source_global
    source_global.add(74)

void assign_owned(int seed):
    global_ids = make_set(seed)

void assign_early(bool use_local, int seed):
    set<int> local = {seed, seed + 1}
    if (use_local):
        global_ids = local
        return
    global_ids = make_set(seed + 100)

int main(string[] args):
    int seed = args.length() + 10
    print(initialized_global.contains(70))
    source_global.add(73)
    print(initialized_global.contains(73))
    print(initialized_empty.length())

    assign_local(seed)
    print(global_ids.contains(seed))
    print(global_ids.contains(99))

    const set<int> fixed = {seed + 2, seed + 3}
    assign_const(fixed)
    print(global_ids.contains(seed + 3))
    set<int> input = {seed + 4, seed + 5}
    assign_parameter(input)
    input.add(99)
    print(global_ids.contains(99))

    assign_field(seed + 6)
    print(global_ids.contains(seed + 6))
    print(global_ids.contains(99))
    SetBox saved = SetBox(global_ids)

    assign_owned(seed + 8)
    print(global_ids.contains(seed + 9))
    print(saved.ids.contains(seed + 6))

    assign_global()
    print(global_ids.contains(70))
    print(global_ids.contains(74))

    assign_early(true, seed + 10)
    print(global_ids.contains(seed + 10))
    assign_early(false, seed + 12)
    print(global_ids.contains(seed + 113))

    global_ids = global_ids
    global_ids.add(80)
    print(global_ids.contains(80))
    print(global_ids.contains(seed + 113))

    for (int index : range(2)):
        assign_local(seed + 20 + index)
        print(global_ids.contains(seed + 20 + index))
        print(global_ids.contains(99))
    return 0
