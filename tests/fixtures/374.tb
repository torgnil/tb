

# Case 1
enum Code { ZERO = 0, TWO = 2 }
enum Legacy { READY, DONE }

int combined_case_1_main():
    int[] source = [1]
    int[] mapped = source.map_to(int value -> value + 1)
    Code item = Code.TWO
    print(mapped[0] == item)
    print(Legacy.DONE)
    return 0

# Case 2
enum Mode { READY }
record Box(Mode state);

const Box GLOBAL = Box(Mode.READY);

int combined_case_2_main():
    print(GLOBAL.state)
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main() != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main() != 0):
        return 1
    return 0
