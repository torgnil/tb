record SortItem(int key, int tie);

int main(string[] args):
    int n = args.length()
    print(n.sort())

    int[] ascending = [3, 1, 2]
    ascending.sort(compare_ascending)
    print(ascending)

    int[] descending = [3, 1, 2]
    descending.sort(compare_descending)
    print(descending)

    int[] generic = [3, -1, 2, -4]
    generic.sort(compare_by_absolute_value)
    print(generic)

    int[] inline = [3, 1, 2]
    inline.sort((int left, int right) -> right - left)
    print(inline)

    SortItem[] items = [SortItem(2, 1), SortItem(1, 3), SortItem(1, 2)]
    items.sort(compare_items)
    for (SortItem item : items):
        print(item.key * 10 + item.tie)

    int[] empty = []
    empty.sort(compare_ascending)
    print(empty.length())

    int[] singleton = [n]
    singleton.sort(compare_descending)
    print(singleton)

    return 0

int sort(int value):
    return value + 40

int compare_ascending(int left, int right):
    return left - right

int compare_descending(int left, int right):
    return right - left

int compare_by_absolute_value(int left, int right):
    int left_abs = left
    int right_abs = right
    if (left_abs < 0):
        left_abs = 0 - left_abs
    if (right_abs < 0):
        right_abs = 0 - right_abs
    return left_abs - right_abs

int compare_items(SortItem left, SortItem right):
    if (left.key < right.key):
        return -1
    if (left.key > right.key):
        return 1
    return left.tie - right.tie
