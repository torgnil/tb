import regex;

void show(string pattern, string text, int offset):
    Regex program = regex_compile(pattern)
    RegexCapture capture = regex_find_captures_from(program, text, offset)
    print(capture.matched)
    if (capture.matched):
        for (int index = 0; index < capture.starts.length(); index += 1):
            print(capture.starts[index])
            print(capture.ends[index])
            print('[' + regex_group(capture, text, index) + ']')
    print('<' + regex_group(capture, text, -1) + '>')
    print('<' + regex_group(capture, text, 99) + '>')

int main():
    show('(a(b)?)+', 'aba', 0)
    show('((b*|ab)+)+', 'bab', 0)
    show('(a){0}', 'b', 0)
    show('(a)|(b)', 'b', 0)
    show('(a?)', 'b', 0)
    show('((a){1,2})', 'xaa', 1)
    show('(x)', 'éx', 0)
    show('(a)', 'b', 0)
    show('(', 'abc', 0)
    show('(a)', 'a', -1)
    Regex program = regex_compile('(a+)')
    RegexCapture first = regex_find_captures(program, 'zaa')
    RegexCapture copy = first
    first.starts[1] = 0
    print(regex_group(copy, 'zaa', 1))
    print(regex_group(copy, 'x', 1))
