import strings;

void show_reverse_partition(string[] parts):
    print(parts.length())
    for (string part in parts):
        print('[' + part + ']')

string[] reverse_partition_runtime(int value):
    string delimiter = value.to_string()
    string text = 'first' + delimiter + 'middle' + delimiter + 'last'
    return text.byte_rpartition(delimiter)

int main():
    show_reverse_partition(reverse_partition_runtime(42))
    show_reverse_partition(byte_rpartition('aaaa', 'aa'))
    show_reverse_partition(byte_rpartition('path/', '/'))
    show_reverse_partition(byte_rpartition('/path', '/'))
    show_reverse_partition(byte_rpartition('path', '/'))
    show_reverse_partition(byte_rpartition('path', ''))
    show_reverse_partition(byte_rpartition('', '/'))
    return 0
