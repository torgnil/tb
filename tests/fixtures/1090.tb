int int_keys(map<int, string> labels, int key):
    return labels[key].length()

int[] collect(const map<int, string> labels):
    return labels.int_keys()

int main():
    map<int, string> labels = {-9223372036854775808: 'east', 9223372036854775807: 'west'}
    int[] keys = collect(labels)
    string[] text_keys = labels.keys()
    for (int i = 0; i < keys.length(); i += 1):
        print(keys[i].to_string() == text_keys[i])
        print(labels[keys[i]])
    print(labels.int_keys(9223372036854775807))
    labels[3] = 'north'
    print(keys.length())
    print(labels.int_keys().length())
    map<int, bool[]> flags = {-9: [true], 4: [false]}
    for (int key in flags.int_keys()):
        print(key)
        print(flags[key][0])
    map<int, string> empty = {}
    print(empty.int_keys().length())
    return 0
