int count_long(string[] lines, int minimum, bool include_empty):
    int count = 0
    for (string line : lines):
        if (line.length() >= minimum || (include_empty && line.is_empty())):
            count += 1
    return count

int main():
    thread_pool pool = thread_pool(2)
    string[] lines = ['alpha', '', 'x', 'beta']
    int minimum = 4
    bool include_empty = true

    future<int> expression = pool.submit(() -> count_long(lines, minimum, include_empty))
    future<int> block = pool.submit(() -> {
        int count = 0
        for (string line : lines) {
            if (line.length() >= minimum || (include_empty && line.is_empty())) {
                count += 1
            }
        }
        return count
    })

    lines[0] = 'changed'
    minimum = 100
    include_empty = false
    print(expression.await())
    print(block.await())
    return 0
