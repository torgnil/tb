import union_find;

int[] labels(const int[] groups):
    return groups.union_find_representatives()

int main():
    int[] groups = union_find_new(5)
    groups.union_find_union(2, 0)
    groups.union_find_union(3, 1)
    groups.union_find_union(3, 2)
    int[] snapshot = labels(groups)
    for (int root in snapshot):
        print(root)
    print(groups[0])
    groups.union_find_union(3, 4)
    print(snapshot[4])
    snapshot[0] = 99
    int[] updated = groups.union_find_representatives()
    print(updated[0])
    print(updated[4])
    int[] empty = union_find_new(0)
    print(empty.union_find_representatives().length())
    return 0
