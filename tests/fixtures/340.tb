import regex;
import regex;

int main():
    Regex first = regex_compile('(ab|c)+')
    Regex second = regex_compile('a?b*')
    print(first.valid)
    print(regex_match(first, 'abc'))
    print(regex_match(first, 'abx'))
    print(regex_match(second, ''))
    print(regex_match(second, 'abbb'))
    print(regex_match(first, 'cabab'))
    print(regex_match(regex_compile(''), ''))
    print(regex_match(regex_compile(''), 'a'))
    print(regex_match(regex_compile('(a?)*'), 'aaa'))
    print(regex_match(regex_compile('a.b'), 'a\nb'))
    print(regex_match(regex_compile('\\.\\*\\[\\]\\\\'), '.*[]\\'))
    print(regex_compile('()').valid)
    print(regex_compile('a|').valid)
    print(regex_compile('|a').valid)
    print(regex_compile('a**').valid)
    print(regex_compile('[a]').valid)
    print(regex_compile('\\d').valid)
    print(regex_match(regex_compile('('), ''))
    Regex damaged = regex_compile('a')
    damaged.out1.clear()
    print(regex_match(damaged, 'a'))
    Regex bad_state = regex_compile('a')
    bad_state.start = 1000
    print(regex_match(bad_state, 'a'))
    int index = 0
    while (index < 100):
        Regex repeated = regex_compile('(a|b)*abb')
        Regex invalid = regex_compile('(a|)')
        if (!regex_match(repeated, 'abababb') || invalid.valid):
            print('loop failed')
            return 1
        index += 1
    print('loop passed')
    return 0
