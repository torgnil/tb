record Job(int rank)

int cmp(int a, int b):
    return a - b

int cmp_job(Job a, Job b):
    return a.rank - b.rank

bool length(prio_q<Job> jobs, int unused):
    return jobs.is_empty()

int count_pending(const prio_q<int> queue):
    return queue.length()

int main():
    int[] values = []
    prio_q<int> queue = values.create_prio_q(cmp)
    print(count_pending(queue))
    queue.push(4)
    queue.push(8)
    print(length(queue))
    queue.peek()
    print(queue.length())
    queue.pop()
    print(queue.length())
    Job[] jobs = [Job(1), Job(2)]
    prio_q<Job> pending = jobs.create_prio_q(cmp_job)
    print(pending.length())
    print(pending.length(0))
    pending.pop()
    print(length(pending))
    pending.pop()
    print(pending.length())
    print(pending.is_empty())
    return 0
