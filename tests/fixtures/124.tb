int main(string[] args):
    int[] values = [7]
    string message = args[0].substring(0, 0) + 'payload'
    int count = 0
    while (count < 3):
        try:
            count += 1
            values[0] += 1
            throw message
        catch (exception error):
            message = 'next ' + count
            print(error)
            print(message)
            print(count)
            print(values[0])
    try:
        try:
            throw 'inner ' + count
        catch (exception inner):
            print(inner)
            throw inner
    catch (exception outer):
        print(outer)
        print(values[0])
    try:
        try:
            print('normal')
        catch (exception unused):
            print('wrong handler')
        throw 'outer after normal'
    catch (exception final):
        print(final)
    print(message)
    print(count)
    print(values[0])
    return 0
