int[][] from_int(int value):
    return [[value]]

int[][] from_bool(bool value):
    if (value):
        return [[1]]
    return [[0]]

int[][] from_string(string value):
    return [[value.length()]]

int first_item(int[][] rows):
    return rows[0][0]

int main(string[] args):
    thread_pool pool = thread_pool(1)
    future<int[][]> a = pool.submit(from_int, 7)
    future<int[][]> b = pool.submit(from_bool, true)
    future<int[][]> c = pool.submit(from_string, 'four')
    print(first_item(a.await()))
    print(first_item(b.await()))
    print(first_item(c.await()))
    return 0
