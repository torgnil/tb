int grid_length(bool[][] rows):
    return rows.length()

bool first_cell(bool[][] rows):
    return rows[0][0]

void clear_first_cell(bool[][] rows):
    rows[0][0] = false

bool[][] snapshot(bool[][] rows):
    return rows

int main():
    map<int, bool[]> flags = {1: [true, true], 2: [false]}
    bool[][] rows = flags.values()
    print(grid_length(rows))
    print(first_cell(rows))
    clear_first_cell(rows)
    print(rows[0][0])
    bool[][] copied = snapshot(rows)
    rows[0][0] = true
    print(copied[0][0])
    print(grid_length(flags.values()))
    return 0
