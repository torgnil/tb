record Key(int value);

cached int value(int n):
    return n * 3 + 7

cached int record_value(Key key):
    return key.value * 2 + 1

cached int recursive(int n):
    if (n <= 0):
        return 0
    return recursive(n - 65536) + 1

cached int risky(int n):
    if (n < 0):
        throw 'retry'
    return n + 3

int worker(int n):
    int total = 0
    for (int i = 0; i < 20; i++):
        total += value(n + 65536 * (i % 3))
    return total + recursive(196608) + record_value(Key(n))

int main(string[] args):
    int n = args.length()
    try:
        int ignored = risky(0 - n)
    catch (exception err):
        print(err)
    print(risky(n))
    thread_pool pool = thread_pool(4)
    future<int> a = pool.submit(worker, n)
    future<int> b = pool.submit(worker, n + 1)
    future<int> c = pool.submit(worker, n + 2)
    future<int> d = pool.submit(worker, n + 3)
    print(a.await())
    print(b.await())
    print(c.await())
    print(d.await())
    print(recursive(196608))
    return 0
