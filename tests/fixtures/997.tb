record Entry(int id, int[] scores, string label);
record Empty();

Entry[] make_entries(int seed):
    return [Entry(seed + 1, [seed + 10], 'one'), Entry(seed + 2, [seed + 20], 'two'), Entry(seed + 3, [seed + 30], 'three')]

int main():
    Entry[] source = make_entries(0)
    Entry[] full = source[:]
    Entry[] middle = source[-3:-1]
    middle[0].id = 99
    middle[0].scores[0] = 99
    middle[0].label = 'changed'
    print(source[1].id)
    print(source[1].scores[0])
    print(source[1].label)
    print(middle[0].id)
    print(middle[0].scores[0])
    print(middle[0].label)
    print(full.length())

    Entry[] prefix = source[:2]
    Entry[] suffix = source[2:]
    Entry[] clamped = source[-10:10]
    Entry[] reversed = source[2:1]
    print(prefix[0].id)
    print(prefix[1].id)
    print(suffix.length())
    print(suffix[0].id)
    print(clamped.length())
    print(reversed.length())
    print(source[1:1].length())

    const Entry[] fixed = make_entries(10)
    Entry[] fixed_window = fixed[1:2]
    fixed_window[0].id = 90
    print(fixed[1].id)
    print(fixed_window[0].id)

    Entry[] temporary = make_entries(40)[1:]
    temporary[0].scores[0] = 777
    print(temporary[0].id)
    print(temporary[0].scores[0])

    Empty[] empty_records = [Empty(), Empty()]
    Empty[] selected_empty = empty_records[1:]
    print(selected_empty.length())
    return 0
