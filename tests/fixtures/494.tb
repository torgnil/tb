import regex;

void check(string pattern, string text):
    Regex r = regex_compile(pattern)
    print(r.valid && regex_match(r, text))
    return

int main():
    check('[0-9]{4}', '2026')
    check('[0-9]{4}', '202')
    check('a{2,4}', 'aa')
    check('a{2,4}', 'aaaa')
    check('a{2,4}', 'aaaaa')
    check('(ab|c){2,}', 'abcab')
    check('(ab|c){2,}', 'ab')
    check('a{0}', '')
    check('a{0}', 'a')
    check('a{0,2}', '')
    check('a{0,2}', 'aa')
    check('a{0,}', 'aaa')
    check('(a{0}b){2}', 'bb')
    check('(a?){2,3}', '')
    check('(a?){2,3}', 'aaa')
    check('(a?){2,3}', 'aaaa')
    check('\\{2\\}', '{2}')
    print(regex_compile('a{}').valid)
    print(regex_compile('a{,2}').valid)
    print(regex_compile('a{2,1}').valid)
    print(regex_compile('a{1001}').valid)
    print(regex_compile('a{2').valid)
    print(regex_compile('a{2}*').valid)
    print(regex_compile('a{999999999999999999999999}').valid)
    print(regex_compile('(a{1000}){1000}').valid)
    print(regex_compile('a{1000}').valid)
    return 0
