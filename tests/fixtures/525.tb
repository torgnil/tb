int early(int end):
    for (int item : range(end)):
        if (item == 2):
            return item
    return -1

int throw_in_loop():
    for (int item : range(4)):
        if (item == 1):
            throw 'range stopped'
    return 0

int main():
    print(early(4))
    print(early(2))
    try:
        print(throw_in_loop())
    catch (string error):
        print(error)
    return 0
