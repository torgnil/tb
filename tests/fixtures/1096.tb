import regex;

void show(string[] fields):
    print(fields.length())
    for (string field in fields):
        print('[' + field + ']')

int main():
    Regex delimiter = regex_compile('(,+)')
    show('a,,b,c'.regex_split_n(delimiter, 1))
    show('a,,b,c'.regex_split_n(delimiter, 2))
    show('a,,b,c'.regex_split_n(delimiter, 0))
    show('ab'.regex_split_n(regex_compile(''), 2))
    show('a,b'.regex_split_n(regex_compile('('), 4))
    show('a,,b,c'.split(delimiter))
    try:
        show('abc'.regex_split_n(delimiter, -1))
    catch (exception error):
        print(error)
    return 0
