record ShiftValue(int value);

int shift_left(int value, int amount):
    return value << amount

int shift_right(int value, int amount):
    return value >> amount

int global_shift = shift_left(7, 64)

int main(string[] args):
    print(global_shift)
    print(shift_left(7, 0))
    print(shift_left(7, 1))
    print(shift_left(7, 63))
    print(shift_left(7, 64))
    print(shift_left(7, 65))
    print(shift_left(7, 1000000))
    print(shift_left(-7, 64))
    print(shift_left(0, 1000000))
    print(shift_right(7, 0))
    print(shift_right(7, 1))
    print(shift_right(7, 63))
    print(shift_right(7, 64))
    print(shift_right(7, 65))
    print(shift_right(7, 1000000))
    print(shift_right(-7, 0))
    print(shift_right(-7, 1))
    print(shift_right(-7, 63))
    print(shift_right(-7, 64))
    print(shift_right(-7, 65))
    print(shift_right(-7, 1000000))
    print(shift_right(0, 1000000))

    int value = 3
    value <<= 4
    value >>= 2
    print(value)
    value = 7
    value <<= 64
    print(value)
    value = -7
    value >>= 65
    print(value)

    int[] values = [3]
    values[0] <<= 4
    values[0] >>= 2
    print(values[0])
    values[0] = 7
    values[0] <<= 64
    print(values[0])
    values[0] = -7
    values[0] >>= 65
    print(values[0])

    ShiftValue item = ShiftValue(3)
    item.value <<= 4
    item.value >>= 2
    print(item.value)
    item.value = 7
    item.value <<= 64
    print(item.value)
    item.value = -7
    item.value >>= 65
    print(item.value)
    return 0
