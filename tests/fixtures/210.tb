

# Case 1
record InsertHolder(int[] values, bool[] flags, string[] words);

int[] global_numbers = [70, 71];
string[] global_words = ['global-left', 'global-right'];

string make_insert_word(int seed):
    return 'owned-' + seed.to_string()

int[] make_insert_numbers(int seed):
    return [seed + 60, seed + 61]

bool[] make_insert_flags():
    return [false]

void print_insert_flags(bool[] flags):
    for (int i : range(flags.length())):
        print(flags[i])

string[] make_insert_words():
    return ['temporary-left', 'temporary-right']

void insert_borrowed(int[] values, int item):
    insert(values, 1, item)

int combined_case_1_main(string[] args):
    int seed = args.length()

    int[] numbers = [seed, seed + 2]
    print(insert(numbers, 1, seed + 10))
    print(numbers)

    int[] empty_numbers = []
    print(insert(empty_numbers, -9223372036854775807 - 1, seed + 20))
    print(empty_numbers)

    int[] at_start = [seed + 1, seed + 2]
    insert(at_start, -9223372036854775807 - 1, seed + 30)
    print(at_start)

    int[] at_end = [seed + 3, seed + 4]
    insert(at_end, 9223372036854775807, seed + 40)
    print(at_end)

    insert_borrowed(numbers, seed + 50)
    print(numbers)

    insert(global_numbers, 1, seed + 70)
    print(global_numbers)

    InsertHolder holder = InsertHolder([seed + 80], [false], ['field-left'])
    insert(holder.values, 1, seed + 81)
    insert(holder.flags, 0, true)
    insert(holder.words, 1, 'field-right')
    print(holder.values)
    print_insert_flags(holder.flags)
    print(holder.words)

    const int[] frozen = [seed + 90, seed + 91]
    int[] mutable_copy = copy(frozen)
    print(insert(mutable_copy, 1, seed + 92))
    print(mutable_copy)

    int[] reused = make_insert_numbers(seed)
    insert(reused, 1, seed + 100)
    print(reused)

    int[] branch_values = [seed]
    if (seed > 0):
        insert(branch_values, -1, seed + 110)
    else:
        insert(branch_values, 0, seed + 111)
    print(branch_values)

    int[] loop_values = []
    int loop_total = 0
    for (int i : range(2)):
        loop_total += insert(loop_values, i, seed + 120 + i)
    print(loop_total)
    print(loop_values)

    print(insert(make_insert_numbers(seed), 1, seed + 130))

    bool[] flags = [true, false]
    insert(flags, 1, true)
    print_insert_flags(flags)

    bool[] empty_flags = []
    insert(empty_flags, 9223372036854775807, false)
    print_insert_flags(empty_flags)

    bool[] reused_flags = make_insert_flags()
    insert(reused_flags, -1, true)
    print_insert_flags(reused_flags)
    insert(make_insert_flags(), 0, true)

    const string borrowed_word = 'borrowed'
    string[] words = ['left', 'right']
    insert(words, 1, borrowed_word)
    print(words)

    string[] owned_words = ['before', 'after']
    insert(owned_words, 1, make_insert_word(seed))
    print(owned_words)

    string[] self_alias_growth = ['grow', 'tail']
    insert(self_alias_growth, 0, self_alias_growth[1])
    print(self_alias_growth)

    string[] self_alias_capacity = ['drop', 'kept']
    self_alias_capacity.remove_at(0)
    insert(self_alias_capacity, 0, self_alias_capacity[0])
    print(self_alias_capacity)

    string[] empty_words = []
    insert(empty_words, -9223372036854775807 - 1, 'first')
    insert(empty_words, 9223372036854775807, 'last')
    print(empty_words)

    insert(global_words, 1, 'global-middle')
    print(global_words)

    string[] copied_words = copy(['copy-left', 'copy-right'])
    insert(copied_words, 1, 'copy-middle')
    print(copied_words)

    insert(make_insert_words(), 1, 'temporary-owned')
    int[] method_numbers = [seed]
    print(method_numbers.insert(0, seed + 140))
    print(method_numbers)
    print('direct insert complete')
    return 0

# Case 2
record PushHolder(int[] numbers, bool[] flags, string[] words);

int[] global_push_values = [100];

int[] make_empty_ints():
    return []

int[] make_ints(int seed):
    return [seed, seed + 1]

bool[] make_empty_flags():
    return []

bool[] make_flags(int seed):
    return [seed > 0]

string[] make_empty_words():
    return []

string[] make_words(int seed):
    return ['owned-' + seed.to_string()]

string make_word(int seed):
    return 'value-' + seed.to_string()

int append_borrowed(bool[] values, bool item):
    return values.push(item)

void print_flags(bool[] values):
    for (int i : range(values.length())):
        print(values[i])

int combined_case_2_main(string[] args):
    int seed = args.length()

    print([seed].push(seed + 1))
    print(make_empty_ints().push(seed + 2))
    print(make_ints(seed).push(seed + 3))
    print(copy([seed]).push(seed + 4))
    print(range(2).push(seed + 5))
    int[] slice_source = [seed, seed + 1, seed + 2]
    print(slice_source[1:3].push(seed + 6))

    int total = 0
    for (int i : range(2)):
        total += make_ints(seed + i).push(seed + 10 + i)
    print(total)
    if (make_empty_ints().push(seed + 12) == 1):
        print('int branch')
    else:
        print('int branch failed')

    print([false].push(seed > 0))
    const bool const_flag = true
    print(make_empty_flags().push(const_flag))
    print(make_flags(seed).push(false))
    bool[] borrowed_flags = [false]
    print(append_borrowed(borrowed_flags, true))
    print_flags(borrowed_flags)

    print(['left'].push('right'))
    print(make_empty_words().push(make_word(seed)))
    print(make_words(seed).push((seed + 3).to_string()))
    const string borrowed_word = 'borrowed'
    string[] retained_words = ['left']
    print(retained_words.push(borrowed_word))
    print(retained_words)
    string[] self_alias = ['grow', 'tail']
    print(self_alias.push(self_alias[1]))
    print(self_alias)

    print(push(make_empty_ints(), seed + 20))
    int[] named_values = [seed]
    print(named_values.push(seed + 21))
    print(named_values)
    const int[] frozen_values = [seed + 22]
    int[] copied_values = copy(frozen_values)
    print(copied_values.push(seed + 23))
    print(copied_values)
    print(frozen_values)
    print(global_push_values.push(seed + 24))
    print(global_push_values)

    PushHolder holder = PushHolder([seed], [false], ['field'])
    print(holder.numbers.push(seed + 25))
    print(holder.numbers.push(seed + 26))
    print(holder.flags.push(true))
    print(holder.flags.push(false))
    print(holder.words.push('item'))
    print(holder.words.push('last'))
    return 0

# Case 3
record Item(int value, string label, int[] values);
record Empty();
record Holder(Item[] items);
record item(int[] values);

Item[] global_items = []

Item make_item(int value):
    return Item(value, 'item-' + value.to_string(), [value])

Item[] make_items(int value):
    return [make_item(value)]

Item[] empty_items():
    return []

int borrowed_item_count(Item[] values):
    return values.length()

int combined_case_3_main(string[] args):
    int seed = args.length() + 3

    print(length(make_items(seed)))
    print(make_items(seed + 1).length())
    print(make_items(seed + 2).is_empty())
    print(length(empty_items()))
    print(empty_items().length())
    print(empty_items().is_empty())

    print([make_item(seed + 3)].length())
    print([make_item(seed + 4)].is_empty())

    Holder holder = Holder([make_item(seed + 5)])
    print(holder.items.length())
    print(holder.items[0].value)
    print(holder.items[0].label)

    Item[] named = make_items(seed + 6)
    print(named.length())
    print(borrowed_item_count(named))
    print(named[0].value)
    print(named[0].values[0])

    const Item[] fixed = make_items(seed + 7)
    print(fixed.length())
    print(fixed[0].value)
    print(fixed[0].label)

    global_items.push(make_item(17))
    print(global_items.length())
    print(global_items[0].value)

    Empty[] no_records = []
    print(no_records.length())
    print(no_records.is_empty())
    print([Empty()].length())
    print([Empty()].is_empty())

    item[] payloads = [item([seed])]
    print(payloads.length())
    print(payloads[0].values.length())

    Item[] reused = make_items(seed + 8)
    print(reused.length())
    reused.push(make_item(seed + 9))
    print(reused.length())

    int total = 0
    for (int i = 0; i < 3; i++):
        total += make_items(seed + i).length()
    print(total)

    if (make_items(seed).is_empty()):
        print(0)
    else:
        print(1)

    int[] native_values = [seed]
    print(native_values.length())
    print(native_values.is_empty())
    bool[] no_flags = []
    print(no_flags.is_empty())
    string[] native_words = ['native']
    print(native_words.length())
    print(native_words.is_empty())
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main(args) != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main(args) != 0):
        return 1
    print('=== case 3 ===')
    if (combined_case_3_main(args) != 0):
        return 1
    return 0
