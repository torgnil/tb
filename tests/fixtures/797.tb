enum Code { A = 1, B = 2 }

map<int[][], int> copy_grid_counts(map<int[][], int> counts):
    return counts

map<Code[][], int> GLOBAL_GRID_COUNTS = {}

record GridCountStore(map<Code[][], int> counts);

int main():
    map<int[][], int> counts = {}
    int[][] source = [[1, 2], [], [3]]
    counts[source] = 7
    source[0][0] = 9
    print(counts[[[1, 2], [], [3]]])
    print(counts[source])
    print(counts.contains(source))
    print(counts.contains([[1, 2], [], [3]]))

    counts[[[1, 2], [], [3]]] = 0
    counts[[[4]]] = 8
    counts[[]] = 3
    print(counts.length())
    int[] ordered = counts.values()
    print(ordered)
    ordered[0] = 99
    print(counts[[[1, 2], [], [3]]])

    map<int[][], int> copied = copy_grid_counts(counts)
    copied[[[1, 2], [], [3]]] = 5
    print(copied.values())
    print(counts[[[1, 2], [], [3]]])

    const int[][] fixed = [[5], []]
    counts[fixed] = 14
    print(counts[[[5], []]])

    map<Code[][], int> enum_counts = {[[Code.A], []]: 12}
    int[][] same_enum_grid = [[1], []]
    print(enum_counts[same_enum_grid])
    enum_counts[[[Code.B]]] = 13
    print(enum_counts.values())

    GLOBAL_GRID_COUNTS[[[Code.B], []]] = 15
    print(GLOBAL_GRID_COUNTS[[[2], []]])
    GridCountStore store = GridCountStore({[[Code.A], []]: 17})
    print(store.counts[[[1], []]])
    return 0
