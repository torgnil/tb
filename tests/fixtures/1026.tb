int main():
    ensure_dir('test-files/directory')
    try:
        remove_path('test-files/missing.txt')
    catch (exception error):
        print(error)
    try:
        remove_path('test-files/directory')
    catch (exception error):
        print(error)
    try:
        rename_path('test-files/missing.txt', 'test-files/destination.txt')
    catch (exception error):
        print(error)

    write_all('test-files/recovered.txt', 'recovered')
    print(read_file('test-files/recovered.txt'))
    return 0
