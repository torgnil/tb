int[][] make_rows():
    return [[1, 2]]

int main():
    thread_pool pool = thread_pool(1)
    future<int> result = pool.submit(int row_index -> {
        int total = 0
        for (int value : make_rows()[row_index]) {
            total += value
        }
        return total
    }, 0)
    return result.await()
