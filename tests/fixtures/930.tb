int calls = 0

string[] maybe_words(string line):
    calls += 1
    if (line == 'bad'):
        throw 'flat map failed'
    return [line, line + '!']

string[] make_lines():
    return ['good', 'bad', 'later']

int main(string[] args):
    try:
        string[] result = make_lines().flat_map(string line -> maybe_words(line))
        print(result.length())
    catch (string error):
        print(error)
    print(calls)
    string[] recovered = ['after'].flat_map(string line -> maybe_words(line))
    print(recovered.length())
    print(recovered[0])
    print(recovered[1])
    print(calls)
    return 0
