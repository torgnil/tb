int text_length(string text):
    return text.length()

int main():
    thread_pool pool = thread_pool(2)
    string[] words = ['one', 'two', 'three']

    future<int> mutable_words = pool.submit(string[] input -> {
        int total = 0
        for (string word : input) {
            word = word + '!'
            total += text_length(word)
        }
        return total
    }, words)

    future<int> const_words = pool.submit(string[] input -> {
        int total = 0
        for (const string word : input) {
            if (word == 'two') {
                continue
            }
            total += text_length(word)
            if (total >= 3) {
                break
            }
        }
        return total
    }, words)

    words[0] = 'changed'
    print(mutable_words.await())
    print(mutable_words.await())
    print(const_words.await())

    string[] empty = []
    future<int> empty_words = pool.submit(string[] input -> {
        int total = 0
        for (string word : input) {
            total += text_length(word)
        }
        return total
    }, empty)
    print(empty_words.await())
    return 0
