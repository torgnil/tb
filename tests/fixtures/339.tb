

# Case 1
num echo_num(num value):
    return value

int combined_case_1_main(string[] args):
    num small = echo_num(0.09000000000000000000)
    num tenth = echo_num(0.1)
    print(small < tenth)
    print(small <= tenth)
    print(small == tenth)
    print(small != tenth)
    print(small >= tenth)
    print(small > tenth)

    num negative_small = echo_num(-0.09000000000000000000)
    num negative_tenth = echo_num(-0.1)
    print(negative_tenth < negative_small)
    print(negative_tenth <= negative_small)
    print(negative_tenth == negative_small)
    print(negative_tenth != negative_small)
    print(negative_tenth >= negative_small)
    print(negative_tenth > negative_small)

    num zero = echo_num(0.00000000000000000000)
    num tiny = echo_num(0.00000000000000000001)
    print(zero == 0.0)
    print(zero < tiny)
    print(-tiny < zero)
    print(tiny > 1.0)
    print(1.0 > tiny)

    num equal_whole = echo_num(0.01)
    num equal_scaled = echo_num(0.01000000000000000000)
    print(equal_whole == equal_scaled)
    print(equal_whole <= equal_scaled)
    print(equal_whole >= equal_scaled)
    print(min(equal_whole, equal_scaled))
    print(max(equal_whole, equal_scaled))

    num minimum = echo_num(-0.9223372036854775808)
    num maximum = echo_num(0.9223372036854775807)
    print(minimum < maximum)
    print(maximum > minimum)
    print(min(minimum, maximum))
    print(max(minimum, maximum))

    print(min(small, tenth))
    print(max(small, tenth))
    print(min(negative_tenth, negative_small))
    print(max(negative_tenth, negative_small))
    return 0

# Case 2
string format_direct(num value):
    return to_string(value)

string format_method(num value):
    return value.to_string()

string format_int(int value):
    return value.to_string()

void discard_num(num value):
    to_string(value)
    return

int combined_case_2_main():
    print(format_direct(12.50))
    print(format_method(-0.25))
    print(format_direct(0.00))
    print(format_method(123.00))
    print(format_int(-42))
    discard_num(9.75)
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main(args) != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main() != 0):
        return 1
    return 0
