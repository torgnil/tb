import process;

int main():
    ProcessResult result = run_process([
        '/usr/bin/awk',
        'BEGIN { for (i = 0; i < 40000; i++) { print "O"; print "E" > "/dev/stderr" } }'
    ])
    print(result.exit_code)
    print(result.stdout.length())
    print(result.stderr.length())
    print(result.stdout[0] == 'O' && result.stderr[0] == 'E')
    return 0
