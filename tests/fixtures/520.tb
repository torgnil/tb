num fixed_rate():
    return 0.025

num scaled_total(num amount):
    return amount * 2.5 + 0.125

num failed_total():
    throw 'numeric worker failed'

future<num> submit_total(thread_pool pool, num amount):
    return pool.submit(scaled_total, amount)

int main(string[] args):
    thread_pool pool = thread_pool(1)
    future<num> fixed = pool.submit(fixed_rate)
    print(fixed.await())

    future<num> total = submit_total(pool, 1.20)
    const future<num> alias = total
    print(alias.wait_for(10000))
    print(total.is_done())
    print(alias.await())
    print(total.await())

    future<num> failed = pool.submit(failed_total)
    try:
        print(failed.await())
    catch (exception error):
        print(error)
    try:
        print(failed.await())
    catch (exception error):
        print(error)
    return 0
