record ConditionalSetBox(set<int> values);

int make_calls = 0
set<int> global_values = {6, 7}

set<int> make_values(int value):
    make_calls += 1
    return {value}

set<int> choose_return(bool owned, set<int> source):
    return owned ? make_values(40) : source

int main(string[] args):
    set<int> source = {1, 2}
    const set<int> fixed = {3, 4}
    ConditionalSetBox box = ConditionalSetBox({5})
    set<int> empty = {}

    int before = make_calls
    set<int> borrowed = false ? make_values(10) : source
    print(make_calls == before)
    borrowed.add(20)
    print(source.contains(20))

    set<int> owned = true ? make_values(11) : source
    print(make_calls == before + 1)
    print(owned.contains(11))

    set<int> const_choice = true ? fixed : empty
    const_choice.add(30)
    print(fixed.contains(30))

    set<int> global_choice = false ? empty : global_values
    global_choice.add(31)
    print(global_values.contains(31))

    set<int> field_choice = false ? empty : box.values
    field_choice.add(32)
    print(box.values.contains(32))

    set<int> borrowed_return = choose_return(false, source)
    borrowed_return.add(33)
    print(source.contains(33))

    set<int> owned_return = choose_return(true, source)
    print(owned_return.contains(40))

    int loop_index = 0
    while (loop_index < 2):
        set<int> loop_choice = loop_index == 0 ? make_values(loop_index + 50) : empty
        print(loop_choice.length())
        loop_index += 1

    set<int> argument_choice = args.length() > 0 ? make_values(60) : source
    print(argument_choice.length())
    return 0
