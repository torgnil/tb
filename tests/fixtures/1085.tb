int int_keys(map<int, int> counts, int key):
    return counts[key]

int[] collect(const map<int, int> counts):
    return counts.int_keys()

int main():
    map<int, int> counts = {}
    print(counts.int_keys().length())
    counts[-9223372036854775808] = 10
    counts[9223372036854775807] = 20
    counts[0] = 30
    int[] keys = collect(counts)
    int total = 0
    for (int key in keys):
        total += counts[key]
    print(total)
    print(counts.int_keys(0))
    string[] text_keys = counts.keys()
    for (int i = 0; i < keys.length(); i += 1):
        print(keys[i].to_string() == text_keys[i])
    counts[-1] = 40
    print(keys.length())
    keys[0] = 100
    print(counts.int_keys().length())
    print(counts[0])
    return 0
