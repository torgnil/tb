int answer():
    return 42

bool ready():
    return true

string label():
    return 'done'

int main(string[] args):
    thread_pool pool = thread_pool(2)
    future<int> a = pool.submit(answer)
    future<bool> b = pool.submit(ready)
    future<string> c = pool.submit(label)
    print(a.await())
    print(b.await())
    print(c.await())
    return 0
