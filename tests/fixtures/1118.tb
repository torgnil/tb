int main():
    thread_pool pool = thread_pool(1)
    string[][] batches = [['aa'], [], ['skip', 'bbb', 'end', 'unused']]
    future<int> total = pool.submit(() -> {
        int count = 0
        for (const string[] batch in batches) {
            for (const string word in batch) {
                if (word == 'skip') {
                    continue
                }
                if (word == 'end') {
                    break
                }
                count += word.length()
            }
        }
        return count
    })
    batches[0][0] = 'changed'
    print(total.await())
    print(total.await())

    const string[][] empty = []
    future<bool> any_rows = pool.submit(string[][] input -> {
        for (const string[] row in input) {
            return true
        }
        return false
    }, empty)
    print(any_rows.await())
    return 0
