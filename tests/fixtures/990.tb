import process;

int main(string[] args):
    if (args.length() > 1 && args[1] == 'recover'):
        print('recovered')
        return 0
    try:
        ProcessResult empty = run_process([])
        print('unreachable')
    catch (exception error):
        print(error)

    try:
        ProcessResult missing = run_process(['/__tb_process_missing_program__'])
        print('unreachable')
    catch (exception error):
        print(error)

    ProcessResult recovered = run_process([args[0], 'recover'])
    print(recovered.exit_code)
    print(recovered.stdout.trim())
    print(recovered.stderr == '')
    return 0
