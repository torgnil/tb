int[] maybe_expand(int value, int amount):
    if (value == 2):
        throw 'captured flat_map failure'
    return [value + amount]

int[] make_values():
    return [1, 2, 3]

int main(string[] args):
    int amount = 9
    try:
        int[] result = make_values().flat_map(int value -> maybe_expand(value, amount))
        print(result.length())
    catch (string error):
        print(error)
    int[] after_error = [7].flat_map(int value -> [value + amount])
    print(after_error.length())
    print(after_error[0])
    return 0
