int fail():
    throw 'expected'

int main(string[] args):
    const int IMMUTABLE = 7
    print('const ' + IMMUTABLE)

    int while_count = 0
    while (while_count < 3):
        print('while ' + while_count)
        if (while_count == 0):
            while_count += 1
        while_count += 1
    print('while final ' + while_count)

    int for_count = 0
    for (int seed = 0; for_count < 3; for_count++):
        print('for ' + for_count)
    print('for final ' + for_count)

    int[] items = [1, 2, 3]
    int each_count = 0
    for (int item : items):
        print('each ' + each_count)
        if (item == 2):
            each_count += 1
        each_count += 1
        if (item == 3):
            break
    print('each final ' + each_count)

    int try_count = 0
    while (try_count < 3):
        try:
            print('try ' + try_count)
            try_count += 1
        catch (exception error):
            print(error)
    print('try final ' + try_count)

    int catch_count = 0
    while (catch_count < 3):
        try:
            print(fail())
        catch (exception error):
            print('catch ' + catch_count)
            catch_count += 1
    print('catch final ' + catch_count)

    int zero_count = 5
    while (zero_count < 0):
        zero_count += 1
    print('zero final ' + zero_count)
    return 0
