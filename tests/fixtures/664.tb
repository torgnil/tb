record Pair(int left, int right);

int main():
    string empty_text = ''
    string text = 'tb'
    int[] empty_ints = []
    int[] numbers = [3, 5]
    bool[] flags = [true, false, true]
    string[] words = ['one', 'two']
    int[][] rows = [[1], [2, 3]]
    string[][] word_rows = [['a'], ['b', 'c']]
    set<int> ids = {4, 8}
    set<Pair> pairs = {Pair(1, 2), Pair(3, 4)}
    map<string, int> counts = {'one': 1, 'two': 2}
    map<int, string> labels = {1: 'one'}
    Pair[] records = [Pair(5, 6), Pair(7, 8)]

    print(length(empty_text))
    print(length(text))
    print(text.length())
    print(length(empty_ints))
    print(length(numbers))
    print(length(flags))
    print(length(words))
    print(length(rows))
    print(length(word_rows))
    print(length(ids))
    print(length(pairs))
    print(length(counts))
    print(length(labels))
    print(length(records))
    print(records.length())
    return 0
