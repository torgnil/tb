import regex;

int main():
    Regex byte_pattern = regex_compile('b')
    print(regex_find_start(byte_pattern, 'abc'))
    print(regex_find_start_from(byte_pattern, 'abc', 0))
    print(regex_find_start_from(byte_pattern, 'abc', 1))
    print(regex_find_start_from(byte_pattern, 'abc', 2))
    print(regex_find_start_from(byte_pattern, 'abc', 3))
    print(regex_find_start_from(byte_pattern, 'abc', -1))
    print(regex_find_start_from(byte_pattern, 'abc', 4))

    Regex empty = regex_compile('')
    print(regex_find_start_from(empty, '', 0))
    print(regex_find_start_from(empty, 'abc', 0))
    print(regex_find_start_from(empty, 'abc', 2))
    print(regex_find_start_from(empty, 'abc', 3))

    Regex nullable = regex_compile('a*')
    print(regex_find_start_from(nullable, 'baac', 0))
    print(regex_find_start_from(nullable, 'baac', 1))
    print(regex_find_start_from(nullable, 'baac', 3))
    print(regex_find_start_from(nullable, 'baac', 4))

    Regex delayed = regex_compile('a.*z|b.*z')
    print(regex_find_start_from(delayed, 'ab123z', 0))
    print(regex_find_start_from(delayed, 'ab123z', 1))
    print(regex_find_start_from(delayed, 'ab123z', 2))

    Regex absolute_start = regex_compile('^a')
    print(regex_find_start_from(absolute_start, 'ab', 0))
    print(regex_find_start_from(absolute_start, 'ab', 1))
    Regex absolute_end = regex_compile('$')
    print(regex_find_start_from(absolute_end, 'abc\n', 0))
    print(regex_find_start_from(absolute_end, 'abc\n', 3))
    print(regex_find_start_from(absolute_end, 'abc\n', 4))

    Regex invalid = regex_compile('(')
    print(regex_find_start_from(invalid, 'abc', 0))
    print(regex_find_start_from(regex_compile('x'), 'éx', 0))
    print(regex_find_start_from(regex_compile('x'), 'éx', 1))
    return 0
