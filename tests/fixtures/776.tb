bool[][] make_grid(bool[] row):
    return [row, row, [], [false, true]]

int main():
    bool[] source = [true, false]
    bool[][] grid = [source, source, [], [false]]
    source[0] = false
    print(grid.length())
    print(grid[0].length())
    print(grid[1].length())
    print(grid[2].length())
    print(grid[3][0])
    print(grid[0][0])
    grid[0][0] = false
    print(grid[0][0])
    print(grid[1][0])

    bool[][] returned = make_grid(source)
    source[0] = true
    print(returned.length())
    print(returned[0][0])
    print(returned[1][0])
    returned[0][0] = true
    print(returned[1][0])

    bool[][] empty = []
    print(empty.length())
    const bool[][] fixed = [[true], []]
    print(fixed.length())
    print(fixed[1].length())
    return 0
