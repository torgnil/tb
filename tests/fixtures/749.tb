int min(const int[][] rows):
    return rows.length()

int max(string[] values):
    return values.length()

int main():
    int[][] typed = [[1]]
    string[] words = ['a']
    print(min([]))
    print(min([[], [1, 2]]))
    print(min(typed))
    print(max([]))
    print(max(words))
    print(min(3, 5))
    return 0
