int const_int_value(int key):
    const map<int, int> counts = {key: key * 3}
    return counts[key]

string const_string_value(int key):
    string lookup_key = 'name-' + key.to_string()
    const map<string, string> labels = {lookup_key: 'value-' + key.to_string()}
    return labels[lookup_key]

string[] const_int_keys(int key):
    const map<int, int> counts = {key: key + 1}
    return counts.keys()

string[] const_int_values(int key):
    const map<int, int> counts = {key: key + 1}
    return counts.values()

string[] keys(int value):
    string[] result = []
    result.push('helper-key-' + value.to_string())
    return result

string[] values(int value):
    string[] result = []
    result.push('helper-value-' + value.to_string())
    return result

int main(string[] args):
    int key = args.length() + 4
    const map<int, int> counts = {key: key * 3, key + 1: key * 4}
    print(counts[key] + 2)
    print(counts[key])
    print(counts[key + 1] - counts[key])
    print(counts.keys().length())
    print(counts.values().length())

    const map<int, int> single_count = {key: key * 3}
    string[] count_keys = single_count.keys()
    string[] count_values = single_count.values()
    single_count.keys()
    single_count.values()
    print(count_keys[0])
    print(count_values[0])
    print(count_keys.length() + count_values.length())

    string label_key = 'item-' + key.to_string()
    const map<string, string> labels = {label_key: 'text-' + key.to_string()}
    print(labels[label_key] + '!')
    print(labels.keys().length())
    print(labels.values().length())
    string[] label_keys = labels.keys()
    string[] label_values = labels.values()
    print(label_keys[0])
    print(label_values[0])

    const map<string, int> scores = {'score-' + key.to_string(): key + 20}
    print(scores['score-' + key.to_string()] + 1)
    print(scores.keys()[0])
    print(scores.values()[0])

    print(const_int_value(key))
    print(const_string_value(key))
    string[] returned_keys = const_int_keys(key)
    string[] returned_values = const_int_values(key)
    print(returned_keys[0])
    print(returned_values[0])
    string[] helper_keys = key.keys()
    string[] helper_values = key.values()
    print(helper_keys[0])
    print(helper_values[0])

    map<int, int> empty_counts = {}
    print(empty_counts.keys().length())
    print(empty_counts.values().length())
    print(empty_counts.is_empty())

    map<int, int> mutable_counts = {key: key * 3}
    print(mutable_counts[key] + 2)
    print(mutable_counts.keys()[0])
    print(mutable_counts.values()[0])
    print(mutable_counts.is_empty())

    int branch_value = 0
    if (counts[key] > 0):
        branch_value = counts[key] + 1
    print(branch_value)

    int i = 0
    int loop_total = 0
    while (i < 2):
        loop_total += counts[key + i]
        i += 1
    print(loop_total)
    return 0
