string make_item(int value):
    return 'owned-' + value.to_string()

int main(string[] args):
    string[] chars = 'safe'.split('')
    print(chars.length())
    print(chars[0])

    string[] empty = []
    print(empty.length())
    print(empty.push(make_item(0)))
    empty.insert(-3, make_item(1))
    print(empty.length())
    print(empty[0])
    print(empty[1])

    string borrowed = make_item(7)
    string[] values = [make_item(2)]
    print(values.push(borrowed))
    print(push(values, make_item(3)))
    values.push(values[0])
    values.push(make_item(4))
    values.insert(-4, make_item(5))
    insert(values, 2, borrowed)
    values.insert(100, make_item(6))
    values.insert(3, values[0])
    print(values.length())

    string[] snapshot = values.copy()
    string popped = values.pop()
    values.clear()
    print(values.length())
    print(popped)
    print(borrowed)
    print(snapshot.length())
    print(snapshot[0])
    print(snapshot[1])
    print(snapshot[2])
    print(snapshot[3])
    print(snapshot[4])
    print(snapshot[5])
    print(snapshot[6])
    print(snapshot[7])
    print(snapshot[8])

    values.push(make_item(8))
    values.insert(100, borrowed)
    print(values.length())
    print(values[0])
    print(values[1])
    print(snapshot[8])
    return 0
