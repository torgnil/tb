enum Limits { LOW = 2, HIGH = 9 }

int calls = 0

int mark(int value):
    calls = calls * 10 + value
    return value

void show(int[] values):
    for (int value : values):
        print(value)

int main():
    show(range(1, 10, 3))
    show(range(10, 0, -3))
    show(range(0, 10, -1))
    show(range(10, 0, 1))
    show(range(5, 5, 2))

    int total = 0
    for (int value : range(1, 8, 3)):
        total += value
    print(total)

    int[] once = range(mark(1), mark(8), mark(3))
    print(calls)
    show(once)

    const int step = -2
    show(range(Limits.HIGH, Limits.LOW, step))

    show(range(-9223372036854775807 - 1, -9223372036854775805, 1))
    show(range(9223372036854775805, 9223372036854775807, 1))
    show(range(9223372036854775807, -9223372036854775807 - 1, -9223372036854775807 - 1))
    return 0
