string int_array_text(int[] values):
    string text = '['
    for (int index : range(values.length())):
        if (index > 0):
            text += ', '
        text += values[index]
    text += ']'
    return text

int global_offset = 2
int callback_calls = 0

int add_values(int left, int right):
    return left + right

int touch_callback(int value):
    callback_calls += 1
    return value

int change_global_offset(int value):
    global_offset += 1
    return value

int[] make_source(int seed):
    return [seed, seed + 1]

int[] global_block = [1, 2].map_to(int item -> {
    int adjusted = item + global_offset
    return adjusted
})

int main(string[] args):
    int[] values = [1, 2, 2, 3]
    int delta = args.length() + 1

    print(int_array_text(global_block))
    print(int_array_text(values))

    int[] mapped = values.map_to(int item -> {
        item += delta
        int extra = 0
        for (int step : range(2)) {
            extra += step
        }
        int adjusted = add_values(item, extra)
        if (adjusted > 5) {
            return adjusted
        } else {
            return adjusted * 2
        }
    })
    print(int_array_text(mapped))

    int[] filtered = values.filter(int item -> {
        int original = item
        item += 1
        if (item > 2) {
            return original % 2 == 0
        }
        return false
    })
    print(int_array_text(filtered))
    print(int_array_text(values))

    int[] closed_filtered = values.filter(int item -> {
        const bool is_even = item % 2 == 0
        if (is_even) {
            return true
        }
        return false
    })
    print(int_array_text(closed_filtered))

    int[] switched = values.map_to(int item -> {
        switch (item) {
            case 1: {
                return 10
            }
            case 2: {
                return 20
            }
            default: {
                return 30
            }
        }
        return 40
    })
    print(int_array_text(switched))

    int[] handled = values.map_to(int item -> {
        try {
            if (item == 2) {
                throw 'two'
            }
            return item + delta
        } catch (exception error) {
            return 99
        }
    })
    print(int_array_text(handled))

    int[] looped = values.map_to(int item -> {
        int step = 0
        int total = 0
        while (step < 4) {
            step += 1
            if (step == 1) {
                continue
            }
            total += 1
            if (step == 3) {
                break
            }
        }
        for (int index = 0; index < 2; index += 1) {
            total += index
        }
        return item + total
    })
    print(int_array_text(looped))

    int[] snapshot = values.map_to(int item -> {
        int saved_offset = global_offset
        int current = change_global_offset(item)
        return saved_offset + current
    })
    print(int_array_text(snapshot))
    print(global_offset)

    int[] empty = []
    int calls_before_empty = callback_calls
    int[] empty_mapped = empty.map_to(int item -> {
        return touch_callback(item)
    })
    print(empty_mapped.length())
    print(callback_calls - calls_before_empty)

    bool enabled = args.length() == 1
    int[] bool_captured = values.map_to(int item -> {
        if (enabled) {
            return item + 1
        } else {
            return item - 1
        }
    })
    print(int_array_text(bool_captured))

    const int[] fixed = values
    const int const_delta = 3
    int[] const_mapped = fixed.map_to(int item -> {
        return item + const_delta
    })
    print(int_array_text(const_mapped))

    int item = 100
    int[] shadowed = values.map_to(int item -> {
        return item + 1
    })
    print(int_array_text(shadowed))
    print(int_array_text(make_source(delta).map_to(int item -> {
        return item * 2
    })))
    return 0
