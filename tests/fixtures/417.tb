record Marker(int value);

int starts_with(int value, string prefix):
    return value + prefix.length()

string ends_with(Marker value):
    return 'marker:' + value.value

string starts_with_at(int value, int offset):
    return 'offset:' + (value + offset)

int is_alpha(int value):
    return value + 1

int is_digit(int value):
    return value + 2

bool is_alnum(int value):
    return value > 0

int is_space(int value):
    return value + 3

string is_whitespace(int value):
    return 'space:' + value

int main(string[] args):
    const int item = 4
    Marker marker = Marker(7)
    print(item.starts_with('x'))
    print(starts_with(item, 'x'))
    print('tb'.starts_with('t'))
    print(marker.ends_with())
    print(item.starts_with_at(3))
    print(item.is_alpha())
    print(item.is_digit())
    print(item.is_alnum())
    print(item.is_space())
    print(item.is_whitespace())
