import union_find;

int component_size(const int[] parents, int item):
    return parents.union_find_component_size_readonly(item)

int main():
    int[] parents = union_find_new(5)
    parents.union_find_union(2, 0)
    parents.union_find_union(3, 1)
    parents.union_find_union(3, 2)
    print(component_size(parents, 0))
    print(component_size(parents, 3))
    print(component_size(parents, 4))
    print(parents[0])
    print(parents.union_find_component_size(0))
    print(parents[0])
    try:
        print(component_size(parents, 5))
    catch (exception error):
        print(error)
    return 0
