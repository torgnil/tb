int[][] wrap_values(int[] values):
    return [values]

int[][] copy_rows(int[][] rows):
    return rows

int first_item(int[][] rows):
    return rows[0][0]

int main(string[] args):
    int[] values = [2, 3]
    int[][] rows = [[4], [5]]
    thread_pool pool = thread_pool(1)
    future<int[][]> a = pool.submit(wrap_values, values)
    future<int[][]> b = pool.submit(copy_rows, rows)
    values[0] = 99
    rows[0][0] = 88
    print(first_item(a.await()))
    print(first_item(b.await()))
    return 0
