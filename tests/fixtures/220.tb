record FieldCell(int value);
record FieldBox(int number, num amount, bool enabled, string label, int[] values, bool[] flags, string[] words, int[][] rows, string[][] groups, map<string, int> counts, FieldCell cell);

int next_field_value(int value):
    return value + 3

map<string, int> make_field_counts(int value):
    return {'owned': value}

int main(string[] args):
    int count = args.length()
    const int fixed = count + 2
    const num fixed_amount = 0.000 - count
    const bool fixed_enabled = count > 0
    const string fixed_label = 'field-' + count
    int[] source_values = [count, count + 2]
    const int[] fixed_values = [fixed]
    bool[] source_flags = [fixed_enabled]
    string[] source_words = [fixed_label]
    int[] source_row = [fixed + 1]
    int[][] source_rows = [source_row]
    string[] source_group = [fixed_label]
    string[][] source_groups = [source_group]
    map<string, int> source_counts = {'borrowed': count + 2}
    const map<string, int> fixed_counts = {'fixed': count + 2}
    const FieldCell source_cell = FieldCell(fixed + 4)

    FieldBox box = FieldBox(0, 0.0, false, '', [], [], [], [], [], {'seed': 1}, FieldCell(0))
    box.number = fixed
    box.number += count
    box.amount = fixed_amount
    box.amount += fixed_amount
    box.enabled = fixed_enabled
    box.label = fixed_label
    box.values = []
    box.flags = []
    box.words = []
    box.rows = []
    box.groups = []
    box.values = fixed_values
    box.values = source_values
    box.flags = source_flags
    box.words = source_words
    box.rows = source_rows
    box.groups = source_groups
    box.counts = fixed_counts
    box.counts = source_counts
    box.cell = source_cell
    box.number = next_field_value(box.cell.value)
    box.cell.value += count

    source_values[0] = 99
    source_flags[0] = false
    source_words[0] = 'changed'
    source_row[0] = 98
    source_group[0] = 'changed'
    source_counts['borrowed'] = 97

    print(box.counts['borrowed'])
    box.counts = make_field_counts(next_field_value(count))

    print(box.number)
    print(box.amount)
    print(box.enabled)
    print(box.label)
    print(box.values[0])
    print(box.flags[0])
    print(box.words[0])
    print(box.rows[0][0])
    print(box.groups[0][0])
    print(box.counts['owned'])
    print(box.cell.value)
    print(box.values.length())
    return 0
