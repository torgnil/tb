string contains(int left, int right):
    return 'value-' + (left + right)

string add_suffix(string value):
    return value + '!'

int main(string[] args):
    int seed = args.length() + 7
    string saved = seed.contains(3)
    print(saved)
    print(add_suffix(saved))
    print(seed.contains(4))
    string direct = seed.contains(5)
    print(direct.length())
