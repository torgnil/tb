int[] make_sum_values(int seed):
    return [seed, seed + 1]

bool[] make_sum_flags(int seed):
    return [seed > 0, seed > 1, false]

int copied_sum(int[] values):
    return values.copy().sum()

int copied_flag_sum(bool[] flags):
    return flags.copy().sum()

int main(string[] args):
    int seed = args.length() + 2

    print(make_sum_values(seed).copy().sum())
    print(make_sum_values(seed).copy().copy().sum())
    print([seed, seed + 1].copy().sum())

    int[] named_values = make_sum_values(seed)
    const int[] const_values = make_sum_values(seed)
    print(named_values.copy().sum())
    print(const_values.copy().sum())
    print(copied_sum(named_values))
    named_values[0] += 10
    print(named_values.sum())

    bool[] named_flags = make_sum_flags(seed)
    const bool[] const_flags = make_sum_flags(seed)
    print(named_flags.copy().sum())
    print(const_flags.copy().sum())
    print(make_sum_flags(seed).copy().sum())
    print([seed > 0, false].copy().sum())
    print(copied_flag_sum(named_flags))

    int[] empty_values = []
    bool[] empty_flags = []
    print(empty_values.copy().sum())
    print(empty_flags.copy().sum())

    int[][] rows = [[seed, seed + 1], [seed + 2, seed + 3]]
    print(rows.copy().pop().sum())
    print(rows.copy().last().sum())

    if (seed == 3):
        print(make_sum_values(seed).copy().sum())
    else:
        print(make_sum_values(seed).copy().sum())

    switch (seed):
        case 3:
            print(make_sum_values(seed).copy().sum())
        default:
            print(make_sum_values(seed).copy().sum())

    for (int offset : range(2)):
        print(make_sum_values(seed + offset).copy().sum())

    try:
        print(make_sum_values(seed).copy().sum())
        throw 'copy-sum'
    catch (exception error):
        print('caught-copy-sum')

    return 0
