import regex;
import uuid;

const int REGEX_POSTFIX_CHAR = 42
const int RANDOM_DEFAULT_SEED = 7
const int UUID_VERSION_MASK = 8

int main():
    print(REGEX_POSTFIX_CHAR)
    print(RANDOM_DEFAULT_SEED + UUID_VERSION_MASK)
    Regex pattern = regex_compile('(a)')
    print(regex_find_all(pattern, 'aaaa').length())
    print(regex_find_all_captures(pattern, 'aaaa').length())
    print(regex_replace(pattern, 'aaaa', '$1!'))
    print('aaaa'.split(pattern).length())
    print(uuid_format(uuid_parse('00112233-4455-6677-8899-aabbccddeeff')))
    string generated = uuid()
    print(uuid_is_valid(generated))
    print(generated[14])
    print('89ab'.contains(generated[19]))
    return 0
