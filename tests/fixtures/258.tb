record WordBox(string text);
record WordList(string[] words);

string[] global_words = ['global-left', 'global-tail'];

string[] make_words(int seed):
    string left = 'left-' + seed.to_string()
    string right = 'right-' + (seed + 1).to_string()
    return [left, right]

string choose_word(int seed, bool tail):
    if (tail):
        return make_words(seed)[-1]
    return make_words(seed)[0]

string echo_word(string word):
    return word

string borrowed_first(string[] words):
    return words[0]

int main(string[] args):
    int seed = args.length() + 4
    print(make_words(seed)[0])
    print(make_words(seed)[-1])
    print(['literal-left', 'literal-tail'][-1])
    print(make_words(seed + 1)[0:][-1])
    print(make_words(seed + 2).copy()[0])
    print(('split-left,split-tail').split(',')[1])
    string returned = choose_word(seed + 3, args.length() > 1)
    print(returned)
    print(choose_word(seed + 4, false))
    string local = make_words(seed + 5)[0]
    print(local)
    local = make_words(seed + 6)[-1]
    print(local)
    const string fixed = make_words(seed + 7)[0]
    print(fixed)
    string[] destination = ['slot-old']
    destination[0] = make_words(seed + 8)[0]
    print(destination[0])
    string[] pushed = []
    pushed.push(make_words(seed + 9)[-1])
    print(pushed[0])
    destination[0] = make_words(seed + 10)[-1]
    print(destination[0])
    WordBox box = WordBox(make_words(seed + 11)[0])
    print(box.text)
    box.text = make_words(seed + 12)[-1]
    print(box.text)
    print(echo_word(make_words(seed + 13)[0]))
    print(make_words(seed + 14)[0] + '-joined')
    print(make_words(seed + 15)[-1].length())
    string[] named = make_words(seed + 16)
    print(named[0])
    named.clear()
    named.push('named-reused')
    print(named[0])
    const string[] constant_words = make_words(seed + 17)
    print(constant_words[-1])
    print(global_words[0])
    print(('line-left\nline-tail').split_lines()[0])
    string[] borrowed_words = make_words(seed + 23)
    print(borrowed_first(borrowed_words))
    print(borrowed_words[1])
    WordList shelf = WordList(make_words(seed + 24))
    print(shelf.words[0])
    print(shelf.words[1])
    string held = make_words(seed + 25)[0]
    print(held)
    print(held)
    int branch_value = 0
    if (args.length() > 1):
        branch_value = make_words(seed + 18)[0].length()
    else:
        branch_value = make_words(seed + 19)[-1].length()
    print(branch_value)
    int loop_total = 0
    for (int offset : range(2)):
        loop_total += make_words(seed + offset)[0].length()
    print(loop_total)
    switch (args.length()):
        case 1:
            print(make_words(seed + 20)[0])
        default:
            print(make_words(seed + 21)[-1])
    try:
        print(make_words(seed + 22)[0])
        throw 'caught-index'
    catch (exception err):
        print(err)
    return 0
