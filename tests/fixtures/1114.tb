import union_find;

int main():
    int[] parents = union_find_new(5)
    const int[][] edges = [[0, 2], [2, 4], [4, 0], [1, 1]]
    print(parents.union_find_union_all(edges))
    print(parents.union_find_component_count())
    print(parents.union_find_union_all(edges))
    int[][] empty = []
    print(parents.union_find_union_all(empty))
    try:
        int[][] bad_ids = [[1, 3], [4, 5]]
        print(parents.union_find_union_all(bad_ids))
    catch (exception error):
        print(error)
    print(parents.union_find_connected_readonly(1, 3))
    try:
        int[][] bad_shape = [[1, 3], [2]]
        print(parents.union_find_union_all(bad_shape))
    catch (exception error):
        print(error)
    print(parents.union_find_connected_readonly(1, 3))
    return 0
