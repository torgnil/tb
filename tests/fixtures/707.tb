enum Separator { MARK }

string join(const int[] values, string separator):
    return values.length().to_string() + separator

int main():
    print(join([], '!'))
    int[] numbers = [1, 2]
    print(join(numbers, '?'))
    print(join([], Separator.MARK))
    string[] words = ['a', 'b']
    print(join(words, '-'))
    print(words.join(':'))
    return 0
