num parse_decimal(string text):
    return to_num(text)

void show_decimal(string text):
    try:
        num value = parse_decimal(text)
        print(value.to_string())
    catch (exception error):
        print(error)
    return

string make_decimal():
    return '12' + '.50'

int main(string[] args):
    show_decimal('12.50')
    show_decimal('-0.25')
    show_decimal('+0003.040')
    show_decimal('.5')
    show_decimal('5.')
    show_decimal('-9223372036854775808')
    show_decimal('9223372036854775807')
    show_decimal('0.00000000000000000000')
    show_decimal('')
    show_decimal('.')
    show_decimal('--1')
    show_decimal('1.2.3')
    show_decimal(' 1')
    show_decimal('1e2')
    show_decimal('9223372036854775808')
    show_decimal('-9223372036854775809')
    num value = to_num(make_decimal())
    print(value + 0.25)
    return 0
