import module_private_record_a;

record Hidden(string label);
record Holder(Hidden item);

Hidden shared = Hidden('global')

Hidden echo(Hidden value):
    return value

int main():
    Hidden local = Hidden('caller')
    Holder holder = Holder(echo(local))
    print(holder.item.label)
    print(shared.label)
    print(private_record_a_value(4))
    return 0
