int main():
    string[] values = ['zebra', 'b' + 'ee', 'apple', 'b' + 'ee']
    values.sort()
    for (string value in values):
        print(value)
    print(values.length())
    values.clear()
    print(values.length())

    string[] empty = []
    empty.sort()
    print(empty.length())

    string[] one = ['only']
    one.sort()
    for (string value in one):
        print(value)
    return 0
