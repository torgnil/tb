import regex;

void show_program(Regex program, string text):
    print(regex_match(program, text))
    print(regex_contains(program, text))
    print(regex_find_start(program, text))
    RegexMatch match = regex_find(program, text)
    print(match.matched)
    print(match.start)
    print(match.end)
    RegexCapture capture = regex_find_captures(program, text)
    print(capture.matched)
    if (capture.matched):
        print(capture.starts.length())

int first_save(Regex program):
    for (int index = 0; index < program.operations.length(); index += 1):
        if (program.operations[index] == REGEX_NFA_SAVE):
            return index
    return -1

int main():
    Regex program = regex_compile('((a|b)+)')
    int save = first_save(program)
    show_program(program, 'ab')
    program.out2[save] = -1
    show_program(program, 'ab')
    program.out2[save] = 0
    show_program(program, 'ab')
    program.out1[save] = save
    show_program(program, 'ab')

    Regex cycle = Regex(true, 0, [12, 4], [0, -1], [0, -1], ['2', '1'])
    show_program(cycle, '')
    Regex forged = Regex(true, 0, [12, 12, 4], [1, 0, -1], [9, 10, -1], ['2', '3', '1'])
    show_program(forged, '')

    RegexCapture retained = regex_match_captures(regex_compile('((^)|a)+'), 'a')
    print(retained.matched)
    print(retained.starts[2])
    print(retained.ends[2])
    string[] fields = 'a,b'.split(regex_compile('(,)'))
    print(fields.length())
    print(fields[0])
    print(fields[1])
    return 0
