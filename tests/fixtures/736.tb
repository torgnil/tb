int main(string[] args):
    string source = ' abc '
    if (args.length() > 100):
        source = ' def '
    string trimmed = source.trim()
    string first = trimmed.substring(0, 1)
    string combined = trimmed + 'z'
    print(trimmed)
    print(first)
    print(combined)
    print(trimmed.substring(0, 0).length())
    print(source == ' abc ')
    return 0
