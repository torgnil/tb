import regex;

int main():
    Regex pattern = regex_compile('(a)?(b?)(c)')
    RegexCapture cap = pattern.regex_match_captures('c')
    for (int i = 0; i < 4; i += 1):
        print(cap.regex_group_matched(i))
        print('[' + cap.regex_group('c', i) + ']')
    print(cap.regex_group_matched(-1))
    print(cap.regex_group_matched(4))
    RegexCapture miss = pattern.regex_match_captures('z')
