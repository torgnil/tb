import regex;

int main():
    Regex pattern = regex_compile('(a)(b)')
    print(pattern.regex_replace_n('ab ab ab', 'X', 2))
    print(pattern.regex_replace_n('ab ab ab', '$2-$1', 2))
    print(pattern.regex_replace_n('ab ab', '$2$1', 0))
    print(pattern.regex_replace_n('ab ab', '$2$1', 9) == pattern.regex_replace('ab ab', '$2$1'))
    print(pattern.regex_replace_n('zz', '$1', 1))
    print(regex_compile('').regex_replace_n('abc', '.', 2))
    try:
        print(pattern.regex_replace_n('ab', 'X', -1))
    catch (exception error):
        print(error)
    return 0
