import process;

int main(string[] args):
    if (args.length() > 1):
        const string stderr_path = '/dev/stderr'
        write_all(stderr_path, 'first')
        stderr_path.write_all(' second\n')
        print('stdout')
        return 0

    ProcessResult piped = run_process([args[0], 'child'])
    print(piped.exit_code)
    print(piped.stdout.replace('\r\n', '\n') == 'stdout\n')
    print(piped.stderr.replace('\r\n', '\n') == 'first second\n')

    ProcessResult redirected = run_process(['python3', '-I', '-S', 'test-files/process_child.py', 'redirect-stderr', args[0], 'child'])
    print(redirected.exit_code)
    print(redirected.stdout.replace('\r\n', '\n') == 'stdout\n')
    print(read_file('stderr-capture.txt').replace('\r\n', '\n') == 'prefix:first second\n')

    ProcessResult closed = run_process(['python3', '-I', '-S', 'test-files/process_child.py', 'closed-stderr', args[0], 'child'])
    print(closed.exit_code)
    print(closed.stdout.replace('\r\n', '\n') == 'write_all: unable to write /dev/stderr\n')
    return 0
