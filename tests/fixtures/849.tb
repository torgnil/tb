num first_plus_half(int[] values):
    if (values[0] < 0):
        throw 'negative-value'
    return values[0] + 0.5

int main():
    thread_pool pool = thread_pool(1)
    int[] values = [3]
    future<num> first = pool.submit(first_plus_half, values)
    values[0] = 9
    print(first.await())
    print(first.await())
    int[] failing_values = [-1]
    future<num> failed = pool.submit(first_plus_half, failing_values)
    try:
        failed.await()
        print('missing failure')
    catch (exception error):
        print(error)
    return 0
