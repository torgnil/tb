int fail_if_negative(int value):
    if (value < 0):
        throw 'negative worker value'
    return value

int main(string[] args):
    thread_pool pool = thread_pool(2)

    future<int> recovered = pool.submit(int value -> {
        int result = 0
        try {
            int checked = fail_if_negative(value)
            result = checked
        } catch (exception ignored) {
            int fallback = 7
            result = fallback
        }
        return result
    }, 0 - 1)

    future<int> successful = pool.submit(int value -> {
        int result = 0
        try {
            int checked = fail_if_negative(value)
            result = checked
        } catch (string ignored) {
            result = 7
        }
        return result
    }, args.length() + 4)

    future<int> bool_parameter = pool.submit(bool enabled -> {
        int result = 0
        try {
            if (enabled) {
                result = 3
            } else {
                throw 'disabled'
            }
        } catch (exception ignored) {
            result = 9
        }
        return result
    }, args.length() == 1)

    future<bool> bool_recovered = pool.submit(int value -> {
        try {
            if (value > 0) {
                return true
            } else {
                throw 'not positive'
            }
        } catch (string ignored) {
            return false
        }
    }, 0 - 1)

    future<int> nested = pool.submit(int value -> {
        int result = 0
        try {
            try {
                result = fail_if_negative(value)
            } catch (exception inner) {
                throw 'reraised from inner catch'
            }
        } catch (string outer) {
            result = 11
        }
        return result
    }, 0 - 1)

    future<int> range_recovery = pool.submit(int count -> {
        int total = 0
        try {
            for (int i : range(count)) {
                if (i == 1) {
                    continue
                }
                if (i == 3) {
                    throw 'range stopped'
                }
                total += i
            }
        } catch (exception caught) {
            for (int j : range(3)) {
                total += 10
                if (j == 0) {
                    continue
                }
                if (j == 2) {
                    break
                }
            }
        }
        return total
    }, 5)

    future<int> loop_recovery = pool.submit(int count -> {
        int total = 0
        for (int i : range(count)) {
            try {
                if (i == 1 || i == 3) {
                    throw 'repeat catch'
                }
                total += i
            } catch (string ignored) {
                total += 10
                if (i == 1) {
                    continue
                }
                if (i == 3) {
                    break
                }
            }
        }
        return total
    }, 5)

    print(recovered.await())
    print(recovered.await())
    print(successful.await())
    print(bool_parameter.await())
    print(bool_recovered.await())
    print(bool_recovered.await())
    print(nested.await())
    print(range_recovery.await())
    print(loop_recovery.await())
    return 0
