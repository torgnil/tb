int word_length(const string[] words):
    return words[0].length()

int word_length_or_throw(const string[] words):
    if (words[0] == 'fail'):
        throw 'captured worker failed'
    return words[0].length()

int word_count(const string[] words):
    return words.length()

future<int> submit_scoped_word(thread_pool pool):
    string[] local_words = ['pear']
    return pool.submit(() -> word_length(local_words))

int main():
    thread_pool pool = thread_pool(1)
    string[] words = ['oak']
    future<int> first = pool.submit(() -> word_length(words))
    words[0] = 'longer'
    print(first.await())
    print(first.await())

    future<int> scoped = submit_scoped_word(pool)
    print(scoped.await())

    string[] empty = []
    future<int> empty_result = pool.submit(() -> word_count(empty))
    print(empty_result.await())

    const string[] fixed_words = ['fir']
    future<int> fixed_result = pool.submit(() -> word_length(fixed_words))
    print(fixed_result.await())

    string[] failing = ['fail']
    future<int> failure = pool.submit(() -> word_length_or_throw(failing))
    try:
        failure.await()
    catch (exception error):
        print(error)

    future<int> after_failure = pool.submit(() -> word_length(words))
    print(after_failure.await())
    return 0
