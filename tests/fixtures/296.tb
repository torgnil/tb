bool is_enabled(int value) {
    return value > 0;
}

int main(string[] args) {
    bool[] flags = [true, is_enabled(args.length() - 1), false];
    int true_count = 0;

    for (const bool flag : flags) {
        if (flag) {
            true_count += 1;
            print(true);
        } else {
            print(false);
        }
    }

    for (bool flag in flags) {
        flag = !flag;
        print(flag);
    }

    print(flags[0]);
    print(flags[1]);
    print(flags[2]);
    print(true_count);

    const bool[] empty_flags = [];
    int empty_count = 0;
    for (bool empty_flag : empty_flags) {
        empty_count += 1;
    }
    print(empty_count);
    return 0;
}
