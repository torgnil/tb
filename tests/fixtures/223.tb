record Box(int[] values, bool[] flags);
record Cell(int value);

int[] make_row(int seed):
    return [seed, seed + 1]

int main(string[] args):
    int n = args.length()
    const int fixed = n + 1
    const bool enabled = n > 0
    Box box = Box([], [])
    box.values = [n, fixed]
    box.flags = [false, enabled]
    print(box.values[0])
    print(box.values[1])
    print(box.flags[1])

    int[] local_values = [n, fixed]
    print(local_values[1])
    int[] made = make_row(n + 5)
    box.values = made
    made[0] = 99
    print(box.values[0])
    Box copied = box
    copied.values[0] = 91
    print(box.values[0])

    const string key = 'key-' + n
    const string text = 'text-' + n
    map<string, int> first = {key: fixed}
    map<string, int> second = {'other': n}
    print(first[key])
    print(second['other'])

    const int fixed_key = n + 2
    map<int, int> integer_keys = {fixed_key: n, n: fixed}
    print(integer_keys[fixed_key])

    const int[] row = [n + 2]
    map<int, int[]> rows = {n: row}
    rows[n][0] = 90
    print(row[0])
    print(rows[n][0])

    const string[] group = [text]
    string[][] groups = [group, [text]]
    groups[0][0] = 'changed'
    print(group[0])
    print(groups[1][0])

    const Cell cell = Cell(n + 3)
    Cell[] cells = [cell, Cell(n + 4)]
    cells[0].value = 92
    print(cell.value)
    print(cells[1].value)

    set<int> seen = {fixed, n}
    print(seen.contains(n))
    return 0
