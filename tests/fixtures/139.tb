record Visit(string name, string[] words, int count);

void visit(int n, string source, string[] borrowed, Visit holder):
    string text = source.substring(0)
    const string fixed_text = source.substring(0)
    string[] words = [text]
    const string[] fixed_words = [fixed_text]
    int[][] grid = [[n, n + 1]]
    const int[][] fixed_grid = [[n + 2]]
    map<int, int> counts = {n: n * 3}
    const map<int, int> fixed_counts = {n: n * 4}
    Visit local = Visit(text, words, n)
    const Visit fixed_local = Visit(fixed_text, fixed_words, n + 1)
    print(local.name)
    print(fixed_local.words[0])
    int fixed_value = fixed_grid[0][0]
    print(grid[0][1] + fixed_value)
    print(counts[n] + fixed_counts[n])
    if (n % 2 == 0):
        const string even_branch = source.substring(0)
        print(even_branch)
    else:
        string odd_branch = source.substring(0)
        print(odd_branch)
    int i = 0
    while (i < 2):
        const string loop_text = source.substring(0)
        print(loop_text)
        i += 1
    switch (n % 2):
        case 0:
            string even_switch = source.substring(0)
            print(even_switch)
        default:
            const string odd_switch = source.substring(0)
            print(odd_switch)
    try:
        throw 'caught'
    catch (exception err):
        print(err)
        print(text)
        print(words[0])
    holder.count += 1
    print(borrowed[0])

void early_or_end(int n, string source):
    const string text = source.substring(0)
    if (n % 2 == 0):
        print(text)
        return
    print(text)

int main(string[] args):
    int n = args.length() + 4
    string source = 'visit-' + n.to_string()
    string[] words = [source]
    Visit holder = Visit(source, words, n)
    visit(n, source, words, holder)
    visit(n + 1, source, words, holder)
    early_or_end(n, source)
    early_or_end(n + 1, source)
    print(source)
    print(words[0])
    print(holder.name)
    print(holder.words[0])
    print(holder.count)
    return 0
