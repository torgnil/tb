void fail():
    throw 'failure'

void borrowed_only(string label, int[] values):
    print(label)
    print(values[0])
    fail()

void replace_parameter(string text):
    text = 'replacement'
    fail()

void replace_array(bool[][] values):
    values = [[true]]
    fail()

int main():
    string message = 'original'
    int[] numbers = [7]
    bool[][] flags = [[false]]
    try:
        borrowed_only(message, numbers)
    catch (exception error):
        print(error)
    print(message)
    print(numbers[0])
    try:
        replace_parameter(message)
    catch (exception error):
        print(error)
    print(message)
    try:
        replace_array(flags)
    catch (exception error):
        print(error)
    print(flags[0][0])
    return 0
