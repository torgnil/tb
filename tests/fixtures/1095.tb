import random;

int main():
    RandomGenerator rng = seeded_random(42)
    print(rng.random_sample_indices(0, 0).length())
    print(rng.state)
    try:
        int[] invalid = rng.random_sample_indices(3, 4)
        print(invalid.length())
    catch (exception error):
        print(error)
    print(rng.state)
    int[] singleton = rng.random_sample_indices(1, 1)
    print(singleton[0])
    print(rng.state)
    int[] sample = rng.random_sample_indices(6, 6)
    for (int item in sample):
        print(item)
    print(rng.state)
    return 0
