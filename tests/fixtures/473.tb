bool[][] make_flag_rows():
    map<int[], bool[]> source = {}
    source[[8]] = [true, true]
    return source.values()

int main():
    map<int[], bool[]> flags = {}
    print(flags.values().length())
    flags[[2]] = [true, false]
    flags[[1]] = [false, true]
    bool[][] rows = flags.values()
    print(rows.length())
    print(rows[0][0])
    rows[0][0] = false
    print(rows[0][0])
    print(flags[[2]][0])
    flags[[2]] = [false, false]
    print(rows[0][0])
    bool[][] updated = flags.values()
    print(updated[0][0])
    bool[][] returned = make_flag_rows()
    print(returned[0][1])
    returned[0][1] = false
    print(returned[0][1])
    return 0
