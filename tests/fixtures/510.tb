int evaluation_order = 0
int lower_calls = 0
int upper_calls = 0

int lower_bound():
    lower_calls += 1
    evaluation_order = evaluation_order * 10 + 1
    return -5

int upper_bound():
    upper_calls += 1
    evaluation_order = evaluation_order * 10 + 2
    return 5

int main(string[] args):
    int value = random(lower_bound(), upper_bound())
    print(evaluation_order)
    print(lower_calls)
    print(upper_calls)
    print(value >= -5 && value < 5)
    return 0
