int main():
    int[] values = [3, -1, 3, 0, -10]
    values = values.sort()
    print(values)

    int[] empty = []
    empty.sort()
    print(empty.length())

    int[] one = [42]
    one.sort()
    print(one)

    string[] words = ['zebra', 'apple', 'mid']
    words = words.sort()
    for (string word in words):
        print(word)
    return 0
