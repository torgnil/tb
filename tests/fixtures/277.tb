record Item(int value);

int sum_values(int[] values):
    return values.sum()

int count_flags(bool[] flags):
    return flags.length()

int first_word_length(string[] words):
    return words[0].length()

int first_row_value(int[][] rows):
    return rows[0][0]

int first_item_value(Item[] items):
    return items[0].value

int count_words(string[] words):
    return words.length()

int count_rows(int[][] rows):
    return rows.length()

int combine_lengths(int[] values, int[] other):
    return values.length() + other.length()

void observe_values(int[] values):
    print(values.length())

int[] make_values():
    return [5, 6]

int main(string[] args):
    int[] values = [4, 5]
    const int[] fixed_values = [6, 7]
    bool[] flags = [true, false]
    string[] words = ['tb']
    int[][] rows = [[8]]
    Item[] items = [Item(9)]
    int[] empty_values = []
    string[] empty_words = []
    int[][] empty_rows = []

    print(sum_values(values))
    print(sum_values(fixed_values))
    print(sum_values(make_values()))
    print(count_flags(flags))
    print(first_word_length(words))
    print(first_row_value(rows))
    print(first_item_value(items))
    print(values.combine_lengths(fixed_values))
    print(sum_values(empty_values))
    print(count_words(empty_words))
    print(count_rows(empty_rows))
    observe_values(values)
    return 0
