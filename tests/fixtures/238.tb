

# Case 1
int[] length(bool flag):
    if flag:
        return [5, 6]
    return [8, 9]

bool[] is_empty(bool flag):
    if flag:
        return [true, false]
    return [false, false]

string[] index_of(bool flag):
    if flag:
        return ['left', 'right']
    return ['up', 'down']

int[][] hash(bool flag):
    if flag:
        return [[3], [4, 5]]
    return [[6, 7], [8, 9]]

int[] echo_values(int[] values):
    return values

int combined_case_1_main(string[] args):
    bool flag = args.length() == 1
    int[] first = flag.length()
    print(first.sum())
    print(sum(echo_values(flag.length())))
    int total = 0
    for (int value : flag.length()):
        total += value
    print(total)
    bool[] flags = flag.is_empty()
    print(flags.length())
    print(flags.sum())
    string[] words = flag.index_of()
    print(words[0])
    print(words.length())
    int[][] grid = flag.hash()
    print(grid[1].sum())
    print(flag.hash().length())
    return 0

# Case 2
record Counter(int value);

const int GLOBAL_MASK = 45 & 15
int global_shift = 3 << 2
int effect_calls = 0

int counted_shift():
    effect_calls += 1
    return 1

int compute(const int value):
    return ((value % 5) << 1) ^ 3

int combined_case_2_main(string[] args):
    int seed = args.length()
    print(GLOBAL_MASK)
    print(global_shift)
    print(compute(seed + 6))

    const int mask = 6
    print(mask & 3)
    print(29 % 6)
    print(12 & 10)
    print(12 | 10)
    print(12 ^ 10)
    print(3 << seed)
    print(3 >> 0)
    print(-32 >> seed)
    print(-5 % 3)
    print(1 << 63)
    print(1 << 64)
    print(-1 >> 65)

    int local = 63
    local %= 10
    local |= 8
    local ^= 3
    local &= 7
    local <<= 2
    local >>= 1
    print(local)

    int[] values = [33]
    values[0] >>= 1
    print(values[0])

    Counter counter = Counter(64)
    counter.value %= 10
    print(counter.value)

    int before_calls = effect_calls
    local = 3
    local <<= counted_shift()
    print(local)
    print(effect_calls - before_calls)

    int branch_value = 0
    if (seed == 1):
        branch_value = 7 ^ 3
    else:
        branch_value = 9 & 5
    for (int index : range(3)):
        branch_value += index
    print(branch_value)

    print(true && false)
    print(1.50 + 0.25)
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main(args) != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main(args) != 0):
        return 1
    return 0
