string helper_label(int value):
    return 'item-' + value

string visit_text(int[] trace, int marker, string text):
    trace.push(marker)
    return text

bool owned_order(int value):
    return helper_label(value) < ('item-z' + '')

int main(string[] args):
    int seed = args.length()
    const string first = 'alpha'
    const string last = 'omega'
    const string dynamic_text = helper_label(seed)
    string reused = 'middle'
    int[] trace = []

    print('a' < 'b')
    print('b' < 'a')
    print('a' <= 'a')
    print('b' > 'a')
    print('b' >= 'b')
    print('' < 'a')
    print('A' < 'a')
    print(helper_label(seed) < 'item-z')
    print(owned_order(seed))
    print(('pre-' + seed) >= 'pre-0')
    print(first < last)
    print(dynamic_text < 'item-z')
    print('a' < reused)
    print(reused)

    bool ordered_once = visit_text(trace, 1, 'b') < visit_text(trace, 2, 'c')
    print(ordered_once)
    print(trace.length())
    print(trace[0])
    print(trace[1])
    bool skipped = false && (visit_text(trace, 3, 'z') < visit_text(trace, 4, 'a'))
    print(skipped)
    print(trace.length())

    int branch_value = 0
    if ('a' < 'b') {
        branch_value = 7
    } else {
        branch_value = 9
    }
    print(branch_value)

    int less_count = 0
    for (int index : range(3)) {
        if (('a' + index) < 'c') {
            less_count += 1
        }
    }
    print(less_count)
    print('same' == 'same')
    print(2 < 3)
    print(1.2 < 1.3)
    print(seed)
    return 0
