record Item(string name, int value);

int main():
    Item[] items = []
    Item borrowed = Item('borrowed', 1)
    items.push(borrowed)
    borrowed.name = 'changed'
    items.push(Item('owned', 2))

    int value = 0
    while (value < 10):
        items.push(Item('item', value))
        value += 1

    print(items.length())
    print(items[0].name)
    print(items[0].value)
    print(items[1].name)
    print(items[11].value)
    return 0
