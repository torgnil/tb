map<int[], int> integer_labels():
    return {[1]: 9}

string mutate_literal_key(int[] key):
    key[0] = 31
    return 'snapshotted literal key'

int main():
    map<int[], string> labels = {[1, 2]: 'north', []: '', [1, 2]: 'N'}
    print(labels.length())
    print(labels[[1, 2]])
    print(labels.contains([]))
    print(labels.contains([9]))

    string[] values = labels.values()
    print(values.length())
    print(values[0])
    print(values[1].length())
    int[][] keys = labels.keys()
    print(keys.length())
    print(keys[0].length())
    print(keys[0][0])
    print(keys[1].length())

    const map<int[], string> fixed = {[4]: 'fixed'}
    print(fixed[[4]])
    print(fixed.values()[0])

    map<int[], string> empty = {}
    print(empty.length())
    print(empty.values().length())
    print(empty.contains([]))

    for (int index : range(0, 12)):
        labels[[index + 20]] = 'item-' + index
    print(labels.length())
    print(labels[[31]])

    int[] mutable_literal_key = [30]
    map<int[], string> literal_snapshot = {mutable_literal_key: mutate_literal_key(mutable_literal_key)}
    print(literal_snapshot[[30]])
    print(literal_snapshot.contains([31]))

    map<int[], int> integers = integer_labels()
    print(integers[[1]])
    print(integers.values()[0])
    return 0
