record LocalSetBox(set<int> values);

set<int> local_global = {40, 41}

set<int> make_local_set(int seed):
    return {seed, seed + 1}

set<int> copy_parameter(const set<int> values):
    set<int> local = values
    local.add(90)
    print(values.contains(90))
    local = make_local_set(90)
    print(values.contains(21))
    return local

void replace_local_from_global():
    set<int> local = local_global
    local = make_local_set(94)
    print(local_global.contains(40))

set<int> choose_local_or_parameter(bool choose_local, const set<int> source, int seed):
    if (choose_local):
        set<int> local = {seed, seed + 1}
        return local
    else:
        return source

int main(string[] args):
    int seed = args.length() + 10
    set<int> source = {seed, seed + 1}
    set<int> copy = source
    print(source.contains(seed))
    print(copy.contains(seed + 1))
    source.add(99)
    print(copy.contains(99))
    copy.add(100)
    print(source.contains(100))

    const set<int> fixed = {20, 21}
    set<int> const_copy = fixed
    print(const_copy.contains(20))
    set<int> param_copy = copy_parameter(fixed)
    print(param_copy.contains(90))
    print(fixed.contains(90))

    set<int> target = {1}
    set<int> replacement = {seed, seed + 1}
    target = replacement
    replacement.add(77)
    print(target.contains(seed))
    print(target.contains(77))
    target.add(78)
    print(replacement.contains(78))
    target = target
    print(target.contains(seed))
    target = make_local_set(seed + 2)
    print(target.contains(seed + 2))
    print(target.contains(seed))

    LocalSetBox box = LocalSetBox({seed + 4, seed + 5})
    set<int> field_copy = box.values
    print(field_copy.contains(seed + 4))
    box.values.add(91)
    print(field_copy.contains(91))

    set<int> global_copy = local_global
    print(global_copy.contains(40))
    global_copy.add(42)
    print(local_global.contains(42))
    replace_local_from_global()

    set<int> shadowed = {50, 51}
    if (args.length() >= 1):
        set<int> shadowed = {60, 61}
        set<int> branch_copy = shadowed
        shadowed.add(92)
        print(branch_copy.contains(92))
    print(shadowed.contains(50))

    set<int> branch_source = {30, 31}
    set<int> borrowed_branch = choose_local_or_parameter(false, branch_source, seed)
    print(borrowed_branch.contains(31))
    borrowed_branch.add(93)
    print(branch_source.contains(93))
    set<int> owned_branch = choose_local_or_parameter(true, branch_source, seed + 4)
    print(owned_branch.contains(seed + 4))

    set<int> empty = {}
    set<int> empty_copy = empty
    print(empty_copy.length())
    set<int> duplicates = {seed, seed, seed + 1}
    set<int> duplicate_copy = duplicates
    print(duplicate_copy.length())

    for (int index : range(2)):
        set<int> loop_source = {index, index + 1}
        set<int> loop_copy = loop_source
        loop_source.add(99)
        print(loop_copy.contains(index))
    return 0
