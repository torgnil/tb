

# Case 1
int EFFECT_COUNT = 0

const map<int, map<int, string>> GLOBAL_GROUPS = {
    -4: {1: 'global-old'},
    0: {0: 'zero'},
    -4: {1: 'global-new', 2: 'kept'}
}

record GroupBox(map<int, map<int, string>> groups);

map<int, string> make_inner(int seed):
    return {seed: 'old-' + seed.to_string(), seed + 1: 'middle-' + seed.to_string(), seed: 'new-' + seed.to_string()}

map<int, map<int, string>> make_groups(int key, int seed):
    return {key: make_inner(seed), key + 1: make_inner(seed + 1), key: make_inner(seed + 2)}

int next_key():
    EFFECT_COUNT += 1
    return 77

map<int, string> next_inner():
    EFFECT_COUNT += 1
    return {EFFECT_COUNT: 'effect-' + EFFECT_COUNT.to_string()}

int combined_case_1_main(string[] args):
    int n = args.length()
    int base = 20 + n * 10
    string token = n.to_string()

    print(GLOBAL_GROUPS.length())
    print(GLOBAL_GROUPS.keys()[0])
    print(GLOBAL_GROUPS[-4][1])
    print(GLOBAL_GROUPS[-4][2])

    map<int, string> shared = {n: 'shared-' + token, n + 1: 'second-' + token}
    map<int, map<int, string>> runtime = {
        -base: shared,
        base + 2: {n: 'middle-' + token},
        base: {n: 'first-' + token},
        -base: {n: 'last-' + token, n + 1: 'last-second-' + token}
    }
    string[] runtime_keys = runtime.keys()
    print(runtime.length())
    print(runtime_keys[0])
    print(runtime_keys[1])
    print(runtime_keys[2])
    print(runtime[-base][n])
    print(runtime[-base][n + 1])
    shared[n] = 'changed-' + token
    print(shared[n])
    print(runtime[-base][n])

    map<int, map<string, int>> string_key_inner = {
        base: {'left-' + token: n, 'right-' + token: n + 1},
        base + 1: {'other-' + token: n + 2},
        base: {'left-' + token: n + 10, 'last-' + token: n + 11}
    }
    print(string_key_inner.length())
    print(string_key_inner[base]['left-' + token])
    print(string_key_inner[base]['last-' + token])

    const map<int, map<int, string>> fixed = {
        base: {1: 'const-old'},
        base + 1: {2: 'const-only'},
        base: {1: 'const-new'}
    }
    print(fixed.length())
    print(fixed[base][1])
    print(fixed[base + 1][2])

    map<int, map<int, string>> copied = runtime
    copied[-base][n] = 'copy-' + token
    print(runtime[-base][n])
    print(copied[-base][n])

    map<int, string> empty_inner = {}
    map<int, map<int, string>> empty_to_full = {
        base + 3: empty_inner,
        base + 4: {n: 'other-' + token},
        base + 3: {n: 'filled-' + token}
    }
    map<int, map<int, string>> full_to_empty = {
        base + 5: {n: 'removed-' + token},
        base + 6: {n: 'kept-' + token},
        base + 5: empty_inner
    }
    print(empty_to_full.length())
    print(empty_to_full[base + 3][n])
    print(full_to_empty.length())
    print(full_to_empty[base + 5].length())
    print(full_to_empty[base + 6][n])

    map<int, map<int, string>> calls = {
        base + 7: make_inner(base),
        base + 8: make_inner(base + 1),
        base + 7: make_inner(base + 2)
    }
    print(calls.length())
    print(calls[base + 7][base + 2])
    print(calls[base + 8][base + 1])

    map<int, map<int, string>> returned = make_groups(base + 9, base + 10)
    print(returned.length())
    print(returned[base + 9][base + 12])
    print(returned[base + 10][base + 11])

    GroupBox box = GroupBox({base + 11: {n: 'box-old'}, base + 12: {n: 'box-only'}, base + 11: {n: 'box-new'}})
    GroupBox clone = box
    clone.groups[base + 11][n] = 'clone-' + token
    print(box.groups.length())
    print(box.groups[base + 11][n])
    print(clone.groups[base + 11][n])

    map<int, map<int, map<string, string>>> deep = {
        base + 13: {n: {'leaf-' + token: 'deep-old'}},
        base + 14: {n: {'other-' + token: 'other'}},
        base + 13: {n: {'leaf-' + token: 'deep-new'}}
    }
    print(deep.length())
    print(deep[base + 13][n]['leaf-' + token])

    if (n > 0):
        map<int, map<int, string>> branched = {base + 15: {n: 'branch-old'}, base + 16: {n: 'branch'}, base + 15: {n: 'branch-new'}}
        print(branched.length())
        print(branched[base + 15][n])
    for (int i : range(2)):
        map<int, map<int, string>> looped = {base + 17 + i: {n: 'loop-old'}, base + 18 + i: {n: 'loop-middle'}, base + 17 + i: {n: 'loop-new'}}
        print(looped.length())
        print(looped[base + 17 + i][n])

    map<int, map<int, string>> effects = {next_key(): next_inner(), next_key(): next_inner(), next_key(): next_inner()}
    print(EFFECT_COUNT)
    print(effects.length())
    print(effects[77][6])

    map<int, map<int, string>> empty = {}
    map<int, map<int, string>> unique = {-1: {n: 'negative'}, 0: {n: 'zero'}, base + 19: {n: 'runtime-' + token}}
    print(empty.length())
    print(unique.length())
    print(unique[-1][n])
    print(unique[base + 19][n])
    return 0

# Case 2
int[] GLOBAL_SEARCH_INTS = [31, 32, 32]
bool[] GLOBAL_SEARCH_FLAGS = [true, false, true]
string[] GLOBAL_SEARCH_WORDS = ['global', 'global', 'tail']

record SearchFields(int[] ints, bool[] flags, string[] words);

int[] make_search_ints(int seed):
    return [seed, seed + 1, seed + 1]

bool[] make_search_flags(int seed):
    return [seed > 1, false, seed > 1]

string[] make_search_words(int seed):
    string word = 'word-' + seed.to_string()
    return [word, word, 'tail-' + seed.to_string()]

int[] make_empty_search_ints(int seed):
    return []

bool[] make_empty_search_flags(int seed):
    return []

string[] make_empty_search_words(int seed):
    return []

bool contains(bool value):
    return value

bool search_from_return(int seed):
    if (seed > 1):
        return 'word-' + seed.to_string() in make_search_words(seed)
    return 'absent' not in make_search_words(seed)

int combined_case_2_main(string[] args):
    int argc = args.length()
    print(args.length() == argc)
    int seed = argc + 4
    string needle = 'word-' + seed.to_string()

    print(contains(make_search_ints(seed), seed + 1))
    print(make_search_ints(seed).contains(seed + 1))
    print(index_of(make_search_ints(seed), seed + 1))
    print(make_search_ints(seed).index_of(seed + 1))
    print((seed + 1) in make_search_ints(seed))
    print((seed + 8) not in make_search_ints(seed))

    print(contains(make_search_flags(seed), seed > 1))
    print(make_search_flags(seed).contains(seed > 1))
    print(index_of(make_search_flags(seed), seed > 1))
    print(make_search_flags(seed).index_of(seed > 1))
    print((seed > 1) in make_search_flags(seed))
    print((seed + 1 < 0) not in make_search_flags(seed))

    print(contains(make_search_words(seed), needle))
    print(make_search_words(seed).contains(needle))
    print(index_of(make_search_words(seed), needle))
    print(make_search_words(seed).index_of(needle))
    print(needle in make_search_words(seed))
    print('missing' not in make_search_words(seed))
    print(needle)

    print(contains([seed, seed], seed))
    print(make_search_ints(seed)[1:].index_of(seed + 1))
    print(make_search_ints(seed).copy().contains(seed + 1))
    print(seed not in make_empty_search_ints(seed))
    print(contains([seed > 1, false], seed > 1))
    print(make_search_flags(seed)[1:].index_of(false))
    print(make_search_flags(seed).copy().contains(seed > 1))
    print((seed > 1) not in make_empty_search_flags(seed))
    print(contains([needle, needle], needle))
    print(make_search_words(seed)[1:].index_of('tail-' + seed.to_string()))
    print(make_search_words(seed).copy().contains(needle))
    print(needle not in make_empty_search_words(seed))

    int[] ints = [seed, seed + 1, seed + 1]
    bool[] flags = [seed > 1, false, seed > 1]
    string[] words = [needle, needle, 'tail']
    const int[] frozen_ints = [seed + 1, seed + 2]
    const bool[] frozen_flags = [false, seed > 1]
    const string[] frozen_words = [needle, 'frozen']
    print(ints.contains(seed + 1))
    print(ints.index_of(seed + 1))
    print(frozen_ints.contains(seed + 2))
    print(flags.index_of(false))
    print(frozen_flags.contains(seed > 1))
    print(words.index_of(needle))
    print(frozen_words.contains(needle))

    SearchFields fields = SearchFields([seed, seed + 1], [false, seed > 1], [needle, 'field-tail'])
    print(fields.ints.contains(seed + 1))
    print(fields.flags.index_of(false))
    print(fields.words.contains(needle))
    print(GLOBAL_SEARCH_INTS.index_of(32))
    print(GLOBAL_SEARCH_FLAGS.contains(true))
    print(GLOBAL_SEARCH_WORDS.index_of('global'))

    int result = 0
    int turn = 0
    while (turn < 3):
        if (turn == 1):
            result += make_search_ints(seed).index_of(seed + 1)
        else:
            if (make_search_flags(seed).contains(seed > 1)):
                result += 1
        turn += 1
    print(result)
    print(search_from_return(seed))

    string later = needle
    print(make_search_words(seed).contains(later))
    print(later)
    print(ints.index_of(seed + 1))
    print(contains(seed > 0))
    print(make_empty_search_ints(seed).index_of(seed))
    print(make_empty_search_flags(seed).contains(true))
    print(make_empty_search_words(seed).index_of(needle))
    print(make_search_ints(seed).contains(seed + 20))
    print(make_search_words(seed).index_of('absent'))
    print(search_from_return(argc - argc))
    return 0

# Case 3
record PopBox(string[] words, int[][] rows);

string[][] global_rows = [['global-left', 'global-right']];

bool[] make_flags(int seed):
    return [seed > 0, seed == 0]

string[] make_words(int seed):
    string token = seed.to_string()
    return ['managed-' + token, 'tail-' + token]

int[][] make_rows(int seed):
    return [[seed, seed + 1], [seed + 2]]

string[][] make_string_rows(int seed):
    string token = seed.to_string()
    return [['row-' + token, 'alias-' + token], ['last-' + token]]

int[] return_int_pop(int seed):
    return make_rows(seed).pop()

string[] return_string_row_pop(int seed):
    return make_string_rows(seed).pop()

string return_string_pop(int seed):
    return make_words(seed).pop()

int combined_case_3_main(string[] args):
    int argc = args.length()
    int seed = argc + 5
    print(argc)

    print(pop([true, false]))
    print([false, true].pop())
    print(pop(make_flags(seed)[0:]))
    print(make_flags(seed).copy().pop())

    bool[] borrowed_flags = [true, false]
    print(borrowed_flags.pop())
    print(borrowed_flags.length())

    string popped_direct = pop(['direct-' + seed.to_string(), 'direct-tail'])
    string popped_ufcs = ['ufcs-' + seed.to_string(), 'ufcs-tail'].pop()
    string popped_slice = make_words(seed)[0:2].pop()
    string popped_copy = make_words(seed).copy().pop()
    print(popped_direct)
    print(popped_ufcs)
    print(popped_slice)
    print(popped_copy)

    string[] borrowed_words = ['borrowed-first', 'borrowed-last']
    string borrowed_pop = borrowed_words.pop()
    print(borrowed_pop)
    print(borrowed_words.length())
    borrowed_words.push('reused-last')
    print(borrowed_words.pop())

    int[] direct_row = pop([[seed, seed + 1], [seed + 2]])
    int[] ufcs_row = [[seed + 3], [seed + 4, seed + 5]].pop()
    int[] slice_row = make_rows(seed + 6)[0:].pop()
    int[] copied_row = make_rows(seed + 7).copy().pop()
    print(direct_row[0])
    print(ufcs_row[0])
    print(slice_row[0])
    print(copied_row[0])
    direct_row[0] = 900
    print(direct_row[0])

    string[] direct_string_row = pop([['direct-row', 'direct-tail'], ['direct-last']])
    string[] ufcs_string_row = [['ufcs-row', 'ufcs-tail'], ['ufcs-last']].pop()
    string[] slice_string_row = make_string_rows(seed)[0:].pop()
    string[] copied_string_row = make_string_rows(seed + 1).copy().pop()
    print(direct_string_row[0])
    print(ufcs_string_row[0])
    print(slice_string_row[0])
    print(copied_string_row[0])
    slice_string_row[0] = 'changed-row'
    print(slice_string_row[0])

    int[] returned_int_row = return_int_pop(seed + 10)
    string[] returned_string_row = return_string_row_pop(seed + 11)
    string returned_string = return_string_pop(seed + 12)
    print(returned_int_row[0])
    print(returned_string_row[0])
    print(returned_string)

    int[][] reused_rows = make_rows(seed + 13)
    int[] reused_row = reused_rows.pop()
    print(reused_row[0])
    print(reused_rows.length())

    int[] borrowed_row = [seed + 14, seed + 15]
    int[][] borrowed_rows = [borrowed_row]
    int[] borrowed_popped_row = borrowed_rows.pop()
    borrowed_popped_row[0] = 901
    print(borrowed_row[0])
    print(borrowed_popped_row[0])

    PopBox box = PopBox(['field-first', 'field-last'], [[seed + 16], [seed + 17]])
    print(box.words.pop())
    int[] field_row = box.rows.pop()
    print(field_row[0])
    print(box.rows.length())

    print(global_rows.pop()[0])
    print(global_rows.length())

    bool[] empty_flags = []
    string[] empty_words = []
    int[][] empty_rows = []
    string[][] empty_string_rows = []
    print(pop(empty_flags))
    print(empty_flags.length())
    print(empty_words.pop().length())
    print(empty_words.length())
    print(empty_rows.pop().is_empty())
    print(empty_string_rows.pop().is_empty())
    int[] selected_empty_row = []
    int[][] selected_empty_rows = [[seed], selected_empty_row]
    print(selected_empty_rows.pop().is_empty())
    print(empty_flags.copy().pop())
    print(empty_words.copy().pop().length())
    print(empty_rows.copy().pop().is_empty())
    print(empty_string_rows.copy().pop().is_empty())

    for (int offset : range(2)):
        print(make_flags(seed + offset).pop())
        print(make_words(seed + offset).pop())
        print(make_rows(seed + offset).pop()[0])
        print(make_string_rows(seed + offset).pop()[0])
    return 0

# Case 4
record IntBox(int[] values);

int[] global_values = [70, 71];

int[] make_values(int seed):
    return [seed, seed + 1]

int[] make_empty_values():
    return []

int pop_borrowed(int[] values):
    return values.pop()

int combined_case_4_main(string[] args):
    int argc = args.length()
    int seed = argc + 4
    print(argc)
    print(make_values(seed).pop())
    print([seed + 2, seed + 3].pop())
    print(range(seed, seed + 2).pop())
    print(make_values(seed + 4)[0:].pop())
    print(make_values(seed + 6).copy().pop())
    print(make_empty_values().pop())
    for (int offset : range(2)):
        if (offset == 0):
            print(make_values(seed + 8 + offset).pop())
        else:
            print(make_values(seed + 8 + offset).pop())
    int[] named = make_values(seed + 10)
    print(named.pop())
    print(named.length())
    named.push(seed + 12)
    print(named.pop())
    int[] borrowed = make_values(seed + 13)
    print(pop_borrowed(borrowed))
    print(borrowed.length())
    borrowed.push(seed + 15)
    print(borrowed.pop())
    const int[] copied = make_values(seed + 16).copy()
    int[] mutable_copy = copied.copy()
    print(mutable_copy.pop())
    print(copied.length())
    print(global_values.pop())
    print(global_values.length())
    IntBox box = IntBox(make_values(seed + 17))
    print(box.values.pop())
    print(box.values.length())
    int[] loop_values = make_values(seed + 18)
    for (int i : range(2)):
        if (i == 0):
            print(loop_values.pop())
        else:
            print(loop_values.pop())
    print(loop_values.length())
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main(args) != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main(args) != 0):
        return 1
    print('=== case 3 ===')
    if (combined_case_3_main(args) != 0):
        return 1
    print('=== case 4 ===')
    if (combined_case_4_main(args) != 0):
        return 1
    return 0
