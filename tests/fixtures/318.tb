enum Mode {
    READY,
    DONE
}

record Box(int value);

int echo_int(const int value):
    return value

bool choose(bool value):
    if (value):
        return true
    return false

string decorate(string value):
    return value + '!'

int[] empty_ints():
    return []

num keep_num(num value):
    return value

Mode keep_mode(Mode value):
    return value

cached int cached_value(int value):
    return value * 2

string try_return(bool should_throw):
    try:
        if (should_throw):
            throw 'caught'
        return 'try'
    catch (exception error):
        return error

map<int, string[]> rows():
    return {1: [], 2: ['row']}

Box echo_box(Box value):
    return value

int main(string[] args):
    print(echo_int(7))
    print(choose(true))
    print(decorate('return'))
    print(keep_num(1.25))
    print(cached_value(3))
    print(try_return(false))
    print(try_return(true))
    int[] values = empty_ints()
    print(values.length())
    map<int, string[]> result = rows()
    print(result[1].length())
    print(result[2][0])
    Box box = echo_box(Box(9))
    print(box.value)
    return 0
