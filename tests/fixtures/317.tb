

# Case 1
int count_true(const bool[] flags):
    return flags.sum()

int combined_case_1_main(string[] args):
    bool[] empty = []
    bool[] empty_copy = empty.copy()
    bool[] empty_slice = empty[0:0]
    print(empty.length())
    print(empty_copy.length())
    print(empty_slice.length())

    bool[] initialized = [args.length() > 0, false]
    print(initialized.length())
    print(initialized[0])
    print(initialized[1])

    empty.push(true)
    empty.insert(-9, false)
    empty.insert(99, true)
    empty.insert(1, false)
    print(empty.length())
    print(empty[0])
    print(empty[1])
    print(empty[2])
    print(empty[3])
    print(count_true(empty))

    bool[] snapshot = empty.copy()
    bool[] middle = empty[1:3]
    snapshot[0] = true
    print(empty[0])
    print(snapshot[0])
    print(middle.length())
    print(middle[0])
    print(middle[1])

    empty.clear()
    print(empty.length())
    print(empty.pop())
    empty.push(false)
    print(empty.length())
    print(empty[0])
    return 0

# Case 2
string make_item(int value):
    return 'owned-' + value.to_string()

int combined_case_2_main(string[] args):
    string[] chars = 'safe'.split('')
    print(chars.length())
    print(chars[0])

    string[] empty = []
    print(empty.length())
    print(empty.push(make_item(0)))
    empty.insert(-3, make_item(1))
    print(empty.length())
    print(empty[0])
    print(empty[1])

    string borrowed = make_item(7)
    string[] values = [make_item(2)]
    print(values.push(borrowed))
    print(push(values, make_item(3)))
    values.push(values[0])
    values.push(make_item(4))
    values.insert(-4, make_item(5))
    insert(values, 2, borrowed)
    values.insert(100, make_item(6))
    values.insert(3, values[0])
    print(values.length())

    string[] snapshot = values.copy()
    string popped = values.pop()
    values.clear()
    print(values.length())
    print(popped)
    print(borrowed)
    print(snapshot.length())
    print(snapshot[0])
    print(snapshot[1])
    print(snapshot[2])
    print(snapshot[3])
    print(snapshot[4])
    print(snapshot[5])
    print(snapshot[6])
    print(snapshot[7])
    print(snapshot[8])

    values.push(make_item(8))
    values.insert(100, borrowed)
    print(values.length())
    print(values[0])
    print(values[1])
    print(snapshot[8])
    return 0

# Case 3
bool[] slice(bool[] values, int start, int end):
    return values[start:end]

int combined_case_3_main(string[] args):
    bool[] values = [true, false]
    bool[] bool_part = values[0:1]
    int[] numbers = [1, 2]
    int[] int_part = numbers[0:1]
    string[] words = ['first', 'second']
    string[] string_part = words[0:1]

    bool[] direct = slice(values, 0, 1)
    bool[] ufcs = values.slice(0, 1)
    print(bool_part.length())
    print(int_part.length())
    print(string_part.length())
    print(direct.length())
    print(ufcs.length())
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main(args) != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main(args) != 0):
        return 1
    print('=== case 3 ===')
    if (combined_case_3_main(args) != 0):
        return 1
    return 0
