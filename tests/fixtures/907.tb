string summarize(string[] values):
    return values.join(',')

string fail_if_bad(string[] values):
    if (values.length() > 0):
        if (values[0] == 'bad'):
            throw 'string task failed'
    return values.join('|')

future<string> submit_scoped_summary(thread_pool pool):
    string[] scoped = ['scoped', 'values']
    return pool.submit(summarize, scoped)

int main():
    thread_pool pool = thread_pool(2)
    string[] values = ['Ada', 'Lin']
    future<string> named = pool.submit(summarize, values)
    future<string> inline = pool.submit(string[] input -> summarize(input), values)
    future<string> borrowed = pool.submit(string[] input -> input[0], values)
    values[0] = 'changed'
    print(named.await())
    print(named.await())
    print(inline.await())
    print(borrowed.await())

    string[] empty = []
    future<string> empty_result = pool.submit(string[] input -> {
        if (input.is_empty()) {
            return ''
        }
        return input[0]
    }, empty)
    print(empty_result.await())

    string[] bad = ['bad']
    future<string> failure = pool.submit(fail_if_bad, bad)
    try:
        print(failure.await())
    catch (exception error):
        print(error)

    future<string> after_failure = pool.submit(summarize, ['after', 'failure'])
    print(after_failure.await())
    future<string> scoped = submit_scoped_summary(pool)
    print(scoped.await())
    return 0
