import union_find;

int main():
    int[] sets = union_find_new(6)
    print(sets.length())
    print(union_find_union(sets, 0, 1))
    print(union_find_union(sets, 2, 3))
    print(union_find_union(sets, 1, 2))
    print(union_find_union(sets, 0, 3))
    print(union_find_connected(sets, 0, 3))
    print(union_find_connected(sets, 0, 4))
    print(union_find_component_size(sets, 2))
    print(union_find_component_size(sets, 4))
    print(union_find_find(sets, 3) == union_find_find(sets, 0))

    int[] empty = union_find_new(0)
    print(empty.length())
    try:
        union_find_find(empty, 0)
    catch (exception error):
        print(error)

    try:
        union_find_new(-1)
    catch (exception error):
        print(error)

    try:
        union_find_connected(sets, 0, 6)
    catch (exception error):
        print(error)
    return 0
