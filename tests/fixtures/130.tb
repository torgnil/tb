int main(string[] args):
    string[] words = ['word' + args.length(), 'literal']
    words.clear()
    print(words.length())
    words.clear()
    words.push('after' + args.length())
    words.push('second')
    words.push('third')
    print(words.length())
    print(words[0])
    words.clear()
    print(words.length())

    string[] empty = []
    clear(empty)
    print(empty.length())
    empty.push('free' + args.length())
    print(empty[0])

    int[] numbers = [1, 2]
    numbers.clear()
    print(numbers.length())

    string[] survivor = ['survive' + args.length()]
    string value = survivor[0]
    clear(survivor)
    print(value)
    return 0
