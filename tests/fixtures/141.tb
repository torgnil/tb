const map<string, int> GLOBAL_COUNTS = {}
const map<int, string> GLOBAL_LABELS = {}
int INITIALIZED = note_globals()

int note_globals():
    print(GLOBAL_COUNTS.length())
    print(GLOBAL_LABELS.is_empty())
    return 7

int borrowed_size(map<string, int> counts):
    print(counts.is_empty())
    return counts.length()

map<string, int> empty_result():
    const map<string, int> result = {}
    return result

string[] empty_keys():
    const map<string, int> counts = {}
    return counts.keys()

string[] empty_values():
    const map<string, string> labels = {}
    return labels.values()

void implicit_empty(int n):
    const map<int, string> labels = {}
    print(labels.is_empty())

void explicit_empty(int n):
    const map<int, int> counts = {}
    print(counts.length())
    return

int main(string[] args):
    int n = args.length() + 4
    const map<string, int> counts = {}
    const map<int, int> int_counts = {}
    const map<int, string> labels = {}
    const map<string, string> names = {}
    print(counts.length())
    print(counts.is_empty())
    print(counts.length())
    print(int_counts.is_empty())
    print(labels.is_empty())
    print(names.length())
    string[] keys = counts.keys()
    string[] values = counts.values()
    print(keys.length())
    print(values.length())
    print(borrowed_size(counts))
    print(counts.is_empty())

    map<string, int> received = empty_result()
    received['key-' + n.to_string()] = n * 3
    print(received['key-' + n.to_string()])
    print(counts.is_empty())
    string[] returned_keys = empty_keys()
    string[] returned_values = empty_values()
    print(returned_keys.length())
    print(returned_values.length())
    implicit_empty(n)
    explicit_empty(n)

    if (n > 0):
        const map<int, int> branch_counts = {}
        print(branch_counts.is_empty())
    int i = 0
    while (i < 2):
        const map<string, int> loop_counts = {}
        string[] loop_keys = loop_counts.keys()
        string[] loop_values = loop_counts.values()
        print(loop_keys.length() + loop_values.length())
        i += 1

    const map<int, int> populated = {n: n * 3}
    print(populated[n])
    map<int, int> mutable_counts = {}
    mutable_counts[n] = n + 1
    print(mutable_counts[n])
    mutable_counts = {}
    print(mutable_counts.is_empty())
    print(GLOBAL_COUNTS.length())
    print(GLOBAL_LABELS.is_empty())
    print(INITIALIZED)
    return 0
