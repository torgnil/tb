string make_label(int value):
    return 'label-' + value.to_string()

set<string> make_singleton_label():
    return {'temporary'}

int main(string[] args):
    set<string> values = {}
    set<string> empty = {}
    print(make_singleton_label()[0])
    print(values.add(make_label(7)))
    print(values.add(make_label(7)))
    print(values[0])

    set<string> independent = values.union(empty)
    print(values.remove(make_label(7)))
    print(values.length())
    print(independent[0])
    print(independent.contains(make_label(7)))
    print(independent.remove(make_label(9)))
    print(independent.length())
    return 0
