record Item(int code, string label);
record Empty();
record Bundle(map<int, Item[]> rows, map<string, Item[]> named);

map<int, Item[]> GLOBAL_ROWS = {1: [], 2: [Item(20, 'old')], 1: [Item(21, 'last')]}
map<string, Empty[]> GLOBAL_EMPTY = {'zero': [], 'one': [Empty()]}

map<int, Item[]> returned_rows(int value):
    return {1: [], 2: [Item(value, 'return')], 1: [Item(value + 1, 'last-return')]}

int summarize_rows(map<int, Item[]> rows):
    return rows.length() + rows[1].length() + rows[2].length()

int main(string[] args):
    int seed = args.length() + 4
    print(GLOBAL_ROWS.length())
    print(GLOBAL_ROWS[1].length())
    print(GLOBAL_ROWS[1][0].code)
    print(GLOBAL_ROWS[2].length())
    print(GLOBAL_EMPTY.length())
    print(GLOBAL_EMPTY['zero'].length())
    print(GLOBAL_EMPTY['one'].length())

    map<int, Item[]> rows = {seed: [], seed + 1: [Item(seed * 10, 'first')], seed: []}
    print(rows.length())
    print(rows[seed].length())
    print(rows[seed + 1][0].code)
    rows[seed] = [Item(seed + 1, 'reset-empty')]
    rows[seed + 1] = []
    print(rows[seed][0].code)
    print(rows[seed + 1].length())
    rows = {seed: [], seed + 1: [Item(seed + 2, 'reassigned')]}
    print(rows.length())
    print(rows[seed].length())
    print(rows[seed + 1][0].code)

    Item[] typed_empty = []
    map<string, Item[]> named = {'blank': typed_empty, 'ready': [Item(seed + 3, 'named')]}
    named['ready'] = []
    named['blank'] = []
    print(named.length())
    print(named['blank'].length())
    print(named['ready'].length())
    named['blank'] = [Item(seed + 4, 'named-reset')]
    print(named['blank'][0].code)

    const map<int, Item[]> fixed = {4: [], 5: [Item(50, 'const')]}
    print(fixed.length())
    print(fixed[4].length())
    print(fixed[5][0].code)

    Bundle bundle = Bundle({1: [], 2: [Item(seed + 5, 'constructor')]}, {'empty': []})
    print(bundle.rows.length())
    print(bundle.rows[1].length())
    print(bundle.rows[2][0].code)
    print(bundle.named['empty'].length())
    bundle.rows = {1: [], 2: [Item(seed + 6, 'field-reset')]}
    bundle.named['empty'] = [Item(seed + 7, 'field-index')]
    print(bundle.rows[1].length())
    print(bundle.rows[2][0].code)
    print(bundle.named['empty'][0].code)

    map<int, Item[]> copied = rows
    copied[seed + 1] = []
    copied[seed] = [Item(90, 'copy-only')]
    print(rows[seed].length())
    print(rows[seed + 1][0].code)
    print(copied[seed].length())
    print(copied[seed + 1].length())

    map<int, Item[]> from_function = returned_rows(seed + 10)
    print(from_function.length())
    print(from_function[1][0].code)
    print(from_function[2][0].code)
    print(summarize_rows({1: [], 2: [Item(seed + 20, 'parameter')]}))
    print({1: [], 2: [Item(seed + 21, 'ufcs-parameter')]}.summarize_rows())

    map<int, Empty[]> empty_records = {1: [], 2: [Empty()], 1: []}
    print(empty_records.length())
    print(empty_records[1].length())
    print(empty_records[2].length())

    map<int, Item[]> loop_rows = {}
    for (int index : range(3)):
        loop_rows = {index: [], index + 10: [Item(index + 30, 'loop')]}
    print(loop_rows.length())
    print(loop_rows[2].length())
    print(loop_rows[12][0].code)

    map<int, int[]> numbers = {1: [], 2: [3]}
    map<string, string[]> words = {'empty': [], 'full': ['word']}
    print(numbers[1].length())
    print(words['empty'].length())
    print(words['full'][0])
    return 0
