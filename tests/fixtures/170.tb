int main(string[] args):
    const string path = 'test-files/write-all-' + args.length().to_string() + '.tmp'
    const string first = args.length().to_string() + '\nsecond'
    write_all(path, first)
    print(read_file(path))
    print(first)

    const string replacement = 'short'
    path.write_all(replacement)
    print(read_file(path))
    print(replacement)

    write_all(path, '')
    print(read_file(path))

    try:
        write_all('test-files/missing-write-all-parent/out', 'unused')
    catch (exception err):
        print(err)
    return 0
