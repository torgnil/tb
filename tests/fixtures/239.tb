

# Case 1
int helper_calls = 0

int next_factor():
    helper_calls += 1
    return 2

int next_divisor():
    helper_calls += 1
    return 4

int[] add_amount(int[] values, int amount):
    return values.map_to(int item -> item + amount)

void print_values(int[] values):
    for (int value in values):
        print(value)

int combined_case_1_main(string[] args):
    int seed = args.length()
    const int fixed = 3
    int[] source = [12, -12, 15, -15]

    int[] added = source.map_to(int item -> item + seed)
    added[0] = 99
    print_values(added)
    print(source[0])

    int[] subtracted = source.map_to(int item -> item - fixed)
    print_values(subtracted)

    int[] multiplied = source.map_to(int item -> item * next_factor())
    print_values(multiplied)

    int[] divided = source.map_to(int item -> item / 4)
    print_values(divided)

    int[] remainder = source.map_to(int item -> item % next_divisor())
    print_values(remainder)
    print(helper_calls)

    const int[] fixed_values = [10, 15]
    int[] fixed_remainder = fixed_values.map_to(int item -> item % fixed)
    print_values(fixed_remainder)

    int[] empty_values = []
    int[] empty_division = empty_values.map_to(int item -> item / 0)
    print(empty_division.length())

    int[] chained = add_amount(source, seed).map_to(int item -> item * 2)
    print_values(chained)
    int branch_value = 0
    if (seed == 1):
        branch_value = chained[0]
    else:
        branch_value = chained[1]
    for (int index : range(2)):
        branch_value += index
    print(branch_value)

    string[] words = ['a', 'abc']
    int[] lengths = words.map_to(string word -> length(word))
    print_values(lengths)
    return 0

# Case 2
int flag_calls = 0
int grid_calls = 0
int word_calls = 0
int condition_calls = 0

record ArrayChoice(bool[] flags, int[][] grid, string[][] words);

bool checked_condition(bool value):
    condition_calls += 1
    return value

bool[] make_flags(int seed):
    flag_calls += 1
    return [seed > 0, seed > 1]

int[][] make_grid(int seed):
    grid_calls += 1
    return [[seed, seed + 1], [seed + 2]]

string[][] make_words(int seed):
    word_calls += 1
    return [['word-' + seed.to_string()], ['tail']]

bool[] fail_flags():
    throw 'unselected bool[] arm'
    return []

int[][] fail_grid():
    throw 'unselected int[][] arm'
    return []

string[][] fail_words():
    throw 'unselected string[][] arm'
    return []

bool[] return_flags(bool choose, int seed):
    return choose ? make_flags(seed) : make_flags(seed + 10)

int[][] return_grid(bool choose, int seed):
    return choose ? make_grid(seed) : make_grid(seed + 10)

string[][] return_words(bool choose, int seed):
    return choose ? make_words(seed) : make_words(seed + 10)

bool[] return_borrowed_flags(bool choose, bool[] left, bool[] right):
    return choose ? left : right

int[][] return_borrowed_grid(bool choose, int[][] left, int[][] right):
    return choose ? left : right

string[][] return_borrowed_words(bool choose, string[][] left, string[][] right):
    return choose ? left : right

int early_value(bool[] values):
    bool[] selected = true ? values : values
    if (selected[0]):
        return selected.length()
    return 0

void print_flags(bool[] values):
    print(values.length())
    print(values[0] ? 1 : 0)
    print(values[1] ? 1 : 0)

void print_grid(int[][] values):
    print(values.length())
    print(values[0][0])
    print(values[0][1])
    print(values[1][0])

void print_words(string[][] values):
    print(values.length())
    print(values[0][0])
    print(values[1][0])

int combined_case_2_main(string[] args):
    bool choose_first = args.length() == 1
    bool take_true = args.length() > 0
    bool[] flags = checked_condition(choose_first) ? make_flags(1) : make_flags(2)
    int[][] grid = choose_first ? make_grid(3) : make_grid(4)
    string[][] words = choose_first ? make_words(5) : make_words(6)
    print_flags(flags)
    print_grid(grid)
    print_words(words)
    print(condition_calls)
    print(flag_calls)
    print(grid_calls)
    print(word_calls)

    bool[] nested_flags = choose_first ? make_flags(7) : (choose_first ? make_flags(8) : make_flags(9))
    print_flags(nested_flags)
    const bool[] fixed_flags = [true, false]
    const int[][] fixed_grid = [[21, 22], [23]]
    const string[][] fixed_words = [['fixed'], ['const']]
    print_flags(choose_first ? fixed_flags : flags)
    print_grid(choose_first ? fixed_grid : grid)
    print_words(choose_first ? fixed_words : words)

    bool[] literal_flags = choose_first ? [true, false] : [false, true]
    int[][] literal_grid = choose_first ? [[14, 15], [16]] : [[17, 18], [19]]
    string[][] literal_words = choose_first ? [['literal-a'], ['literal-b']] : [['other-a'], ['other-b']]
    print_flags(literal_flags)
    print_grid(literal_grid)
    print_words(literal_words)

    bool[] empty_flags = []
    int[][] empty_grid = []
    string[][] empty_words = []
    print((choose_first ? empty_flags : flags).length())
    print((choose_first ? empty_grid : grid).length())
    print((choose_first ? empty_words : words).length())
    print((choose_first ? make_flags(44) : make_flags(45)).length())
    print((choose_first ? make_grid(46) : make_grid(47)).length())
    print((choose_first ? make_words(48) : make_words(49)).length())

    bool[] returned_flags = return_flags(!choose_first, 11)
    int[][] returned_grid = return_grid(!choose_first, 12)
    string[][] returned_words = return_words(!choose_first, 13)
    print_flags(returned_flags)
    print_grid(returned_grid)
    print_words(returned_words)

    bool[] borrowed_flags = return_borrowed_flags(choose_first, flags, fixed_flags)
    int[][] borrowed_grid = return_borrowed_grid(choose_first, grid, fixed_grid)
    string[][] borrowed_words = return_borrowed_words(choose_first, words, fixed_words)
    borrowed_flags[0] = false
    borrowed_grid[0][0] = 99
    borrowed_words[0][0] = 'changed'
    print_flags(flags)
    print_grid(grid)
    print_words(words)
    print_flags(borrowed_flags)
    print_grid(borrowed_grid)
    print_words(borrowed_words)

    bool[] lazy_flags = take_true ? make_flags(31) : fail_flags()
    int[][] lazy_grid = take_true ? make_grid(32) : fail_grid()
    string[][] lazy_words = take_true ? make_words(33) : fail_words()
    bool[] lazy_other_flags = !take_true ? fail_flags() : make_flags(34)
    int[][] lazy_other_grid = !take_true ? fail_grid() : make_grid(35)
    string[][] lazy_other_words = !take_true ? fail_words() : make_words(36)
    print_flags(lazy_flags)
    print_grid(lazy_grid)
    print_words(lazy_words)
    print_flags(lazy_other_flags)
    print_grid(lazy_other_grid)
    print_words(lazy_other_words)

    ArrayChoice choice = ArrayChoice(choose_first ? make_flags(41) : flags, choose_first ? make_grid(42) : grid, choose_first ? make_words(43) : words)
    print_flags(choice.flags)
    print_grid(choice.grid)
    print_words(choice.words)

    bool[] repeated = []
    for (int repeat in range(2)):
        repeated = choose_first ? make_flags(repeat + 51) : make_flags(repeat + 61)
        print_flags(repeated)
    print(early_value(flags))
    print(flag_calls)
    print(grid_calls)
    print(word_calls)
    return 0

# Case 3
string int_array_text(int[] values):
    string text = '['
    for (int index : range(values.length())):
        if (index > 0):
            text += ', '
        text += values[index]
    text += ']'
    return text

int[] transform_closed(int[] values):
    return values.map_to(int item -> item * (item + 1))

int[] make_values(int seed):
    return [seed, 0 - seed, 0, 3]

int[] transform_global():
    return global_values.map_to(int item -> item < 0 ? 0 - item : item)

int[] global_values = [0 - 4, 5, 0]
int[] global_mapped = global_values.map_to(int item -> item * (item + 1))

int combined_case_3_main(string[] args):
    int seed = args.length() + 2
    int[] values = [seed, 0 - seed, 0, 3]
    const int[] frozen = values
    int __tb_int_map_expression_0 = 42

    print(int_array_text(values.map_to(int item -> item * (item + 1))))
    print(int_array_text(values.map_to(int item -> 2 * item + 1)))
    print(int_array_text(values.map_to(int item -> item < 0 ? 0 - item : item)))
    print(int_array_text(values.map_to(int item -> item == 0 ? 99 : 84 / item)))
    print(int_array_text(values.map_to(int item -> item > 0 && (item & 1) == 1 ? item << 1 : item >> 1)))
    print(int_array_text(values.map_to(int item -> item < 0 ? (item == 0 - 3 ? 1 : 2) : (item == 0 ? 3 : 4))))
    print(int_array_text(values.map_to(int item -> item)))
    print(int_array_text(values.map_to(int item -> 9)))
    print(int_array_text(frozen.map_to(int item -> item * item)))
    print(int_array_text(transform_closed(values)))
    print(int_array_text(transform_global()))
    print(int_array_text(global_mapped))

    int[] empty = []
    print(empty.map_to(int item -> item * (item + 1)).length())
    print(values.map_to(int item -> item * (item + 1)).length())

    int[] independent = values.map_to(int item -> 10 + item)
    independent[0] = 700
    print(values[0])
    print(independent[0])
    print(make_values(seed).map_to(int item -> item * (item + 1)).sum())

    if (seed == 3):
        print(values.map_to(int item -> item * (item + 1))[0])
    else:
        print(values.map_to(int item -> 2 * item + 1)[0])

    int loop_value = 0
    for (int index : range(2)):
        int[] repeated = values.map_to(int item -> 1 + item)
        loop_value += repeated[index]
    print(loop_value)
    print(__tb_int_map_expression_0)
    return 0

# Case 4
int GLOBAL_NEGATED = -17
num GLOBAL_PRECISE = -2.750

int negate_constant(const int value):
    return -value

num negate_number(const num value):
    return -value

bool invert(bool value):
    return not value

int combined_case_4_main(string[] args):
    const int seed = args.length() + 4
    const num precise = args.length() + 0.50
    bool is_default = args.length() == 1

    print(-seed)
    print(-negate_constant(seed))
    print(-(-seed))
    print(-precise)
    print(-negate_number(precise))
    print(-(-precise))
    print(!is_default)
    print(not is_default)
    print(invert(is_default))
    print(GLOBAL_NEGATED)
    print(GLOBAL_PRECISE)

    if (is_default):
        print(-3)
    else:
        print(-4)

    int loop_total = 0
    for (int index : range(3)):
        loop_total += -index
    print(loop_total)
    return 0

int main(string[] args):
    print('=== case 1 ===')
    if (combined_case_1_main(args) != 0):
        return 1
    print('=== case 2 ===')
    if (combined_case_2_main(args) != 0):
        return 1
    print('=== case 3 ===')
    if (combined_case_3_main(args) != 0):
        return 1
    print('=== case 4 ===')
    if (combined_case_4_main(args) != 0):
        return 1
    return 0
