record Empty();

int count_ints(const int[] values):
    return values.length()

int count_flags(const bool[] flags):
    return flags.length()

int count_words(const string[] words):
    return words.length()

int count_int_rows(const int[][] rows):
    return rows.length()

int count_rows(const string[][] rows):
    return rows.length()

int combined_lengths(string[] first, const string[] second):
    return first.length() + second.length()

void append_word(string[] words):
    words.push('added')
    print(words.length())

string last_word(const string[][] rows):
    return rows[1][0]

int count_empty_records(Empty[] values):
    return values.length()

int main(string[] args):
    string[] typed_empty = []
    Empty[] empty_records = []
    print(count_ints([]))
    print(count_flags([]))
    print(count_words([]))
    print(count_words(typed_empty))
    print(count_int_rows([[]]))
    print(count_int_rows([[], [1, 2]]))
    print(count_rows([[]]))
    print(count_rows([[], ['one', 'two']]))
    print(combined_lengths([], ['three']))
    append_word([])
    print(last_word([[], ['retained']]))
    print(count_empty_records(empty_records))
    print(count_words(['populated']))
    return 0
