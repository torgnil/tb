enum Mode {
    READY,
    DONE
}

int make_count():
    return 5

bool make_enabled():
    return false

num make_rate():
    return 1.25

string make_label():
    return 'runtime'

Mode make_mode():
    return Mode.DONE

int static_count = 3
bool static_enabled = true
num static_rate = 2.50
string static_label = 'static'
Mode static_mode = Mode.READY

int runtime_count = make_count()
bool runtime_enabled = make_enabled()
num runtime_rate = make_rate()
string runtime_label = make_label()
Mode runtime_mode = make_mode()

int copied_count = runtime_count
bool copied_enabled = runtime_enabled
num copied_rate = runtime_rate
string copied_label = runtime_label
Mode copied_mode = runtime_mode

string last_error = ''

void update_globals(const int value, const bool enabled, const string label):
    if (enabled):
        runtime_count = value
    else:
        runtime_count = 0
    runtime_enabled = enabled
    runtime_rate = value
    runtime_label = label
    runtime_mode = Mode.READY

void capture_error():
    try:
        throw 'caught'
    catch (exception problem):
        last_error = problem

void print_scalar_globals():
    print(runtime_count)
    print(runtime_enabled)
    print(runtime_rate)
    print(runtime_label)
    print(runtime_mode)

int main(string[] args):
    int seed = args.length()
    print(static_count)
    print(static_enabled)
    print(static_rate)
    print(static_label)
    print(static_mode)

    print(runtime_count)
    print(runtime_enabled)
    print(runtime_rate)
    print(runtime_label)
    print(runtime_mode)

    update_globals(seed + 10, seed > 1, 'updated-' + seed)
    print_scalar_globals()
    capture_error()
    print(last_error)

    string runtime_count = 'local-shadow'
    print(runtime_count)
    print(copied_count)
    print(copied_enabled)
    print(copied_rate)
    print(copied_label)
    print(copied_mode)
    return 0
