int main(string[] args):
    int n = args.length()

    int[] singleton = [n + 1]
    singleton.insert(0, n + 10)
    print(singleton)

    int[] before_last = [n + 1, n + 2]
    before_last.insert(1, n + 20)
    print(before_last)

    int[] middle = [n + 1, n + 2, n + 3, n + 4]
    middle.insert(2, n + 30)
    print(middle)

    int[] front = [n + 5, n + 6]
    front.insert(0, n + 40)
    print(front)

    int[] end = [n + 7, n + 8]
    end.insert(10, n + 50)
    print(end)

    int[] empty = []
    empty.insert(0, n + 60)
    print(empty)

    int[] negative = [n + 9, n + 10]
    negative.insert(-2, n + 70)
    print(negative)

    int[] beyond = [n + 11, n + 12]
    beyond.insert(99, n + 80)
    print(beyond)

    int[] repeated = [n + 13, n + 14]
    repeated.insert(1, n + 90)
    repeated.insert(2, n + 100)
    print(repeated)
    return 0
