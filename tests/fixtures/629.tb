import regex;

void show(string[] values):
    print(values.length())
    for (string value : values):
        print('[' + value + ']')

int main():
    string pattern = '(,)|(;)'
    Regex separator = regex_compile(pattern)
    show(split('a,b;c', separator))
    show('x12yz'.split(regex_compile('([0-9]+)([a-z]+)')))
    show(split('ab', regex_compile('(^)')))
    show(split('a,b', regex_compile(',')))
    show(split('a,b', regex_compile('(')))
    return 0
