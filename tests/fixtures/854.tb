int main():
    string repeated = 'a'
    int iteration = 0
    while (iteration < 7) {
        repeated = repeated + repeated
        iteration += 1
    }
    print(repeated.length())
    print(repeated)

    string empty = ''
    empty = empty + empty
    print(empty.length())

    string prefix = 'prefix'
    string suffix = '-tail'
    prefix = prefix + suffix
    print(prefix)

    string shared = 'xy'
    string alias = shared
    shared = shared + alias
    print(shared)
    print(alias)
    return 0
