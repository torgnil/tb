int compute(int n):
    return n * 3 + 1

int main(string[] args):
    thread_pool single = thread_pool(1)
    thread_pool pair = thread_pool(2)
    thread_pool group = thread_pool(4)
    future<int> a = single.submit(compute, args.length())
    future<int> b = pair.submit(compute, args.length() + 1)
    future<int> c = group.submit(compute, args.length() + 2)
    print(a.await())
    print(b.await())
    print(c.await())
    return 0
