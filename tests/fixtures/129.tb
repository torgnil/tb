record Point(int x, int y);
record Bundle(int number, string text, Point point, int[] numbers, string[] words);

const Point GLOBAL = Point(7, 8);

int main(string[] args):
    const Bundle local = Bundle(args.length() + 20, 'local' + args.length(), Point(args.length() + 30, 40), [args.length() + 50, 51], ['word' + args.length(), 'tail'])
    print(local.number)
    print(local.text)
    print(local.point.x)
    print(local.point.y)
    print(local.numbers[0])
    print(local.numbers.length())
    print(local.words[0])
    print(local.words.length())

    print(GLOBAL.x)
    print(GLOBAL.y)

    Bundle mutable = Bundle(args.length() + 60, 'mutable' + args.length(), Point(args.length() + 70, 80), [args.length() + 90], ['control' + args.length()])
    print(mutable.number)
    print(mutable.text)
    print(mutable.point.x)
    print(mutable.numbers[0])
    print(mutable.words[0])
    return 0
