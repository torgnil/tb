enum Mode { READY, DONE }
enum Code { ZERO = 0, ONE = 1 }
record Task(Mode state, Code code, string label);
record Envelope(Task task, Mode status);

const Task GLOBAL = Task('READY', Code.ZERO, 'global');

Mode make_state(string suffix):
    return 'ready' + suffix

Task make_task():
    Mode state = make_state('!')
    Task task = Task(state, Code.ONE, 'returned')
    return task

int main():
    print(GLOBAL.state)
    print(GLOBAL.code)

    Task task = make_task()
    print(task.state)
    print(task.code)
    print(task.label)

    task.state = Mode.DONE
    print(task.state)
    task.state = ''
    print(task.state)

    Envelope envelope = Envelope(task, Mode.READY)
    print(envelope.task.state)
    print(envelope.status)

    const Task fixed = Task(Mode.DONE, Code.ZERO, 'const')
    print(fixed.state)
    print(fixed.label)
    return 0
