void fail():
    string message = 'bootstrap ' + 'exception'
    throw message

int main(string[] args):
    string[] source = read_lines('smoke.tb')
    if (source[0] != 'void fail():'):
        return 1
    if (time_ms() <= 0):
        return 2
    try:
        fail()
    catch (exception err):
        if (err != 'bootstrap exception'):
            return 3
        print('Windows bootstrap smoke test passed')
        return 0
    return 4
