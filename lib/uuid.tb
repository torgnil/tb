# Validate the canonical 8-4-4-4-12 hexadecimal UUID text representation.
# Version and variant bits are intentionally unrestricted.
bool uuid_is_valid(string text):
    if (text.length() != 36):
        return false
    string scan_text = text + ''
    for (int index = 0; index < 36; index++):
        string character = scan_text[index]
        if (index == 8 || index == 13 || index == 18 || index == 23):
            if (character != '-'):
                return false
        else if (!((character >= '0' && character <= '9') || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F'))):
            return false
    return true
