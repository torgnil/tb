# Search byte offsets, matching substring and regular-expression positions.
int byte_index_of(string text, string needle):
    return byte_index_of_from(text, needle, 0)

int byte_index_of_from(string text, string needle, int start):
    int text_length = text.length()
    int needle_length = needle.length()
    if (start < 0 || start > text_length):
        return -1
    if (needle_length == 0):
        return start
    if (needle_length > text_length - start):
        return -1
    int last_start = text_length - needle_length
    int position = start
    while (position <= last_start):
        int offset = 0
        while (offset < needle_length):
            if (text[position + offset] != needle[offset]):
                break
            offset += 1
        if (offset == needle_length):
            return position
        position += 1
    return -1

# Count non-overlapping byte sequences; empty needles match every boundary.
int byte_count(string text, string needle):
    int needle_length = needle.length()
    if (needle_length == 0):
        return text.length() + 1
    int count = 0
    int start = 0
    while (true):
        int position = byte_index_of_from(text, needle, start)
        if (position < 0):
            return count
        count += 1
        start = position + needle_length
    return count

# Count matches at or after a byte offset.
int byte_count_from(string text, string needle, int start):
    int text_length = text.length()
    int needle_length = needle.length()
    if (start < 0 || start > text_length):
        return 0
    if (needle_length == 0):
        return text_length - start + 1
    int count = 0
    while (true):
        int position = byte_index_of_from(text, needle, start)
        if (position < 0):
            return count
        count += 1
        start = position + needle_length
    return count
