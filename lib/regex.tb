# A byte-oriented, full-match Thompson NFA. Instructions use parallel arrays.
# Outgoing patch-list nodes encode the instruction and slot as 2 * pc + slot.
record Regex(bool valid, int start, int[] operations, int[] out1, int[] out2, string[] characters);
record RegexPostfix(bool valid, int[] kinds, string[] characters);
record RegexClassToken(bool valid, bool escaped, bool predefined, string value, int next);
record RegexRepeat(bool valid, int minimum, int maximum, int end);

void regex_postfix_add(int[] kinds, string[] characters, int kind, string character):
    kinds.push(kind)
    characters.push(character)

int regex_precedence(int operator):
    if (operator == 2):
        return 1
    if (operator == 3):
        return 2
    return 0

void regex_push_operator(int[] operators, int[] kinds, string[] characters, int operator):
    while (!operators.is_empty()):
        int top = operators[-1]
        if (top == 1):
            break
        if (regex_precedence(top) < regex_precedence(operator)):
            break
        operators.pop()
        regex_postfix_add(kinds, characters, 6 - top, '')
    operators.push(operator)

bool regex_reserved(string character):
    return character == '[' || character == ']' || character == '{' || character == '}' || character == '^' || character == '$'

bool regex_class_escape(string character):
    return character == 'd' || character == 'D' || character == 'w' || character == 'W' || character == 's' || character == 'S'

bool regex_escapable(string character):
    return regex_class_escape(character) || character == '\\' || character == '.' || character == '|' || character == '*' || character == '+' || character == '?' || character == '(' || character == ')' || regex_reserved(character)

# Read one class member; only recognized regex escapes are accepted.
RegexClassToken regex_class_token(string body, int index):
    if (index >= body.length()):
        return RegexClassToken(false, false, false, '', index)
    string value = body[index]
    if (value != '\\'):
        return RegexClassToken(true, false, false, value, index + 1)
    index += 1
    if (index >= body.length()):
        return RegexClassToken(false, false, false, '', index)
    value = body[index]
    if (!regex_escapable(value) && value != '-'):
        return RegexClassToken(false, false, false, '', index)
    return RegexClassToken(true, true, regex_class_escape(value), value, index + 1)

# Returns 0 for invalid syntax, 1 for a valid nonmatch, and 2 for a match.
# Class bodies are checked when compiled and again if a public Regex is mutated.
int regex_bracket_check(string body, string character):
    int index = 0
    bool negate = false
    if (body.is_empty()):
        return 0
    if (body[0] == '^'):
        negate = true
        index = 1
    int first = index
    bool any = false
    bool matched = false
    while (index < body.length()):
        int start = index
        RegexClassToken token = regex_class_token(body, index)
        if (!token.valid):
            return 0
        index = token.next
        if (!token.escaped && token.value == '-' && start != first && index != body.length()):
            return 0
        bool has_range = false
        if (index < body.length()):
            if (body[index] == '-'):
                if (index + 1 < body.length()):
                    has_range = true
        if (has_range):
            if (token.predefined):
                return 0
            RegexClassToken last = regex_class_token(body, index + 1)
            if (!last.valid || last.predefined):
                return 0
            if (!last.escaped && last.value == '-'):
                return 0
            if (token.value > last.value):
                return 0
            if (character >= token.value && character <= last.value):
                matched = true
            index = last.next
        else if (token.predefined):
            if (regex_class_matches(token.value, character)):
                matched = true
        else if (character == token.value):
            matched = true
        any = true
    if (!any):
        return 0
    if (negate):
        matched = !matched
    if (matched):
        return 2
    return 1

# A maximum of 1,000 repetitions per bound keeps expansion predictable.
# A negative maximum denotes the open-ended form {n,}.
RegexRepeat regex_repeat_parse(string pattern, int start):
    int index = start + 1
    int minimum = 0
    bool has_minimum = false
    while (index < pattern.length()):
        string digit = pattern[index]
        if (!digit.is_digit()):
            break
        has_minimum = true
        minimum = minimum * 10 + digit.to_int()
        if (minimum > 1000):
            return RegexRepeat(false, 0, 0, index)
        index += 1
    if (!has_minimum || index >= pattern.length()):
        return RegexRepeat(false, 0, 0, index)
    if (pattern[index] == '}'):
        return RegexRepeat(true, minimum, minimum, index)
    if (pattern[index] != ','):
        return RegexRepeat(false, 0, 0, index)
    index += 1
    int maximum = 0
    bool has_maximum = false
    while (index < pattern.length()):
        string digit = pattern[index]
        if (!digit.is_digit()):
            break
        has_maximum = true
        maximum = maximum * 10 + digit.to_int()
        if (maximum > 1000):
            return RegexRepeat(false, 0, 0, index)
        index += 1
    if (index >= pattern.length()):
        return RegexRepeat(false, 0, 0, index)
    if (pattern[index] != '}'):
        return RegexRepeat(false, 0, 0, index)
    if (!has_maximum):
        return RegexRepeat(true, minimum, -1, index)
    if (maximum < minimum):
        return RegexRepeat(false, 0, 0, index)
    return RegexRepeat(true, minimum, maximum, index)

# Expand counted postfix expressions inside out. The stack records the first
# token of each complete operand, so a group can be copied without cloning an NFA.
RegexPostfix regex_expand_counts(RegexPostfix postfix):
    int[] kinds = []
    string[] characters = []
    int[] starts = []
    int index = 0
    while (index < postfix.kinds.length()):
        int kind = postfix.kinds[index]
        if (kind == 10):
            if (starts.is_empty()):
                return RegexPostfix(false, [], [])
            int start = starts.pop()
            string spec = postfix.characters[index]
            RegexRepeat repeat = regex_repeat_parse(spec, 0)
            if (!repeat.valid):
                return RegexPostfix(false, [], [])
            int[] fragment_kinds = []
            string[] fragment_chars = []
            int cursor = start
            while (cursor < kinds.length()):
                fragment_kinds.push(kinds[cursor])
                fragment_chars.push(characters[cursor])
                cursor += 1
            int copies = repeat.maximum
            if (copies < 0):
                copies = repeat.minimum + 1
            # Values are bounded before multiplication: 1,001 * 20,000.
            int expanded_size = 1
            if (copies > 0):
                int optional = copies - repeat.minimum
                expanded_size = copies * fragment_kinds.length() + copies - 1 + optional
            if (start + expanded_size > 20000):
                return RegexPostfix(false, [], [])
            while (kinds.length() > start):
                kinds.pop()
                characters.pop()
            bool emitted = false
            int copy = 0
            while (copy < copies):
                cursor = 0
                while (cursor < fragment_kinds.length()):
                    regex_postfix_add(kinds, characters, fragment_kinds[cursor], fragment_chars[cursor])
                    cursor += 1
                if (copy >= repeat.minimum):
                    if (repeat.maximum < 0):
                        regex_postfix_add(kinds, characters, 5, '')
                    else:
                        regex_postfix_add(kinds, characters, 7, '')
                if (emitted):
                    regex_postfix_add(kinds, characters, 3, '')
                emitted = true
                copy += 1
            if (!emitted):
                regex_postfix_add(kinds, characters, 11, '')
            starts.push(start)
        else:
            if (kind == 3 || kind == 4):
                if (starts.length() < 2):
                    return RegexPostfix(false, [], [])
                starts.pop()
            else if (kind == 5 || kind == 6 || kind == 7):
                if (starts.is_empty()):
                    return RegexPostfix(false, [], [])
            else:
                starts.push(kinds.length())
            regex_postfix_add(kinds, characters, kind, postfix.characters[index])
        if (kinds.length() > 20000):
            return RegexPostfix(false, [], [])
        index += 1
    return RegexPostfix(true, kinds, characters)

RegexPostfix regex_postfix(string pattern):
    int[] kinds = []
    string[] characters = []
    int[] operators = []
    bool expect_atom = true
    bool can_quantify = false
    bool has_counts = false
    int index = 0
    while (index < pattern.length()):
        string character = pattern[index]
        bool escaped = false
        if (character == '\\'):
            index += 1
            if (index >= pattern.length()):
                return RegexPostfix(false, [], [])
            character = pattern[index]
            if (!regex_escapable(character)):
                return RegexPostfix(false, [], [])
            escaped = true
        if (!escaped && character == '['):
            int end = index + 1
            bool closed = false
            while (end < pattern.length()):
                string item = pattern[end]
                if (item == '\\'):
                    end += 1
                    if (end >= pattern.length()):
                        return RegexPostfix(false, [], [])
                else if (item == ']'):
                    closed = true
                    break
                end += 1
            if (!closed):
                return RegexPostfix(false, [], [])
            string body = pattern.substring(index + 1, end)
            if (regex_bracket_check(body, '') == 0):
                return RegexPostfix(false, [], [])
            if (!expect_atom):
                regex_push_operator(operators, kinds, characters, 3)
            regex_postfix_add(kinds, characters, 9, body)
            expect_atom = false
            can_quantify = true
            index = end
        else if (!escaped && character == '('):
            if (!expect_atom):
                regex_push_operator(operators, kinds, characters, 3)
            operators.push(1)
            expect_atom = true
            can_quantify = false
        else if (!escaped && character == ')'):
            if (expect_atom):
                return RegexPostfix(false, [], [])
            bool found_open = false
            while (!operators.is_empty()):
                int top = operators.pop()
                if (top == 1):
                    found_open = true
                    break
                regex_postfix_add(kinds, characters, 6 - top, '')
            if (!found_open):
                return RegexPostfix(false, [], [])
            expect_atom = false
            can_quantify = true
        else if (!escaped && character == '|'):
            if (expect_atom):
                return RegexPostfix(false, [], [])
            regex_push_operator(operators, kinds, characters, 2)
            expect_atom = true
            can_quantify = false
        else if (!escaped && character == '{'):
            if (!can_quantify):
                return RegexPostfix(false, [], [])
            RegexRepeat repeat = regex_repeat_parse(pattern, index)
            if (!repeat.valid):
                return RegexPostfix(false, [], [])
            regex_postfix_add(kinds, characters, 10, pattern.substring(index, repeat.end + 1))
            has_counts = true
            can_quantify = false
            index = repeat.end
        else if (!escaped && (character == '*' || character == '+' || character == '?')):
            if (!can_quantify):
                return RegexPostfix(false, [], [])
            int kind = 5
            if (character == '+'):
                kind = 6
            else if (character == '?'):
                kind = 7
            regex_postfix_add(kinds, characters, kind, '')
            can_quantify = false
        else:
            if (!escaped && regex_reserved(character)):
                return RegexPostfix(false, [], [])
            if (!expect_atom):
                regex_push_operator(operators, kinds, characters, 3)
            int kind = 1
            if (!escaped && character == '.'):
                kind = 2
            else if (escaped && regex_class_escape(character)):
                kind = 8
            regex_postfix_add(kinds, characters, kind, character)
            expect_atom = false
            can_quantify = true
        index += 1
    if (expect_atom && !pattern.is_empty()):
        return RegexPostfix(false, [], [])
    while (!operators.is_empty()):
        int top = operators.pop()
        if (top == 1):
            return RegexPostfix(false, [], [])
        regex_postfix_add(kinds, characters, 6 - top, '')
    RegexPostfix result = RegexPostfix(true, kinds, characters)
    if (has_counts):
        return regex_expand_counts(result)
    return result

int regex_emit(int[] operations, int[] out1, int[] out2, string[] characters, int operation, int first, int second, string character):
    int position = operations.length()
    operations.push(operation)
    out1.push(first)
    out2.push(second)
    characters.push(character)
    return position

int regex_patch_next(int[] out1, int[] out2, int node):
    int position = node / 2
    if (node % 2 == 0):
        return out1[position]
    return out2[position]

void regex_patch_set(int[] out1, int[] out2, int node, int value):
    int position = node / 2
    if (node % 2 == 0):
        out1[position] = value
    else:
        out2[position] = value

void regex_patch(int[] out1, int[] out2, int head, int target):
    int node = head
    while (node >= 0):
        int next = regex_patch_next(out1, out2, node)
        regex_patch_set(out1, out2, node, target)
        node = next

int regex_append_patch(int[] out1, int[] out2, int first, int second):
    if (first < 0):
        return second
    int tail = first
    while (regex_patch_next(out1, out2, tail) >= 0):
        tail = regex_patch_next(out1, out2, tail)
    regex_patch_set(out1, out2, tail, second)
    return first

Regex regex_invalid():
    return Regex(false, -1, [], [], [], [])

Regex regex_compile(string pattern):
    RegexPostfix postfix = regex_postfix(pattern)
    if (!postfix.valid):
        return regex_invalid()
    int[] operations = []
    int[] out1 = []
    int[] out2 = []
    string[] characters = []
    int[] starts = []
    int[] patches = []
    int index = 0
    while (index < postfix.kinds.length()):
        int kind = postfix.kinds[index]
        if (kind == 1 || kind == 2 || kind == 8 || kind == 9 || kind == 11):
            int operation = kind
            if (kind == 8):
                operation = 5
            if (kind == 9):
                operation = 6
            if (kind == 11):
                operation = 7
            int state = regex_emit(operations, out1, out2, characters, operation, -1, -1, postfix.characters[index])
            starts.push(state)
            patches.push(state * 2)
        else if (kind == 3 || kind == 4):
            if (starts.length() < 2):
                return regex_invalid()
            int right_start = starts.pop()
            int right_patch = patches.pop()
            int left_start = starts.pop()
            int left_patch = patches.pop()
            if (kind == 3):
                regex_patch(out1, out2, left_patch, right_start)
                starts.push(left_start)
                patches.push(right_patch)
            else:
                int split = regex_emit(operations, out1, out2, characters, 3, left_start, right_start, '')
                starts.push(split)
                patches.push(regex_append_patch(out1, out2, left_patch, right_patch))
        else:
            if (starts.is_empty()):
                return regex_invalid()
            int body_start = starts.pop()
            int body_patch = patches.pop()
            int split = regex_emit(operations, out1, out2, characters, 3, body_start, -1, '')
            if (kind == 5 || kind == 6):
                regex_patch(out1, out2, body_patch, split)
                if (kind == 5):
                    starts.push(split)
                else:
                    starts.push(body_start)
                patches.push(split * 2 + 1)
            else if (kind == 7):
                starts.push(split)
                patches.push(regex_append_patch(out1, out2, body_patch, split * 2 + 1))
            else:
                return regex_invalid()
        index += 1
    int match = regex_emit(operations, out1, out2, characters, 4, -1, -1, '')
    int start = match
    if (!starts.is_empty()):
        if (starts.length() != 1):
            return regex_invalid()
        start = starts.pop()
        regex_patch(out1, out2, patches.pop(), match)
    return Regex(true, start, operations, out1, out2, characters)

# Add an epsilon closure once per input position. A state is visited at most
# once even if repetition creates epsilon cycles. Invalid mutated programs
# fail rather than indexing outside their instruction arrays.
bool regex_add_state(Regex program, int state, int[] seen, int[] pending, int[] active):
    pending.push(state)
    while (!pending.is_empty()):
        int current = pending.pop()
        if (current < 0):
            return false
        if (current >= program.operations.length()):
            return false
        if (seen[current] == 0):
            seen[current] = 1
            int operation = program.operations[current]
            if (operation == 7):
                pending.push(program.out1[current])
            else if (operation == 3):
                pending.push(program.out2[current])
                pending.push(program.out1[current])
            else if (operation == 1 || operation == 2 || operation == 4 || operation == 5 || operation == 6):
                active.push(current)
            else:
                return false
    return true

# ASCII classes operate on one byte; whitespace includes tab through CR and space.
bool regex_class_matches(string kind, string character):
    bool matches = false
    if (kind == 'd' || kind == 'D'):
        matches = character.is_digit()
    else if (kind == 'w' || kind == 'W'):
        matches = character.is_alpha() || character.is_digit() || character == '_'
    else if (kind == 's' || kind == 'S'):
        matches = character == ' ' || (character >= '\t' && character <= '\r')
    if (kind == 'D' || kind == 'W' || kind == 'S'):
        return !matches
    return matches

bool regex_match(Regex program, string text):
    if (!program.valid):
        return false
    int count = program.operations.length()
    if (count == 0):
        return false
    if (program.out1.length() != count || program.out2.length() != count || program.characters.length() != count):
        return false
    int[] seen = range(count)
    seen.fill(0)
    int[] pending = []
    int[] current = []
    int[] next = []
    if (!regex_add_state(program, program.start, seen, pending, current)):
        return false
    int text_index = 0
    while (text_index < text.length()):
        string character = text[text_index]
        seen.fill(0)
        next.clear()
        int index = 0
        while (index < current.length()):
            int state = current[index]
            int operation = program.operations[state]
            bool matches = operation == 2
            if (operation == 1):
                matches = program.characters[state] == character
            else if (operation == 5):
                matches = regex_class_matches(program.characters[state], character)
            else if (operation == 6):
                matches = regex_bracket_check(program.characters[state], character) == 2
            if (matches):
                if (!regex_add_state(program, program.out1[state], seen, pending, next)):
                    return false
            index += 1
        current.clear()
        for (int state : next):
            current.push(state)
        if (current.is_empty()):
            return false
        text_index += 1
    for (int state : current):
        if (program.operations[state] == 4):
            return true
    return false

# Search every possible start position in one NFA traversal. Injecting the start
# closure at each input boundary avoids restarting the matcher on each suffix.
bool regex_contains(Regex program, string text):
    if (!program.valid):
        return false
    int count = program.operations.length()
    if (count == 0):
        return false
    if (program.out1.length() != count || program.out2.length() != count || program.characters.length() != count):
        return false
    # Materialize bytes once. The specialized split helper caches the source
    # length and walks it directly, so matching does not rescan borrowed text.
    string[] text_bytes = text.split('')
    int text_length = text_bytes.length()
    int[] seen = range(count)
    seen.fill(0)
    int[] pending = []
    int[] current = []
    int[] next = []
    int text_index = 0
    while (text_index <= text_length):
        seen.fill(0)
        for (int state : current):
            if (state < 0 || state >= count):
                return false
            seen[state] = 1
        if (!regex_add_state(program, program.start, seen, pending, current)):
            return false
        for (int state : current):
            if (program.operations[state] == 4):
                return true
        if (text_index == text_length):
            return false
        seen.fill(0)
        next.clear()
        string character = text_bytes[text_index]
        int index = 0
        while (index < current.length()):
            int state = current[index]
            int operation = program.operations[state]
            bool matches = operation == 2
            if (operation == 1):
                matches = program.characters[state] == character
            else if (operation == 5):
                matches = regex_class_matches(program.characters[state], character)
            else if (operation == 6):
                matches = regex_bracket_check(program.characters[state], character) == 2
            if (matches):
                if (!regex_add_state(program, program.out1[state], seen, pending, next)):
                    return false
            index += 1
        current.clear()
        for (int state : next):
            current.push(state)
        text_index += 1
    return false
