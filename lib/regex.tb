# A byte-oriented Thompson NFA. Instructions use parallel arrays.
# Outgoing patch-list nodes encode the instruction and slot as 2 * pc + slot.
record Regex(bool valid, int start, int[] operations, int[] out1, int[] out2, string[] characters);
record RegexPostfix(bool valid, int[] kinds, string[] characters);
record RegexRepeat(bool valid, int minimum, int maximum, int end);

# The operator stack, postfix stream, and NFA use separate integer codes.
const int REGEX_OPERATOR_OPEN = 1
const int REGEX_OPERATOR_ALTERNATE = 2
const int REGEX_OPERATOR_CONCAT = 3

const int REGEX_POSTFIX_CHAR = 1
const int REGEX_POSTFIX_ANY = 2
const int REGEX_POSTFIX_CONCAT = 3
const int REGEX_POSTFIX_ALTERNATE = 4
const int REGEX_POSTFIX_STAR = 5
const int REGEX_POSTFIX_PLUS = 6
const int REGEX_POSTFIX_OPTIONAL = 7
const int REGEX_POSTFIX_CLASS = 8
const int REGEX_POSTFIX_BRACKET = 9
const int REGEX_POSTFIX_REPEAT = 10
const int REGEX_POSTFIX_EMPTY = 11
const int REGEX_POSTFIX_START = 12
const int REGEX_POSTFIX_END = 13

const int REGEX_NFA_CHAR = 1
const int REGEX_NFA_ANY = 2
const int REGEX_NFA_SPLIT = 3
const int REGEX_NFA_MATCH = 4
const int REGEX_NFA_CLASS = 5
const int REGEX_NFA_BRACKET = 6
const int REGEX_NFA_EMPTY = 7
const int REGEX_NFA_START = 8
const int REGEX_NFA_END = 9

const int REGEX_CLASS_INVALID = 0
const int REGEX_CLASS_NO_MATCH = 1
const int REGEX_CLASS_MATCH = 2

void regex_postfix_add(int[] kinds, string[] characters, int kind, string character):
    kinds.push(kind)
    characters.push(character)

int regex_precedence(int operator):
    if (operator == REGEX_OPERATOR_ALTERNATE):
        return 1
    if (operator == REGEX_OPERATOR_CONCAT):
        return 2
    return 0

int regex_operator_postfix(int operator):
    if (operator == REGEX_OPERATOR_ALTERNATE):
        return REGEX_POSTFIX_ALTERNATE
    if (operator == REGEX_OPERATOR_CONCAT):
        return REGEX_POSTFIX_CONCAT
    return 0

void regex_push_operator(int[] operators, int[] kinds, string[] characters, int operator):
    while (!operators.is_empty()):
        int top = operators[-1]
        if (top == REGEX_OPERATOR_OPEN):
            break
        if (regex_precedence(top) < regex_precedence(operator)):
            break
        operators.pop()
        regex_postfix_add(kinds, characters, regex_operator_postfix(top), '')
    operators.push(operator)

bool regex_reserved(string character):
    return character.length() == 1 && '[]{}^$'.contains(character)

bool regex_class_escape(string character):
    return character.length() == 1 && 'dDwWsS'.contains(character)

bool regex_escapable(string character):
    return character.length() == 1 && 'dDwWsS\\.|*+?()[]{}^$'.contains(character)

# Returns 0 for invalid syntax, 1 for a valid nonmatch, and 2 for a match.
# Class bodies are checked when compiled and again if a public Regex is mutated.
int regex_bracket_check(string body, string character):
    int length = body.length()
    int index = 0
    bool negate = false
    if (length == 0):
        return REGEX_CLASS_INVALID
    if (body[0] == '^'):
        negate = true
        index = 1
    int first = index
    bool any = false
    bool matched = false
    while (index < length):
        int start = index
        string value = body[index]
        bool escaped = false
        bool predefined = false
        index += 1
        if (value == '\\'):
            escaped = true
            if (index >= length):
                return REGEX_CLASS_INVALID
            value = body[index]
            if (!regex_escapable(value) && value != '-'):
                return REGEX_CLASS_INVALID
            predefined = regex_class_escape(value)
            index += 1
        if (!escaped && value == '-' && start != first && index != length):
            return REGEX_CLASS_INVALID
        bool has_range = false
        if (index < length):
            if (body[index] == '-'):
                if (index + 1 < length):
                    has_range = true
        if (has_range):
            if (predefined):
                return REGEX_CLASS_INVALID
            int last_index = index + 1
            string last_value = body[last_index]
            bool last_escaped = false
            bool last_predefined = false
            last_index += 1
            if (last_value == '\\'):
                last_escaped = true
                if (last_index >= length):
                    return REGEX_CLASS_INVALID
                last_value = body[last_index]
                if (!regex_escapable(last_value) && last_value != '-'):
                    return REGEX_CLASS_INVALID
                last_predefined = regex_class_escape(last_value)
                last_index += 1
            if (last_predefined):
                return REGEX_CLASS_INVALID
            if (!last_escaped && last_value == '-'):
                return REGEX_CLASS_INVALID
            if (value > last_value):
                return REGEX_CLASS_INVALID
            if (character >= value && character <= last_value):
                matched = true
            index = last_index
        else if (predefined):
            if (regex_class_matches(value, character)):
                matched = true
        else if (character == value):
            matched = true
        any = true
    if (!any):
        return REGEX_CLASS_INVALID
    if (negate):
        matched = !matched
    if (matched):
        return REGEX_CLASS_MATCH
    return REGEX_CLASS_NO_MATCH

# A maximum of 1,000 repetitions per bound keeps expansion predictable.
# A negative maximum denotes the open-ended form {n,}.
RegexRepeat regex_repeat_parse(string pattern, int start):
    string scan_pattern = pattern + ''
    int pattern_length = scan_pattern.length()
    int index = start + 1
    int minimum = 0
    bool has_minimum = false
    while (index < pattern_length):
        string digit = scan_pattern[index]
        if (!digit.is_digit()):
            break
        has_minimum = true
        minimum = minimum * 10 + digit.to_int()
        if (minimum > 1000):
            return RegexRepeat(false, 0, 0, index)
        index += 1
    if (!has_minimum || index >= pattern_length):
        return RegexRepeat(false, 0, 0, index)
    if (scan_pattern[index] == '}'):
        return RegexRepeat(true, minimum, minimum, index)
    if (scan_pattern[index] != ','):
        return RegexRepeat(false, 0, 0, index)
    index += 1
    int maximum = 0
    bool has_maximum = false
    while (index < pattern_length):
        string digit = scan_pattern[index]
        if (!digit.is_digit()):
            break
        has_maximum = true
        maximum = maximum * 10 + digit.to_int()
        if (maximum > 1000):
            return RegexRepeat(false, 0, 0, index)
        index += 1
    if (index >= pattern_length):
        return RegexRepeat(false, 0, 0, index)
    if (scan_pattern[index] != '}'):
        return RegexRepeat(false, 0, 0, index)
    if (!has_maximum):
        return RegexRepeat(true, minimum, -1, index)
    if (maximum < minimum):
        return RegexRepeat(false, 0, 0, index)
    return RegexRepeat(true, minimum, maximum, index)

# Expand counted postfix expressions inside out. The stack records the first
# token of each complete operand, so a group can be copied without cloning an NFA.
RegexPostfix regex_expand_counts(RegexPostfix postfix):
    int[] kinds = []
    string[] characters = []
    int[] starts = []
    int index = 0
    while (index < postfix.kinds.length()):
        int kind = postfix.kinds[index]
        if (kind == REGEX_POSTFIX_REPEAT):
            if (starts.is_empty()):
                return RegexPostfix(false, [], [])
            int start = starts.pop()
            string spec = postfix.characters[index]
            RegexRepeat repeat = regex_repeat_parse(spec, 0)
            if (!repeat.valid):
                return RegexPostfix(false, [], [])
            int[] fragment_kinds = []
            string[] fragment_chars = []
            int cursor = start
            while (cursor < kinds.length()):
                fragment_kinds.push(kinds[cursor])
                fragment_chars.push(characters[cursor])
                cursor += 1
            int copies = repeat.maximum
            if (copies < 0):
                copies = repeat.minimum + 1
            # Values are bounded before multiplication: 1,001 * 20,000.
            int expanded_size = 1
            if (copies > 0):
                int optional = copies - repeat.minimum
                expanded_size = copies * fragment_kinds.length() + copies - 1 + optional
            if (start + expanded_size > 20000):
                return RegexPostfix(false, [], [])
            while (kinds.length() > start):
                kinds.pop()
                characters.pop()
            bool emitted = false
            int copy = 0
            while (copy < copies):
                cursor = 0
                while (cursor < fragment_kinds.length()):
                    regex_postfix_add(kinds, characters, fragment_kinds[cursor], fragment_chars[cursor])
                    cursor += 1
                if (copy >= repeat.minimum):
                    if (repeat.maximum < 0):
                        regex_postfix_add(kinds, characters, REGEX_POSTFIX_STAR, '')
                    else:
                        regex_postfix_add(kinds, characters, REGEX_POSTFIX_OPTIONAL, '')
                if (emitted):
                    regex_postfix_add(kinds, characters, REGEX_POSTFIX_CONCAT, '')
                emitted = true
                copy += 1
            if (!emitted):
                regex_postfix_add(kinds, characters, REGEX_POSTFIX_EMPTY, '')
            starts.push(start)
        else:
            if (kind == REGEX_POSTFIX_CONCAT || kind == REGEX_POSTFIX_ALTERNATE):
                if (starts.length() < 2):
                    return RegexPostfix(false, [], [])
                starts.pop()
            else if (kind == REGEX_POSTFIX_STAR || kind == REGEX_POSTFIX_PLUS || kind == REGEX_POSTFIX_OPTIONAL):
                if (starts.is_empty()):
                    return RegexPostfix(false, [], [])
            else:
                starts.push(kinds.length())
            regex_postfix_add(kinds, characters, kind, postfix.characters[index])
        if (kinds.length() > 20000):
            return RegexPostfix(false, [], [])
        index += 1
    return RegexPostfix(true, kinds, characters)

RegexPostfix regex_postfix(string pattern):
    # Index the managed copy so byte reads do not rescan borrowed input length.
    string scan_pattern = pattern + ''
    int pattern_length = scan_pattern.length()
    int[] kinds = []
    string[] characters = []
    int[] operators = []
    bool expect_atom = true
    bool can_quantify = false
    bool has_counts = false
    int index = 0
    while (index < pattern_length):
        string character = scan_pattern[index]
        bool escaped = false
        if (character == '\\'):
            index += 1
            if (index >= pattern_length):
                return RegexPostfix(false, [], [])
            character = scan_pattern[index]
            if (!regex_escapable(character)):
                return RegexPostfix(false, [], [])
            escaped = true
        if (!escaped && character == '['):
            int end = index + 1
            bool closed = false
            while (end < pattern_length):
                string item = scan_pattern[end]
                if (item == '\\'):
                    end += 1
                    if (end >= pattern_length):
                        return RegexPostfix(false, [], [])
                else if (item == ']'):
                    closed = true
                    break
                end += 1
            if (!closed):
                return RegexPostfix(false, [], [])
            string body = scan_pattern.substring(index + 1, end)
            if (regex_bracket_check(body, '') == REGEX_CLASS_INVALID):
                return RegexPostfix(false, [], [])
            if (!expect_atom):
                regex_push_operator(operators, kinds, characters, REGEX_OPERATOR_CONCAT)
            regex_postfix_add(kinds, characters, REGEX_POSTFIX_BRACKET, body)
            expect_atom = false
            can_quantify = true
            index = end
        else if (!escaped && '^$'.contains(character)):
            if (!expect_atom):
                regex_push_operator(operators, kinds, characters, REGEX_OPERATOR_CONCAT)
            int kind = REGEX_POSTFIX_START
            if (character == '$'):
                kind = REGEX_POSTFIX_END
            regex_postfix_add(kinds, characters, kind, '')
            expect_atom = false
            can_quantify = false
        else if (!escaped && character == '('):
            if (!expect_atom):
                regex_push_operator(operators, kinds, characters, REGEX_OPERATOR_CONCAT)
            operators.push(REGEX_OPERATOR_OPEN)
            expect_atom = true
            can_quantify = false
        else if (!escaped && character == ')'):
            if (expect_atom):
                return RegexPostfix(false, [], [])
            bool found_open = false
            while (!operators.is_empty()):
                int top = operators.pop()
                if (top == REGEX_OPERATOR_OPEN):
                    found_open = true
                    break
                regex_postfix_add(kinds, characters, regex_operator_postfix(top), '')
            if (!found_open):
                return RegexPostfix(false, [], [])
            expect_atom = false
            can_quantify = true
        else if (!escaped && character == '|'):
            if (expect_atom):
                return RegexPostfix(false, [], [])
            regex_push_operator(operators, kinds, characters, REGEX_OPERATOR_ALTERNATE)
            expect_atom = true
            can_quantify = false
        else if (!escaped && character == '{'):
            if (!can_quantify):
                return RegexPostfix(false, [], [])
            int repeat_end = index + 1
            while (repeat_end < pattern_length && scan_pattern[repeat_end] != '}'):
                repeat_end += 1
            if (repeat_end < pattern_length):
                repeat_end += 1
            string repeat_source = scan_pattern.substring(index, repeat_end)
            RegexRepeat repeat = regex_repeat_parse(repeat_source, 0)
            if (!repeat.valid):
                return RegexPostfix(false, [], [])
            regex_postfix_add(kinds, characters, REGEX_POSTFIX_REPEAT, repeat_source)
            has_counts = true
            can_quantify = false
            index = repeat_end - 1
        else if (!escaped && '*+?'.contains(character)):
            if (!can_quantify):
                return RegexPostfix(false, [], [])
            int kind = REGEX_POSTFIX_STAR
            if (character == '+'):
                kind = REGEX_POSTFIX_PLUS
            else if (character == '?'):
                kind = REGEX_POSTFIX_OPTIONAL
            regex_postfix_add(kinds, characters, kind, '')
            can_quantify = false
        else:
            if (!escaped && regex_reserved(character)):
                return RegexPostfix(false, [], [])
            if (!expect_atom):
                regex_push_operator(operators, kinds, characters, REGEX_OPERATOR_CONCAT)
            int kind = REGEX_POSTFIX_CHAR
            if (!escaped && character == '.'):
                kind = REGEX_POSTFIX_ANY
            else if (escaped && regex_class_escape(character)):
                kind = REGEX_POSTFIX_CLASS
            regex_postfix_add(kinds, characters, kind, character)
            expect_atom = false
            can_quantify = true
        index += 1
    if (expect_atom && pattern_length > 0):
        return RegexPostfix(false, [], [])
    while (!operators.is_empty()):
        int top = operators.pop()
        if (top == REGEX_OPERATOR_OPEN):
            return RegexPostfix(false, [], [])
        regex_postfix_add(kinds, characters, regex_operator_postfix(top), '')
    RegexPostfix result = RegexPostfix(true, kinds, characters)
    if (has_counts):
        return regex_expand_counts(result)
    return result

int regex_emit(int[] operations, int[] out1, int[] out2, string[] characters, int operation, int first, int second, string character):
    int position = operations.length()
    operations.push(operation)
    out1.push(first)
    out2.push(second)
    characters.push(character)
    return position

int regex_patch_next(int[] out1, int[] out2, int node):
    int position = node / 2
    if (node % 2 == 0):
        return out1[position]
    return out2[position]

void regex_patch_set(int[] out1, int[] out2, int node, int value):
    int position = node / 2
    if (node % 2 == 0):
        out1[position] = value
    else:
        out2[position] = value

void regex_patch(int[] out1, int[] out2, int head, int target):
    int node = head
    while (node >= 0):
        int next = regex_patch_next(out1, out2, node)
        regex_patch_set(out1, out2, node, target)
        node = next

void regex_patch_link(int[] out1, int[] out2, int tail, int head):
    if (tail >= 0):
        regex_patch_set(out1, out2, tail, head)

Regex regex_invalid():
    return Regex(false, -1, [], [], [], [])

string regex_escape(string text):
    string scan_text = text + ''
    int text_length = scan_text.length()
    string[] pieces = []
    int segment_start = 0
    int index = 0
    while (index < text_length):
        string character = scan_text[index]
        if ('\\.|*+?()[]{}^$'.contains(character)):
            if (segment_start < index):
                pieces.push(scan_text.substring(segment_start, index))
            pieces.push('\\')
            pieces.push(character)
            segment_start = index + 1
        index += 1
    if (segment_start < text_length):
        pieces.push(scan_text.substring(segment_start))
    return pieces.join('')

# Translate atom kinds from the postfix stream to their NFA instruction codes.
int regex_postfix_operation(int kind):
    switch (kind):
        case REGEX_POSTFIX_CHAR:
            return REGEX_NFA_CHAR
        case REGEX_POSTFIX_ANY:
            return REGEX_NFA_ANY
        case REGEX_POSTFIX_CLASS:
            return REGEX_NFA_CLASS
        case REGEX_POSTFIX_BRACKET:
            return REGEX_NFA_BRACKET
        case REGEX_POSTFIX_EMPTY:
            return REGEX_NFA_EMPTY
        case REGEX_POSTFIX_START:
            return REGEX_NFA_START
        case REGEX_POSTFIX_END:
            return REGEX_NFA_END
    return 0

Regex regex_compile(string pattern):
    RegexPostfix postfix = regex_postfix(pattern)
    if (!postfix.valid):
        return regex_invalid()
    int[] operations = []
    int[] out1 = []
    int[] out2 = []
    string[] characters = []
    int[] starts = []
    int[] patches = []
    # Each fragment carries the tail matching its unresolved patch-list head.
    int[] patch_tails = []
    int index = 0
    while (index < postfix.kinds.length()):
        int kind = postfix.kinds[index]
        int operation = regex_postfix_operation(kind)
        if (operation != 0):
            int state = regex_emit(operations, out1, out2, characters, operation, -1, -1, postfix.characters[index])
            starts.push(state)
            patches.push(state * 2)
            patch_tails.push(state * 2)
        else if (kind == REGEX_POSTFIX_CONCAT || kind == REGEX_POSTFIX_ALTERNATE):
            if (starts.length() < 2):
                return regex_invalid()
            int right_start = starts.pop()
            int right_patch = patches.pop()
            int right_tail = patch_tails.pop()
            int left_start = starts.pop()
            int left_patch = patches.pop()
            int left_tail = patch_tails.pop()
            if (kind == REGEX_POSTFIX_CONCAT):
                regex_patch(out1, out2, left_patch, right_start)
                starts.push(left_start)
                patches.push(right_patch)
                patch_tails.push(right_tail)
            else:
                int split = regex_emit(operations, out1, out2, characters, REGEX_NFA_SPLIT, left_start, right_start, '')
                regex_patch_link(out1, out2, left_tail, right_patch)
                starts.push(split)
                patches.push(left_patch)
                patch_tails.push(right_tail)
        else:
            if (starts.is_empty()):
                return regex_invalid()
            int body_start = starts.pop()
            int body_patch = patches.pop()
            int body_tail = patch_tails.pop()
            int split = regex_emit(operations, out1, out2, characters, REGEX_NFA_SPLIT, body_start, -1, '')
            if (kind == REGEX_POSTFIX_STAR || kind == REGEX_POSTFIX_PLUS):
                regex_patch(out1, out2, body_patch, split)
                if (kind == REGEX_POSTFIX_STAR):
                    starts.push(split)
                else:
                    starts.push(body_start)
                patches.push(split * 2 + 1)
                patch_tails.push(split * 2 + 1)
            else if (kind == REGEX_POSTFIX_OPTIONAL):
                starts.push(split)
                regex_patch_link(out1, out2, body_tail, split * 2 + 1)
                patches.push(body_patch)
                patch_tails.push(split * 2 + 1)
            else:
                return regex_invalid()
        index += 1
    int match = regex_emit(operations, out1, out2, characters, REGEX_NFA_MATCH, -1, -1, '')
    int start = match
    if (!starts.is_empty()):
        if (starts.length() != 1):
            return regex_invalid()
        start = starts.pop()
        regex_patch(out1, out2, patches.pop(), match)
    return Regex(true, start, operations, out1, out2, characters)

# Queue the successors of an epsilon instruction, preserving split priority.
# Return false for instructions that consume a byte or finish a match.
bool regex_queue_epsilon(Regex program, int state, int[] pending, bool at_start, bool at_end):
    switch (program.operations[state]):
        case REGEX_NFA_EMPTY:
            pending.push(program.out1[state])
            return true
        case REGEX_NFA_START:
            if (at_start):
                pending.push(program.out1[state])
            return true
        case REGEX_NFA_END:
            if (at_end):
                pending.push(program.out1[state])
            return true
        case REGEX_NFA_SPLIT:
            pending.push(program.out2[state])
            pending.push(program.out1[state])
            return true
    return false

# Add an epsilon closure once per input position. A state is visited at most
# once even if repetition creates epsilon cycles. Invalid mutated programs
# fail rather than indexing outside their instruction arrays.
bool regex_add_state(Regex program, int state, int[] seen, int[] pending, int[] active, bool at_start, bool at_end):
    pending.push(state)
    while (!pending.is_empty()):
        int current = pending.pop()
        if (current < 0):
            return false
        if (current >= program.operations.length()):
            return false
        if (seen[current] == 0):
            seen[current] = 1
            int operation = program.operations[current]
            if (regex_queue_epsilon(program, current, pending, at_start, at_end)):
                continue
            if (operation == REGEX_NFA_CHAR || operation == REGEX_NFA_ANY || operation == REGEX_NFA_MATCH || operation == REGEX_NFA_CLASS || operation == REGEX_NFA_BRACKET):
                active.push(current)
            else:
                return false
    return true

# ASCII classes operate on one byte; whitespace includes tab through CR and space.
bool regex_class_matches(string kind, string character):
    if (kind.length() != 1):
        return false
    bool matches = false
    if ('dD'.contains(kind)):
        matches = character.is_digit()
    else if ('wW'.contains(kind)):
        matches = character.is_alpha() || character.is_digit() || character == '_'
    else if ('sS'.contains(kind)):
        matches = character == ' ' || (character >= '\t' && character <= '\r')
    if ('DWS'.contains(kind)):
        return !matches
    return matches

# Return the same three-way result as regex_bracket_check. A MATCH state does
# not consume a byte. Callers decide how to handle an invalid bracket class.
int regex_state_match(Regex program, int state, string character):
    int operation = program.operations[state]
    if (operation == REGEX_NFA_ANY):
        return REGEX_CLASS_MATCH
    if (operation == REGEX_NFA_CHAR):
        if (program.characters[state] == character):
            return REGEX_CLASS_MATCH
    else if (operation == REGEX_NFA_CLASS):
        if (regex_class_matches(program.characters[state], character)):
            return REGEX_CLASS_MATCH
    else if (operation == REGEX_NFA_BRACKET):
        return regex_bracket_check(program.characters[state], character)
    return REGEX_CLASS_NO_MATCH

bool regex_match(Regex program, string text):
    if (!program.valid):
        return false
    int count = program.operations.length()
    if (count == 0):
        return false
    if (program.out1.length() != count || program.out2.length() != count || program.characters.length() != count):
        return false
    int[] seen = range(count)
    seen.fill(0)
    int[] pending = []
    int[] current = []
    int[] next = []
    int text_length = text.length()
    bool final_lf = false
    if (text_length > 0):
        final_lf = text[text_length - 1] == '\n'
    bool initial_end = text_length == 0 || (text_length == 1 && final_lf)
    if (!regex_add_state(program, program.start, seen, pending, current, true, initial_end)):
        return false
    # Copy once into a managed string so indexed byte reads use its cached
    # length instead of rescanning the borrowed input with strlen each time.
    string scan_text = text + ''
    int text_index = 0
    while (text_index < text_length):
        string character = scan_text[text_index]
        seen.fill(0)
        next.clear()
        int index = 0
        while (index < current.length()):
            int state = current[index]
            if (regex_state_match(program, state, character) == REGEX_CLASS_MATCH):
                int boundary = text_index + 1
                bool at_end = boundary == text_length || (final_lf && boundary == text_length - 1)
                if (!regex_add_state(program, program.out1[state], seen, pending, next, false, at_end)):
                    return false
            index += 1
        current.clear()
        for (int state : next):
            current.push(state)
        if (current.is_empty()):
            return false
        text_index += 1
    for (int state : current):
        if (program.operations[state] == REGEX_NFA_MATCH):
            return true
    return false

# Search every possible start position in one NFA traversal. Injecting the start
# closure at each input boundary avoids restarting the matcher on each suffix.
bool regex_contains(Regex program, string text):
    if (!program.valid):
        return false
    int count = program.operations.length()
    if (count == 0):
        return false
    if (program.out1.length() != count || program.out2.length() != count || program.characters.length() != count):
        return false
    # Materialize bytes once. The specialized split helper caches the source
    # length and walks it directly, so matching does not rescan borrowed text.
    string[] text_bytes = text.split('')
    int text_length = text_bytes.length()
    bool final_lf = false
    if (text_length > 0):
        final_lf = text_bytes[text_length - 1] == '\n'
    int[] seen = range(count)
    seen.fill(0)
    int[] pending = []
    int[] current = []
    int[] next = []
    int text_index = 0
    while (text_index <= text_length):
        seen.fill(0)
        for (int state : current):
            if (state < 0 || state >= count):
                return false
            seen[state] = 1
        bool at_end = text_index == text_length || (final_lf && text_index == text_length - 1)
        if (!regex_add_state(program, program.start, seen, pending, current, text_index == 0, at_end)):
            return false
        for (int state : current):
            if (program.operations[state] == REGEX_NFA_MATCH):
                return true
        if (text_index == text_length):
            return false
        seen.fill(0)
        next.clear()
        string character = text_bytes[text_index]
        int index = 0
        while (index < current.length()):
            int state = current[index]
            if (regex_state_match(program, state, character) == REGEX_CLASS_MATCH):
                int boundary = text_index + 1
                bool next_end = boundary == text_length || (final_lf && boundary == text_length - 1)
                if (!regex_add_state(program, program.out1[state], seen, pending, next, false, next_end)):
                    return false
            index += 1
        current.clear()
        for (int state : next):
            current.push(state)
        text_index += 1
    return false

# Add one start-origin's epsilon closure. Callers process seeds in increasing
# origin order and share seen across the boundary, so the first visit to a
# state always carries its earliest possible start.
bool regex_add_start_state(Regex program, int state, int start, int[] seen, int[] pending, int[] active, int[] active_starts, bool at_start, bool at_end):
    pending.push(state)
    while (!pending.is_empty()):
        int current = pending.pop()
        if (current < 0 || current >= program.operations.length()):
            return false
        if (seen[current] == -1):
            seen[current] = start
            int operation = program.operations[current]
            if (regex_queue_epsilon(program, current, pending, at_start, at_end)):
                continue
            if (operation == REGEX_NFA_CLASS):
                string kind = program.characters[current]
                if (!regex_class_escape(kind)):
                    return false
                active.push(current)
                active_starts.push(start)
            else if (operation == REGEX_NFA_BRACKET):
                if (regex_bracket_check(program.characters[current], '') == REGEX_CLASS_INVALID):
                    return false
                active.push(current)
                active_starts.push(start)
            else if (operation == REGEX_NFA_CHAR || operation == REGEX_NFA_ANY || operation == REGEX_NFA_MATCH):
                active.push(current)
                active_starts.push(start)
            else:
                return false
    return true

# Find the earliest accepted start in a single parallel NFA traversal. The
# current state list stays grouped by increasing start offset; each closure is
# exhausted before a later start is injected, making first-state deduplication
# equivalent to retaining the minimum start for that state and boundary.
int regex_find_start(Regex program, string text):
    if (!program.valid):
        return -1
    int count = program.operations.length()
    if (count == 0):
        return -1
    if (program.out1.length() != count || program.out2.length() != count || program.characters.length() != count):
        return -1
    string[] text_bytes = text.split('')
    int text_length = text_bytes.length()
    bool final_lf = false
    if (text_length > 0):
        final_lf = text_bytes[text_length - 1] == '\n'
    int[] seen = range(count)
    seen.fill(-1)
    int[] pending = []
    int[] current = []
    int[] current_starts = []
    int[] next = []
    int[] next_starts = []
    int best = -1
    int text_index = 0
    bool initial_end = text_length == 0 || (text_length == 1 && final_lf)
    if (!regex_add_start_state(program, program.start, 0, seen, pending, current, current_starts, true, initial_end)):
        return -1
    while (true):
        int index = 0
        while (index < current.length()):
            int state = current[index]
            if (state < 0 || state >= count):
                return -1
            if (program.operations[state] == REGEX_NFA_MATCH):
                int match_start = current_starts[index]
                if (best == -1 || match_start < best):
                    best = match_start
            index += 1
        if (text_index == text_length):
            return best
        seen.fill(-1)
        next.clear()
        next_starts.clear()
        string character = text_bytes[text_index]
        index = 0
        while (index < current.length()):
            int state = current[index]
            if (state < 0 || state >= count):
                return -1
            int match_result = regex_state_match(program, state, character)
            if (match_result == REGEX_CLASS_INVALID):
                return -1
            if (match_result == REGEX_CLASS_MATCH):
                int boundary = text_index + 1
                bool at_end = boundary == text_length || (final_lf && boundary == text_length - 1)
                if (!regex_add_start_state(program, program.out1[state], current_starts[index], seen, pending, next, next_starts, false, at_end)):
                    return -1
            index += 1
        current.clear()
        current_starts.clear()
        for (int next_index = 0; next_index < next.length(); next_index += 1):
            current.push(next[next_index])
            current_starts.push(next_starts[next_index])
        int boundary = text_index + 1
        bool at_end = boundary == text_length || (final_lf && boundary == text_length - 1)
        if (!regex_add_start_state(program, program.start, boundary, seen, pending, current, current_starts, false, at_end)):
            return -1
        text_index += 1
    return best
