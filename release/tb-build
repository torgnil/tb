#!/bin/sh

set -eu

if [ "$#" -lt 2 ]; then
    echo "Usage: tb-build INPUT.tb OUTPUT [CLANG_ARG...]" >&2
    exit 2
fi

input=$1
output=$2
shift 2
script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
bundle_root=$(CDPATH= cd "$script_dir" && pwd)
scratch_dir=$(mktemp -d "${TMPDIR:-/tmp}/tb-build.XXXXXX")
llvm_file="$scratch_dir/program.ll"
cleanup() {
    rm -rf "$scratch_dir"
}
trap cleanup 0
trap 'exit 1' HUP INT TERM

"$bundle_root/tb" "$input" "$llvm_file"

for suffix in cflags csources linkflags; do
    metadata_file="$llvm_file.$suffix"
    [ -f "$metadata_file" ] || continue
    while IFS= read -r value || [ -n "$value" ]; do
        [ -n "$value" ] || continue
        set -- "$@" "$value"
    done < "$metadata_file"
done

set -- "$@" "$llvm_file" -o "$output"
clang "$@"
