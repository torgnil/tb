import regex;

int main():
    Regex pattern = regex_compile('([a-z]+|[0-9]+)')
    string[] samples = ['alpha', '12345', 'ab!cd', '---', '----------------------------------------']
    int full = 0
    for (int i = 0; i < 1000; i++):
        for (string sample : samples):
            if (regex_match(pattern, sample)):
                full += 1
    print(full)
    return 0
