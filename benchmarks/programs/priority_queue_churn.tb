int compare_high_first(int left, int right):
    return right - left

int build_value(int round, int index):
    return (round * 17 + index * 31 + index * index) % 997

int main(string[] args):
    int total = 0
    for (int round = 0; round < 1200; round++):
        int[] values = []
        for (int index = 0; index < 64; index++):
            values.push(build_value(round + args.length(), index))

        prio_q<int> queue = values.create_prio_q(compare_high_first)
        for (int index = 0; index < 8; index++):
            queue.push(build_value(round + 53, index + 71))

        int position = 1
        while (!queue.is_empty()):
            total += queue.pop() * position
            position++

    print(total)
    return 0
